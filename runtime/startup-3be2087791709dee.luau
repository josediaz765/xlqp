[ "src/framework/config/ui/chatlogs.luau" ] = "return {\n    title = 'Chat Logs',\n    maxLabels = 200,\n    window = {\n        width = 340,\n        height = 240,\n        topBarHeight = 20,\n        rowHeight = 22,\n        closeIconSize = 10,\n        buttonCorner = 6,\n        buttonInset = 2,\n        tabInset = 0,\n        stripeTransparency = 0.96,\n        entryHoverTransparency = 0.88,\n        shownX = 12,\n        shownY = 100,\n        hiddenX = -360,\n        tweenTime = 0.28,\n        tabTweenTime = 0.2,\n    },\n    scrollBar = {\n        barThickness = 12,\n        increment = 20,\n        wheelIncrement = 40,\n    },\n    textSizes = {\n        title = 16,\n        control = 12,\n        tab = 13,\n        entry = 13,\n    },\n    tabs = {\n        chat = 'Chat',\n        join = 'Joins',\n    },\n    controls = {\n        enabled = 'Enabled',\n        disabled = 'Disabled',\n        save = 'Save',\n        clear = 'Clear',\n    },\n    messages = {\n        saved = 'Saved',\n        saveFailed = 'Save failed',\n        copied = 'Copied',\n        chatCopied = 'Message copied to the clipboard',\n        joinCopied = 'User ID copied to the clipboard:',\n        noClipboard = 'Your executor has no clipboard function',\n    },\n}\n",
[ "src/framework/config/ui/colors.luau" ] = "local red = Color3.fromRGB(255, 85, 102)\nlocal purple = Color3.fromRGB(192, 132, 252)\nlocal green = Color3.fromRGB(74, 222, 128)\n\nreturn {\n    text = {red = red, purple = purple, green = green},\n    args = {\n        number = purple,\n        boolean = purple,\n        text = green,\n        string = green,\n        symbol = red,\n        comment = purple,\n        others = green,\n        warn = purple,\n        error = red,\n        valid = green,\n        tag = purple,\n    },\n    commands = {undefined = red, client = green, deprecated = purple},\n}\n",
[ "src/framework/config/ui/notifier.luau" ] = "return {\n    defaultTime = 5,\n    defaultTitle = 'Notification',\n    size = UDim2.fromOffset(250, 100),\n    maxHeight = 240,\n    cornerRadius = 6,\n    titleHeight = 20,\n    iconSize = 11,\n    titleTextSize = 14,\n    textSize = 14,\n    padding = 8,\n    spacing = 4,\n    gapToWindow = 0,\n    maxVisible = 5,\n    actionHeight = 22,\n    actionMinWidth = 56,\n    actionPadding = 12,\n    actionGap = 4,\n    actionsTopGap = 4,\n    tweenTime = 0.5,\n    flashTime = 0.5,\n}\n",
[ "src/framework/config/ui/partpath.luau" ] = "return {\n    window = {\n        title = 'Part Path',\n        width = 250,\n        topBarHeight = 20,\n        closeIconSize = 15,\n        closeInset = 2,\n        rowHeight = 17,\n        buttonRowHeight = 21,\n        buttonHeight = 17,\n        buttonGap = 6,\n        rowPadding = 4,\n        pathCharsPerLine = 28,\n        textInset = 5,\n        verticalPadding = 3,\n        stripeTransparency = 0.96,\n        shownY = 100,\n        hiddenY = -500,\n        tweenTime = 0.5,\n    },\n    textSizes = {\n        title = 16,\n        section = 11,\n        value = 14,\n        help = 11,\n        button = 12,\n    },\n    headers = {\n        path = '#path',\n        actions = '#actions',\n    },\n    labels = {\n        hint = 'no part selected',\n        help = \n[[click a part to see its path. \"select part\" saves it as a waypoint.]],\n    },\n    buttons = {\n        selectPart = 'select part',\n        copyPath = 'copy path',\n        copied = 'copied',\n        feedbackTime = 1.5,\n        cornerRadius = 6,\n    },\n    messages = {\n        noPart = 'select a part first',\n        noPath = 'select a part to copy its path',\n        noClipboard = \"this executor doesn't support clipboard\",\n    },\n}\n",
[ "src/framework/config/ui/reference.luau" ] = "local colorFromRGB = require('../../../utils/tools').colorFromRGB\nlocal cmdsColors = require('./colors').commands\nlocal textHighlight = require('../../../utils/textHighlight')\n\nlocal function h(text)\n    return textHighlight:apply(text)\nend\n\nreturn {\n    cases = {\n        {\n            'all',\n            '- includes everyone',\n        },\n        {\n            'others',\n            '- includes everyone except you',\n        },\n        {\n            'me',\n            '- includes your player only',\n        },\n        {\n            '@username',\n            [[- searches for players by username only (ignores displaynames)]],\n        },\n        {\n            '#[number]',\n            '- gets a specified amount of random players',\n        },\n        {\n            'random',\n            '- affects a random player',\n        },\n        {\n            '%[team name]',\n            '- includes everyone on a given team',\n        },\n        {\n            'allies / team',\n            '- players who are on your team',\n        },\n        {\n            'enemies / nonteam',\n            '- players who are not on your team',\n        },\n        {\n            'friends',\n            '- anyone who is friends with you',\n        },\n        {\n            'nonfriends',\n            '- anyone who is not friends with you',\n        },\n        {\n            'guests',\n            '- guest players (obsolete)',\n        },\n        {\n            'bacons',\n            '- anyone with the \"bacon\" or pal hair',\n        },\n        {\n            'age[number]',\n            '- includes anyone below or at the given age',\n        },\n        {\n            'rad[number]',\n            '- includes anyone within the given radius',\n        },\n        {\n            'nearest',\n            '- gets the closest player to you',\n        },\n        {\n            'farthest',\n            '- gets the farthest player from you',\n        },\n        {\n            'group[ID]',\n            '- gets players who are in a certain group',\n        },\n        {\n            'alive',\n            '- gets players who are alive',\n        },\n        {\n            'dead',\n            '- gets players who are dead',\n        },\n    },\n    sections = {\n        {\n            {\n                'title',\n                'Commands Colors',\n            },\n            {\n                'text',\n                `{colorFromRGB('COMMAND_UNDEFINED', cmdsColors.undefined)} -> This command don't work (BETA)`,\n            },\n            {\n                'text',\n                `{colorFromRGB('CLIENT', cmdsColors.client)} -> Only works on client`,\n            },\n            {\n                'text',\n                `{colorFromRGB('DEPRECATED', cmdsColors.deprecated)} -> This command is deprecated`,\n            },\n        },\n        {\n            {\n                'title',\n                'Special Player Cases',\n            },\n            {\n                'text',\n                \n[[These keywords can be used to quickly select groups of players in commands:]],\n            },\n            {\n                'cases',\n            },\n        },\n        {\n            {\n                'title',\n                'Command Arguments',\n            },\n            {\n                'text',\n                \n[[Some commands need extra information. Anything you type after the command name is an argument, and arguments are separated by spaces.]],\n            },\n            {\n                'text',\n                `The gray hint in the command bar shows what each argument expects. For example, {h('(fly_speed: number?)')} means you type a number.`,\n            },\n            {\n                'bold',\n                \n[[The ? means the argument is optional. You can leave it out and the command still runs.]],\n            },\n            {\n                'text',\n                `Arguments are read in order, so optional ones go last. If a value has spaces, put it in quotes, like {h('\"John Doe\"')}.`,\n            },\n            {\n                'text',\n                \n[[If something is wrong, the command bar tells you what to fix, and nothing runs.]],\n            },\n            {\n                'bold',\n                'Examples:',\n            },\n            {\n                'text',\n                \n[[;fly 50 - fly at speed 50\n;fov 90 - set the field of view to 90\n;tppos 0,10,0 - teleport to X 0, Y 10, Z 0]],\n            },\n        },\n        {\n            {\n                'title',\n                'What the Hint Words Mean',\n            },\n            {\n                'text',\n                `<b>number</b> - a number, like 10 or 2.5\\n<b>string</b> - text, like a name or a word\\n<b>boolean</b> - yes or no. You can also type true/false or enabled/disabled\\n<b>player</b> - a player name, or one of the special words above\\n<b>vector3</b> - a position written as three numbers with commas: X,Y,Z, like 0,10,0\\n<b>color3</b> - a color, written as {h('#ff0000')} or as red,green,blue from 0 to 255\\n<b>waypoint</b> - the name of a waypoint you saved\\n<b>className</b> - a type of object in the game, like Part or Model\\n<b>team</b> - the name of a team in the game\\n<b>keycode</b> - a keyboard key, like E\\n<b>command</b> - the name of a command\\n<b>alias</b> - a shortcut name you made with addalias\\n<b>plugin</b> - the name of a plugin you installed\\n<b>object</b> - any text, nothing is checked`,\n            },\n        },\n        {\n            {\n                'title',\n                'Various Operators',\n            },\n            {\n                'bold',\n                'Use commas to separate multiple expressions:',\n            },\n            {\n                'text',\n                ';locate noob,noob2,bob',\n            },\n            {\n                'bold',\n                \n[[Use - to exclude, and + to include players in your expression:]],\n            },\n            {\n                'text',\n                \n[[;locate %blue-friends (gets players in blue team who aren't your friends)]],\n            },\n            {\n                'bold',\n                \n[[Put ! before a command to run it with the last arguments it was ran with:]],\n            },\n            {\n                'text',\n                \n[[After running ;offset 0 100 0,  you can run !offset anytime to repeat that command with the same arguments that were used to run it last time]],\n            },\n        },\n        {\n            {\n                'title',\n                'Command Looping',\n            },\n            {\n                'bold',\n                \n[=[Form: [How many times it loops]^[delay (optional)]^[command]]=],\n            },\n            {\n                'text',\n                \"Use the 'breakloops' command to stop all running loops.\",\n            },\n            {\n                'bold',\n                'Examples:',\n            },\n            {\n                'text',\n                \n[[;5^btools - gives you 5 sets of btools\n;10^3^drophats - drops your hats every 3 seconds 10 times\n;inf^0.1^animspeed 100 - infinitely loops your animation speed to 100]],\n            },\n        },\n        {\n            {\n                'title',\n                'Execute Multiple Commands at Once',\n            },\n            {\n                'bold',\n                'You can execute multiple commands at once using \"\\\\\"',\n            },\n            {\n                'bold',\n                'Examples:',\n            },\n            {\n                'text',\n                \n[[;drophats\\respawn - drops your hats and respawns you\n;enable inventory\\enable playerlist\\refresh - enables those coregui items and refreshes you]],\n            },\n        },\n        {\n            {\n                'title',\n                'Browse Command History',\n            },\n            {\n                'text',\n                \n[[While focused on the command bar, you can use the up and down arrow keys to browse recently used commands]],\n            },\n        },\n        {\n            {\n                'title',\n                'Autocomplete in the Command Bar',\n            },\n            {\n                'text',\n                \n[[While focused on the command bar, you can use the tab key to insert the top suggested command into the command bar.]],\n            },\n        },\n        {\n            {\n                'title',\n                'Using Event Binds',\n            },\n            {\n                'text',\n                \n[[Use event binds to set up commands that get executed when certain events happen. You can edit the conditions for an event command to run (such as which player triggers it).]],\n            },\n            {\n                'text',\n                \n[[Some events may send arguments; you can use them in your event command by using $ followed by the argument number ($1, $2, etc). You can find out the order and types of these arguments by looking at the settings of the event command.]],\n            },\n            {\n                'bold',\n                'Example:',\n            },\n            {\n                'text',\n                \n[[Setting up 'goto $1' on the OnChatted event will teleport you to any player that chats.]],\n            },\n        },\n        {\n            {\n                'title',\n                'Get Further Help',\n            },\n            {\n                'text',\n                \n[[You can join the Discord server to get support with IY,  and read up on more documentation such as the Plugin API.]],\n            },\n            {\n                'invite',\n            },\n        },\n    },\n}\n",
[ "src/framework/config/ui/serverinfo.luau" ] = "return {\n    window = {\n        title = 'Server',\n        width = 250,\n        topBarHeight = 20,\n        closeIconSize = 15,\n        closeInset = 2,\n        rowHeight = 17,\n        rowGap = 0,\n        textInset = 5,\n        verticalPadding = 3,\n        stripeTransparency = 0.96,\n        shownY = 100,\n        hiddenY = -500,\n        tweenTime = 0.5,\n        updateInterval = 1,\n    },\n    copyButton = {\n        width = 50,\n        height = 15,\n        gap = 6,\n        cornerRadius = 6,\n        idleText = 'Copy',\n        copiedText = 'Copied',\n        feedbackTime = 1.5,\n    },\n    textSizes = {\n        title = 16,\n        section = 11,\n        value = 14,\n        copyButton = 12,\n    },\n    headers = {\n        localPlayer = '#player',\n        runTime = '#run-time',\n        statistics = '#statistics',\n    },\n    labels = {\n        playerId = 'player-id:  ',\n        appearance = 'appearance: ',\n        players = 'players:     ',\n        maxPlayers = 'max-players: ',\n        gameId = 'game-id:     ',\n        placeId = 'place-id:    ',\n        placeName = 'place-name:  ',\n    },\n    time = {\n        hour = 'Hour(s)',\n        minute = 'Minute(s)',\n        second = 'Second(s)',\n    },\n    messages = {\n        loading = 'LOADING',\n        unknownPlace = 'Unknown',\n        alreadyEnabled = 'the info menu is already enabled',\n        noClipboard = \"this executor doesn't support clipboard\",\n    },\n}\n",
[ "src/framework/config/ui/settings.luau" ] = "local keepiy = require('../commands/keepiy')\n\nreturn {\n    keys = {\n        keepMenuOpen = 'interface.keepMenuOpen',\n        keepIY = keepiy.settingKey,\n        clearOnEnter = 'clearOnEnter',\n        theme = 'selectedTheme',\n    },\n    panel = {\n        shownY = 0,\n        hiddenY = 1,\n        tweenTime = 0.5,\n        padding = 5,\n        rowHeight = 25,\n        rowGap = 4,\n        headerHeight = 16,\n        stripeTransparency = 0.5,\n        scrollBarThickness = 4,\n        floatBackSize = 25,\n        floatBackMargin = 6,\n        floatBackFlat = 0.3,\n        floatBackOut = 0.5,\n        floatBackTime = 0.35,\n    },\n    row = {\n        labelInset = 28,\n        iconInset = 5,\n        iconSize = 16,\n        chevronSize = 14,\n    },\n    box = {\n        size = 16,\n        inset = 4,\n        cornerRadius = 3,\n        fillCornerRadius = 2,\n    },\n    value = {\n        width = 20,\n        height = 16,\n        cornerRadius = 4,\n        keybindWidth = 88,\n        aliasWidth = 110,\n        inputWidth = 110,\n        formDelayWidth = 46,\n        addWidth = 44,\n        delayWidth = 44,\n        buttonWidth = 36,\n        reloadWidth = 52,\n        positionWidth = 92,\n    },\n    badge = {\n        height = 12,\n        overhang = 3,\n    },\n    textSizes = {\n        header = 12,\n        label = 14,\n        value = 12,\n        footer = 11,\n        badge = 10,\n    },\n    footer = '{name} {version}',\n    pages = {\n        back = 'Back',\n        backIcon = 'lucide-chevron-left',\n        theme = {\n            title = '#theme',\n            incomplete = '(incomplete)',\n            primary = 'primary',\n        },\n        keybinds = {\n            title = '#keybinds',\n            reset = 'Reset to defaults',\n            alwaysWorks = '%s also works as the %s',\n        },\n        commands = {\n            title = '#command settings',\n            reset = 'Reset command keys to defaults',\n        },\n        importExport = {\n            title = '#import / export',\n            exportTitle = '#export',\n            exportRow = 'Copy settings',\n            exportHint = \n[[copies your settings, keybinds, aliases, event binds and waypoints as text]],\n            importTitle = '#import',\n            importRow = 'Import settings',\n            importHint = \n[[paste a copied text in the box, then import it. It replaces the settings it holds]],\n            placeholder = 'paste the copied text here',\n            copied = 'settings copied to the clipboard',\n            copyFailed = \n[[your exploit can't copy: the text is in the box, copy it from there]],\n            empty = 'paste a copied text first',\n            notAnExport = 'that text is not an export of IY',\n            imported = 'imported %s',\n            restartNote = 'aliases and plugins apply when IY is opened again',\n            notifyTitle = 'Import / Export',\n        },\n        aliases = {\n            title = '#aliases',\n            addTitle = '#add alias',\n            aliasHint = 'alias',\n            commandHint = 'command it runs',\n            addButton = 'Add alias',\n            listTitle = '#custom aliases',\n            listHint = 'tap an alias to remove it',\n            empty = 'no custom aliases yet',\n            missing = 'write the alias and the command it runs',\n            spaces = \"an alias can't have spaces\",\n            badCharacters = \n[[an alias can't have \\ ^ ! , | & or quotes: the command bar reads them as something else]],\n            added = \"added '%s'\",\n            removed = \"removed '%s'\",\n            notifyTitle = 'Aliases',\n            undoTitle = 'Alias Removed',\n            undoMessage = \"'%s' ran '%s'\",\n            undo = 'Undo',\n            undoTime = 10,\n            restored = \"restored '%s'\",\n        },\n        waypoints = {\n            title = '#waypoints',\n            notifyTitle = 'Waypoints',\n            newTitle = '#new waypoint',\n            nameHint = 'name',\n            positionHint = 'x, y, z',\n            addButton = 'Add',\n            formHint = 'no position saves where you are standing',\n            modeTitle = '#tap a waypoint to',\n            modes = {\n                {\n                    mode = 'teleport',\n                    label = 'Teleport',\n                },\n                {\n                    mode = 'tween',\n                    label = 'Tween',\n                },\n                {\n                    mode = 'walk',\n                    label = 'Walk',\n                },\n            },\n            markers = 'Show markers in the world',\n            listTitle = '#waypoints of this game',\n            listHint = 'tap one to go there, Del removes it',\n            empty = 'no waypoints in this game yet',\n            delete = 'Del',\n            clearTitle = '#clear',\n            clearGame = 'Clear this game',\n            clearAll = 'Clear every game',\n            missingName = 'write a name for the waypoint',\n            badPosition = 'the position needs 3 numbers, like 10, 5, -20',\n            noCharacter = 'your character was not found',\n            noMarkers = 'there are no waypoints to show',\n            saved = \"saved '%s' at %s\",\n            updated = \"updated '%s' to %s\",\n            went = \"teleported to '%s' %s\",\n            wentTween = \"tweening to '%s' %s\",\n            wentWalk = \"walking to '%s' %s\",\n            cantGo = \"can't go there: your character was not found\",\n            removed = \"removed '%s'\",\n            restored = \"restored '%s'\",\n            nameTaken = \"there is already a waypoint named '%s'\",\n            undoTitle = 'Waypoint Removed',\n            undoMessage = \"'%s' %s was removed\",\n            undo = 'Undo',\n            undoTime = 10,\n            confirmTitle = 'Clear Waypoints',\n            confirmGame = 'Delete the %d waypoint(s) of this game?',\n            confirmAll = 'Delete the %d waypoint(s) of every game?',\n            confirmClear = 'Delete',\n            confirmCancel = 'Cancel',\n            cleared = 'deleted %d waypoint(s)',\n            nothingToClear = 'there are no waypoints to delete',\n        },\n        plugins = {\n            title = '#plugins',\n            notifyTitle = 'Plugins',\n            errorTitle = 'Plugin Error',\n            addTitle = '#add plugin',\n            fileHint = 'plugin file name',\n            addButton = 'Add plugin',\n            folderHint = 'plugins are .luau files in the %s folder',\n            trustHint = \n[[a plugin runs code with full access: only add files you trust]],\n            installedTitle = '#installed plugins',\n            installedHint = 'tap a plugin to see its state, Reload reads its file again',\n            noneInstalled = 'no plugins installed yet',\n            folderTitle = '#in the plugins folder',\n            noneInFolder = 'no new plugins in the folder',\n            add = 'Add',\n            addAll = 'Add all (%d)',\n            reload = 'Reload',\n            remove = 'Del',\n            failedLabel = '%s (failed)',\n            loadedLabel = '%s (%d)',\n            stateLoaded = \"'%s' is loaded with %d command(s)\",\n            stateFailed = \"'%s' did not load: %s\",\n            stateUnknown = \"'%s' is installed but not loaded\",\n            added = \"added '%s' (%d command(s))\",\n            reloaded = \"reloaded '%s' (%d command(s))\",\n            removed = \"removed '%s'\",\n            missingName = 'write the file name of the plugin',\n            addedAll = 'added %d plugin(s)',\n            failedAll = ', %d failed (see the console)',\n        },\n        eventBinds = {\n            title = '#event binds',\n            notifyTitle = 'Event Binds',\n            notAdded = 'the bind was not added',\n            columns = 4,\n            commandHint = 'command (goto $1)',\n            delayHint = 'delay',\n            conditionHints = {\n                Player = 'any, me, friends...',\n                String = 'any, or text',\n                Number = 'any, or max',\n            },\n            addButton = 'Add',\n            header = '#%s - %s',\n            listTitle = '#binds of %s',\n            listHint = 'tap a bind to remove it, or type a new delay in its box',\n            empty = 'no binds for this event yet',\n            badDelay = 'the delay must be a number',\n            negativeDelay = 'the delay must be 0 or more',\n            added = 'added a bind to %s',\n            removed = \"removed '%s'\",\n            delayChanged = \"the delay of '%s' is now %s\",\n            restored = \"restored '%s'\",\n            undoTitle = 'Bind Removed',\n            undoMessage = \"'%s' was removed from #%s\",\n            undoDelay = 'delay %s',\n            undo = 'Undo',\n            undoTime = 10,\n        },\n    },\n    sections = {\n        {\n            title = '#general',\n            options = {\n                {\n                    kind = 'keybind',\n                    label = 'Prefix',\n                    icon = 'lucide-terminal',\n                    binding = 'prefix',\n                },\n                {\n                    kind = 'switch',\n                    label = 'Keep Menu Open',\n                    icon = 'lucide-pin',\n                    setting = 'keepMenuOpen',\n                },\n                {\n                    kind = 'switch',\n                    label = 'Keep Interface',\n                    icon = 'lucide-refresh-cw',\n                    setting = 'keepIY',\n                },\n                {\n                    kind = 'switch',\n                    label = 'Clear On Enter',\n                    icon = 'lucide-eraser',\n                    setting = 'clearOnEnter',\n                },\n            },\n        },\n        {\n            title = '#editors',\n            options = {\n                {\n                    kind = 'button',\n                    label = 'Edit Theme',\n                    icon = 'lucide-palette',\n                    action = 'theme',\n                },\n                {\n                    kind = 'button',\n                    label = 'Edit Keybinds',\n                    icon = 'lucide-keyboard',\n                    action = 'keybinds',\n                },\n                {\n                    kind = 'button',\n                    label = 'Edit Aliases',\n                    icon = 'lucide-tag',\n                    action = 'aliases',\n                },\n                {\n                    kind = 'button',\n                    label = 'Edit/Goto Waypoints',\n                    icon = 'lucide-map-pin',\n                    action = 'waypoints',\n                },\n                {\n                    kind = 'button',\n                    label = 'Manage Plugins',\n                    icon = 'lucide-puzzle',\n                    action = 'plugins',\n                },\n                {\n                    kind = 'button',\n                    label = 'Edit Event Binds',\n                    icon = 'lucide-zap',\n                    action = 'eventBinds',\n                },\n                {\n                    kind = 'button',\n                    label = 'Command Settings',\n                    icon = 'lucide-sliders-horizontal',\n                    action = 'commands',\n                },\n                {\n                    kind = 'button',\n                    label = 'Import / Export',\n                    icon = 'lucide-arrow-down-up',\n                    action = 'importExport',\n                },\n            },\n        },\n    },\n}\n",
[ "src/framework/config/ui/themes.luau" ] = "return {\n    defaultKey = 'theme',\n    darken = 0.31,\n    options = {\n        {\n            key = 'theme',\n        },\n        {\n            key = 'darkGreen',\n            color = Color3.fromRGB(34, 110, 62),\n        },\n        {\n            key = 'pink',\n            color = Color3.fromRGB(230, 96, 160),\n        },\n        {\n            key = 'yellow',\n            color = Color3.fromRGB(240, 196, 46),\n        },\n    },\n}\n",
[ "src/framework/config/utils/keysToText.luau" ] = "local function checkKeycodes(keys)\n    local newKeys = {}\n\n    for name, char in keys do\n        local keyCode = Enum.KeyCode[name]\n\n        newKeys[keyCode] = char\n    end\n\n    return newKeys\nend\n\nreturn checkKeycodes({\n    ['Quote'] = \"'\",\n    ['QuotedDouble'] = '\"',\n    ['Comma'] = ',',\n    ['Minus'] = '-',\n    ['Period'] = '.',\n    ['Slash'] = '/',\n    ['Colon'] = ':',\n    ['Semicolon'] = ';',\n    ['LessThan'] = '<',\n    ['Equals'] = '=',\n    ['GreaterThan'] = '>',\n    ['Question'] = '?',\n    ['At'] = '@',\n    ['Hash'] = '#',\n    ['Dollar'] = '$',\n    ['Percent'] = '%',\n    ['Caret'] = '^',\n    ['Ampersand'] = '&',\n    ['Asterisk'] = '*',\n    ['LeftParenthesis'] = '(',\n    ['RightParenthesis'] = ')',\n    ['Plus'] = '+',\n    ['Underscore'] = '_',\n    ['LeftBracket'] = '[',\n    ['BackSlash'] = '\\\\',\n    ['RightBracket'] = ']',\n    ['Backquote'] = '`',\n    ['LeftCurly'] = '{',\n    ['Pipe'] = '|',\n    ['RightCurly'] = '}',\n    ['Tilde'] = '~',\n    ['Zero'] = '0',\n    ['One'] = '1',\n    ['Two'] = '2',\n    ['Three'] = '3',\n    ['Four'] = '4',\n    ['Five'] = '5',\n    ['Six'] = '6',\n    ['Seven'] = '7',\n    ['Eight'] = '8',\n    ['Nine'] = '9',\n})\n",
