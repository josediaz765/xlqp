[ "src/framework/services/connectionService.luau" ] = "local connectionService = {connections = {}}\nlocal privateEnv = require('../environment/private')\n\nif privateEnv.connectionService then\n    privateEnv.connectionService:cleanup()\nend\n\nprivateEnv.connectionService = connectionService\n\nfunction connectionService:cleanup()\n    for _, connection in self.connections do\n        connection:Disconnect()\n    end\nend\nfunction connectionService:disconnect(connection)\n    if connection then\n        connection:Disconnect()\n    end\nend\nfunction connectionService:Connect(signal, func)\n    local connection = signal:Connect(func)\n\n    table.insert(self.connections, connection)\n\n    return connection\nend\n\nreturn connectionService\n",
[ "src/framework/services/createService/init.luau" ] = "local specialProps = require('./specialProps')\nlocal logger = require('../../../utils/logger')\nlocal createService = {}\n\nfunction createService.setProperties(object, properties)\n    for property, value in properties do\n        if specialProps[property] then\n            specialProps[property](object, value)\n\n            continue\n        end\n        if type(property) == 'number' and typeof(value) == 'Instance' then\n            value.Parent = object\n\n            continue\n        end\n\n        object[property] = value\n    end\n\n    return object\nend\nfunction createService.setup(object, ...)\n    for _, value in {...}do\n        local valueType = typeof(value)\n\n        if valueType == 'table' then\n            createService.setProperties(object, value)\n        else\n            local property = if valueType == 'string'then'Name'else'Parent'\n\n            object[property] = value\n        end\n    end\n\n    return object\nend\nfunction createService.new(className, ...)\n    local object = Instance.new(className)\n\n    return createService.setup(object, ...)\nend\n\nreturn createService\n",
[ "src/framework/services/createService/specialProps.luau" ] = "return {}\n",
[ "src/framework/services/fetchService.luau" ] = "local resources = require('../resources')\nlocal fetchService = {}\n\nfunction fetchService.fetch(path)\n    return resources.lookup(path)\nend\nfunction fetchService.download(name)\n    if name == 'compiled.luau' then\n        return resources.source()\n    end\n\n    return resources.lookup(name)\nend\nfunction fetchService.downloadUrl(name)\n    return 'embedded://' .. name\nend\nfunction fetchService.load(path, name)\n    return resources.load(path, name)\nend\n\nreturn fetchService\n",
[ "src/framework/services/init.luau" ] = "return {\n    createService = require('./createService'),\n    specialProps = require('./createService/specialProps'),\n    connectionService = require('./connectionService'),\n    fetchService = require('./fetchService'),\n    keyboardService = require('./keyboardService'),\n    localPlayer = require('./localPlayer'),\n    messageService = require('./messageService'),\n    playerService = require('./playerService'),\n    rbxServices = require('./rbxServices'),\n    tweenService = require('./tweenService'),\n}\n",
[ "src/framework/services/keyboardService.luau" ] = "local robloxServices = require('./rbxServices')\nlocal connectionService = require('./connectionService')\nlocal settingsData = require('../../storage/data/settings')\nlocal keybindsConfig = require('../config/services/keybinds')\nlocal keysToText = require('../config/utils/keysToText')\nlocal userInputService = robloxServices.UserInputService\nlocal keyboardService = {}\nlocal listeners = {}\nlocal capturing = nil\nlocal isConnected = false\n\nlocal function keyCodeFromName(name)\n    if type(name) ~= 'string' then\n        return nil\n    end\n\n    local ok, keyCode = pcall(function()\n        return Enum.KeyCode[name]\n    end)\n\n    return if ok then keyCode else nil\nend\nlocal function bindingConfig(name)\n    local config = keybindsConfig.bindings[name]\n\n    assert(config, `keyboardService: there is no binding named '{name}'`)\n\n    return config\nend\nlocal function bindingKey(name)\n    local config = bindingConfig(name)\n\n    return keyCodeFromName(settingsData:getValue(config.settingKey)) or keyCodeFromName(config.default) or Enum.KeyCode.Unknown\nend\nlocal function bindingKeys(name)\n    local config = bindingConfig(name)\n    local keys = {\n        bindingKey(name),\n    }\n\n    for _, fixedName in config.also or {}do\n        local fixed = keyCodeFromName(fixedName)\n\n        if fixed then\n            table.insert(keys, fixed)\n        end\n    end\n\n    return keys\nend\nlocal function onInputBegan(input, processed)\n    if input.UserInputType ~= Enum.UserInputType.Keyboard then\n        return\n    end\n\n    local keyCode = input.KeyCode\n\n    if keyCode == Enum.KeyCode.Unknown then\n        return\n    end\n    if capturing then\n        local request = capturing\n\n        capturing = nil\n\n        if keyCode == Enum.KeyCode.Escape then\n            if request.onCancel then\n                request.onCancel()\n            end\n        else\n            request.onKey(keyCode)\n        end\n\n        return\n    end\n    for _, listener in table.clone(listeners)do\n        if listener.connected and (not processed or listener.allowProcessed) and table.find(listener.getKeys(), keyCode) then\n            listener.callback(input)\n        end\n    end\nend\nlocal function ensureConnected()\n    if isConnected then\n        return\n    end\n\n    isConnected = true\n\n    connectionService:Connect(userInputService.InputBegan, onInputBegan)\nend\nlocal function addListener(getKeys, callback, allowProcessed)\n    ensureConnected()\n\n    local listener = {\n        getKeys = getKeys,\n        callback = callback,\n        connected = true,\n        allowProcessed = allowProcessed == true,\n    }\n\n    table.insert(listeners, listener)\n\n    local connection = {}\n\n    function connection:Disconnect()\n        listener.connected = false\n\n        local index = table.find(listeners, listener)\n\n        if index then\n            table.remove(listeners, index)\n        end\n    end\n\n    return connection\nend\n\nfunction keyboardService:onKeysPressed(keys, callback)\n    return addListener(function()\n        return keys\n    end, callback)\nend\nfunction keyboardService:onBindingPressed(name, callback, allowProcessed)\n    bindingConfig(name)\n\n    return addListener(function()\n        return bindingKeys(name)\n    end, callback, allowProcessed)\nend\nfunction keyboardService:capture(onKey, onCancel)\n    ensureConnected()\n\n    local request = {\n        onKey = onKey,\n        onCancel = onCancel,\n    }\n\n    capturing = request\n\n    return function()\n        if capturing == request then\n            capturing = nil\n        end\n    end\nend\nfunction keyboardService:getBinding(name)\n    return bindingKey(name)\nend\nfunction keyboardService:setBinding(name, keyCode)\n    local config = bindingConfig(name)\n\n    assert(typeof(keyCode) == 'EnumItem' and keyCode.EnumType == Enum.KeyCode, 'keyboardService: setBinding needs a KeyCode')\n    settingsData:setValue(config.settingKey, keyCode.Name)\n    settingsData:save()\nend\nfunction keyboardService:resetBinding(name)\n    local config = bindingConfig(name)\n\n    settingsData:setValue(config.settingKey, nil)\n    settingsData:save()\nend\nfunction keyboardService:getKeyName(keyCode)\n    return keysToText[keyCode] or keyCode.Name\nend\nfunction keyboardService:getBindingName(name)\n    return self:getKeyName(bindingKey(name))\nend\n\nreturn keyboardService\n",
[ "src/framework/services/localPlayer.luau" ] = "local services = require('./rbxServices')\n\nreturn services.Players.LocalPlayer\n",
[ "src/framework/services/messageService.luau" ] = "local robloxServices = require('./rbxServices')\nlocal coreGui = robloxServices.CoreGui\nlocal messageService = {}\n\nmessageService.__index = messageService\n\nfunction messageService:destroy()\n    self.message:destroy()\n    setmetatable(self, nil)\nend\nfunction messageService:set(message)\n    if message and #message > 0 then\n        self.message.Text = message\n        self.message.Parent = coreGui\n    else\n        self.message.Parent = nil\n    end\nend\nfunction messageService.new()\n    return setmetatable({\n        message = Instance.new('Message'),\n    }, messageService)\nend\n\nreturn messageService\n",
[ "src/framework/services/playerService.luau" ] = "local robloxServices = require('./rbxServices')\nlocal localPlayer = require('./localPlayer')\nlocal logger = require('../../utils/logger')\nlocal teleportService = robloxServices.TeleportService\nlocal tweenService = robloxServices.TweenService\nlocal playerMouse = localPlayer:GetMouse()\nlocal playerService = {}\nlocal activeTween = nil\nlocal DEFAULT_TWEEN_SPEED = 100\nlocal seatedLock = nil\n\nfunction playerService:getMouse()\n    return playerMouse\nend\nfunction playerService:isMouseInGuiObject(guiObject)\n    local guiPosition = guiObject.AbsolutePosition\n    local guiSize = guiObject.AbsoluteSize\n\n    return playerMouse.X >= guiPosition.X and playerMouse.X < guiPosition.X + guiSize.X and playerMouse.Y >= guiPosition.Y and playerMouse.Y < guiPosition.Y + guiSize.Y\nend\nfunction playerService:teleportToJobId(jobId, placeId)\n    placeId = placeId or game.PlaceId\n\n    teleportService:TeleportToPlaceInstance(placeId, jobId, localPlayer)\nend\nfunction playerService:isAlive(character)\n    local humanoid = if character then character:FindFirstChildOfClass('Humanoid')else self:getHumanoid()\n\n    return humanoid ~= nil and humanoid.Health > 0\nend\nfunction playerService:getCharacter()\n    return localPlayer.Character\nend\nfunction playerService:getHumanoid()\n    local character = self:getCharacter()\n\n    return character and character:FindFirstChildOfClass('Humanoid')\nend\nfunction playerService:getRootPart()\n    local humanoid = self:getHumanoid()\n\n    return humanoid and humanoid.RootPart\nend\nfunction playerService:resetCharacter()\n    local character = self:getCharacter()\n\n    if not character then\n        return\n    end\n\n    local humanoid = character:FindFirstChildOfClass('Humanoid')\n\n    if humanoid then\n        humanoid:ChangeState(Enum.HumanoidStateType.Dead)\n    else\n        character:BreakJoints()\n    end\nend\nfunction playerService:getPlayersByName(query)\n    local list = {}\n    local subAt = #query\n\n    query = query:lower()\n\n    for _, player in robloxServices.Players:GetPlayers()do\n        local name = string.lower(player.Name):sub(1, subAt)\n        local displayName = string.lower(player.displayName):sub(1, subAt)\n\n        if name == query or displayName == query then\n            table.insert(list, player)\n        end\n    end\n\n    return list\nend\nfunction playerService:getCamera()\n    return workspace.CurrentCamera\nend\nfunction playerService:unseat()\n    local humanoid = self:getHumanoid()\n\n    if not humanoid then\n        return nil\n    end\n    if humanoid.SeatPart ~= nil then\n        humanoid.Sit = false\n\n        task.wait(0.1)\n    end\n\n    return self:getHumanoid()\nend\nfunction playerService:setRootCFrame(cframe)\n    local rootPart = self:getRootPart()\n\n    if not rootPart then\n        return false\n    end\n\n    rootPart.CFrame = cframe\n    rootPart.AssemblyLinearVelocity = Vector3.zero\n\n    return true\nend\nfunction playerService:teleportTo(target)\n    logger:expect(target, {\n        'CFrame',\n        'Vector3',\n    }, \"'playerService:teleportTo' #1\")\n\n    if typeof(target) == 'Vector3' then\n        target = CFrame.new(target)\n    end\n\n    self:unseat()\n\n    return self:setRootCFrame(target)\nend\nfunction playerService:breakVelocity(duration)\n    local character = self:getCharacter()\n\n    if not character then\n        return\n    end\n\n    local endsAt = os.clock() + (duration or 1)\n\n    task.spawn(function()\n        while os.clock() < endsAt and character.Parent do\n            for _, part in character:GetDescendants()do\n                if part:IsA('BasePart') then\n                    part.AssemblyLinearVelocity = Vector3.zero\n                    part.AssemblyAngularVelocity = Vector3.zero\n                end\n            end\n\n            task.wait()\n        end\n    end)\nend\n\nlocal function releaseSeated()\n    local lock = seatedLock\n\n    seatedLock = nil\n\n    if lock and lock.humanoid.Parent then\n        lock.humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, lock.wasEnabled)\n    end\nend\nlocal function lockSeated(humanoid)\n    if seatedLock and seatedLock.humanoid == humanoid then\n        return\n    end\n\n    releaseSeated()\n\n    seatedLock = {\n        humanoid = humanoid,\n        wasEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Seated),\n    }\n\n    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)\nend\n\nfunction playerService:cancelTween()\n    local tween = activeTween\n\n    activeTween = nil\n\n    releaseSeated()\n\n    if tween then\n        tween:Cancel()\n\n        return true\n    end\n\n    return false\nend\nfunction playerService:tweenTeleportTo(config)\n    logger:expect(config, {\n        'table',\n    }, \"'playerService:tweenTeleportTo' #1\")\n\n    local target = config.target\n    local speed = config.speed or DEFAULT_TWEEN_SPEED\n\n    logger:expect(target, {\n        'CFrame',\n        'Vector3',\n    }, \"'playerService:tweenTeleportTo' config.target\")\n    logger:expect(speed, {\n        'number',\n    }, \"'playerService:tweenTeleportTo' config.speed\")\n\n    if typeof(target) == 'Vector3' then\n        target = CFrame.new(target)\n    end\n\n    self:unseat()\n\n    local rootPart = self:getRootPart()\n\n    if not rootPart then\n        return nil\n    end\n\n    local distance = (target.Position - rootPart.Position).Magnitude\n    local duration = distance / math.max(speed, 1)\n    local previous = activeTween\n\n    activeTween = nil\n\n    if previous then\n        previous:Cancel()\n    end\n\n    local humanoid = self:getHumanoid()\n\n    if humanoid then\n        lockSeated(humanoid)\n    end\n\n    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)\n    local tween = tweenService:Create(rootPart, info, {CFrame = target})\n\n    activeTween = tween\n\n    tween.Completed:Once(function()\n        if activeTween ~= tween then\n            return\n        end\n\n        activeTween = nil\n\n        releaseSeated()\n        self:breakVelocity()\n    end)\n    tween:Play()\n\n    return tween\nend\nfunction playerService:waitForStreamPlayerCharacter(character, waitTime)\n    if not (character and workspace.StreamingEnabled) then\n        return\n    end\n\n    local targetPosition = character:GetPivot().Position\n\n    waitTime = waitTime or 5\n\n    task.spawn(localPlayer.RequestStreamAroundAsync, localPlayer, targetPosition, waitTime)\n    character:WaitForChild('HumanoidRootPart', waitTime)\nend\n\nreturn playerService\n",
[ "src/framework/services/rbxServices.luau" ] = "local robloxServices = {}\nlocal executorEnv = require('../environment/executor')\nlocal logger = require('../../utils/logger')\n\nfunction robloxServices:__index(serviceName)\n    logger:expect(serviceName, {\n        'string',\n    }, '[index] serviceName')\n\n    local service = game:GetService(serviceName)\n    local clone = executorEnv.cloneref(service)\n\n    rawset(self, serviceName, clone)\n\n    return clone\nend\n\nreturn setmetatable({}, robloxServices)\n",
[ "src/framework/services/tweenService.luau" ] = "local tweenConfig = require('../config/services/tween')\nlocal tweenService = {}\n\nfunction tweenService:getScale(value)\n    return tweenConfig.isEnabled and (value * tweenConfig.animationScale) or 0\nend\nfunction tweenService:getScrollSpeed(value)\n    return (value * tweenConfig.scrollSpeed)\nend\n\nreturn tweenService\n",
[ "src/framework/settings.luau" ] = "local settingsData = require('../storage/data/settings')\n\nreturn {\n    applicationName = 'XLQP',\n    isRemakeVersion = false,\n    version = require('../version'),\n    newVersionMessage = \"You're using an old version of XLQP\",\n    theme = {\n        defaultTheme = 'dark',\n        selectedTheme = settingsData:register('selectedTheme', 'dark'),\n    },\n    commands = {\n        cmdsRank = {\n            maxTimesUsed = 5,\n            decreasePerUse = 0.25,\n            increasePerUse = 1,\n        },\n    },\n    ui = {\n        defaultTheme = 'Dark',\n        scale = {\n            minScale = 0.8,\n            maxScale = 2,\n            current = settingsData:register('interface.uiScale', 1),\n        },\n        commands = {\n            padding = 0,\n            labelSize = 17,\n            textSize = 14,\n            placeholderText = '>_ command bar',\n        },\n        window = {\n            windowSize = UDim2.fromOffset(250, 220),\n            draggable = true,\n        },\n    },\n    links = require('./config/links'),\n    storage = require('./config/storage'),\n}\n",
