[ "assets/settings.png" ] = "\137PNG\r\n\026\n\000\000\000\rIHDR\000\000\000\024\000\000\000\024\008\006\000\000\000\224w=\248\000\000\000\004sBIT\008\008\008\008|\008d\136\000\000\000\001sRGB\000\174\206\028\233\000\000\001\201IDATH\137\205\149\201J\003A\016\1343\230\016\189(^=\185\197% J\240 \248\004jpE\031\195\229)D\208\139\235\027(\226k8.(\168\144\220r4&.\137z5\202\231aj\152\178\237q\220@\011\154\233\249\235\159\191\186\171k\170c\177\255`@\027\176\011\220\201\216\001Z\127K<\014dyo\231\128\243\027\001\250E\176\012\180\200n\238\005\235\249\142`\189\222>\176%bk\n\219\180`\173@C\148\2482P\149\143\179\192\177J\201\128\226\r*\252\024\200\201\252\tX\012\019\159\023R\021\200+\129k`\194\194\159\001n\021/\015<\203|\214$;@Q\156\163\130\245\002\233\136\029;@\026\232\149\247q\209(\152\196\132ZI\179Eh\012p\129\007\025.0b\225%\149N\220t\158\136\227\000H(<C\184\r\027\139\2445\014m\219\237\004JB\208\213\225\n\182\007\164d\236\t\230*\158_m% \025\150\211\180\144\174\020v'X\183\194R\130\149\021v#\216\155\127\163\198\136Q\142\1897\199x\134\217\203\135^\160\131\160\146V\021\174S\212\245\137\020\021\173)\002N\133p\244\133C\030R\188Z\165qh\138\215\169\143Z,\1933x\213\245\008T\128}T\005)^\187\210\137kG\rA\005e\004k\002\250>\204\171\199\235\003\154d>)\026\1516\226\1308\205VQ\000\166,\252i\1886\226\155n\021sa\171Y\225m\179\203)\129\176fwAp_<\001KQ[nD\181\011\236\237zC\176u\133E\183\235\144\128\254\133S\193\187p\218\t.\156\2003\250L\128\184\145*\223\206~,\174\130\248\151~E\014v\027K\215\253\019{\005\019V\160\162\237\214\246j\000\000\000\000IEND\174B`\130",
[ "main.luau" ] = "local resources = require(\"./src/framework/resources\")\nlocal host = (getgenv and getgenv()) or getfenv()\nlocal root = __XLQP_ROOT or host.XLQP_ROOT or \"xlqp\"\nlocal baseUrl = __XLQP_BASE_URL or host.XLQP_BASE_URL or \"https://raw.githubusercontent.com/josediaz765/xlqp/main/\"\nlocal localMode = __XLQP_LOCAL\nlocal cacheSuffix = __XLQP_CACHE_SUFFIX or \"\"\nif localMode == nil then localMode = host.XLQP_LOCAL == true end\nif baseUrl:sub(-1) ~= \"/\" then baseUrl ..= \"/\" end\n\nresources.configure(function(continuation)\n    local reader = if localMode then \"readfile(\" .. string.format(\"%q\", root .. \"/loader.luau\") .. \")\"\n        else \"game:HttpGet(\" .. string.format(\"%q\", baseUrl .. \"loader.luau\" .. cacheSuffix) .. \")\"\n    return \"getgenv().XLQP_ROOT=\" .. string.format(\"%q\", root)\n        .. \"\\ngetgenv().XLQP_BASE_URL=\" .. string.format(\"%q\", baseUrl)\n        .. \"\\ngetgenv().XLQP_LOCAL=\" .. tostring(localMode)\n        .. \"\\nreturn assert(loadstring(\" .. reader .. \", \" .. string.format(\"%q\", \"XLQP/loader\") .. \"))(\"\n        .. (if continuation then string.format(\"%q\", continuation) else \"nil\") .. \")\"\nend)\n\nreturn require(\"./src/core\"):boot()\n",
[ "rbxBundle.luau" ] = "local ORIGINAL_REQUIRE = require\nlocal bundle = {}\nlocal moduleCache = {}\nlocal EXTENSIONS = {\n    '.lua',\n    '.luau',\n    '/init.lua',\n    '/init.luau',\n}\n\nlocal function normalizePath(path)\n    local parts = {}\n\n    for part in string.gmatch(path, '[^/]+')do\n        if part == '..' then\n            table.remove(parts)\n        elseif part ~= '.' then\n            table.insert(parts, part)\n        end\n    end\n\n    return table.concat(parts, '/')\nend\nlocal function folderOf(path)\n    return path:match('^(.*)/[^/]*$') or ''\nend\n\nfunction bundle.new(currentPath)\n    currentPath = currentPath or ''\n\n    assert(type(currentPath) == 'string', '#1 must be a string')\n\n    local bundler = {\n        currentPath = normalizePath(currentPath),\n    }\n\n    function bundler.readFile(filePath)\n        if type(__XLQP_READ) == \"function\" then\n            local ok, source = pcall(__XLQP_READ, filePath)\n            if ok then return source end\n            return nil, tostring(source)\n        end\n        if type(readfile) ~= 'function' or type(isfile) ~= 'function' then\n            return nil, 'readfile/isfile not available'\n        end\n        if not isfile(filePath) then\n            return nil, 'file not found: ' .. filePath\n        end\n\n        return readfile(filePath)\n    end\n    function bundler.createChunk(sourceCode, folderPath, debugPath)\n        local chunk, err = loadstring(sourceCode, '=' .. debugPath)\n\n        if not chunk then\n            return false, err\n        end\n        if setfenv and getfenv then\n            local env = setmetatable({}, {\n                __index = getfenv(chunk),\n            })\n\n            env.require = bundle.new(folderPath).require\n\n            setfenv(chunk, env)\n        end\n\n        return pcall(chunk)\n    end\n    function bundler.require(path)\n        if type(path) ~= 'string' then\n            return ORIGINAL_REQUIRE(path)\n        end\n\n        local names = {path}\n\n        if path:lower() ~= path then\n            table.insert(names, path:lower())\n        end\n\n        local filePath, source\n\n        for _, name in ipairs(names)do\n            for _, ext in ipairs(EXTENSIONS)do\n                local candidate = normalizePath(bundler.currentPath .. '/' .. name .. ext)\n                local entry = moduleCache[candidate]\n\n                if entry then\n                    if entry.loading then\n                        error(\"circular require: '\" .. candidate .. \"'\", 2)\n                    end\n\n                    return entry.value\n                end\n\n                local content = bundler.readFile(candidate)\n\n                if content then\n                    filePath, source = candidate, content\n\n                    break\n                end\n            end\n\n            if filePath then\n                break\n            end\n        end\n\n        if not filePath then\n            error(\"could not resolve module path: '\" .. path .. \"'\", 2)\n        end\n\n        moduleCache[filePath] = {loading = true}\n\n        local ok, result = bundler.createChunk(source, folderOf(filePath), filePath)\n\n        if not ok then\n            moduleCache[filePath] = nil\n\n            error(result, 0)\n        end\n        if result == nil then\n            result = true\n        end\n\n        moduleCache[filePath] = {value = result}\n\n        return result\n    end\n\n    return bundler\nend\n\nreturn bundle\n",
[ "src/commands/cmds/aliases/init.luau" ] = "local customAliases = require('../../systems/customAliases')\n\nreturn {\n    {\n        action = 'addalias',\n        description = 'Adds an alias to a command',\n        args = {\n            {\n                kind = 'command',\n            },\n            {\n                kind = 'string',\n                name = 'alias',\n            },\n        },\n        run = function(self, args)\n            local commandName = args:nextValue()\n            local alias = args:nextValue()\n\n            if not (commandName and alias) then\n                return\n            end\n\n            local success, reason = customAliases.add(self.commandsList, alias, commandName)\n\n            if success then\n                self:notify('Aliases Modified', `Added {alias:lower()} as an alias to {commandName}`)\n            else\n                self:notify('Aliases Modified', reason)\n            end\n        end,\n    },\n    {\n        action = 'removealias',\n        description = 'Removes a custom alias',\n        args = {\n            kind = 'alias',\n        },\n        run = function(self, args)\n            local alias = args:nextValue()\n\n            if not alias then\n                return\n            end\n\n            local success, target = customAliases.remove(self.commandsList, alias)\n\n            if success then\n                self:notify('Aliases Modified', `Removed the alias {alias} from {target}`)\n            end\n        end,\n    },\n    {\n        action = 'clraliases',\n        description = 'Removes all custom aliases',\n        args = {\n            kind = 'boolean',\n            name = 'confirm',\n            optional = true,\n        },\n        run = function(self, args)\n            if args and args:nextValue() == false then\n                return\n            end\n\n            local count = customAliases.clear(self.commandsList)\n\n            self:notify('Aliases Modified', `Removed {count} custom alias(es)`)\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/camzoom.luau" ] = "return {\n    {\n        action = 'maxzoom',\n        description = 'Maximum camera zoom',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            self.localPlayer.CameraMaxZoomDistance = args:nextValue()\n        end,\n    },\n    {\n        action = 'minzoom',\n        description = 'Minimum camera zoom',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            self.localPlayer.CameraMinZoomDistance = args:nextValue()\n        end,\n    },\n    {\n        action = 'camdistance',\n        description = 'Changes camera distance from your player',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local distance = args:nextValue()\n            local player = self.localPlayer\n            local camMax = player.CameraMaxZoomDistance\n            local camMin = player.CameraMinZoomDistance\n\n            if camMax < distance then\n                camMax = distance\n            end\n\n            player.CameraMaxZoomDistance = distance\n            player.CameraMinZoomDistance = distance\n\n            task.wait()\n\n            player.CameraMaxZoomDistance = camMax\n            player.CameraMinZoomDistance = camMin\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/fixcam.luau" ] = "local freecam = require('../../systems/freecam')\n\nreturn {\n    action = 'fixcam|restorecam',\n    description = 'Fixes camera',\n    run = function(self)\n        local playerService = self.playerService\n        local localPlayer = self.localPlayer\n\n        freecam.stop(self)\n\n        if self:hasGarbage('view') then\n            self:run('unview')\n        end\n\n        local humanoid = playerService:getHumanoid()\n\n        if humanoid then\n            self.signals.onCameraReset:Fire()\n\n            local camera = playerService:getCamera()\n\n            camera.CameraSubject = humanoid\n            camera.CameraType = Enum.CameraType.Custom\n            localPlayer.CameraMinZoomDistance = 0.5\n            localPlayer.CameraMaxZoomDistance = 400\n            localPlayer.CameraMode = Enum.CameraMode.Classic\n\n            self:notify('camera has been reseted successfully')\n        end\n    end,\n}\n",
[ "src/commands/cmds/camera/fov.luau" ] = "return {\n    action = 'fov',\n    description = 'Adjusts field of view (default is 70)',\n    args = {\n        kind = 'number',\n        default = 70,\n    },\n    run = function(self, args)\n        local fov = math.clamp(math.abs(args:nextValue() or 70), 1, 120)\n\n        workspace.CurrentCamera.FieldOfView = fov\n    end,\n}\n",
[ "src/commands/cmds/camera/freecam.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal freecam = require('../../systems/freecam')\nlocal TITLE = 'Freecam'\n\nlocal function getWaypointPosition(self, name)\n    local places = self.storage.waypoints:getValue(tostring(game.PlaceId))\n    local coords = type(places) == 'table' and places[name]\n\n    if not coords then\n        return nil\n    end\n\n    return self:unstringify(coords, 'Vector3')\nend\nlocal function formatPosition(position)\n    return `{math.round(position.X)},{math.round(position.Y)},{math.round(position.Z)}`\nend\n\nreturn {\n    {\n        action = 'freecam|fc',\n        description = 'Allows you to freely move camera around the game',\n        args = {\n            kind = 'number',\n            name = 'camera speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local speed = args:nextValue()\n\n            if speed then\n                self.privateEnv.freecamSpeed = speed\n            end\n\n            freecam.start(self)\n        end,\n    },\n    {\n        action = 'freecampos|fcpos',\n        description = 'Moves / opens freecam in a certain position',\n        args = {\n            kind = 'vector3',\n        },\n        run = function(self, args)\n            local position = args:nextValue()\n\n            if position then\n                freecam.start(self, position)\n            end\n        end,\n    },\n    {\n        action = 'freecamwaypoint|fcwp',\n        description = 'Moves / opens freecam to a waypoint',\n        args = {\n            kind = 'waypoint',\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n            local position = name and getWaypointPosition(self, name)\n\n            if not position then\n                self:notify(TITLE, `there is no waypoint named '{name}'`)\n\n                return\n            end\n\n            freecam.start(self, position)\n        end,\n    },\n    {\n        action = 'freecamgoto|fcgoto|freecamtp|fctp',\n        description = 'Moves / opens freecam to a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n            local root = target and target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n            if not root then\n                self:notify(TITLE, \"that player's character is not loaded\")\n\n                return\n            end\n\n            freecam.start(self, root.Position)\n        end,\n    },\n    {\n        action = 'unfreecam|unfc|nofreecam|nofc',\n        description = 'Disables freecam',\n        run = function(self)\n            freecam.stop(self)\n        end,\n    },\n    {\n        action = 'freecamspeed|fcspeed',\n        description = 'Adjusts freecam speed (default is 1)',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            self.privateEnv.freecamSpeed = args:nextValue() or freecam.DEFAULT_SPEED\n        end,\n    },\n    {\n        action = 'notifyfreecamposition|notifyfcpos',\n        description = 'Noitifies you your freecam coordinates',\n        run = function(self)\n            local position = freecam.getPosition(self)\n\n            if not position then\n                self:notify(TITLE, 'freecam is not on')\n\n                return\n            end\n\n            self:notify('Freecam Position', formatPosition(position))\n        end,\n    },\n    {\n        action = 'copyfreecamposition|copyfcpos',\n        description = 'Copies your freecam coordinates to your clipboard',\n        run = function(self)\n            local position = freecam.getPosition(self)\n\n            if not position then\n                self:notify(TITLE, 'freecam is not on')\n\n                return\n            end\n\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            setclipboard(formatPosition(position))\n            self:notify(TITLE, 'copied freecam position to clipboard')\n        end,\n    },\n    {\n        action = 'freecamboost|fcboost',\n        description = \n[[Increases the freecam boost (the BOOST button) by an amount, and saves it]],\n        args = {\n            kind = 'number',\n            name = 'amount',\n            optional = true,\n        },\n        run = function(self, args)\n            local amount = args:nextValue() or 1\n            local boost = freecam.addBoost(self, amount)\n\n            self:notify(TITLE, `freecam boost is now {boost}x`)\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/gotocamera.luau" ] = "return {\n    {\n        action = 'gotocamera|gotocam|tocam',\n        description = 'Teleports you to the location of your camera',\n        run = function(self)\n            self.playerService:teleportTo(self.playerService:getCamera().CFrame)\n        end,\n    },\n    {\n        action = 'tweengotocamera|tweengotocam|tgotocamera|tgotocam',\n        description = 'Tweens you to the location of your camera',\n        run = function(self)\n            self.playerService:tweenTeleportTo({\n                target = self.playerService:getCamera().CFrame,\n                speed = self.privateEnv.tweenSpeed,\n            })\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/init.luau" ] = "return {\n    require('./view'),\n    require('./freecam'),\n    require('./gotocamera'),\n    require('./pov'),\n    require('./noclipcam'),\n    require('./camzoom'),\n    require('./fov'),\n    require('./fixcam'),\n    require('./shiftlock'),\n    require('./lookat'),\n    require('./stare'),\n}\n",
[ "src/commands/cmds/camera/lookat.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal DEFAULT_ZOOM = {\n    max = 400,\n    min = 0.5,\n}\n\nreturn {\n    action = 'lookat',\n    description = 'Moves your camera view to a player',\n    args = {\n        kind = 'player',\n    },\n    run = function(self, args)\n        local target = resolvePlayers(args:nextValue())[1]\n        local targetHead = target and target.Character and target.Character:FindFirstChild('Head')\n\n        if not targetHead then\n            self:notify('Lookat', \"the player's character is not loaded\")\n\n            return\n        end\n\n        local player = self.localPlayer\n        local camera = self.playerService:getCamera()\n\n        if player.CameraMaxZoomDistance ~= 0.5 then\n            self.privateEnv.lookAtZoom = {\n                max = player.CameraMaxZoomDistance,\n                min = player.CameraMinZoomDistance,\n            }\n        end\n\n        local zoom = self.privateEnv.lookAtZoom or DEFAULT_ZOOM\n\n        player.CameraMaxZoomDistance = 0.5\n        player.CameraMinZoomDistance = 0.5\n\n        task.wait()\n\n        camera.CFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)\n\n        task.wait(0.1)\n\n        player.CameraMaxZoomDistance = zoom.max\n        player.CameraMinZoomDistance = zoom.min\n    end,\n}\n",
[ "src/commands/cmds/camera/noclipcam.luau" ] = "local function getPopper(player)\n    local scripts = player:FindFirstChild('PlayerScripts')\n    local playerModule = scripts and scripts:FindFirstChild('PlayerModule')\n    local cameraModule = playerModule and playerModule:FindFirstChild('CameraModule')\n    local zoomController = cameraModule and cameraModule:FindFirstChild('ZoomController')\n\n    return zoomController and zoomController:FindFirstChild('Popper')\nend\n\nreturn {\n    action = 'noclipcam|nccam',\n    description = 'Allows camera to go through objects like walls',\n    run = function(self)\n        local getgc = self:expectExploit('getgc')\n        local getconstants = self:expectExploit('getconstants')\n        local setconstant = self:expectExploit('setconstant')\n        local getfenv = self:expectExploit('getfenv')\n\n        if not (getgc and getconstants and setconstant and getfenv) then\n            return\n        end\n\n        local popper = getPopper(self.localPlayer)\n\n        if not popper then\n            self:notify('noclipcam', 'camera popper not found')\n\n            return\n        end\n\n        for _, value in getgc()do\n            if type(value) == 'function' and getfenv(value).script == popper then\n                for index, constant in getconstants(value)do\n                    if tonumber(constant) == 0.25 then\n                        setconstant(value, index, 0)\n                    elseif tonumber(constant) == 0 then\n                        setconstant(value, index, 0.25)\n                    end\n                end\n            end\n        end\n    end,\n}\n",
[ "src/commands/cmds/camera/pov.luau" ] = "return {\n    {\n        action = 'firstp',\n        description = 'Forces camera to go into first person',\n        run = function(self)\n            self.localPlayer.CameraMode = Enum.CameraMode.LockFirstPerson\n        end,\n    },\n    {\n        action = 'thirdp',\n        description = 'Allows camera to go into third person',\n        run = function(self)\n            self.localPlayer.CameraMode = Enum.CameraMode.Classic\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/shiftlock.luau" ] = "return {\n    action = 'enableshiftlock|enablesl',\n    description = 'Enables the shift lock option',\n    run = function(self)\n        local player = self.localPlayer\n\n        player.DevEnableMouseLock = true\n\n        if self:hasGarbage('shiftlock') then\n            return\n        end\n\n        local garbage = self:createGarbage('shiftlock')\n\n        garbage.connection = self:connect(player:GetPropertyChangedSignal('DevEnableMouseLock'), function(\n        )\n            player.DevEnableMouseLock = true\n        end)\n\n        self:notify('Shiftlock', 'Shift lock should now be available')\n    end,\n}\n",
[ "src/commands/cmds/camera/stare.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function stopStare(self)\n    local garbage = self:collectGarbage('stareat')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'stareat|stare',\n        description = 'Stare / look at a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            stopStare(self)\n\n            local garbage = self:createGarbage('stareat')\n\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                if target.Parent == nil then\n                    stopStare(self)\n\n                    return\n                end\n\n                local root = self.playerService:getRootPart()\n                local targetRoot = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                if not (root and targetRoot) then\n                    return\n                end\n\n                local lookAt = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)\n\n                if (lookAt - root.Position).Magnitude < 0.01 then\n                    return\n                end\n\n                root.CFrame = CFrame.new(root.Position, lookAt)\n            end)\n        end,\n    },\n    {\n        action = 'unstareat|unstare',\n        description = 'Disables stareat',\n        run = function(self)\n            stopStare(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/camera/view.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal freecam = require('../../systems/freecam')\n\nlocal function getSubject(character)\n    if not character then\n        return nil\n    end\n\n    return character:FindFirstChildOfClass('Humanoid') or character\nend\nlocal function setSubject(self, subject)\n    local camera = self.playerService:getCamera()\n\n    if subject and camera.CameraSubject ~= subject then\n        camera.CameraSubject = subject\n    end\nend\nlocal function restoreOwnSubject(self)\n    local humanoid = self.playerService:getHumanoid()\n\n    if humanoid then\n        setSubject(self, humanoid)\n    end\nend\nlocal function stopView(self)\n    local garbage = self:collectGarbage('view')\n\n    if not garbage then\n        return false\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    return true\nend\n\nreturn {\n    {\n        action = 'spectate|view',\n        description = 'View a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            freecam.stop(self)\n            stopView(self)\n\n            local garbage = self:createGarbage('view')\n\n            garbage.connections = {}\n\n            local camera = self.playerService:getCamera()\n\n            local function follow()\n                local subject = getSubject(target.Character)\n\n                if subject then\n                    setSubject(self, subject)\n                end\n            end\n\n            table.insert(garbage.connections, self:connect(camera:GetPropertyChangedSignal('CameraSubject'), follow))\n            table.insert(garbage.connections, self:connect(target.CharacterAdded, function(\n                character\n            )\n                character:WaitForChild('Humanoid', 10)\n                follow()\n            end))\n            table.insert(garbage.connections, self:connect(self.players.PlayerRemoving, function(\n                player\n            )\n                if player == target then\n                    stopView(self)\n                    restoreOwnSubject(self)\n                end\n            end))\n            follow()\n            self:notify('Spectate', 'Viewing ' .. target.Name)\n        end,\n    },\n    {\n        action = 'viewpart|viewp',\n        description = 'View a part',\n        args = {\n            kind = 'string',\n            name = 'part name',\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            if not text then\n                return\n            end\n\n            freecam.stop(self)\n            stopView(self)\n\n            local wanted = string.lower(text)\n\n            for _, object in workspace:GetDescendants()do\n                if object:IsA('BasePart') and string.lower(object.Name) == wanted then\n                    setSubject(self, object)\n\n                    return\n                end\n            end\n\n            self:notify('Spectate', 'no part named ' .. text)\n        end,\n    },\n    {\n        action = 'unspectate|unview',\n        description = 'Stops viewing player, or part.',\n        run = function(self)\n            freecam.stop(self)\n\n            local wasViewing = stopView(self)\n\n            restoreOwnSubject(self)\n\n            if wasViewing then\n                self:notify('Spectate', 'View turned off')\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/animations.luau" ] = "local DANCES_R6 = {\n    '27789359',\n    '30196114',\n    '248263260',\n    '45834924',\n    '33796059',\n    '28488254',\n    '52155728',\n}\nlocal DANCES_R15 = {\n    '3333432454',\n    '4555808220',\n    '4049037604',\n    '4555782893',\n    '10214311282',\n    '10714010337',\n    '10713981723',\n    '10714372526',\n    '10714076981',\n    '10714392151',\n    '11444443576',\n}\n\nlocal function stopTracks(humanoid)\n    for _, track in humanoid:GetPlayingAnimationTracks()do\n        track:Stop()\n    end\nend\nlocal function setAnimateDisabled(self, disabled)\n    local character = self.localPlayer.Character\n    local animate = character and character:FindFirstChild('Animate')\n\n    if animate then\n        animate.Disabled = disabled\n    end\nend\nlocal function refreshAnimations(self)\n    local humanoid = self.playerService:getHumanoid()\n    local character = self.localPlayer.Character\n    local animate = character and character:FindFirstChild('Animate')\n\n    if not (humanoid and animate) then\n        self:notify('Refresh Animations', 'Failed to get Animate/Humanoid')\n\n        return\n    end\n\n    animate.Disabled = true\n\n    stopTracks(humanoid)\n\n    animate.Disabled = false\nend\nlocal function stopDance(self)\n    local garbage = self:collectGarbage('dance')\n\n    if garbage and garbage.track then\n        garbage.track:Stop()\n        garbage.track:Destroy()\n    end\nend\nlocal function setCustomAnimations(self, allowed)\n    self.robloxServices.StarterPlayer.AllowCustomAnimations = allowed\n\n    refreshAnimations(self)\nend\n\nreturn {\n    {\n        action = 'animation|anim',\n        description = 'Plays an animation by its asset ID (optional speed)',\n        args = {\n            {\n                kind = 'string',\n                name = 'animation id',\n            },\n            {\n                kind = 'number',\n                name = 'speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            local id = tostring(args:nextValue())\n            local speed = args:nextValue()\n\n            if not id:find('rbxassetid://') then\n                id = 'rbxassetid://' .. id\n            end\n\n            local animation = Instance.new('Animation')\n\n            animation.AnimationId = id\n\n            local track = humanoid:LoadAnimation(animation)\n\n            track.Priority = Enum.AnimationPriority.Movement\n\n            track:Play()\n\n            if speed then\n                track:AdjustSpeed(speed)\n            end\n        end,\n    },\n    {\n        action = 'emote|em',\n        description = 'Plays an emote by its animation ID (optional speed)',\n        args = {\n            {\n                kind = 'number',\n                name = 'emote id',\n            },\n            {\n                kind = 'number',\n                name = 'speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            local emoteId = args:nextValue()\n            local played, track = pcall(function()\n                return humanoid:PlayEmoteAndGetAnimTrackById(emoteId)\n            end)\n\n            if not played or not track then\n                self:notify('Emote', `there is no emote with the ID {emoteId}`)\n\n                return\n            end\n\n            local speed = args:nextValue()\n\n            if track and speed then\n                track:AdjustSpeed(speed)\n            end\n        end,\n    },\n    {\n        action = 'noanim',\n        description = 'Disables the default Roblox animations',\n        run = function(self)\n            setAnimateDisabled(self, true)\n        end,\n    },\n    {\n        action = 'reanim',\n        description = 'Enables the default Roblox animations again',\n        run = function(self)\n            setAnimateDisabled(self, false)\n        end,\n    },\n    {\n        action = 'animspeed',\n        description = 'Sets the speed of every playing animation (default is 1)',\n        args = {\n            kind = 'number',\n            name = 'speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            local speed = args:nextValue() or 1\n\n            for _, track in humanoid:GetPlayingAnimationTracks()do\n                track:AdjustSpeed(speed)\n            end\n        end,\n    },\n    {\n        action = 'stopanimations|stopanims|stopanim',\n        description = 'Stops every playing animation',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if humanoid then\n                stopTracks(humanoid)\n            end\n        end,\n    },\n    {\n        action = 'refreshanimations|refreshanimation|refreshanims|refreshanim',\n        description = \"Restarts your character's default animations\",\n        run = function(self)\n            refreshAnimations(self)\n        end,\n    },\n    {\n        action = 'allowcustomanim|allowcustomanimations',\n        description = 'Allows custom animations on your character',\n        run = function(self)\n            setCustomAnimations(self, true)\n        end,\n    },\n    {\n        action = 'unallowcustomanim|unallowcustomanimations',\n        description = 'Stops custom animations on your character',\n        run = function(self)\n            setCustomAnimations(self, false)\n        end,\n    },\n    {\n        action = 'loopanimation|loopanim',\n        description = 'Makes the animations that are currently playing loop',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            for _, track in humanoid:GetPlayingAnimationTracks()do\n                track.Looped = true\n            end\n        end,\n    },\n    {\n        action = 'dance',\n        description = 'Plays a random dance on a loop',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            stopDance(self)\n\n            local ids = humanoid.RigType == Enum.HumanoidRigType.R15 and DANCES_R15 or DANCES_R6\n            local animation = Instance.new('Animation')\n\n            animation.AnimationId = 'rbxassetid://' .. ids[math.random(1, #ids)]\n\n            local track = humanoid:LoadAnimation(animation)\n\n            track.Looped = true\n\n            track:Play()\n\n            self:registerGarbage('dance').track = track\n        end,\n    },\n    {\n        action = 'undance|nodance',\n        description = 'Stops the dance',\n        run = function(self)\n            stopDance(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/appearance.luau" ] = "local function destroyWhere(container, predicate)\n    if not container then\n        return\n    end\n\n    for _, object in container:GetDescendants()do\n        if predicate(object) then\n            object:Destroy()\n        end\n    end\nend\nlocal function getCharacter(self)\n    return self.localPlayer.Character\nend\nlocal function getAccessories(self)\n    local humanoid = self.playerService:getHumanoid()\n\n    return humanoid and humanoid:GetAccessories() or {}\nend\nlocal function isSpecialMesh(object)\n    return object:IsA('SpecialMesh')\nend\n\nreturn {\n    {\n        action = 'blockhead',\n        description = 'Removes the mesh from your head (makes it block-like)',\n        run = function(self)\n            local character = getCharacter(self)\n            local head = character and character:FindFirstChild('Head')\n            local mesh = head and head:FindFirstChildOfClass('SpecialMesh')\n\n            if mesh then\n                mesh:Destroy()\n            end\n        end,\n    },\n    {\n        action = 'blockhats',\n        description = 'Removes the meshes from your accessories',\n        run = function(self)\n            for _, accessory in getAccessories(self)do\n                destroyWhere(accessory, isSpecialMesh)\n            end\n        end,\n    },\n    {\n        action = 'blocktool',\n        description = 'Removes the meshes from your equipped tools',\n        run = function(self)\n            local character = getCharacter(self)\n\n            if not character then\n                return\n            end\n\n            for _, child in character:GetChildren()do\n                if child:IsA('Tool') or child:IsA('HopperBin') then\n                    destroyWhere(child, isSpecialMesh)\n                end\n            end\n        end,\n    },\n    {\n        action = 'nobgui|unbgui|nobillboardgui|unbillboardgui|noname|rohg',\n        description = 'Removes BillboardGuis and SurfaceGuis from your character',\n        run = function(self)\n            destroyWhere(getCharacter(self), function(object)\n                return object:IsA('BillboardGui') or object:IsA('SurfaceGui')\n            end)\n        end,\n    },\n    {\n        action = 'naked',\n        description = 'Removes your clothing and shirt graphics',\n        run = function(self)\n            destroyWhere(getCharacter(self), function(object)\n                return object:IsA('Clothing') or object:IsA('ShirtGraphic')\n            end)\n        end,\n    },\n    {\n        action = 'noface|removeface',\n        description = 'Removes your face decal',\n        run = function(self)\n            destroyWhere(getCharacter(self), function(object)\n                return object:IsA('Decal') and object.Name == 'face'\n            end)\n        end,\n    },\n    {\n        action = 'deletehats|nohats|rhats',\n        description = 'Removes the welds that hold your accessories on',\n        run = function(self)\n            destroyWhere(getCharacter(self), function(object)\n                return object:IsA('Weld') and object:FindFirstAncestorWhichIsA('Accessory') ~= nil\n            end)\n        end,\n    },\n    {\n        action = 'drophats|drophat',\n        description = 'Drops your accessories into the workspace',\n        run = function(self)\n            for _, accessory in getAccessories(self)do\n                accessory.Parent = workspace\n            end\n        end,\n    },\n    {\n        action = 'clearcharappearance|clearchar|clrchar',\n        description = 'Clears your character appearance',\n        run = function(self)\n            self.localPlayer:ClearCharacterAppearance()\n        end,\n    },\n    {\n        action = 'split',\n        description = 'Splits your R15 character in half (removes the waist)',\n        run = function(self)\n            local character = getCharacter(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not (character and humanoid) then\n                return\n            end\n            if humanoid.RigType ~= Enum.HumanoidRigType.R15 then\n                self:notify('R15 Required', 'This command requires the R15 rig type')\n\n                return\n            end\n\n            local upperTorso = character:FindFirstChild('UpperTorso')\n            local waist = upperTorso and upperTorso:FindFirstChild('Waist')\n\n            if waist then\n                waist:Destroy()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/autofling.luau" ] = "local DEFAULT_RADIUS = 5\nlocal MIN_RADIUS = 1\nlocal CHECK_COOLDOWN = 0.1\nlocal LINGER = 1\n\nlocal function someoneWithin(self, position, radius)\n    for _, player in self.players:GetPlayers()do\n        if player == self.localPlayer then\n            continue\n        end\n\n        local character = player.Character\n        local root = character and character:FindFirstChild('HumanoidRootPart')\n        local humanoid = character and character:FindFirstChildOfClass('Humanoid')\n\n        if root and humanoid and humanoid.Health > 0 and (root.Position - position).Magnitude <= radius then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function runFlingCommand(self, name)\n    local command = self.commandsList.lookup[name]\n\n    if command and command.run then\n        command.run(self)\n    end\nend\nlocal function flingOn(self, garbage)\n    if self:hasGarbage('fling') then\n        return\n    end\n\n    runFlingCommand(self, 'fling')\n\n    local flingGarbage = self:getGarbage('fling')\n\n    if flingGarbage then\n        garbage.flingGarbage = flingGarbage\n    end\nend\nlocal function flingOff(self, garbage)\n    local flingGarbage = garbage.flingGarbage\n\n    garbage.flingGarbage = nil\n\n    if flingGarbage and self:getGarbage('fling') == flingGarbage then\n        runFlingCommand(self, 'unfling')\n    end\nend\nlocal function clearTouches(garbage)\n    for _, connection in garbage.touchConnections do\n        connection:Disconnect()\n    end\n\n    table.clear(garbage.touchConnections)\nend\nlocal function watchTouches(self, garbage, character)\n    clearTouches(garbage)\n\n    local function onTouched(hit)\n        local model = hit:FindFirstAncestorOfClass('Model')\n\n        if not model or model == character then\n            return\n        end\n\n        local player = self.players:GetPlayerFromCharacter(model)\n\n        if not player or player == self.localPlayer then\n            return\n        end\n\n        garbage.lastContact = os.clock()\n\n        flingOn(self, garbage)\n    end\n    local function watchPart(part)\n        if part:IsA('BasePart') then\n            table.insert(garbage.touchConnections, self:connect(part.Touched, onTouched))\n        end\n    end\n\n    for _, part in character:GetDescendants()do\n        watchPart(part)\n    end\n\n    table.insert(garbage.touchConnections, self:connect(character.DescendantAdded, watchPart))\nend\nlocal function check(self, garbage)\n    if self:getGarbage('autofling') ~= garbage then\n        return\n    end\n\n    local root = self.playerService:getRootPart()\n\n    if root and someoneWithin(self, root.Position, garbage.radius) then\n        garbage.lastContact = os.clock()\n    end\n    if os.clock() - garbage.lastContact <= LINGER then\n        flingOn(self, garbage)\n    else\n        flingOff(self, garbage)\n    end\nend\nlocal function startAutoFling(self, radius)\n    local garbage = self:createGarbage('autofling')\n\n    garbage.radius = radius\n    garbage.lastContact = -math.huge\n    garbage.connections = {}\n    garbage.touchConnections = {}\n    garbage.loopId = self.loopService:add(function()\n        check(self, garbage)\n    end, CHECK_COOLDOWN)\n\n    table.insert(garbage.connections, self:connect(self.localPlayer.CharacterAdded, function(\n        character\n    )\n        watchTouches(self, garbage, character)\n    end))\n\n    local character = self.playerService:getCharacter()\n\n    if character then\n        watchTouches(self, garbage, character)\n    end\nend\nlocal function stopAutoFling(self)\n    local garbage = self:collectGarbage('autofling')\n\n    if not garbage then\n        return false\n    end\n\n    self.loopService:remove(garbage.loopId)\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    clearTouches(garbage)\n    flingOff(self, garbage)\n\n    return true\nend\n\nreturn {\n    {\n        action = 'autofling|guardfling|touchfling',\n        description = \n[[Turns fling on by itself when someone comes near you (default 10 studs) or touches you]],\n        args = {\n            kind = 'number',\n            name = 'distance',\n            optional = true,\n        },\n        run = function(self, args)\n            local radius = math.max(args:nextValue() or DEFAULT_RADIUS, MIN_RADIUS)\n            local garbage = self:getGarbage('autofling')\n\n            if garbage then\n                garbage.radius = radius\n\n                self:notify('autofling', `radius is now {radius} studs`)\n\n                return\n            end\n\n            startAutoFling(self, radius)\n            self:notify('autofling enabled', `fling turns on when someone is within {radius} studs or touches you`)\n        end,\n    },\n    {\n        action = 'unautofling|noautofling|untouchfling',\n        description = 'Disables autofling',\n        run = function(self)\n            if stopAutoFling(self) then\n                self:notify('autofling disabled')\n            end\n        end,\n    },\n    {\n        action = 'toggleautofling|toggletouchfling',\n        description = 'Toggles autofling',\n        run = function(self)\n            self:run(if self:hasGarbage('autofling')then'unautofling'else'autofling')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/bang.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal BANG_R6_ANIMATION = 'rbxassetid://148840371'\nlocal BANG_R15_ANIMATION = 'rbxassetid://5918726674'\nlocal CARPET_ANIMATION = 'rbxassetid://282574440'\n\nlocal function getTorso(character)\n    if not character then\n        return nil\n    end\n\n    return character:FindFirstChild('Torso') or character:FindFirstChild('UpperTorso') or character:FindFirstChild('LowerTorso') or character:FindFirstChild('HumanoidRootPart')\nend\nlocal function playAnimation(humanoid, animationId)\n    local animation = Instance.new('Animation')\n\n    animation.AnimationId = animationId\n\n    local track = humanoid:LoadAnimation(animation)\n\n    track:Play(0.1, 1, 1)\n\n    return track, animation\nend\nlocal function stopBang(self)\n    local garbage = self:collectGarbage('bang')\n\n    if not garbage then\n        return\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    garbage.track:Stop()\n    garbage.animation:Destroy()\nend\nlocal function stopCarpet(self)\n    local garbage = self:collectGarbage('carpet')\n\n    if not garbage then\n        return\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    garbage.track:Stop()\n    garbage.animation:Destroy()\nend\n\nreturn {\n    {\n        action = 'bang',\n        description = 'owo',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            stopBang(self)\n\n            local target = resolvePlayers(args:nextValue())[1]\n            local speed = args:nextValue() or 3\n            local humanoid = self.playerService:getHumanoid()\n\n            if not (target and humanoid) then\n                return\n            end\n\n            local animationId = humanoid.RigType == Enum.HumanoidRigType.R15 and BANG_R15_ANIMATION or BANG_R6_ANIMATION\n            local track, animation = playAnimation(humanoid, animationId)\n\n            track:AdjustSpeed(speed)\n\n            local garbage = self:createGarbage('bang')\n\n            garbage.track = track\n            garbage.animation = animation\n            garbage.connections = {}\n\n            table.insert(garbage.connections, self:connect(humanoid.Died, function(\n            )\n                stopBang(self)\n            end))\n\n            local offset = CFrame.new(0, 0, 1.1)\n\n            table.insert(garbage.connections, self:connect(self.runService.Stepped, function(\n            )\n                local root = self.playerService:getRootPart()\n                local torso = getTorso(target.Character)\n\n                if root and torso then\n                    root.CFrame = torso.CFrame * offset\n                end\n            end))\n        end,\n    },\n    {\n        action = 'unbang',\n        description = 'uwu',\n        run = function(self)\n            stopBang(self)\n        end,\n    },\n    {\n        action = 'carpet',\n        description = 'Be someones carpet',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n            if humanoid.RigType == Enum.HumanoidRigType.R15 then\n                self:notify('R6 Required', 'This command requires the r6 rig type')\n\n                return\n            end\n\n            stopCarpet(self)\n\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            local track, animation = playAnimation(humanoid, CARPET_ANIMATION)\n            local garbage = self:createGarbage('carpet')\n\n            garbage.track = track\n            garbage.animation = animation\n            garbage.connections = {}\n\n            table.insert(garbage.connections, self:connect(humanoid.Died, function(\n            )\n                stopCarpet(self)\n            end))\n            table.insert(garbage.connections, self:connect(self.runService.Heartbeat, function(\n            )\n                local root = self.playerService:getRootPart()\n                local targetRoot = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                if root and targetRoot then\n                    root.CFrame = targetRoot.CFrame\n                end\n            end))\n        end,\n    },\n    {\n        action = 'uncarpet',\n        description = 'Undoes carpet',\n        run = function(self)\n            stopCarpet(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/cframefly.luau" ] = "local DEFAULT_SPEED = 50\n\nlocal function stopCFrameFly(self)\n    local garbage = self:collectGarbage('cframefly')\n\n    if not garbage then\n        return\n    end\n\n    garbage.connection:Disconnect()\n\n    garbage.humanoid.PlatformStand = false\n    garbage.head.Anchored = false\nend\nlocal function startCFrameFly(self)\n    stopCFrameFly(self)\n\n    local humanoid = self.playerService:getHumanoid()\n    local character = self.playerService:getCharacter()\n    local head = character and character:FindFirstChild('Head')\n\n    if not (humanoid and head) then\n        self:notify('cframefly', 'your character is not loaded')\n\n        return\n    end\n\n    humanoid.PlatformStand = true\n    head.Anchored = true\n\n    local garbage = self:createGarbage('cframefly')\n\n    garbage.humanoid = humanoid\n    garbage.head = head\n    garbage.connection = self:connect(self.runService.Heartbeat, function(\n        deltaTime\n    )\n        if not head:IsDescendantOf(workspace) then\n            stopCFrameFly(self)\n\n            return\n        end\n\n        local speed = self.privateEnv.cframeFlySpeed or DEFAULT_SPEED\n        local moveDirection = humanoid.MoveDirection * (speed * deltaTime)\n        local headCFrame = head.CFrame\n        local cameraCFrame = workspace.CurrentCamera.CFrame\n        local cameraOffset = headCFrame:ToObjectSpace(cameraCFrame).Position\n\n        cameraCFrame = cameraCFrame * CFrame.new(-cameraOffset.X, -cameraOffset.Y, \n-cameraOffset.Z + 1)\n\n        local cameraPosition = cameraCFrame.Position\n        local headPosition = headCFrame.Position\n        local objectSpaceVelocity = CFrame.new(cameraPosition, Vector3.new(headPosition.X, cameraPosition.Y, headPosition.Z)):VectorToObjectSpace(moveDirection)\n\n        head.CFrame = CFrame.new(headPosition) * (cameraCFrame - cameraPosition) * CFrame.new(objectSpaceVelocity)\n    end)\nend\n\nreturn {\n    {\n        action = 'cframefly|cfly',\n        description = 'Makes you fly, bypassing some anti cheats (works on mobile)',\n        args = {\n            kind = 'number',\n            name = 'speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local speed = args:nextValue()\n\n            if speed then\n                self.privateEnv.cframeFlySpeed = speed\n            end\n\n            startCFrameFly(self)\n        end,\n    },\n    {\n        action = 'cframeflyspeed|cflyspeed',\n        description = 'Sets cfly speed',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            self.privateEnv.cframeFlySpeed = args:nextValue() or DEFAULT_SPEED\n        end,\n    },\n    {\n        action = 'uncframefly|uncfly',\n        description = 'Disables cfly',\n        run = function(self)\n            stopCFrameFly(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/copyanim.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal DEFAULT_ANIMATION_ID = '507768375'\nlocal DEFAULT_ANIMATION_ID_2 = '180435571'\n\nreturn {\n    {\n        action = 'copyanimation|copyanim|copyemote',\n        description = 'Copies someone elses animation',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            for _, target in resolvePlayers(args:nextValue())do\n                local targetHumanoid = target.Character and target.Character:FindFirstChildOfClass('Humanoid')\n\n                if targetHumanoid then\n                    for _, track in humanoid:GetPlayingAnimationTracks()do\n                        track:Stop()\n                    end\n                    for _, track in targetHumanoid:GetPlayingAnimationTracks()do\n                        if not string.find(track.Animation.AnimationId, DEFAULT_ANIMATION_ID, 1, true) then\n                            local copy = humanoid:LoadAnimation(track.Animation)\n\n                            copy:Play(0.1, 1, track.Speed)\n\n                            copy.TimePosition = track.TimePosition\n\n                            task.spawn(function()\n                                track.Stopped:Wait()\n                                copy:Stop()\n                                copy:Destroy()\n                            end)\n                        end\n                    end\n                end\n            end\n        end,\n    },\n    {\n        action = 'copyanimationid|copyanimid|copyemoteid',\n        description = 'Copies your animation id or someone elses to your clipboard',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            local player = self.localPlayer\n            local text = args:nextValue()\n\n            if text then\n                player = resolvePlayers(text)[1]\n            end\n\n            local humanoid = player and player.Character and player.Character:FindFirstChildWhichIsA('Humanoid')\n\n            if not humanoid then\n                self:notify('Animations', 'character is not loaded')\n\n                return\n            end\n\n            local entries = {}\n\n            for _, track in humanoid:GetPlayingAnimationTracks()do\n                local animationId = track.Animation.AnimationId\n                local ignored = string.find(animationId, DEFAULT_ANIMATION_ID, 1, true) or string.find(animationId, DEFAULT_ANIMATION_ID_2, 1, true)\n\n                if not ignored then\n                    local assetId = string.match(animationId, 'rbxassetid://(%d+)')\n\n                    if assetId then\n                        local success, info = pcall(function()\n                            return self.robloxServices.MarketplaceService:GetProductInfo(tonumber(assetId))\n                        end)\n                        local name = 'Failed to get name'\n\n                        if success then\n                            name = info.Name\n                        end\n\n                        table.insert(entries, 'Name: ' .. name .. '\\nAnimation Id: ' .. animationId)\n                    else\n                        table.insert(entries, 'Animation Id: ' .. animationId)\n                    end\n                end\n            end\n\n            if #entries == 0 then\n                self:notify('Animations', 'No animations to copy')\n\n                return\n            end\n\n            setclipboard('Animations Copied\\n\\n' .. table.concat(entries, '\\n\\n'))\n            self:notify('Animations', 'Copied to clipboard')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/fling.luau" ] = "local argsManager = require('../../systems/argsManager')\nlocal FLING_PHYSICAL_PROPERTY = PhysicalProperties.new(100, 0.3, 0.5)\nlocal FLING_SPIN = Vector3.yAxis * 99999\n\nlocal function createFlingTemplate()\n    local bodyVelocity = Instance.new('BodyAngularVelocity')\n\n    bodyVelocity.MaxTorque = Vector3.new(0, math.huge, 0)\n    bodyVelocity.P = math.huge\n\n    return bodyVelocity\nend\nlocal function flingRun(self)\n    if self:hasGarbage('fling') then\n        self:notify(\"fling is already enabled\\ndisable using 'unfling'\")\n\n        return\n    end\n\n    local humanoid = self.playerService:getHumanoid()\n\n    if not (humanoid and humanoid.Health ~= 0) then\n        return\n    end\n\n    local root = self:getRoot()\n\n    if not root then\n        return\n    end\n\n    local character = humanoid.Parent\n\n    self:notify('fling now is activated')\n    self:run('noclip', argsManager.new({\n        {\n            value = 'nonotify',\n        },\n    }))\n\n    local garbage = self:createGarbage('fling')\n\n    garbage.originalStates = {}\n\n    for _, part in character:GetDescendants()do\n        if not part:IsA('BasePart') then\n            continue\n        end\n\n        garbage.originalStates[part] = {\n            CustomPhysicalProperties = part.CustomPhysicalProperties,\n            Massless = part.Massless,\n        }\n        part.CustomPhysicalProperties = FLING_PHYSICAL_PROPERTY\n    end\n\n    local bodyVelocity = createFlingTemplate()\n\n    garbage.flingVelocity = bodyVelocity\n    garbage.flingConnection = self:connect(humanoid.Died, function()\n        self:notify('player died: disabling fling...')\n        self:run('unfling')\n    end)\n    garbage.flingThread = task.spawn(function()\n        task.wait(0.1)\n\n        if self:getGarbage('fling') ~= garbage then\n            return\n        end\n\n        for _, part in character:GetChildren()do\n            if part:IsA('BasePart') then\n                part.Massless = true\n                part.Velocity = Vector3.zero\n            end\n        end\n\n        bodyVelocity.Parent = root\n\n        while self:getGarbage('fling') == garbage and root.Parent do\n            bodyVelocity.AngularVelocity = FLING_SPIN\n\n            task.wait(0.2)\n\n            bodyVelocity.AngularVelocity = Vector3.zero\n\n            task.wait(0.1)\n        end\n    end)\nend\nlocal function unflingRun(self)\n    local garbage = self:collectGarbage('fling')\n\n    if not garbage then\n        return\n    end\n    if garbage.flingThread then\n        task.cancel(garbage.flingThread)\n    end\n    if garbage.flingVelocity then\n        garbage.flingVelocity:Destroy()\n    end\n    if garbage.flingConnection then\n        garbage.flingConnection:Disconnect()\n    end\n\n    for object, properties in garbage.originalStates do\n        for property, value in properties do\n            object[property] = value\n        end\n    end\n\n    self:notify('fling disabled')\nend\n\nlocal WALKFLING_OFFSET = 0.1\n\nlocal function isLive(character, root)\n    return character ~= nil and character.Parent ~= nil and root ~= nil and root.Parent ~= nil\nend\nlocal function walkflingRun(self)\n    if self:hasGarbage('walkfling') then\n        self:notify(\"walkfling is already enabled\\ndisable using 'unwalkfling'\")\n\n        return\n    end\n\n    local garbage = self:createGarbage('walkfling')\n\n    if not self:hasGarbage('noclip') then\n        self:run('noclip', argsManager.new({\n            {\n                value = 'nonotify',\n            },\n        }))\n\n        garbage.enabledNoclip = true\n    end\n\n    local runService = self.runService\n\n    local function isActive()\n        return self:getGarbage('walkfling') == garbage\n    end\n\n    garbage.thread = task.spawn(function()\n        while isActive() do\n            runService.Heartbeat:Wait()\n\n            local character = self.playerService:getCharacter()\n            local root = character and character:FindFirstChild('HumanoidRootPart')\n\n            while isActive() and not isLive(character, root) do\n                runService.Heartbeat:Wait()\n\n                character = self.playerService:getCharacter()\n                root = character and character:FindFirstChild('HumanoidRootPart')\n            end\n\n            if not isActive() then\n                break\n            end\n\n            local velocity = root.AssemblyLinearVelocity\n\n            root.AssemblyLinearVelocity = velocity * 10000 + Vector3.new(0, 10000, 0)\n\n            runService.RenderStepped:Wait()\n\n            if isLive(character, root) then\n                root.AssemblyLinearVelocity = velocity\n            end\n\n            runService.Stepped:Wait()\n\n            if isLive(character, root) then\n                root.AssemblyLinearVelocity = velocity + Vector3.new(0, WALKFLING_OFFSET, 0)\n            end\n        end\n    end)\n\n    local humanoid = self.playerService:getHumanoid()\n\n    if humanoid then\n        garbage.diedConnection = self:connect(humanoid.Died, function()\n            self:run('unwalkfling')\n        end)\n    end\nend\nlocal function unwalkflingRun(self)\n    local garbage = self:collectGarbage('walkfling')\n\n    if not garbage then\n        return\n    end\n    if garbage.diedConnection then\n        garbage.diedConnection:Disconnect()\n    end\n    if garbage.enabledNoclip then\n        self:run('unnoclip', argsManager.new({\n            {\n                value = 'nonotify',\n            },\n        }))\n    end\nend\nlocal function flyflingRun(self, args)\n    self:run('unvehiclefly')\n    self:run('unwalkfling')\n\n    local speed = args and args:nextValue()\n\n    if speed then\n        self.privateEnv.vehicleFlySpeed = speed\n    end\n\n    self:run('vehiclefly', argsManager.new({}))\n    walkflingRun(self)\n\n    local walkGarbage = self:getGarbage('walkfling')\n\n    if walkGarbage then\n        walkGarbage.flyfling = true\n    end\nend\nlocal function unflyflingRun(self)\n    self:run('unvehiclefly')\n    self:run('unwalkfling')\n    self:run('breakvelocity')\nend\n\nreturn {\n    {\n        action = 'fling|forcefling',\n        description = 'Flings anyone you touch',\n        run = flingRun,\n    },\n    {\n        action = 'unfling|nofling',\n        description = 'Disables the fling command',\n        run = unflingRun,\n    },\n    {\n        action = 'flyfling',\n        description = 'Basically the invisfling command but not invisible',\n        args = {\n            kind = 'number',\n            name = 'speed',\n            optional = true,\n        },\n        run = flyflingRun,\n    },\n    {\n        action = 'unflyfling',\n        description = 'Disables the flyfling command',\n        run = unflyflingRun,\n    },\n    {\n        action = 'walkfling',\n        description = 'Basically fling but no spinning',\n        run = walkflingRun,\n    },\n    {\n        action = 'unwalkfling|nowalkfling',\n        description = 'Disables walkfling',\n        run = unwalkflingRun,\n    },\n    {\n        action = 'togglefling',\n        description = 'Toggles fling',\n        run = function(self)\n            self:run(if self:hasGarbage('fling')then'unfling'else'fling')\n        end,\n    },\n    {\n        action = 'toggleflyfling',\n        description = 'Toggles flyfling',\n        args = {\n            kind = 'number',\n            name = 'speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local garbage = self:getGarbage('walkfling')\n\n            if garbage and garbage.flyfling then\n                self:run('unflyfling')\n            else\n                self:run('flyfling', args)\n            end\n        end,\n    },\n    {\n        action = 'togglewalkfling',\n        description = 'Toggles walkfling',\n        run = function(self)\n            self:run(if self:hasGarbage('walkfling')then'unwalkfling'else'walkfling')\n        end,\n    },\n    {\n        action = 'toggleantifling',\n        description = 'Toggles antifling',\n        run = function(self)\n            self:run(if self:hasGarbage('antifling')then'unantifling'else'antifling')\n        end,\n    },\n    {\n        action = 'invisfling',\n        description = \n[[Enables invisible fling (the invis part is patched, try using the god command before using this)]],\n        run = function(self)\n            self:run('invisible')\n            task.spawn(function()\n                self:run('fling')\n            end)\n        end,\n    },\n    {\n        action = 'antifling',\n        description = 'Disables player collisions to prevent you from being flung',\n        run = function(self)\n            if self:hasGarbage('antifling') then\n                return\n            end\n\n            local garbage = self:createGarbage('antifling')\n\n            garbage.connection = self:connect(self.runService.Stepped, function()\n                for _, player in self.players:GetPlayers()do\n                    if player ~= self.localPlayer and player.Character then\n                        for _, part in player.Character:GetDescendants()do\n                            if part:IsA('BasePart') then\n                                part.CanCollide = false\n                            end\n                        end\n                    end\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unantifling',\n        description = 'Disables antifling',\n        run = function(self)\n            local garbage = self:collectGarbage('antifling')\n\n            if garbage then\n                garbage.connection:Disconnect()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/float.luau" ] = "local keyboardService = require('../../../framework/services/keyboardService')\nlocal FLOAT_OFFSET = -3.1\n\nlocal function removeFloat(self)\n    local garbage = self:collectGarbage('float')\n\n    if not garbage then\n        return\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    garbage.platform:Destroy()\nend\nlocal function startFloat(self)\n    if self:hasGarbage('float') then\n        self:notify('float is already enabled')\n\n        return\n    end\n\n    local character = self.playerService:getCharacter()\n    local root = self.playerService:getRootPart()\n\n    if not (character and root) then\n        self:notify('Float', 'your character is not loaded')\n\n        return\n    end\n\n    local platform = Instance.new('Part')\n\n    platform.Name = 'IYFloatPlatform'\n    platform.Transparency = 1\n    platform.Size = Vector3.new(2, 0.2, 1.5)\n    platform.Anchored = true\n    platform.CFrame = root.CFrame * CFrame.new(0, FLOAT_OFFSET, 0)\n    platform.Parent = character\n\n    local garbage = self:createGarbage('float')\n\n    garbage.platform = platform\n    garbage.offset = FLOAT_OFFSET\n    garbage.connections = {}\n\n    table.insert(garbage.connections, self:connect(self.runService.Heartbeat, function(\n    )\n        local currentRoot = self.playerService:getRootPart()\n\n        if not (currentRoot and platform:IsDescendantOf(workspace)) then\n            removeFloat(self)\n\n            return\n        end\n\n        platform.CFrame = currentRoot.CFrame * CFrame.new(0, garbage.offset, 0)\n    end))\n    table.insert(garbage.connections, self:connect(self.robloxServices.UserInputService.InputBegan, function(\n        input,\n        processed\n    )\n        if processed then\n            return\n        end\n        if input.KeyCode == keyboardService:getBinding('floatUp') then\n            garbage.offset += 1.5\n        elseif input.KeyCode == keyboardService:getBinding('floatDown') then\n            garbage.offset -= 0.5\n        end\n    end))\n    table.insert(garbage.connections, self:connect(self.robloxServices.UserInputService.InputEnded, function(\n        input\n    )\n        if input.KeyCode == keyboardService:getBinding('floatUp') then\n            garbage.offset -= 1.5\n        elseif input.KeyCode == keyboardService:getBinding('floatDown') then\n            garbage.offset += 0.5\n        end\n    end))\n    self:notify('Float', `Enabled ({keyboardService:getBindingName('floatDown')} = down & {keyboardService:getBindingName('floatUp')} = up)`)\nend\n\nreturn {\n    {\n        action = 'float|platform',\n        description = 'Spawns a platform beneath you causing you to float',\n        run = function(self)\n            startFloat(self)\n        end,\n    },\n    {\n        action = 'togglefloat',\n        description = 'Toggles float',\n        run = function(self)\n            self:run(if self:hasGarbage('float')then'unfloat'else'float')\n        end,\n    },\n    {\n        action = 'unfloat|noplatform|nofloat|unplatform',\n        description = 'Removes the platform',\n        run = function(self)\n            if not self:hasGarbage('float') then\n                return\n            end\n\n            removeFloat(self)\n            self:notify('Float', 'Disabled')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/fly.luau" ] = "local flight = require('../../systems/flight')\nlocal DEFAULT_SPEED = 100\n\nreturn {\n    {\n        action = 'fly',\n        description = 'Makes you fly',\n        args = {\n            kind = 'number',\n            name = 'fly speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local speed = args:nextValue()\n\n            if speed then\n                self.privateEnv.flySpeed = speed\n            elseif self.privateEnv.flySpeed then\n                self:notify('Fly', `no speed given, using the last speed set: {self.privateEnv.flySpeed}`)\n            else\n                self:notify('Fly', `no speed given, using the default speed: {DEFAULT_SPEED}`)\n            end\n\n            flight.start(self, {\n                garbageName = 'fly',\n                kind = 'fly',\n                platformStand = true,\n                getSpeed = function()\n                    return self.privateEnv.flySpeed or DEFAULT_SPEED\n                end,\n            })\n        end,\n    },\n    {\n        action = 'flyspeed|flysp',\n        description = 'Set fly speed (default is 100)',\n        args = {\n            kind = 'number',\n            name = 'fly speed',\n        },\n        run = function(self, args)\n            self.privateEnv.flySpeed = args:nextValue() or DEFAULT_SPEED\n        end,\n    },\n    {\n        action = 'togglefly',\n        description = 'Toggles fly',\n        args = {\n            kind = 'number',\n            name = 'fly speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local garbage = self:getGarbage('fly')\n\n            if garbage and garbage.kind == 'fly' then\n                self:run('unfly')\n            else\n                self:run('fly', args)\n            end\n        end,\n    },\n    {\n        action = 'unfly|nofly',\n        description = 'Disables fly',\n        run = function(self)\n            flight.stop(self, 'fly')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/follow.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    {\n        action = 'walkto|follow',\n        description = 'Walks your character to a player and keeps following them',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            local previous = self:collectGarbage('walkto')\n\n            if previous then\n                previous.running = false\n            end\n\n            local humanoid = self.playerService:getHumanoid()\n\n            if humanoid and humanoid.SeatPart then\n                humanoid.Sit = false\n\n                task.wait(0.1)\n            end\n\n            local garbage = self:createGarbage('walkto')\n\n            garbage.running = true\n\n            task.spawn(function()\n                while garbage.running do\n                    local currentHumanoid = self.playerService:getHumanoid()\n                    local targetRoot = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                    if not (currentHumanoid and targetRoot) then\n                        break\n                    end\n\n                    currentHumanoid:MoveTo(targetRoot.Position)\n                    task.wait()\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unwalkto|nowalkto|unfollow|nofollow',\n        description = 'Stops walking to the player',\n        run = function(self)\n            local garbage = self:collectGarbage('walkto')\n\n            if garbage then\n                garbage.running = false\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/god.luau" ] = "return {\n    {\n        action = 'god',\n        description = 'Makes your character difficult to kill in most games',\n        run = function(self)\n            local localPlayer = self.localPlayer\n            local character = localPlayer.Character\n            local humanoid = character and character:FindFirstChildWhichIsA('Humanoid')\n\n            if not humanoid then\n                return\n            end\n\n            local camera = workspace.CurrentCamera\n            local cameraCFrame = camera.CFrame\n            local newHumanoid = humanoid:Clone()\n\n            newHumanoid.Parent = character\n            localPlayer.Character = nil\n\n            newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)\n            newHumanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)\n            newHumanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\n\n            newHumanoid.BreakJointsOnDeath = true\n\n            humanoid:Destroy()\n\n            localPlayer.Character = character\n            camera.CameraSubject = newHumanoid\n\n            task.wait()\n\n            camera.CFrame = cameraCFrame\n            newHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None\n\n            local animate = character:FindFirstChild('Animate')\n\n            if animate then\n                animate.Disabled = true\n\n                task.wait()\n\n                animate.Disabled = false\n            end\n\n            newHumanoid.Health = newHumanoid.MaxHealth\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/hats.luau" ] = "local function stopSpin(self)\n    local garbage = self:collectGarbage('hatspin')\n\n    if not garbage then\n        return\n    end\n\n    garbage.connection:Disconnect()\n\n    for _, accessory in garbage.accessories do\n        local handle = accessory:FindFirstChild('Handle')\n\n        if handle then\n            for _, child in handle:GetChildren()do\n                if child:IsA('BodyPosition') or child:IsA('BodyAngularVelocity') then\n                    child:Destroy()\n                end\n            end\n        end\n        if garbage.character:IsDescendantOf(workspace) then\n            accessory.Parent = workspace\n\n            task.wait()\n\n            accessory.Parent = garbage.character\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'hatspin|spinhats',\n        description = 'Spins your characters accessories',\n        args = {\n            kind = 'number',\n            name = 'spin speed',\n            optional = true,\n        },\n        run = function(self, args)\n            stopSpin(self)\n\n            local humanoid = self.playerService:getHumanoid()\n            local character = self.playerService:getCharacter()\n\n            if not (humanoid and character) then\n                return\n            end\n\n            local speed = args:nextValue() or 100\n            local garbage = self:createGarbage('hatspin')\n\n            garbage.character = character\n            garbage.accessories = {}\n            garbage.keeps = {}\n\n            for _, accessory in humanoid:GetAccessories()do\n                local handle = accessory:FindFirstChild('Handle')\n                local weld = handle and handle:FindFirstChildOfClass('Weld')\n\n                if weld then\n                    weld:Destroy()\n\n                    local keep = Instance.new('BodyPosition')\n\n                    keep.P = 30000\n                    keep.D = 50\n                    keep.Parent = handle\n\n                    local spin = Instance.new('BodyAngularVelocity')\n\n                    spin.AngularVelocity = Vector3.new(0, speed, 0)\n                    spin.MaxTorque = Vector3.new(0, speed * 2, 0)\n                    spin.Parent = handle\n\n                    table.insert(garbage.accessories, accessory)\n                    table.insert(garbage.keeps, keep)\n                end\n            end\n\n            garbage.connection = self:connect(self.runService.Stepped, function()\n                local currentCharacter = self.playerService:getCharacter()\n\n                if currentCharacter ~= character then\n                    stopSpin(self)\n\n                    return\n                end\n\n                local head = character:FindFirstChild('Head')\n\n                if not head then\n                    return\n                end\n\n                for _, keep in garbage.keeps do\n                    keep.Position = head.Position\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unhatspin|unspinhats',\n        description = 'Undoes spinhats',\n        run = function(self)\n            stopSpin(self)\n        end,\n    },\n    {\n        action = 'clearhats|cleanhats',\n        description = 'Clears hats in the workspace',\n        run = function(self)\n            local firetouchinterest = self:expectExploit('firetouchinterest')\n\n            if not firetouchinterest then\n                return\n            end\n\n            task.spawn(function()\n                local character = self.playerService:getCharacter()\n                local humanoid = self.playerService:getHumanoid()\n                local root = self.playerService:getRootPart()\n\n                if not (character and humanoid and root) then\n                    return\n                end\n\n                local oldCFrame = root.CFrame\n                local hats = {}\n\n                for _, child in workspace:GetChildren()do\n                    if child:IsA('Accessory') then\n                        table.insert(hats, child)\n                    end\n                end\n                for _, accessory in humanoid:GetAccessories()do\n                    accessory:Destroy()\n                end\n                for _, hat in hats do\n                    local handle = hat:FindFirstChild('Handle')\n                    local currentRoot = self.playerService:getRootPart()\n\n                    if handle and currentRoot then\n                        firetouchinterest(handle, currentRoot, 0)\n                    end\n\n                    local waited = 0\n\n                    while character.Parent and not character:FindFirstChildOfClass('Accessory') and waited < 120 do\n                        task.wait()\n\n                        waited += 1\n                    end\n\n                    local attached = character:FindFirstChildOfClass('Accessory')\n\n                    if attached then\n                        attached:Destroy()\n                    end\n\n                    task.wait()\n                end\n\n                self.playerService:resetCharacter()\n                self.localPlayer.CharacterAdded:Wait()\n\n                for _ = 1, 20 do\n                    task.wait()\n\n                    local newRoot = self.playerService:getRootPart()\n\n                    if newRoot then\n                        newRoot.CFrame = oldCFrame\n                    end\n                end\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/headsit.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function stopHeadSit(self)\n    local garbage = self:collectGarbage('headsit')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'headsit',\n        description = 'Sit on a players head',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            stopHeadSit(self)\n\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            humanoid.Sit = true\n\n            local garbage = self:createGarbage('headsit')\n\n            garbage.connection = self:connect(self.runService.Heartbeat, function(\n            )\n                local root = self.playerService:getRootPart()\n                local currentHumanoid = self.playerService:getHumanoid()\n                local targetRoot = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                if not (root and currentHumanoid and targetRoot and currentHumanoid.Sit) then\n                    stopHeadSit(self)\n\n                    return\n                end\n\n                root.CFrame = targetRoot.CFrame * CFrame.new(0, 1.6, 0.4)\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/init.luau" ] = "return {\n    require('./fly'),\n    require('./noclip'),\n    require('./vehiclefly'),\n    require('./cframefly'),\n    require('./qefly'),\n    require('./vehiclenoclip'),\n    require('./float'),\n    require('./swin'),\n    require('./movement'),\n    require('./states'),\n    require('./appearance'),\n    require('./tools'),\n    require('./animations'),\n    require('./physics'),\n    require('./safety'),\n    require('./poses'),\n    require('./looks'),\n    require('./rootparts'),\n    require('./toolfilter'),\n    require('./follow'),\n    require('./loops'),\n    require('./fling'),\n    require('./invisible'),\n    require('./limbs'),\n    require('./hats'),\n    require('./toolextras'),\n    require('./jumps'),\n    require('./spoof'),\n    require('./size'),\n    require('./orbit'),\n    require('./headsit'),\n    require('./god'),\n    require('./scare'),\n    require('./bang'),\n    require('./copyanim'),\n}\n",
[ "src/commands/cmds/character/invisible.luau" ] = "local function applyInvisible(self, garbage)\n    local character = self.playerService:getCharacter()\n\n    if not character then\n        return\n    end\n\n    for _, object in character:GetDescendants()do\n        if (object:IsA('BasePart') or object:IsA('Decal')) and garbage.originals[object] == nil then\n            garbage.originals[object] = object.Transparency\n            object.Transparency = 1\n        end\n    end\nend\nlocal function startInvisible(self)\n    local previous = self:getGarbage('invisible')\n\n    if previous and previous.connection and previous.connection.Connected then\n        self:notify('Invisible', 'you are already invisible')\n\n        return\n    end\n\n    local originals = {}\n\n    if previous then\n        originals = previous.originals or {}\n\n        self:collectGarbage('invisible')\n\n        if previous.connection then\n            previous.connection:Disconnect()\n        end\n    end\n\n    local garbage = self:createGarbage('invisible')\n\n    garbage.originals = originals\n\n    applyInvisible(self, garbage)\n\n    garbage.connection = self:connect(self.localPlayer.CharacterAdded, function()\n        applyInvisible(self, garbage)\n    end)\n\n    self:notify('Invisible', 'other players can no longer see your character')\nend\nlocal function stopInvisible(self)\n    local garbage = self:collectGarbage('invisible')\n\n    if not garbage then\n        return false\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\n\n    for object, transparency in garbage.originals do\n        if object.Parent then\n            object.Transparency = transparency\n        end\n    end\n\n    return true\nend\n\nreturn {\n    {\n        action = 'invisible|invis',\n        description = 'Makes you invisible to other players',\n        run = function(self)\n            startInvisible(self)\n        end,\n    },\n    {\n        action = 'visible|vis|uninvisible',\n        description = 'Makes you visible to other players',\n        run = function(self)\n            if not stopInvisible(self) then\n                self:notify('Visible', 'you are already visible')\n            end\n        end,\n    },\n    {\n        action = 'toggleinvis',\n        description = 'Toggles invisibility',\n        run = function(self)\n            self:run(if self:hasGarbage('invisible')then'visible'else'invisible')\n        end,\n    },\n    {\n        action = 'toolinvisible|toolinvis|tinvis',\n        description = 'Makes you invisible to other players and able to use tools',\n        run = function(self)\n            startInvisible(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/jumps.luau" ] = "local function stopLoop(self, name)\n    local garbage = self:collectGarbage(name)\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function isBlockedAhead(root, character)\n    local look = root.CFrame.LookVector * 3\n    local lowRay = Ray.new(root.Position - Vector3.new(0, 1.5, 0), look)\n    local highRay = Ray.new(root.Position + Vector3.new(0, 1.5, 0), look)\n\n    return workspace:FindPartOnRay(lowRay, character) ~= nil or workspace:FindPartOnRay(highRay, character) ~= nil\nend\n\nreturn {\n    {\n        action = 'autojump|ajump',\n        description = 'Automatically jumps when you run into an object',\n        run = function(self)\n            stopLoop(self, 'autojump')\n\n            local garbage = self:createGarbage('autojump')\n\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                local character = self.playerService:getCharacter()\n                local humanoid = self.playerService:getHumanoid()\n                local root = self.playerService:getRootPart()\n\n                if character and humanoid and root and isBlockedAhead(root, character) then\n                    humanoid.Jump = true\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unautojump|noautojump|noajump|unajump',\n        description = 'Disables autojump',\n        run = function(self)\n            stopLoop(self, 'autojump')\n        end,\n    },\n    {\n        action = 'edgejump|ejump',\n        description = 'Automatically jumps when you get to the edge of an object',\n        run = function(self)\n            stopLoop(self, 'edgejump')\n\n            local garbage = self:createGarbage('edgejump')\n\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                local humanoid = self.playerService:getHumanoid()\n                local root = self.playerService:getRootPart()\n\n                if not (humanoid and root) then\n                    return\n                end\n\n                local previous = garbage.state\n                local state = humanoid:GetState()\n\n                garbage.state = state\n\n                if previous ~= state and state == Enum.HumanoidStateType.Freefall and previous ~= Enum.HumanoidStateType.Jumping and garbage.lastCFrame then\n                    root.CFrame = garbage.lastCFrame\n\n                    local velocity = root.AssemblyLinearVelocity\n\n                    root.AssemblyLinearVelocity = Vector3.new(velocity.X, humanoid.JumpPower, velocity.Z)\n                end\n\n                garbage.lastCFrame = root.CFrame\n            end)\n        end,\n    },\n    {\n        action = 'unedgejump|noedgejump|noejump|unejump',\n        description = 'Disables edgejump',\n        run = function(self)\n            stopLoop(self, 'edgejump')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/limbs.luau" ] = "local function destroyParts(character, names)\n    for _, name in names do\n        local part = character:FindFirstChild(name)\n\n        if part then\n            part:Destroy()\n        end\n    end\nend\nlocal function isR15(self)\n    local humanoid = self.playerService:getHumanoid()\n\n    return humanoid ~= nil and humanoid.RigType == Enum.HumanoidRigType.R15\nend\n\nreturn {\n    {\n        action = 'noarms|rarms',\n        description = 'Removes your arms',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if character then\n                destroyParts(character, isR15(self) and {\n                    'RightUpperArm',\n                    'LeftUpperArm',\n                } or {\n                    'Right Arm',\n                    'Left Arm',\n                })\n            end\n        end,\n    },\n    {\n        action = 'nolegs|rlegs',\n        description = 'Removes your legs',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if character then\n                destroyParts(character, isR15(self) and {\n                    'RightUpperLeg',\n                    'LeftUpperLeg',\n                } or {\n                    'Right Leg',\n                    'Left Leg',\n                })\n            end\n        end,\n    },\n    {\n        action = 'nolimbs|rlimbs',\n        description = 'Removes your limbs',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if character then\n                destroyParts(character, isR15(self) and {\n                    'RightUpperLeg',\n                    'LeftUpperLeg',\n                    'RightUpperArm',\n                    'LeftUpperArm',\n                } or {\n                    'Right Leg',\n                    'Left Leg',\n                    'Right Arm',\n                    'Left Arm',\n                })\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/looks.luau" ] = "local function isGui(object)\n    return object:IsA('BillboardGui') or object:IsA('SurfaceGui')\nend\nlocal function destroyNamedChildren(container, names)\n    for _, name in names do\n        local child = container:FindFirstChild(name)\n\n        if child then\n            child:Destroy()\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'creeper',\n        description = \n[[Gives your character a creeper look (removes the face mesh, arms and accessories)]],\n        run = function(self)\n            local character = self.localPlayer.Character\n            local humanoid = self.playerService:getHumanoid()\n\n            if not (character and humanoid) then\n                return\n            end\n\n            local head = character:FindFirstChild('Head')\n            local mesh = head and head:FindFirstChildOfClass('SpecialMesh')\n\n            if mesh then\n                mesh:Destroy()\n            end\n            if humanoid.RigType == Enum.HumanoidRigType.R15 then\n                destroyNamedChildren(character, {\n                    'LeftUpperArm',\n                    'RightUpperArm',\n                })\n            else\n                destroyNamedChildren(character, {\n                    'Left Arm',\n                    'Right Arm',\n                })\n            end\n\n            humanoid:RemoveAccessories()\n        end,\n    },\n    {\n        action = 'chardelete|charremove|cd',\n        description = 'Deletes every part of your character with the given name',\n        args = {\n            kind = 'string',\n            name = 'item name',\n        },\n        run = function(self, args)\n            local character = self.localPlayer.Character\n            local input = args:nextValue() or ''\n\n            if not character then\n                return\n            end\n\n            for _, object in character:GetDescendants()do\n                if object.Name:lower() == input:lower() then\n                    object:Destroy()\n                end\n            end\n\n            self:notify('Item(s) Deleted', `Deleted {input}`)\n        end,\n    },\n    {\n        action = \n[[chardeleteclass|charremoveclass|chardeleteclassname|charremoveclassname|cdc]],\n        description = \n[[Deletes every part of your character with the given class name]],\n        args = {\n            kind = 'className',\n            name = 'class name',\n        },\n        run = function(self, args)\n            local character = self.localPlayer.Character\n            local input = args:nextValue() or ''\n\n            if not character then\n                return\n            end\n\n            for _, object in character:GetDescendants()do\n                if object.ClassName:lower() == input:lower() then\n                    object:Destroy()\n                end\n            end\n\n            self:notify('Item(s) Deleted', `Deleted items with ClassName {input}`)\n        end,\n    },\n    {\n        action = \n[[loopnobgui|loopunbgui|loopnobillboardgui|loopunbillboardgui|loopnoname|looprohg]],\n        description = \n[[Removes BillboardGuis and SurfaceGuis from your character, including new ones]],\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if not character then\n                return\n            end\n\n            local old = self:collectGarbage('nobgui')\n\n            if old and old.connection then\n                old.connection:Disconnect()\n            end\n\n            for _, object in character:GetDescendants()do\n                if isGui(object) then\n                    object:Destroy()\n                end\n            end\n\n            local garbage = self:createGarbage('nobgui')\n\n            garbage.connection = self:connect(character.DescendantAdded, function(\n                object\n            )\n                if isGui(object) then\n                    task.wait()\n                    object:Destroy()\n                end\n            end)\n        end,\n    },\n    {\n        action = \n[[unloopnobgui|unloopunbgui|unloopnobillboardgui|unloopunbillboardgui|unloopnoname|unlooprohg]],\n        description = \n[[Stops removing BillboardGuis and SurfaceGuis from your character]],\n        run = function(self)\n            local garbage = self:collectGarbage('nobgui')\n\n            if garbage and garbage.connection then\n                garbage.connection:Disconnect()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/loops.luau" ] = "local function applyWalkSpeed(humanoid, speed)\n    humanoid.WalkSpeed = speed\nend\nlocal function applyJumpPower(humanoid, power)\n    if humanoid.UseJumpPower then\n        humanoid.JumpPower = power\n    else\n        humanoid.JumpHeight = power\n    end\nend\nlocal function stopLoop(self, garbageName)\n    local garbage = self:collectGarbage(garbageName)\n\n    if garbage and garbage.connections then\n        for _, connection in garbage.connections do\n            connection:Disconnect()\n        end\n    end\nend\nlocal function startLoop(self, garbageName, property, apply, value)\n    stopLoop(self, garbageName)\n\n    local garbage = self:createGarbage(garbageName)\n\n    garbage.connections = {}\n\n    local function watch(humanoid)\n        apply(humanoid, value)\n        table.insert(garbage.connections, self:connect(humanoid:GetPropertyChangedSignal(property), function(\n        )\n            apply(humanoid, value)\n        end))\n    end\n\n    local humanoid = self.playerService:getHumanoid()\n\n    if humanoid then\n        watch(humanoid)\n    end\n\n    table.insert(garbage.connections, self:connect(self.localPlayer.CharacterAdded, function(\n        character\n    )\n        watch(character:WaitForChild('Humanoid'))\n    end))\nend\n\nreturn {\n    {\n        action = 'loopspeed|loopws',\n        description = \n[[Keeps your walk speed set, even after respawning (default is 16)]],\n        args = {\n            kind = 'number',\n            name = 'walk speed',\n            optional = true,\n        },\n        run = function(self, args)\n            startLoop(self, 'loopspeed', 'WalkSpeed', applyWalkSpeed, args:nextValue() or 16)\n        end,\n    },\n    {\n        action = 'unloopspeed|unloopws',\n        description = 'Stops the walk speed loop',\n        run = function(self)\n            stopLoop(self, 'loopspeed')\n        end,\n    },\n    {\n        action = 'loopjumppower|loopjp|loopjpower',\n        description = \n[[Keeps your jump power set, even after respawning (default is 50)]],\n        args = {\n            kind = 'number',\n            name = 'jump power',\n            optional = true,\n        },\n        run = function(self, args)\n            startLoop(self, 'loopjumppower', 'JumpPower', applyJumpPower, args:nextValue() or 50)\n        end,\n    },\n    {\n        action = 'unloopjumppower|unloopjp|unloopjpower',\n        description = 'Stops the jump power loop',\n        run = function(self)\n            stopLoop(self, 'loopjumppower')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/movement.luau" ] = "local function setHumanoidProperty(self, property, value)\n    local humanoid = self.playerService:getHumanoid()\n\n    if humanoid then\n        humanoid[property] = value\n    end\nend\nlocal function humanoidToggle(action, description, property, value)\n    return {\n        action = action,\n        description = description,\n        run = function(self)\n            setHumanoidProperty(self, property, value)\n        end,\n    }\nend\n\nreturn {\n    {\n        action = 'speed|ws|walkspeed',\n        description = 'Sets your walk speed (default is 16)',\n        args = {\n            kind = 'number',\n            name = 'walk speed',\n            optional = true,\n        },\n        run = function(self, args)\n            setHumanoidProperty(self, 'WalkSpeed', args:nextValue() or 16)\n        end,\n    },\n    {\n        action = 'jpower|jumppower|jp',\n        description = 'Sets your jump power (default is 50)',\n        args = {\n            kind = 'number',\n            name = 'jump power',\n            optional = true,\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            local power = args:nextValue() or 50\n\n            if humanoid.UseJumpPower then\n                humanoid.JumpPower = power\n            else\n                humanoid.JumpHeight = power\n            end\n        end,\n    },\n    {\n        action = 'maxslopeangle|msa',\n        description = \n[[Sets the max slope angle your humanoid can walk up (default is 89)]],\n        args = {\n            kind = 'number',\n            name = 'angle',\n            optional = true,\n        },\n        run = function(self, args)\n            setHumanoidProperty(self, 'MaxSlopeAngle', args:nextValue() or 89)\n        end,\n    },\n    {\n        action = 'hipheight|hheight',\n        description = 'Sets your hip height (default depends on your rig)',\n        args = {\n            kind = 'number',\n            name = 'hip height',\n            optional = true,\n        },\n        run = function(self, args)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n\n            local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15\n\n            humanoid.HipHeight = args:nextValue() or (isR15 and 2.1 or 0)\n        end,\n    },\n    humanoidToggle('stun|platformstand', 'Makes your character stiff (PlatformStand)', 'PlatformStand', true),\n    humanoidToggle('unstun|nostun|unplatformstand|noplatformstand', 'Disables stun', 'PlatformStand', false),\n    humanoidToggle('norotate|noautorotate', 'Stops your character from auto rotating', 'AutoRotate', false),\n    humanoidToggle('unnorotate|autorotate', 'Lets your character auto rotate again', 'AutoRotate', true),\n    {\n        action = 'trip',\n        description = 'Trips your character forward',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n            local root = self.playerService:getRootPart()\n\n            if not (humanoid and root) then\n                return\n            end\n\n            humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)\n\n            root.AssemblyLinearVelocity = root.CFrame.LookVector * 30\n        end,\n    },\n    {\n        action = 'breakvelocity',\n        description = \"Stops the character's movement for one second\",\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if not character then\n                return\n            end\n\n            local started = os.clock()\n\n            task.spawn(function()\n                while os.clock() - started < 1 do\n                    for _, part in character:GetDescendants()do\n                        if part:IsA('BasePart') then\n                            part.AssemblyLinearVelocity = Vector3.zero\n                            part.AssemblyAngularVelocity = Vector3.zero\n                        end\n                    end\n\n                    task.wait()\n                end\n            end)\n        end,\n    },\n    {\n        action = 'deletevelocity|dv|removevelocity|removeforces',\n        description = 'Deletes the force and velocity objects on your character',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if not character then\n                return\n            end\n\n            local forceClasses = {\n                'BodyVelocity',\n                'BodyGyro',\n                'RocketPropulsion',\n                'BodyThrust',\n                'BodyAngularVelocity',\n                'AngularVelocity',\n                'BodyForce',\n                'VectorForce',\n                'LineForce',\n            }\n\n            for _, object in character:GetDescendants()do\n                for _, className in forceClasses do\n                    if object:IsA(className) then\n                        object:Destroy()\n\n                        break\n                    end\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/noclip.luau" ] = "local NOTIFY_TITLE = 'Noclip'\nlocal silentArg = {\n    kind = 'string',\n    name = 'nonotify',\n    optional = true,\n}\n\nlocal function stopNoclip(self)\n    local garbage = self:collectGarbage('noclip')\n\n    if not garbage then\n        return false\n    end\n\n    garbage.connection:Disconnect()\n\n    for part in garbage.parts do\n        if part.Parent then\n            part.CanCollide = true\n        end\n    end\n\n    return true\nend\nlocal function startNoclip(self)\n    local garbage = self:createGarbage('noclip')\n\n    garbage.parts = setmetatable({}, {\n        __mode = 'k',\n    })\n    garbage.connection = self:connect(self.runService.Stepped, function()\n        local character = self.playerService:getCharacter()\n\n        if not character then\n            return\n        end\n\n        local float = self:getGarbage('float')\n        local platform = float and float.platform\n\n        for _, part in character:GetDescendants()do\n            if part:IsA('BasePart') and part.CanCollide and part ~= platform then\n                part.CanCollide = false\n                garbage.parts[part] = true\n            end\n        end\n    end)\nend\n\nreturn {\n    {\n        action = 'noclip',\n        description = 'Go through objects',\n        args = silentArg,\n        run = function(self, args)\n            local silent = args:nextValue() == 'nonotify'\n\n            stopNoclip(self)\n            startNoclip(self)\n\n            if not silent then\n                self:notify(NOTIFY_TITLE, 'Noclip Enabled')\n            end\n        end,\n    },\n    {\n        action = 'unnoclip|clip',\n        description = 'Disables noclip',\n        args = silentArg,\n        run = function(self, args)\n            local silent = args:nextValue() == 'nonotify'\n\n            stopNoclip(self)\n\n            if not silent then\n                self:notify(NOTIFY_TITLE, 'Noclip Disabled')\n            end\n        end,\n    },\n    {\n        action = 'togglenoclip',\n        description = 'Toggles noclip',\n        run = function(self)\n            self:run(if self:hasGarbage('noclip')then'unnoclip'else'noclip')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/orbit.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function stopOrbit(self)\n    local garbage = self:collectGarbage('orbit')\n\n    if not garbage then\n        return\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'orbit',\n        description = \n[[Makes your character orbit around a player with an optional speed and an optional distance]],\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'speed',\n                optional = true,\n            },\n            {\n                kind = 'number',\n                name = 'distance',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            stopOrbit(self)\n\n            local target = resolvePlayers(args:nextValue())[1]\n            local speed = args:nextValue() or 0.2\n            local distance = args:nextValue() or 6\n            local humanoid = self.playerService:getHumanoid()\n\n            if not (target and humanoid) then\n                return\n            end\n\n            local garbage = self:createGarbage('orbit')\n\n            garbage.connections = {}\n\n            local rotation = 0\n\n            local function getTargetRoot()\n                return target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n            end\n\n            table.insert(garbage.connections, self:connect(self.runService.Heartbeat, function(\n            )\n                local root = self.playerService:getRootPart()\n                local targetRoot = getTargetRoot()\n\n                if not (root and targetRoot) then\n                    return\n                end\n\n                rotation += speed\n\n                root.CFrame = CFrame.new(targetRoot.Position) * CFrame.Angles(0, math.rad(rotation), 0) * CFrame.new(distance, 0, 0)\n            end))\n            table.insert(garbage.connections, self:connect(self.runService.RenderStepped, function(\n            )\n                local root = self.playerService:getRootPart()\n                local targetRoot = getTargetRoot()\n\n                if root and targetRoot then\n                    root.CFrame = CFrame.new(root.Position, targetRoot.Position)\n                end\n            end))\n            table.insert(garbage.connections, self:connect(humanoid.Died, function(\n            )\n                stopOrbit(self)\n            end))\n            table.insert(garbage.connections, self:connect(humanoid.Seated, function(\n                active\n            )\n                if active then\n                    stopOrbit(self)\n                end\n            end))\n            self:notify('Orbit', 'Started orbiting ' .. target.Name)\n        end,\n    },\n    {\n        action = 'unorbit',\n        description = 'Disables orbit',\n        run = function(self)\n            if not self:hasGarbage('orbit') then\n                return\n            end\n\n            stopOrbit(self)\n            self:notify('Orbit', 'Stopped orbiting player')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/physics.luau" ] = "local function setDensity(self, density)\n    local character = self.localPlayer.Character\n\n    if not character then\n        return\n    end\n\n    for _, part in character:GetDescendants()do\n        if part:IsA('BasePart') then\n            part.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0.5)\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'strengthen',\n        description = 'Makes your body parts heavier (default is 100)',\n        args = {\n            kind = 'number',\n            name = 'density',\n            optional = true,\n        },\n        run = function(self, args)\n            setDensity(self, args:nextValue() or 100)\n        end,\n    },\n    {\n        action = 'weaken',\n        description = 'Makes your body parts lighter (default is 0)',\n        args = {\n            kind = 'number',\n            name = 'density',\n            optional = true,\n        },\n        run = function(self, args)\n            setDensity(self, -(args:nextValue() or 0))\n        end,\n    },\n    {\n        action = 'unweaken|unstrengthen',\n        description = \"Resets your body parts' density\",\n        run = function(self)\n            setDensity(self, 0.7)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/poses.luau" ] = "local function stopSpasm(self)\n    local garbage = self:collectGarbage('spasm')\n\n    if garbage and garbage.track then\n        garbage.track:Stop()\n        garbage.track:Destroy()\n    end\nend\nlocal function removeSpinners(root)\n    for _, child in root:GetChildren()do\n        if child.Name == 'Spinning' then\n            child:Destroy()\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'spasm',\n        description = 'Makes your R6 character spasm (uses an animation)',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n            if humanoid.RigType == Enum.HumanoidRigType.R15 then\n                self:notify('R6 Required', 'This command requires the r6 rig type')\n\n                return\n            end\n\n            stopSpasm(self)\n\n            local animation = Instance.new('Animation')\n\n            animation.AnimationId = 'rbxassetid://33796059'\n\n            local track = humanoid:LoadAnimation(animation)\n\n            track:Play()\n            track:AdjustSpeed(99)\n\n            self:registerGarbage('spasm').track = track\n        end,\n    },\n    {\n        action = 'unspasm|nospasm',\n        description = 'Stops the spasm',\n        run = function(self)\n            stopSpasm(self)\n        end,\n    },\n    {\n        action = 'headthrow',\n        description = \"Throws your R6 character's head (uses an animation)\",\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if not humanoid then\n                return\n            end\n            if humanoid.RigType == Enum.HumanoidRigType.R15 then\n                self:notify('R6 Required', 'This command requires the r6 rig type')\n\n                return\n            end\n\n            local animation = Instance.new('Animation')\n\n            animation.AnimationId = 'rbxassetid://35154961'\n\n            local track = humanoid:LoadAnimation(animation)\n\n            track:Play(0)\n            track:AdjustSpeed(1)\n        end,\n    },\n    {\n        action = 'sitwalk',\n        description = 'Uses the sit animation while walking, running and jumping',\n        run = function(self)\n            local character = self.localPlayer.Character\n            local humanoid = self.playerService:getHumanoid()\n            local animate = character and character:FindFirstChild('Animate')\n\n            if not (humanoid and animate) then\n                return\n            end\n\n            local sitFolder = animate:FindFirstChild('sit')\n            local sitAnimation = sitFolder and sitFolder:FindFirstChildWhichIsA('Animation')\n\n            if not sitAnimation then\n                return\n            end\n\n            for _, folderName in {\n                'idle',\n                'walk',\n                'run',\n                'jump',\n            }do\n                local folder = animate:FindFirstChild(folderName)\n                local animation = folder and folder:FindFirstChildWhichIsA('Animation')\n\n                if animation then\n                    animation.AnimationId = sitAnimation.AnimationId\n                end\n            end\n\n            humanoid.HipHeight = humanoid.RigType == Enum.HumanoidRigType.R15 and 0.5 or \n-1.5\n        end,\n    },\n    {\n        action = 'spin',\n        description = 'Spins your character (default speed is 20)',\n        args = {\n            kind = 'number',\n            name = 'spin speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local root = self:getRoot()\n\n            if not root then\n                return\n            end\n\n            removeSpinners(root)\n\n            local spinner = Instance.new('BodyAngularVelocity')\n\n            spinner.Name = 'Spinning'\n            spinner.MaxTorque = Vector3.new(0, math.huge, 0)\n            spinner.AngularVelocity = Vector3.new(0, args:nextValue() or 20, 0)\n            spinner.Parent = root\n        end,\n    },\n    {\n        action = 'unspin',\n        description = 'Stops spinning your character',\n        run = function(self)\n            local root = self.playerService:getRootPart()\n\n            if root then\n                removeSpinners(root)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/qefly.luau" ] = "return {\n    action = 'qefly|flyqe',\n    description = \n[[Enables or disables the up and down keys for fly (set them in Settings > Command Settings)]],\n    args = {\n        kind = 'boolean',\n        optional = true,\n    },\n    run = function(self, args)\n        self.privateEnv.qeFly = args:nextValue() ~= false\n    end,\n}\n",
[ "src/commands/cmds/character/rootparts.luau" ] = "return {\n    {\n        action = 'noroot|removeroot|rroot',\n        description = \"Removes your character's root part (client side)\",\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if not character then\n                return\n            end\n\n            local humanoid = character:FindFirstChildOfClass('Humanoid')\n            local root = humanoid and humanoid.RootPart\n\n            character.Parent = nil\n\n            if root then\n                root:Destroy()\n            end\n\n            character.Parent = workspace\n        end,\n    },\n    {\n        action = 'replaceroot|replacerootpart',\n        description = \"Replaces your character's root part with a fresh copy\",\n        run = function(self)\n            local character = self.localPlayer.Character\n            local root = self.playerService:getRootPart()\n\n            if not (character and root) then\n                return\n            end\n\n            local oldParent = character.Parent\n            local oldCFrame = root.CFrame\n\n            character.Parent = game\n\n            local newRoot = root:Clone()\n\n            newRoot.Parent = character\n\n            root:Destroy()\n\n            newRoot.CFrame = oldCFrame\n            character.Parent = oldParent\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/safety.luau" ] = "local ORIGINAL_DESTROY_HEIGHT = workspace.FallenPartsDestroyHeight\n\nreturn {\n    {\n        action = 'antivoid',\n        description = 'Pushes you back up when you fall below the destroy height',\n        run = function(self)\n            if self:hasGarbage('antivoid') then\n                self:notify('antivoid is already enabled')\n\n                return\n            end\n\n            local garbage = self:createGarbage('antivoid')\n\n            garbage.connection = self:connect(self.runService.Stepped, function()\n                local root = self.playerService:getRootPart()\n\n                if root and root.Position.Y <= ORIGINAL_DESTROY_HEIGHT + 25 then\n                    root.AssemblyLinearVelocity += Vector3.new(0, 250, 0)\n                end\n            end)\n\n            self:notify('antivoid', 'Enabled')\n        end,\n    },\n    {\n        action = 'unantivoid|noantivoid',\n        description = 'Disables antivoid',\n        run = function(self)\n            local garbage = self:collectGarbage('antivoid')\n\n            if garbage and garbage.connection then\n                garbage.connection:Disconnect()\n                self:notify('antivoid', 'Disabled')\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/scare.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal ORIGINAL_DESTROY_HEIGHT = workspace.FallenPartsDestroyHeight\nlocal JERK_ANIMATION_ID = 'rbxassetid://72042024'\n\nlocal function stopJerk(garbage)\n    if garbage.track then\n        garbage.track:Stop()\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'fakeout',\n        description = \n[[Tp to the void and then back (useful to kill people attached to you)]],\n        run = function(self)\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            local oldCFrame = root.CFrame\n            local antivoidWasEnabled = self:hasGarbage('antivoid')\n\n            if antivoidWasEnabled then\n                self:run('unantivoid')\n            end\n\n            pcall(function()\n                workspace.FallenPartsDestroyHeight = 0 / 0\n            end)\n\n            root.CFrame = CFrame.new(0, ORIGINAL_DESTROY_HEIGHT - 25, 0)\n\n            task.wait(1)\n\n            local currentRoot = self.playerService:getRootPart()\n\n            if currentRoot then\n                currentRoot.CFrame = oldCFrame\n            end\n\n            pcall(function()\n                workspace.FallenPartsDestroyHeight = ORIGINAL_DESTROY_HEIGHT\n            end)\n\n            if antivoidWasEnabled then\n                self:run('antivoid')\n            end\n        end,\n    },\n    {\n        action = 'scare|spook',\n        description = 'Teleports in front of a player for half a second',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n            local root = self.playerService:getRootPart()\n            local targetRoot = target and target ~= self.localPlayer and target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n            if not (root and targetRoot) then\n                return\n            end\n\n            local oldCFrame = root.CFrame\n\n            root.CFrame = targetRoot.CFrame + targetRoot.CFrame.LookVector * 2\n            root.CFrame = CFrame.new(root.Position, targetRoot.Position)\n\n            task.wait(0.5)\n\n            local currentRoot = self.playerService:getRootPart()\n\n            if currentRoot then\n                currentRoot.CFrame = oldCFrame\n            end\n        end,\n    },\n    {\n        action = 'jerk',\n        description = 'Makes you jork it',\n        run = function(self)\n            local previous = self:collectGarbage('jerk')\n\n            if previous then\n                local wasPlaying = previous.track ~= nil and previous.track.IsPlaying\n\n                stopJerk(previous)\n\n                if wasPlaying then\n                    return\n                end\n            end\n\n            local humanoid = self.playerService:getHumanoid()\n            local animator = humanoid and humanoid:FindFirstChildOfClass('Animator')\n\n            if not animator then\n                self:notify('Jerk', 'your character has no Animator')\n\n                return\n            end\n\n            local animation = Instance.new('Animation')\n\n            animation.AnimationId = JERK_ANIMATION_ID\n\n            local ok, track = pcall(function()\n                return animator:LoadAnimation(animation)\n            end)\n\n            if not ok then\n                self:notify('Jerk', \n[[could not load the jerk animation (check JERK_ANIMATION_ID in scare.luau)]])\n\n                return\n            end\n\n            track.Looped = true\n\n            track:Play()\n\n            local garbage = self:createGarbage('jerk')\n\n            garbage.track = track\n            garbage.connection = self:connect(humanoid.Died, function()\n                local current = self:collectGarbage('jerk')\n\n                if current then\n                    stopJerk(current)\n                end\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/size.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function getSize(size)\n    if size == 1 then\n        return Vector3.new(2, 1, 1)\n    end\n\n    return Vector3.one * size\nend\n\nreturn {\n    {\n        action = 'headsize',\n        description = 'Expands the head size for players Head (default is 1)',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'head size',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n            local size = args:nextValue() or 1\n\n            for _, target in targets do\n                local head = target ~= self.localPlayer and target.Character and target.Character:FindFirstChild('Head')\n\n                if head and head:IsA('BasePart') then\n                    head.CanCollide = false\n                    head.Size = getSize(size)\n                end\n            end\n        end,\n    },\n    {\n        action = 'hitbox',\n        description = \n[[Expands the hitbox for players HumanoidRootPart (default is 1)]],\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'size',\n                optional = true,\n            },\n            {\n                kind = 'number',\n                name = 'transparency',\n                optional = true,\n                clamp = {0, 1},\n            },\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n            local size = args:nextValue() or 1\n            local transparency = args:nextValue() or 0.4\n\n            for _, target in targets do\n                local root = target ~= self.localPlayer and target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                if root and root:IsA('BasePart') then\n                    root.CanCollide = false\n                    root.Size = getSize(size)\n                    root.Transparency = transparency\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/spoof.luau" ] = "local function spoofProperty(self, property, value)\n    local spoofs = self.privateEnv.spoofs or {}\n\n    self.privateEnv.spoofs = spoofs\n\n    local spoof = spoofs[property]\n\n    if spoof then\n        spoof.value = value\n\n        return\n    end\n\n    local hookmetamethod = self:expectExploit('hookmetamethod')\n    local checkcaller = self:expectExploit('checkcaller')\n\n    if not (hookmetamethod and checkcaller) then\n        return\n    end\n\n    local localPlayer = self.localPlayer\n    local lowerProperty = string.lower(property)\n\n    spoof = {value = value}\n    spoofs[property] = spoof\n\n    local function isSpoofed(object, key)\n        if checkcaller() or typeof(object) ~= 'Instance' or typeof(key) ~= 'string' then\n            return false\n        end\n        if string.lower(key) ~= lowerProperty or not object:IsA('Humanoid') then\n            return false\n        end\n\n        local character = localPlayer.Character\n\n        return character ~= nil and object:IsDescendantOf(character)\n    end\n\n    local oldIndex\n\n    oldIndex = hookmetamethod(game, '__index', function(object, key)\n        if isSpoofed(object, key) then\n            return spoof.last or spoof.value\n        end\n\n        return oldIndex(object, key)\n    end)\n\n    local oldNewIndex\n\n    oldNewIndex = hookmetamethod(game, '__newindex', function(\n        object,\n        key,\n        newValue\n    )\n        if isSpoofed(object, key) then\n            spoof.last = tonumber(newValue)\n        end\n\n        return oldNewIndex(object, key, newValue)\n    end)\nend\n\nreturn {\n    {\n        action = 'spoofspeed|spoofws',\n        description = 'Spoofs your WalkSpeed on the Client',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local value = args:nextValue()\n\n            if value then\n                spoofProperty(self, 'WalkSpeed', value)\n            end\n        end,\n    },\n    {\n        action = 'spoofjumppower|spoofjp',\n        description = 'Spoofs your JumpPower on the Client',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local value = args:nextValue()\n\n            if value then\n                spoofProperty(self, 'JumpPower', value)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/states.luau" ] = "local function startJumpLoop(self, garbageName, debounce)\n    if self:hasGarbage(garbageName) then\n        self:notify(`{garbageName} is already enabled`)\n\n        return\n    end\n\n    local garbage = self:createGarbage(garbageName)\n\n    garbage.connection = self:connect(self.robloxServices.UserInputService.JumpRequest, function(\n    )\n        if debounce and garbage.debouncing then\n            return\n        end\n\n        local humanoid = self.playerService:getHumanoid()\n\n        if not humanoid then\n            return\n        end\n\n        garbage.debouncing = true\n\n        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        task.wait()\n\n        garbage.debouncing = false\n    end)\nend\nlocal function stopJumpLoop(self, garbageName)\n    local garbage = self:collectGarbage(garbageName)\n\n    if garbage and garbage.connection then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function setHumanoidState(self, stateName, enabled)\n    local humanoid = self.playerService:getHumanoid()\n    local success, state = pcall(function()\n        return Enum.HumanoidStateType[stateName]\n    end)\n\n    if not success then\n        self:notify('Invalid state', `{stateName} is not a HumanoidStateType`)\n\n        return\n    end\n    if humanoid then\n        humanoid:SetStateEnabled(state, enabled)\n    end\nend\n\nreturn {\n    {\n        action = 'sit',\n        description = 'Makes your character sit',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if humanoid then\n                humanoid.Sit = true\n            end\n        end,\n    },\n    {\n        action = 'nosit',\n        description = 'Stops your character from being able to sit',\n        run = function(self)\n            setHumanoidState(self, 'Seated', false)\n        end,\n    },\n    {\n        action = 'unnosit',\n        description = 'Lets your character sit again',\n        run = function(self)\n            setHumanoidState(self, 'Seated', true)\n        end,\n    },\n    {\n        action = 'enablestate',\n        description = 'Enables a humanoid state (example: Jumping)',\n        args = {\n            kind = 'string',\n            name = 'state name',\n        },\n        run = function(self, args)\n            setHumanoidState(self, args:nextValue(), true)\n        end,\n    },\n    {\n        action = 'disablestate',\n        description = 'Disables a humanoid state (example: Jumping)',\n        args = {\n            kind = 'string',\n            name = 'state name',\n        },\n        run = function(self, args)\n            setHumanoidState(self, args:nextValue(), false)\n        end,\n    },\n    {\n        action = 'lay|laydown',\n        description = 'Lays your character down',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n            local root = self.playerService:getRootPart()\n\n            if not (humanoid and root) then\n                return\n            end\n\n            humanoid.Sit = true\n\n            task.wait(0.1)\n\n            root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            root.CFrame = root.CFrame * CFrame.Angles(math.pi * 0.5, 0, 0)\n\n            for _, track in humanoid:GetPlayingAnimationTracks()do\n                track:Stop()\n            end\n        end,\n    },\n    {\n        action = 'jump',\n        description = 'Makes your character jump once',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if humanoid then\n                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n            end\n        end,\n    },\n    {\n        action = 'infjump|infinitejump',\n        description = 'Lets you jump again while in the air',\n        run = function(self)\n            startJumpLoop(self, 'infjump', true)\n        end,\n    },\n    {\n        action = 'uninfjump|uninfinitejump|noinfjump|noinfinitejump',\n        description = 'Disables infinite jump',\n        run = function(self)\n            stopJumpLoop(self, 'infjump')\n        end,\n    },\n    {\n        action = 'flyjump',\n        description = 'Makes you jump every time a jump is requested',\n        run = function(self)\n            startJumpLoop(self, 'flyjump', false)\n        end,\n    },\n    {\n        action = 'unflyjump|noflyjump',\n        description = 'Disables flyjump',\n        run = function(self)\n            stopJumpLoop(self, 'flyjump')\n        end,\n    },\n    {\n        action = 'nilchar',\n        description = 'Removes your character from the workspace (client side)',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if character then\n                character.Parent = nil\n            end\n        end,\n    },\n    {\n        action = 'unnilchar|nonilchar',\n        description = 'Puts your character back into the workspace',\n        run = function(self)\n            local character = self.localPlayer.Character\n\n            if character then\n                character.Parent = workspace\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/swin.luau" ] = "local function getSwimStates()\n    local states = {}\n\n    for _, state in Enum.HumanoidStateType:GetEnumItems()do\n        if state ~= Enum.HumanoidStateType.None and state ~= Enum.HumanoidStateType.Dead then\n            table.insert(states, state)\n        end\n    end\n\n    return states\nend\nlocal function stopSwim(self)\n    local garbage = self:collectGarbage('swim')\n\n    if not garbage then\n        return\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n    for _, state in garbage.states do\n        garbage.humanoid:SetStateEnabled(state, true)\n    end\n\n    workspace.Gravity = garbage.gravity\nend\nlocal function startSwim(self)\n    if self:hasGarbage('swim') then\n        self:notify('swim is already enabled')\n\n        return\n    end\n\n    local humanoid = self.playerService:getHumanoid()\n\n    if not humanoid then\n        self:notify('swim', 'your character is not loaded')\n\n        return\n    end\n\n    local garbage = self:createGarbage('swim')\n\n    garbage.humanoid = humanoid\n    garbage.gravity = workspace.Gravity\n    garbage.states = getSwimStates()\n    garbage.connections = {}\n    workspace.Gravity = 0\n\n    for _, state in garbage.states do\n        humanoid:SetStateEnabled(state, false)\n    end\n\n    humanoid:ChangeState(Enum.HumanoidStateType.Swimming)\n    table.insert(garbage.connections, self:connect(humanoid.Died, function()\n        stopSwim(self)\n    end))\n    table.insert(garbage.connections, self:connect(self.runService.Heartbeat, function(\n    )\n        local root = self.playerService:getRootPart()\n\n        if not root then\n            return\n        end\n\n        local moving = humanoid.MoveDirection ~= Vector3.zero or self.robloxServices.UserInputService:IsKeyDown(Enum.KeyCode.Space)\n\n        if not moving then\n            root.AssemblyLinearVelocity = Vector3.zero\n        end\n    end))\nend\n\nreturn {\n    {\n        action = 'swim',\n        description = 'Allows you to swim in the air',\n        run = function(self)\n            startSwim(self)\n        end,\n    },\n    {\n        action = 'unswim|noswim',\n        description = 'Stops you from swimming everywhere',\n        run = function(self)\n            stopSwim(self)\n        end,\n    },\n    {\n        action = 'toggleswim',\n        description = 'Toggles swimming',\n        run = function(self)\n            if self:hasGarbage('swim') then\n                stopSwim(self)\n            else\n                startSwim(self)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/toolextras.luau" ] = "local DEFAULT_REACH = 60\n\nlocal function copyTools(instance, backpack)\n    for _, child in instance:GetChildren()do\n        if child:IsA('Tool') or child:IsA('HopperBin') then\n            child:Clone().Parent = backpack\n        end\n\n        copyTools(child, backpack)\n    end\nend\nlocal function setDroppable(container)\n    if not container then\n        return\n    end\n\n    for _, child in container:GetChildren()do\n        if child:IsA('Tool') then\n            child.CanBeDropped = true\n        end\n    end\nend\nlocal function tryGrab(self, child)\n    local humanoid = self.playerService:getHumanoid()\n\n    if humanoid and child:IsA('BackpackItem') and child:FindFirstChild('Handle') then\n        humanoid:EquipTool(child)\n    end\nend\nlocal function stopGrabTools(self)\n    local garbage = self:collectGarbage('grabtools')\n\n    if garbage and garbage.connection then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function startGrabTools(self)\n    stopGrabTools(self)\n\n    local garbage = self:createGarbage('grabtools')\n\n    for _, child in workspace:GetChildren()do\n        tryGrab(self, child)\n    end\n\n    garbage.connection = self:connect(workspace.ChildAdded, function(child)\n        tryGrab(self, child)\n    end)\nend\nlocal function stopReach(self)\n    local garbage = self:collectGarbage('reach')\n\n    if not garbage then\n        return\n    end\n\n    for _, record in garbage.records do\n        local handle = record.handle\n        local box = handle:FindFirstChild('SelectionBoxCreated')\n\n        if box then\n            box:Destroy()\n        end\n\n        handle.Size = record.size\n        handle.Massless = record.massless\n        record.tool.GripPos = record.gripPos\n    end\nend\nlocal function startReach(self, handleSize)\n    stopReach(self)\n\n    local character = self.playerService:getCharacter()\n    local humanoid = self.playerService:getHumanoid()\n\n    if not (character and humanoid) then\n        self:notify('Reach', 'your character is not loaded')\n\n        return\n    end\n\n    local garbage = self:createGarbage('reach')\n\n    garbage.records = {}\n\n    for _, tool in character:GetDescendants()do\n        if not tool:IsA('Tool') then\n            continue\n        end\n\n        local handle = tool:FindFirstChild('Handle')\n\n        if not (handle and handle:IsA('BasePart')) then\n            continue\n        end\n\n        table.insert(garbage.records, {\n            tool = tool,\n            handle = handle,\n            size = handle.Size,\n            massless = handle.Massless,\n            gripPos = tool.GripPos,\n        })\n\n        local box = Instance.new('SelectionBox')\n\n        box.Name = 'SelectionBoxCreated'\n        box.Adornee = handle\n        box.Parent = handle\n        handle.Massless = true\n        handle.Size = handleSize\n        tool.GripPos = Vector3.zero\n    end\n\n    humanoid:UnequipTools()\nend\n\nreturn {\n    {\n        action = 'tools|gears',\n        description = 'Copies tools from ReplicatedStorage and Lighting',\n        run = function(self)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n            if not backpack then\n                self:notify('Tools', 'your backpack is not loaded')\n\n                return\n            end\n\n            copyTools(self.robloxServices.Lighting, backpack)\n            copyTools(self.robloxServices.ReplicatedStorage, backpack)\n            self:notify('Tools', 'Copied tools from ReplicatedStorage and Lighting')\n        end,\n    },\n    {\n        action = 'grabtools',\n        description = 'Automatically get tools that are dropped',\n        run = function(self)\n            startGrabTools(self)\n            self:notify('Grabtools', 'Picking up any dropped tools')\n        end,\n    },\n    {\n        action = 'ungrabtools|nograbtools',\n        description = 'Disables grabtools',\n        run = function(self)\n            stopGrabTools(self)\n            self:notify('Grabtools', 'Grabtools has been disabled')\n        end,\n    },\n    {\n        action = 'dupetools|clonetools',\n        description = 'Duplicates your inventory tools a set amount of times',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n            if not backpack then\n                self:notify('Dupetools', 'your backpack is not loaded')\n\n                return\n            end\n\n            local times = math.clamp(math.floor(args:nextValue() or 1), 1, 100)\n            local added = 0\n\n            for _, item in backpack:GetChildren()do\n                if item:IsA('Tool') or item:IsA('HopperBin') then\n                    for _ = 1, times do\n                        item:Clone().Parent = backpack\n\n                        added += 1\n                    end\n                end\n            end\n\n            self:notify('Dupetools', `added {added} tool(s)`)\n        end,\n    },\n    {\n        action = 'droppabletools',\n        description = 'Makes your tools droppable',\n        run = function(self)\n            setDroppable(self.playerService:getCharacter())\n            setDroppable(self.localPlayer:FindFirstChildOfClass('Backpack'))\n        end,\n    },\n    {\n        action = 'reach',\n        description = 'Increases the hitbox of your held tool',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local length = args and args:nextValue() or DEFAULT_REACH\n\n            startReach(self, Vector3.new(0.5, 0.5, length))\n        end,\n    },\n    {\n        action = 'boxreach',\n        description = 'Increases the hitbox of your held tool in a box shape',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local size = args and args:nextValue() or DEFAULT_REACH\n\n            startReach(self, Vector3.one * size)\n        end,\n    },\n    {\n        action = 'unreach|noreach|unboxreach',\n        description = 'Turns off reach',\n        run = function(self)\n            stopReach(self)\n        end,\n    },\n    {\n        action = 'grippos',\n        description = 'Changes your current tools grip position',\n        args = {\n            kind = 'vector3',\n        },\n        run = function(self, args)\n            local character = self.localPlayer.Character\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n            if not (character and backpack) then\n                return\n            end\n\n            local gripPos = args:nextValue()\n\n            for _, tool in character:GetChildren()do\n                if tool:IsA('Tool') then\n                    tool.Parent = backpack\n                    tool.GripPos = gripPos\n                    tool.Parent = character\n                end\n            end\n        end,\n    },\n    {\n        action = 'usetools',\n        description = 'Activates all tools in your backpack at the same time',\n        args = {\n            {\n                kind = 'number',\n                name = 'tools amount',\n                optional = true,\n            },\n            {\n                kind = 'number',\n                name = 'equip delay',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n            local character = self.playerService:getCharacter()\n\n            if not (backpack and character) then\n                return\n            end\n\n            local amount = args:nextValue() or 1\n            local delay = args:nextValue()\n\n            for _, tool in backpack:GetChildren()do\n                if not tool:IsA('Tool') then\n                    continue\n                end\n\n                tool.Parent = character\n\n                task.spawn(function()\n                    for _ = 1, amount do\n                        tool:Activate()\n\n                        if delay then\n                            task.wait(delay)\n                        end\n                    end\n\n                    tool.Parent = backpack\n                end)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/toolfilter.luau" ] = "local function getFilter(self)\n    local garbage = self:registerGarbage('removespecifictool')\n\n    garbage.connections = garbage.connections or {}\n\n    return garbage\nend\n\nreturn {\n    {\n        action = 'removespecifictool',\n        description = 'Keeps removing tools with the given name from your backpack',\n        args = {\n            kind = 'string',\n            name = 'tool name',\n        },\n        run = function(self, args)\n            local toolName = (args:nextValue() or ''):lower()\n            local filter = getFilter(self)\n\n            if filter.connections[toolName] then\n                return\n            end\n\n            filter.connections[toolName] = self:connect(self.runService.RenderStepped, function(\n            )\n                local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n                if not backpack then\n                    return\n                end\n\n                for _, tool in backpack:GetChildren()do\n                    if tool.Name:lower() == toolName then\n                        tool:Destroy()\n                    end\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unremovespecifictool',\n        description = 'Stops removing tools with the given name',\n        args = {\n            kind = 'string',\n            name = 'tool name',\n        },\n        run = function(self, args)\n            local toolName = (args:nextValue() or ''):lower()\n            local garbage = self:getGarbage('removespecifictool')\n            local connection = garbage and garbage.connections and garbage.connections[toolName]\n\n            if connection then\n                connection:Disconnect()\n\n                garbage.connections[toolName] = nil\n            end\n        end,\n    },\n    {\n        action = 'clearremovespecifictool',\n        description = 'Stops removing every tool that is being filtered',\n        run = function(self)\n            local garbage = self:collectGarbage('removespecifictool')\n\n            if not (garbage and garbage.connections) then\n                return\n            end\n\n            for _, connection in garbage.connections do\n                connection:Disconnect()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/tools.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function isTool(object)\n    return object:IsA('Tool') or object:IsA('HopperBin')\nend\nlocal function destroyTools(container)\n    if not container then\n        return\n    end\n\n    for _, object in container:GetDescendants()do\n        if isTool(object) then\n            object:Destroy()\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'notools|rtools|clrtools|removetools|deletetools|dtools',\n        description = 'Deletes every tool in your backpack and character',\n        run = function(self)\n            destroyTools(self.localPlayer:FindFirstChildOfClass('Backpack'))\n            destroyTools(self.localPlayer.Character)\n        end,\n    },\n    {\n        action = 'deleteselectedtool|dst',\n        description = 'Deletes the tools you are currently holding',\n        run = function(self)\n            destroyTools(self.localPlayer.Character)\n        end,\n    },\n    {\n        action = 'equiptools',\n        description = 'Equips every tool in your backpack',\n        run = function(self)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n            local character = self.localPlayer.Character\n\n            if not (backpack and character) then\n                return\n            end\n\n            for _, tool in backpack:GetChildren()do\n                if isTool(tool) then\n                    tool.Parent = character\n                end\n            end\n        end,\n    },\n    {\n        action = 'unequiptools',\n        description = 'Unequips all your tools',\n        run = function(self)\n            local humanoid = self.playerService:getHumanoid()\n\n            if humanoid then\n                humanoid:UnequipTools()\n            end\n        end,\n    },\n    {\n        action = 'droptools|droptool',\n        description = 'Drops every tool from your backpack to the workspace',\n        run = function(self)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n            local character = self.localPlayer.Character\n\n            if not (backpack and character) then\n                return\n            end\n\n            for _, tool in backpack:GetChildren()do\n                if isTool(tool) then\n                    tool.Parent = character\n                end\n            end\n\n            task.wait()\n\n            for _, tool in character:GetChildren()do\n                if isTool(tool) then\n                    tool.Parent = workspace\n                end\n            end\n        end,\n    },\n    {\n        action = 'copytools',\n        description = \"Copies the tools from a player's backpack into yours\",\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n            if not backpack then\n                return\n            end\n\n            for _, player in resolvePlayers(args:nextValue())do\n                local otherBackpack = player:FindFirstChildOfClass('Backpack')\n\n                if otherBackpack then\n                    for _, tool in otherBackpack:GetChildren()do\n                        if isTool(tool) then\n                            local copy = tool:Clone()\n\n                            copy.Parent = backpack\n                        end\n                    end\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/vehiclefly.luau" ] = "local flight = require('../../systems/flight')\nlocal DEFAULT_SPEED = 100\n\nreturn {\n    {\n        action = 'vehiclefly|vfly',\n        description = 'Makes you fly in a vehicle',\n        args = {\n            kind = 'number',\n            name = 'vehicle fly speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local speed = args:nextValue()\n\n            if speed then\n                self.privateEnv.vehicleFlySpeed = speed\n            end\n\n            flight.start(self, {\n                garbageName = 'fly',\n                kind = 'vehiclefly',\n                platformStand = false,\n                getSpeed = function()\n                    return self.privateEnv.vehicleFlySpeed or DEFAULT_SPEED\n                end,\n            })\n        end,\n    },\n    {\n        action = 'vehicleflyspeed|vflyspeed|vflysp',\n        description = 'Set vehicle fly speed',\n        args = {\n            kind = 'number',\n            name = 'vehicle fly speed',\n        },\n        run = function(self, args)\n            self.privateEnv.vehicleFlySpeed = args:nextValue() or DEFAULT_SPEED\n        end,\n    },\n    {\n        action = 'togglevfly',\n        description = 'Toggles vehicle fly',\n        args = {\n            kind = 'number',\n            name = 'vehicle fly speed',\n            optional = true,\n        },\n        run = function(self, args)\n            local garbage = self:getGarbage('fly')\n\n            if garbage and garbage.kind == 'vehiclefly' then\n                self:run('unvehiclefly')\n            else\n                self:run('vehiclefly', args)\n            end\n        end,\n    },\n    {\n        action = 'unvehiclefly|unvfly|novehiclefly|novfly',\n        description = 'Disables vehicle fly',\n        run = function(self)\n            flight.stop(self, 'fly')\n        end,\n    },\n}\n",
[ "src/commands/cmds/character/vehiclenoclip.luau" ] = "local function getVehicle(seat)\n    local current = seat\n\n    while current and not current:IsA('Model') do\n        current = current.Parent\n    end\n\n    return current\nend\nlocal function restoreVehicle(self)\n    local garbage = self:collectGarbage('vehiclenoclip')\n\n    if not garbage then\n        return\n    end\n\n    for _, part in garbage.parts do\n        part.CanCollide = true\n    end\nend\n\nreturn {\n    {\n        action = 'vehiclenoclip|vnoclip',\n        description = 'Turns off vehicle collision',\n        run = function(self)\n            restoreVehicle(self)\n\n            local humanoid = self.playerService:getHumanoid()\n            local seat = humanoid and humanoid.SeatPart\n            local vehicle = seat and getVehicle(seat)\n\n            if not vehicle then\n                self:notify('vehiclenoclip', 'you are not sitting in a vehicle')\n\n                return\n            end\n\n            local garbage = self:createGarbage('vehiclenoclip')\n\n            garbage.parts = {}\n\n            for _, part in vehicle:GetDescendants()do\n                if part:IsA('BasePart') and part.CanCollide then\n                    part.CanCollide = false\n\n                    table.insert(garbage.parts, part)\n                end\n            end\n        end,\n    },\n    {\n        action = 'togglevnoclip',\n        description = 'Toggles vehicle collision',\n        run = function(self)\n            self:run(if self:hasGarbage('vehiclenoclip')then'vehicleclip'else'vehiclenoclip')\n        end,\n    },\n    {\n        action = 'vehicleclip|vclip|unvnoclip',\n        description = 'Enables vehicle collision',\n        run = function(self)\n            restoreVehicle(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/boombox.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    {\n        action = 'muteboombox',\n        description = 'Mutes someones boombox',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                task.spawn(function()\n                    local containers = {\n                        player.Character,\n                        player:FindFirstChildOfClass('Backpack'),\n                    }\n\n                    for _, container in containers do\n                        for _, sound in container:GetDescendants()do\n                            if sound:IsA('Sound') then\n                                sound.Playing = false\n                            end\n                        end\n                    end\n                end)\n            end\n        end,\n    },\n    {\n        action = 'unmuteboombox',\n        description = 'Unmutes someones boombox',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                task.spawn(function()\n                    local character = player.Character\n\n                    if not character then\n                        return\n                    end\n\n                    for _, sound in character:GetDescendants()do\n                        if sound:IsA('Sound') and not sound.Playing then\n                            sound.Playing = true\n                        end\n                    end\n                end)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/bubblechat.luau" ] = "local rbxServices = require('../../../framework/services/rbxServices')\nlocal chatSender = require('../../systems/chatSender')\n\nlocal function setBubbleChat(enabled)\n    if chatSender.isLegacy() then\n        rbxServices.Chat.BubbleChatEnabled = enabled\n    else\n        rbxServices.TextChatService.BubbleChatConfiguration.Enabled = enabled\n    end\nend\n\nreturn {\n    {\n        action = 'bubblechat',\n        description = 'Enables bubble chat for your client (CLIENT)',\n        client = true,\n        run = function()\n            setBubbleChat(true)\n        end,\n    },\n    {\n        action = 'unbubblechat|nobubblechat',\n        description = 'Disables bubble chat for your client (CLIENT)',\n        client = true,\n        run = function()\n            setBubbleChat(false)\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/chat.luau" ] = "local chatSender = require('../../systems/chatSender')\nlocal resolvePlayers = require('../../systems/resolvePlayers')\nlocal SPAM = 'spam'\nlocal PM_PREFIX = 'pmspam:'\n\nlocal function say(self, title, message)\n    local success, reason = chatSender.send(message)\n\n    if not success then\n        self:notify(title, reason)\n    end\n\n    return success\nend\nlocal function stopSpam(self)\n    local garbage = self:collectGarbage(SPAM)\n\n    if garbage then\n        garbage.running = false\n    end\nend\nlocal function startSpam(self, message)\n    stopSpam(self)\n\n    local garbage = self:createGarbage(SPAM)\n\n    garbage.running = true\n\n    task.spawn(function()\n        while garbage.running do\n            if not say(self, 'Spam', message) then\n                garbage.running = false\n\n                break\n            end\n\n            task.wait(self.privateEnv.spamSpeed or 1)\n        end\n\n        if self:getGarbage(SPAM) == garbage then\n            self:collectGarbage(SPAM)\n        end\n    end)\nend\nlocal function pmName(player)\n    return PM_PREFIX .. player.Name\nend\nlocal function stopPmSpam(self, name)\n    local garbage = self:collectGarbage(name)\n\n    if garbage then\n        garbage.running = false\n    end\nend\nlocal function startPmSpam(self, player, message)\n    local name = pmName(player)\n\n    stopPmSpam(self, name)\n\n    local garbage = self:createGarbage(name)\n\n    garbage.running = true\n\n    task.spawn(function()\n        while garbage.running and player.Parent == self.players do\n            if not say(self, 'PM Spam', `/w {player.Name} {message}`) then\n                garbage.running = false\n\n                break\n            end\n\n            task.wait(self.privateEnv.spamSpeed or 1)\n        end\n\n        if self:getGarbage(name) == garbage then\n            self:collectGarbage(name)\n        end\n    end)\nend\nlocal function everyPmName(self)\n    local names = {}\n\n    for name in pairs(self.garbages)do\n        if name:sub(1, #PM_PREFIX) == PM_PREFIX then\n            table.insert(names, name)\n        end\n    end\n\n    return names\nend\nlocal function pmTargets(self, text)\n    local names = {}\n\n    for _, player in resolvePlayers(text)do\n        table.insert(names, pmName(player))\n    end\n\n    if not resolvePlayers.isSelector(text) then\n        local wanted = text:lower()\n\n        for _, name in everyPmName(self)do\n            local playerName = name:sub(#PM_PREFIX + 1):lower()\n\n            if playerName:sub(1, #wanted) == wanted then\n                table.insert(names, name)\n            end\n        end\n    end\n\n    return names\nend\n\nreturn {\n    {\n        action = 'chat|say',\n        description = 'Makes you chat a string (possible mute bypass)',\n        args = {\n            kind = 'string',\n            name = 'your message',\n        },\n        run = function(self, args)\n            local message = args:nextValue()\n\n            if not message then\n                return\n            end\n\n            say(self, 'Chat', message)\n        end,\n    },\n    {\n        action = 'spam',\n        description = 'Makes you spam the chat',\n        args = {\n            kind = 'string',\n            name = 'your message',\n        },\n        run = function(self, args)\n            local message = args:nextValue()\n\n            if not message then\n                return\n            end\n\n            startSpam(self, message)\n        end,\n    },\n    {\n        action = 'unspam|nospam',\n        description = 'Turns off spam',\n        run = function(self)\n            stopSpam(self)\n        end,\n    },\n    {\n        action = 'whisper|pm',\n        description = \n[[Makes you whisper a string to someone (possible mute bypass)]],\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'string',\n                name = 'your message',\n            },\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n            local message = args:nextValue()\n\n            if not message then\n                return\n            end\n\n            for _, player in targets do\n                if player ~= self.localPlayer then\n                    say(self, 'Whisper', `/w {player.Name} {message}`)\n                end\n            end\n        end,\n    },\n    {\n        action = 'pmspam',\n        description = 'Makes you spam a players whispers',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'string',\n                name = 'your message',\n            },\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n            local message = args:nextValue()\n\n            if not message then\n                return\n            end\n\n            for _, player in targets do\n                if player ~= self.localPlayer then\n                    startPmSpam(self, player, message)\n                end\n            end\n        end,\n    },\n    {\n        action = 'unpmspam|nopmspam',\n        description = 'Turns off pm spam (no player: turns it off for everyone)',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n            local names = if text then pmTargets(self, text)else everyPmName(self)\n\n            for _, name in names do\n                stopPmSpam(self, name)\n            end\n        end,\n    },\n    {\n        action = 'spamspeed|spamdelay',\n        description = 'How quickly you spam (default is 1)',\n        args = {\n            kind = 'number',\n            name = 'delay',\n            optional = true,\n        },\n        run = function(self, args)\n            self.privateEnv.spamSpeed = math.max(args:nextValue() or 1, 0)\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/chatwindow.luau" ] = "local rbxServices = require('../../../framework/services/rbxServices')\nlocal chatSender = require('../../systems/chatSender')\n\nlocal function setChatWindow(enabled)\n    if chatSender.isLegacy() then\n        rbxServices.StarterGui:SetCore('ChatActive', enabled)\n    else\n        rbxServices.TextChatService.ChatWindowConfiguration.Enabled = enabled\n    end\nend\nlocal function darkenChat()\n    local textChat = rbxServices.TextChatService\n    local settings = {\n        {\n            textChat:FindFirstChildOfClass('BubbleChatConfiguration'),\n            {\n                Enabled = true,\n                BackgroundColor3 = Color3.fromRGB(),\n                BackgroundTransparency = 0.3,\n                TailVisible = true,\n            },\n        },\n        {\n            textChat:FindFirstChildOfClass('ChatWindowConfiguration'),\n            {\n                Enabled = true,\n                BackgroundColor3 = Color3.fromRGB(),\n                BackgroundTransparency = 0.3,\n                TextColor3 = Color3.fromRGB(0xff, 0xff, 0xff),\n                TextStrokeColor3 = Color3.fromRGB(),\n                TextStrokeTransparency = 0.5,\n            },\n        },\n        {\n            textChat:FindFirstChildOfClass('ChatInputBarConfiguration'),\n            {\n                Enabled = true,\n                BackgroundColor3 = Color3.fromRGB(),\n                BackgroundTransparency = 0.5,\n                PlaceholderColor3 = Color3.fromRGB(0xff, 0xff, 0xff),\n                TextColor3 = Color3.fromRGB(0xff, 0xff, 0xff),\n                TextStrokeColor3 = Color3.fromRGB(),\n                TextStrokeTransparency = 0.5,\n            },\n        },\n    }\n\n    for _, pair in settings do\n        local configuration, properties = pair[1], pair[2]\n\n        if configuration then\n            for name, value in properties do\n                configuration[name] = value\n            end\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'chatwindow',\n        description = 'Enables the chat window for your client',\n        client = true,\n        run = function()\n            setChatWindow(true)\n        end,\n    },\n    {\n        action = 'unchatwindow|nochatwindow',\n        description = 'Disables the chat window for your client',\n        client = true,\n        run = function()\n            setChatWindow(false)\n        end,\n    },\n    {\n        action = 'darkchat',\n        description = 'Makes the chat window dark for your client',\n        client = true,\n        run = function(self)\n            if chatSender.isLegacy() then\n                self:notify('Dark Chat', 'darkchat only works with the TextChatService chat')\n\n                return\n            end\n\n            darkenChat()\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/init.luau" ] = "return {\n    require('./logs'),\n    require('./chat'),\n    require('./bubblechat'),\n    require('./chatwindow'),\n    require('./voicechat'),\n    require('./oof'),\n    require('./boombox'),\n}\n",
[ "src/commands/cmds/communication/logs.luau" ] = "local chatLogs = require('../../systems/chatLogs')\n\nreturn {\n    {\n        action = 'logs',\n        description = \n[[Opens the chat logs window with chat and join logs turned on]],\n        run = function(self)\n            chatLogs.setChat(true)\n            chatLogs.setJoin(true)\n            self.infiniteYield:chatLogs('chat')\n        end,\n    },\n    {\n        action = 'chatlogs|clogs',\n        description = 'Turns on chat logs and opens the chat tab',\n        run = function(self)\n            chatLogs.setChat(true)\n            self.infiniteYield:chatLogs('chat')\n        end,\n    },\n    {\n        action = 'joinlogs|jlogs',\n        description = 'Turns on join logs and opens the joins tab',\n        run = function(self)\n            chatLogs.setJoin(true)\n            self.infiniteYield:chatLogs('join')\n        end,\n    },\n    {\n        action = 'chatlogswebhook|logswebhook',\n        description = \n[[Set a discord webhook for chatlogs to go to (provide no url to disable this)]],\n        args = {\n            kind = 'string',\n            name = 'url',\n            optional = true,\n        },\n        run = function(self, args)\n            local url = args:nextValue()\n\n            if not url then\n                chatLogs.setWebhook(nil)\n                self:notify('Logs Webhook', 'webhook disabled')\n\n                return\n            end\n            if not self.executorEnv.httprequest then\n                self:notify('Incompatible Exploit', \n[[Your exploit does not support this command (missing request)]])\n\n                return\n            end\n\n            chatLogs.setWebhook(url)\n            self:notify('Logs Webhook', 'chat logs will be sent to the webhook')\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/oof.luau" ] = "return {\n    {\n        action = 'loopoof',\n        description = \n[[Makes every player's head play its sounds (oof) over and over]],\n        run = function(self)\n            if self:hasGarbage('oof') then\n                self:notify('oof loop is already enabled')\n\n                return\n            end\n\n            local garbage = self:createGarbage('oof')\n\n            garbage.running = true\n\n            task.spawn(function()\n                while garbage.running do\n                    for _, player in self.robloxServices.Players:GetPlayers()do\n                        local head = player.Character and player.Character:FindFirstChild('Head')\n\n                        if head then\n                            for _, sound in head:GetChildren()do\n                                if sound:IsA('Sound') then\n                                    sound.Playing = true\n                                end\n                            end\n                        end\n                    end\n\n                    task.wait(0.1)\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unloopoof',\n        description = 'Stops the oof loop',\n        run = function(self)\n            local garbage = self:collectGarbage('oof')\n\n            if garbage then\n                garbage.running = false\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/communication/voicechat.luau" ] = "local rbxServices = require('../../../framework/services/rbxServices')\nlocal resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function getVoiceInternal()\n    local success, service = pcall(function()\n        return rbxServices.VoiceChatInternal\n    end)\n\n    if success then\n        return service\n    end\n\n    return nil\nend\nlocal function withVoice(self, callback)\n    local voice = getVoiceInternal()\n\n    if not voice then\n        self:notify('Voice Chat', 'this game has no voice chat service')\n\n        return\n    end\n\n    local success, reason = pcall(callback, voice)\n\n    if not success then\n        self:notify('Voice Chat', tostring(reason))\n    end\nend\nlocal function stopListen(self)\n    local garbage = self:collectGarbage('listento')\n\n    if not garbage then\n        return false\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\n\n    rbxServices.SoundService:SetListener(Enum.ListenerType.Camera)\n\n    return true\nend\nlocal function listenTo(self, player)\n    local garbage = self:createGarbage('listento')\n\n    local function follow(character)\n        local root = character:WaitForChild('HumanoidRootPart', 10)\n\n        if root and self:getGarbage('listento') == garbage then\n            rbxServices.SoundService:SetListener(Enum.ListenerType.ObjectPosition, root)\n        end\n    end\n\n    garbage.connection = self:connect(player.CharacterAdded, function(\n        character\n    )\n        task.spawn(follow, character)\n    end)\n\n    if player.Character then\n        task.spawn(follow, player.Character)\n    end\nend\n\nreturn {\n    {\n        action = 'listento',\n        description = \n[[Listens to the area around a player. Can also eavesdrop with vc]],\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            stopListen(self)\n\n            if not text then\n                return\n            end\n\n            local target = resolvePlayers(text)[1]\n\n            if target then\n                listenTo(self, target)\n            end\n        end,\n    },\n    {\n        action = 'unlistento',\n        description = 'Disables listento',\n        run = function(self)\n            stopListen(self)\n        end,\n    },\n    {\n        action = 'muteallvoices|muteallvcs',\n        description = 'Mutes voice chat for all players',\n        run = function(self)\n            withVoice(self, function(voice)\n                voice:SubscribePauseAll(true)\n            end)\n        end,\n    },\n    {\n        action = 'unmuteallvoices|unmuteallvcs',\n        description = 'Unmutes voice chat for all players',\n        run = function(self)\n            withVoice(self, function(voice)\n                voice:SubscribePauseAll(false)\n            end)\n        end,\n    },\n    {\n        action = 'mutevc',\n        description = 'Mutes the voice chat of a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n\n            withVoice(self, function(voice)\n                for _, player in targets do\n                    if player ~= self.localPlayer then\n                        voice:SubscribePause(player.UserId, true)\n                    end\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unmutevc',\n        description = 'Unmutes the voice chat of a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n\n            withVoice(self, function(voice)\n                for _, player in targets do\n                    if player ~= self.localPlayer then\n                        voice:SubscribePause(player.UserId, false)\n                    end\n                end\n            end)\n        end,\n    },\n    {\n        action = 'phonebook|call',\n        description = \n[[Prompts the Roblox phonebook UI to let you call your friends. Needs voice chat enabled]],\n        run = function(self)\n            local success, canCall = pcall(function()\n                return rbxServices.SocialService:CanSendCallInviteAsync(self.localPlayer)\n            end)\n\n            if success and canCall then\n                rbxServices.SocialService:PromptPhoneBook(self.localPlayer, '')\n            else\n                self:notify('Phonebook', \"It seems you're not able to call anyone. Sorry!\")\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/alignmentkeys.luau" ] = "local MOVE_KEYS = {\n    [Enum.KeyCode.Comma] = -1,\n    [Enum.KeyCode.Period] = 1,\n}\n\nreturn {\n    {\n        action = 'alignmentkeys',\n        description = \n[[Enables the left and right alignment keys (comma and period)]],\n        run = function(self)\n            local garbage = self:createGarbage('alignmentkeys')\n\n            if not garbage then\n                return\n            end\n\n            garbage.akConn = self:connect(self.robloxServices.UserInputService.InputBegan, function(\n                inp,\n                processed\n            )\n                if processed then\n                    return\n                end\n\n                local direction = MOVE_KEYS[inp.KeyCode]\n\n                if not direction then\n                    return\n                end\n\n                local camera = self.playerService:getCamera()\n\n                if not camera then\n                    return\n                end\n\n                camera:PanUnits(direction)\n            end)\n            garbage.akEmotes = self.starterGui:GetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu)\n\n            self.starterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)\n        end,\n    },\n    {\n        action = 'unalignmentkeys|noalignmentkeys',\n        description = 'Disables the alignment keys',\n        run = function(self)\n            local garbage = self:collectGarbage('alignmentkeys')\n\n            if not garbage then\n                return\n            end\n            if garbage.akEmotes ~= nil then\n                self.starterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, garbage.akEmotes)\n            end\n\n            garbage.akConn:Disconnect()\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/allowrejoin.luau" ] = "return {\n    client = true,\n    action = 'allowrejoin|allowrj',\n    description = 'Changes if antiteleport allows you to rejoin or not',\n    args = {\n        kind = 'boolean',\n        name = 'allow',\n        optional = true,\n    },\n    run = function(self, args)\n        local allow = args:nextValue()\n\n        if allow == nil then\n            allow = not self.storage.settings:getValue('allowRejoin')\n        end\n\n        self.storage.settings:setValue('allowRejoin', allow)\n        self:notify('Client AntiTP', `Scripts now {allow and 'may' or 'may not'} make you rejoin the server`)\n    end,\n}\n",
[ "src/commands/cmds/general/antiafk.luau" ] = "return {\n    action = 'antiafk|antiidle',\n    description = 'Prevents the game from kicking you for being idle/afk',\n    run = function(self)\n        local getconnections = self.executorEnv.getconnections\n        local privateEnv = self.privateEnv\n\n        if privateEnv.enabledAntiAfk then\n            self:notify('anti AFK is already enabled')\n\n            return\n        end\n\n        privateEnv.enabledAntiAfk = true\n\n        if not getconnections then\n            self.localPlayer.Idled:Connect(function()\n                self.virtualUser:CaptureController()\n                self.virtualUser:ClickButton2(Vector2.new())\n            end)\n\n            return\n        end\n\n        for _, connection in getconnections(self.localPlayer.Idled)do\n            local disconnect = connection.Disconnect or connection.Disable\n\n            if disconnect then\n                disconnect(connection)\n            end\n        end\n\n        self:notify('anti AFK is now enabled')\n    end,\n}\n",
[ "src/commands/cmds/general/antigameplayedpaused.luau" ] = "return {\n    action = 'antigameplaypaused',\n    description = \n[[Clears the annoying box shown when a game is loading assets due to network lag]],\n}\n",
[ "src/commands/cmds/general/antigameplaypaused.luau" ] = "local NETWORK_PAUSE_NAME = 'CoreScripts/NetworkPause'\n\nlocal function stopAntiPause(self)\n    local garbage = self:collectGarbage('antigameplaypaused')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'antigameplaypaused',\n        description = \n[[Clears the annoying box shown when a game is loading assets due to network lag]],\n        run = function(self)\n            stopAntiPause(self)\n\n            local robloxGui = self.coreGui:FindFirstChild('RobloxGui')\n\n            if not robloxGui then\n                self:notify('Anti Pause', 'RobloxGui was not found')\n\n                return\n            end\n\n            local garbage = self:createGarbage('antigameplaypaused')\n\n            garbage.connection = self:connect(robloxGui.ChildAdded, function(\n                child\n            )\n                if child.Name == NETWORK_PAUSE_NAME then\n                    child:Destroy()\n                end\n            end)\n\n            local existing = robloxGui:FindFirstChild(NETWORK_PAUSE_NAME)\n\n            if existing then\n                existing:Destroy()\n            end\n        end,\n    },\n    {\n        action = 'unantigameplaypaused',\n        description = 'Disables antigameplaypaused',\n        run = function(self)\n            stopAntiPause(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/antilag.luau" ] = "local EDIT_PROPERTIES = {\n    BasePart = {\n        CastShadow = false,\n        Material = Enum.Material.Plastic,\n        Reflectance = 0,\n        BackSurface = Enum.SurfaceType.SmoothNoOutlines,\n        BottomSurface = Enum.SurfaceType.SmoothNoOutlines,\n        FrontSurface = Enum.SurfaceType.SmoothNoOutlines,\n        LeftSurface = Enum.SurfaceType.SmoothNoOutlines,\n        RightSurface = Enum.SurfaceType.SmoothNoOutlines,\n        TopSurface = Enum.SurfaceType.SmoothNoOutlines,\n    },\n    Decal = {\n        Transparency = 1,\n        Texture = '',\n    },\n    ParticleEmitter = {\n        Lifetime = NumberRange.new(0),\n    },\n    Trail = {\n        Lifetime = NumberRange.new(0),\n    },\n    PostEffect = {Enabled = false},\n}\nlocal DESTROY_OBJECTS = {\n    'ForceField',\n    'Sparkles',\n    'Smoke',\n    'Fire',\n    'Beam',\n}\n\nlocal function optimizeGame(self)\n    local terrain = workspace:FindFirstChildWhichIsA('Terrain')\n    local lighting = self.rbxServices.Lighting\n\n    terrain.WaterWaveSize = 0\n    terrain.WaterWaveSpeed = 0\n    terrain.WaterReflectance = 0\n    terrain.WaterTransparency = 1\n    lighting.GlobalShadows = false\n    lighting.FogEnd = 9e9\n    lighting.FogStart = 9e9\n    self.gameSettings.Rendering.QualityLevel = 1\n\n    for _, object in game:GetDescendants()do\n        for class, properties in EDIT_PROPERTIES do\n            if not object:IsA(class) then\n                continue\n            end\n\n            for property, value in properties do\n                object[property] = value\n            end\n        end\n    end\n\n    self:connect(workspace.DescendantAdded, function(object)\n        if object:IsA('BasePart') then\n            BasePart.CastShadow = false\n\n            return\n        end\n\n        for _, class in DESTROY_OBJECTS do\n            if not object:IsA(class) then\n                continue\n            end\n\n            task.defer(function()\n                object:Destroy()\n            end)\n        end\n    end)\nend\n\nreturn {\n    action = 'antilag|boostfps|lowgraphics',\n    description = 'Lowers game quality to boost FPS',\n    run = function(self)\n        if self.privateEnv.antiLagEnabled then\n            self:notify('anti lag is already enabled')\n\n            return\n        end\n\n        self.privateEnv.antiLagEnabled = true\n\n        optimizeGame(self)\n    end,\n}\n",
[ "src/commands/cmds/general/autoclick.luau" ] = "local MIN_WAIT = 0.01\n\nlocal function wait(seconds)\n    task.wait(math.max(seconds, MIN_WAIT))\nend\nlocal function stopLoop(self, name)\n    local garbage = self:collectGarbage(name)\n\n    if not garbage then\n        return false\n    end\n\n    garbage.running = false\n\n    return true\nend\nlocal function startLoop(self, name, clickDelay, releaseDelay, press)\n    stopLoop(self, name)\n\n    local garbage = self:createGarbage(name)\n\n    garbage.running = true\n\n    task.spawn(function()\n        while garbage.running do\n            press(true)\n            wait(releaseDelay)\n            press(false)\n            wait(clickDelay)\n        end\n    end)\nend\n\nreturn {\n    {\n        action = 'autoclick',\n        description = 'Automatically clicks your mouse with a set delay',\n        args = {\n            {\n                kind = 'number',\n                name = 'click delay',\n            },\n            {\n                kind = 'number',\n                name = 'release delay',\n            },\n        },\n        run = function(self, args)\n            local clickDelay = args:nextValue() or 0.1\n            local releaseDelay = args:nextValue() or 0.05\n            local virtualInput = self.robloxServices.VirtualInputManager\n\n            startLoop(self, 'autoclick', clickDelay, releaseDelay, function(\n                down\n            )\n                local mouse = self.playerService:getMouse()\n\n                virtualInput:SendMouseButtonEvent(mouse.X, mouse.Y, 0, down, game, 0)\n            end)\n        end,\n    },\n    {\n        action = 'unautoclick|noautoclick',\n        description = 'Turns off autoclick',\n        run = function(self)\n            stopLoop(self, 'autoclick')\n        end,\n    },\n    {\n        action = 'autokeypress|keypress',\n        description = 'Automatically presses a key with a set delay',\n        args = {\n            {\n                kind = 'keycode',\n            },\n            {\n                kind = 'number',\n                name = 'click delay',\n            },\n            {\n                kind = 'number',\n                name = 'release delay',\n            },\n        },\n        run = function(self, args)\n            local keyCode = args:nextValue()\n            local clickDelay = args:nextValue() or 0.1\n            local releaseDelay = args:nextValue() or 0.05\n            local virtualInput = self.robloxServices.VirtualInputManager\n\n            startLoop(self, 'autokeypress', clickDelay, releaseDelay, function(\n                down\n            )\n                virtualInput:SendKeyEvent(down, keyCode, false, game)\n            end)\n        end,\n    },\n    {\n        action = 'unautokeypress|noautokeypress|unkeypress|nokeypress',\n        description = 'Stops autokeypress',\n        run = function(self)\n            stopLoop(self, 'autokeypress')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/autorejoin.luau" ] = "return {\n    action = 'autorejoin|autorj',\n    description = \n[[Automatically rejoins the server if you get kicked/disconnected]],\n    run = function(self)\n        if self.privateEnv.autoRejoinConn then\n            self:notify('auto rejoin is already enabled')\n\n            return\n        end\n\n        self.privateEnv.autoRejoinConn = self:connect(self.guiService.ErrorMessageChanged, function(\n        )\n            self:run('rejoin')\n        end)\n    end,\n}\n",
[ "src/commands/cmds/general/breakloops.luau" ] = "return {\n    action = 'breakloops|break',\n    description = 'Stops any cmd loops (100^1^cmd)',\n    run = function(self)\n        self.loopService:stop()\n    end,\n}\n",
[ "src/commands/cmds/general/cancelteleport.luau" ] = "return {\n    action = 'cancelteleport|canceltp',\n    description = 'Cancels teleports in progress',\n    run = function(self)\n        self.playerService:cancelTween()\n        self.teleportService:TeleportCancel()\n    end,\n}\n",
[ "src/commands/cmds/general/clearerror.luau" ] = "return {\n    action = 'clearerror',\n    description = 'Clears the annoying box and blur when a game kicks you',\n    run = function(self)\n        self.guiService:ClearError()\n    end,\n}\n",
[ "src/commands/cmds/general/clientantikick.luau" ] = "return {\n    action = 'clientantikick|antikick',\n    description = 'Prevents localscripts from kicking you (CLIENT)',\n    run = function(self)\n        if self.privateEnv.clientAntiKick then\n            self:notify('Client Antikick', 'already active')\n\n            return\n        end\n\n        local hookmetamethod = self:expectExploit('hookmetamethod')\n        local getnamecallmethod = self:expectExploit('getnamecallmethod')\n\n        if not (hookmetamethod and getnamecallmethod) then\n            return\n        end\n\n        local localPlayer = self.localPlayer\n        local hookfunction = self.executorEnv.hookfunction\n\n        if hookfunction then\n            pcall(hookfunction, localPlayer.Kick, function() end)\n        end\n\n        local oldIndex\n\n        oldIndex = hookmetamethod(game, '__index', function(object, key)\n            if object == localPlayer and typeof(key) == 'string' and key:lower() == 'kick' then\n                error(\"Expected ':' not '.' calling member function Kick\", 2)\n            end\n\n            return oldIndex(object, key)\n        end)\n\n        local oldNamecall\n\n        oldNamecall = hookmetamethod(game, '__namecall', function(object, ...)\n            if object == localPlayer and getnamecallmethod():lower() == 'kick' then\n                return\n            end\n\n            return oldNamecall(object, ...)\n        end)\n        self.privateEnv.clientAntiKick = true\n\n        self:notify('Client Antikick', \n[[Client anti kick is now active (only effective on localscript kick)]])\n    end,\n}\n",
[ "src/commands/cmds/general/clientantiteleport.luau" ] = "return {\n    action = 'clientantiteleport|antiteleport',\n    description = 'Prevents localscripts from teleporting you (CLIENT)',\n    run = function(self)\n        if self.privateEnv.clientAntiTeleport then\n            self:notify('Client AntiTP', 'already active')\n\n            return\n        end\n\n        local hookmetamethod = self:expectExploit('hookmetamethod')\n        local getnamecallmethod = self:expectExploit('getnamecallmethod')\n\n        if not (hookmetamethod and getnamecallmethod) then\n            return\n        end\n\n        local teleportService = self.teleportService\n        local settings = self.storage.settings\n        local checkcaller = self.executorEnv.checkcaller\n        local oldIndex\n\n        oldIndex = hookmetamethod(game, '__index', function(object, key)\n            if object == teleportService and typeof(key) == 'string' then\n                if key:lower() == 'teleport' then\n                    error(\"Expected ':' not '.' calling member function Teleport\", 2)\n                elseif key == 'TeleportToPlaceInstance' then\n                    error(\n[[Expected ':' not '.' calling member function TeleportToPlaceInstance]], 2)\n                end\n            end\n\n            return oldIndex(object, key)\n        end)\n\n        local oldNamecall\n\n        oldNamecall = hookmetamethod(game, '__namecall', function(object, ...)\n            if object == teleportService and not checkcaller() then\n                local method = getnamecallmethod()\n\n                if method:lower() == 'teleport' or method == 'TeleportToPlaceInstance' then\n                    local placeId = ...\n                    local allowed = settings:getValue('allowRejoin') == true and placeId == game.PlaceId\n\n                    if not allowed then\n                        return\n                    end\n                end\n            end\n\n            return oldNamecall(object, ...)\n        end)\n        self.privateEnv.clientAntiTeleport = true\n\n        self:notify('Client AntiTP', \n[[Client anti teleport is now active (only effective on localscript teleport)]])\n    end,\n}\n",
[ "src/commands/cmds/general/console.luau" ] = "return {\n    action = 'console',\n    description = 'Opens the Roblox console',\n    run = function(self)\n        self.starterGui:SetCore('DevConsoleVisible', true)\n    end,\n}\n",
[ "src/commands/cmds/general/copyids.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    {\n        action = 'copyid|copyuserid',\n        description = \"Copies a player's user ID to your clipboard\",\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self.executorEnv.setclipboard(tostring(player.UserId))\n            end\n        end,\n    },\n    {\n        action = 'appearanceid|aid',\n        description = \"Notifies a player's character appearance ID\",\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self:notify('Appearance ID', tostring(player.CharacterAppearanceId))\n            end\n        end,\n    },\n    {\n        action = 'copyappearanceid|caid',\n        description = \"Copies a player's character appearance ID to your clipboard\",\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self.executorEnv.setclipboard(tostring(player.CharacterAppearanceId))\n            end\n        end,\n    },\n    {\n        action = 'copycreatorid|copycreator',\n        description = \"Copies the game creator's user ID to your clipboard\",\n        run = function(self)\n            local creatorId = game.CreatorId\n\n            if game.CreatorType == Enum.CreatorType.Group then\n                creatorId = self.groupService:GetGroupInfoAsync(creatorId).Owner.Id\n            elseif game.CreatorType ~= Enum.CreatorType.User then\n                return\n            end\n\n            self.executorEnv.setclipboard(tostring(creatorId))\n            self:notify('Copied ID', 'Copied creator ID to clipboard')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/creatorid.luau" ] = "local function getOwnerId(self)\n    local creatorId = game.CreatorId\n\n    if game.CreatorType ~= Enum.CreatorType.User then\n        creatorId = self.groupService:GetGroupInfoAsync(creatorId).Owner.Id\n    end\n\n    return creatorId\nend\n\nreturn {\n    {\n        action = 'creatorid',\n        description = 'Notify, or copies the creators ID to your clipboard',\n        args = {\n            kind = 'boolean',\n            name = 'copy',\n            optional = true,\n        },\n        run = function(self, args)\n            local ownerId = tostring(getOwnerId(self))\n\n            if args:nextValue() then\n                self.executorEnv.setclipboard(ownerId)\n            end\n\n            self:notify('Creator Id', `the OwnerId is '{ownerId}'`)\n        end,\n    },\n    {\n        client = true,\n        action = 'setcreatorid|setascreator',\n        description = 'Sets your userid to the creators ID',\n        run = function(self, args)\n            local ownerId = getOwnerId(self)\n\n            self.localPlayer.UserId = ownerId\n\n            self:notify('Set ID', `Set UserId to '{ownerId}'`)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/ctrllock.luau" ] = "local function setShiftKey(self, keyCode)\n    local scripts = self.localPlayer.PlayerScripts\n    local mouseLock = scripts.PlayerModule.CameraModule.MouseLockController\n    local boundKeys = mouseLock:FindFirstChild('BoundKeys')\n\n    if not boundKeys then\n        boundKeys = Instance.new('StringValue', mouseLock)\n        boundKeys.Name = 'BoundKeys'\n    end\n\n    boundKeys.Value = keyCode\nend\n\nreturn {\n    {\n        action = 'ctrllock',\n        description = 'Binds Shiftlock to LeftControl',\n        run = function(self)\n            setShiftKey(self, 'LeftControl')\n        end,\n    },\n    {\n        action = 'unctrllock',\n        description = 'Re-binds Shiftlock to LeftShift',\n        run = function(self)\n            setShiftKey(self, 'LeftShift')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/datalimit.luau" ] = "return {\n    action = 'datalimit',\n    description = 'Set outgoing KBPS limit',\n    args = {\n        kind = 'number',\n        name = 'KB per second',\n    },\n    run = function(self, args)\n        local value = args:nextValue()\n\n        self.networkClient:SetOutgoingKBPSLimit(value)\n    end,\n}\n",
[ "src/commands/cmds/general/debug.luau" ] = "local logger = require('../../../utils/logger')\n\nreturn {\n    action = 'debug',\n    description = 'Turns the debug logger on or off (default is on)',\n    args = {\n        kind = 'boolean',\n        name = 'enabled',\n        optional = true,\n    },\n    run = function(self, args)\n        local enabled = args:nextValue()\n\n        if enabled == nil then\n            enabled = true\n        end\n        if enabled then\n            logger:enable()\n        else\n            logger:disable()\n        end\n\n        self:notify('debug', tostring(enabled))\n    end,\n}\n",
[ "src/commands/cmds/general/discord.luau" ] = "return {\n    action = 'discord|support|help',\n    description = 'Invite to the Infinite Yield discord server.',\n    run = function(self)\n        self.executorEnv.setclipboard(self.config.links.discord)\n    end,\n}\n",
[ "src/commands/cmds/general/enable.luau" ] = "local coreGuiTypeNames = {\n    ['inventory'] = Enum.CoreGuiType.Backpack,\n    ['leaderboard'] = Enum.CoreGuiType.PlayerList,\n    ['emotes'] = Enum.CoreGuiType.EmotesMenu,\n}\n\nfor _, item in Enum.CoreGuiType:GetEnumItems()do\n    coreGuiTypeNames[string.lower(item.Name)] = item\nend\n\nlocal function setCoreGui(self, name, enabled)\n    if name == 'reset' then\n        self.starterGui:SetCore('ResetButtonCallback', enabled)\n\n        return\n    end\n\n    local coreGuiType = coreGuiTypeNames[name]\n\n    if coreGuiType then\n        self.starterGui:SetCoreGuiEnabled(coreGuiType, enabled)\n    end\nend\n\nreturn {\n    {\n        action = 'enable',\n        description = \n[[Enables a CoreGui element (inventory, leaderboard, chat, reset, emotes...)]],\n        args = {\n            kind = 'string',\n            name = 'gui name',\n        },\n        run = function(self, args)\n            setCoreGui(self, args:nextValue():lower(), true)\n        end,\n    },\n    {\n        action = 'disable',\n        description = \n[[Disables a CoreGui element (inventory, leaderboard, chat, reset, emotes...)]],\n        args = {\n            kind = 'string',\n            name = 'gui name',\n        },\n        run = function(self, args)\n            setCoreGui(self, args:nextValue():lower(), false)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/exit.luau" ] = "return {\n    action = 'exit|shutdown|leave',\n    description = 'Kills roblox process',\n    run = function()\n        game:shutdown()\n    end,\n}\n",
[ "src/commands/cmds/general/friends.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    {\n        action = 'friend',\n        description = 'Sends a friend request to a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self.localPlayer:RequestFriendship(player)\n            end\n        end,\n    },\n    {\n        action = 'unfriend',\n        description = 'Removes a player from your friends',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self.localPlayer:RevokeFriendship(player)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/gameinfo.luau" ] = "local copyArg = {\n    kind = 'boolean',\n    name = 'copy',\n    optional = true,\n}\n\nlocal function sendValue(self, value, copy)\n    if copy == false then\n        self.executorEnv.setclipboard(value)\n    else\n        self:notify(value)\n    end\nend\n\nreturn {\n    {\n        action = 'jobid',\n        description = 'Copies the games JobId to your clipboard, or notify',\n        args = copyArg,\n        run = function(self, args)\n            local value = `roblox://placeId={game.PlaceId}&gameInstanceId={game.JobId}`\n\n            sendValue(self, value, args:nextValue())\n        end,\n    },\n    {\n        action = 'placeid',\n        description = 'Copies the current place id to your clipboard, or notify',\n        args = copyArg,\n        run = function(self, args)\n            sendValue(self, tostring(game.PlaceId), args:nextValue())\n        end,\n    },\n    {\n        action = 'gameid',\n        description = 'Copies the current game id to your clipboard, or notify',\n        args = copyArg,\n        run = function(self, args)\n            sendValue(self, tostring(game.GameId), args:nextValue())\n        end,\n    },\n    {\n        action = 'copyplaceid',\n        description = 'Copies the current place id to your clipboard',\n        run = function(self)\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            setclipboard(tostring(game.PlaceId))\n            self:notify('Copied', 'place id copied to your clipboard')\n        end,\n    },\n    {\n        action = 'copygameid',\n        description = 'Copies the current game id to your clipboard',\n        run = function(self)\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            setclipboard(tostring(game.GameId))\n            self:notify('Copied', 'game id copied to your clipboard')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/gameteleport.luau" ] = "local stringPlaceId = tostring(game.PlaceId)\nlocal stringJobId = tostring(game.JobId)\n\nreturn {\n    {\n        action = 'gameteleport|gametp',\n        description = 'Joins a game by ID',\n        args = {\n            kind = 'number',\n            name = 'place id',\n            options = {stringPlaceId},\n        },\n        run = function(self, args)\n            self.teleportService:Teleport(args:nextValue())\n        end,\n    },\n    {\n        action = 'teleportjobid|tpjobid',\n        description = 'Joins a game by jobid',\n        args = {\n            {\n                kind = 'string',\n                name = 'job id',\n                options = {stringJobId},\n            },\n            {\n                kind = 'number',\n                name = 'place id',\n                options = {stringPlaceId},\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local jobId = args:nextValue() or game.JobId\n            local placeId = args:nextValue() or game.PlaceId\n\n            self.playerService:teleportToJobId(jobId, placeId)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/guidelete.luau" ] = "return {\n    {\n        platform = 'PC',\n        action = 'guidelete',\n        description = 'Enables backspace to delete GUI',\n    },\n    {\n        platform = 'PC',\n        action = 'unguidelete|noguidelete',\n        description = 'Disables guidelete',\n    },\n}\n",
[ "src/commands/cmds/general/guiscale.luau" ] = "local scaleConfig = require('../../../framework/settings').ui.scale\n\nreturn {\n    action = 'guiscale|uiscale',\n    description = \n[[Changes the size of the gui. [number] accepts decimals and whole numbers.]],\n    args = {\n        kind = 'number',\n        clamp = {\n            scaleConfig.minScale,\n            scaleConfig.maxScale,\n        },\n    },\n    run = function(self, args)\n        local scale = args:nextValue()\n\n        self.infiniteYield:setScale(scale)\n    end,\n}\n",
[ "src/commands/cmds/general/handlekill.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    {\n        action = 'handlekill|hkill',\n        description = 'Kills a player using tool damage (YOU NEED A TOOL) (TOOL)',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'radius',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local firetouchinterest = self:expectExploit('firetouchinterest')\n\n            if not firetouchinterest then\n                return\n            end\n\n            local character = self.playerService:getCharacter()\n            local tool = character and character:FindFirstChildWhichIsA('Tool')\n            local handle = tool and tool:FindFirstChild('Handle')\n\n            if not handle then\n                self:notify('Handle Kill', 'You need to hold a \"Tool\" that does damage on touch.')\n\n                return\n            end\n\n            local targets = resolvePlayers(args:nextValue())\n            local radius = args:nextValue() or math.huge\n            local previous = self:collectGarbage('handlekill')\n\n            if previous then\n                previous.running = false\n            end\n\n            local garbage = self:createGarbage('handlekill')\n\n            garbage.running = true\n\n            self:notify('Handle Kill', 'Started!')\n            task.spawn(function()\n                while garbage.running do\n                    task.wait()\n\n                    local currentCharacter = self.playerService:getCharacter()\n\n                    if not (currentCharacter and tool.Parent == currentCharacter) then\n                        break\n                    end\n\n                    local root = self.playerService:getRootPart()\n\n                    for _, target in targets do\n                        local targetCharacter = target ~= self.localPlayer and target.Character\n                        local humanoid = targetCharacter and targetCharacter:FindFirstChildWhichIsA('Humanoid')\n                        local targetRoot = targetCharacter and targetCharacter:FindFirstChild('HumanoidRootPart')\n\n                        if root and humanoid and targetRoot and humanoid.Health > 0 and (root.Position - targetRoot.Position).Magnitude <= radius then\n                            firetouchinterest(handle, targetRoot, 1)\n                            firetouchinterest(handle, targetRoot, 0)\n                        end\n                    end\n                end\n\n                garbage.running = false\n\n                self:notify('Handle Kill', 'Stopped!')\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/hideguis.luau" ] = "return {\n    {\n        action = 'hideguis',\n        description = 'Hides any GUIs in PlayerGui',\n    },\n    {\n        action = 'unhideguis',\n        description = 'Undoes hideguis',\n    },\n}\n",
[ "src/commands/cmds/general/hideiy.luau" ] = "local keyboardService = require('../../../framework/services/keyboardService')\n\nlocal function clearListener(self)\n    local garbage = self:collectGarbage('hideiy')\n\n    if garbage and garbage.connection then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function listenForShowKeys(self, interface)\n    clearListener(self)\n\n    local garbage = self:registerGarbage('hideiy')\n\n    garbage.connection = keyboardService:onBindingPressed('prefix', function()\n        if interface.mainFrame.Visible then\n            return\n        end\n\n        interface:showCommandBar()\n    end)\nend\nlocal function hideWindow(self)\n    local interface = self.infiniteYield\n\n    if not interface or not interface.mainFrame then\n        self:notify('IY', 'the main window is not created yet')\n\n        return\n    end\n    if not interface.mainFrame.Visible then\n        self:notify('IY', 'already hidden')\n\n        return\n    end\n\n    interface:hideWindow()\n    listenForShowKeys(self, interface)\n\n    local prefixName = keyboardService:getBindingName('prefix')\n\n    self:notify('IY', `hidden. Press {prefixName} or tap the IY button to type a command`)\nend\nlocal function showWindow(self)\n    clearListener(self)\n\n    local interface = self.infiniteYield\n\n    if interface then\n        interface:showWindow()\n    end\nend\n\nreturn {\n    {\n        action = 'hideiy|hideinterface',\n        description = 'Hides the main IY GUI',\n        run = function(self)\n            hideWindow(self)\n        end,\n    },\n    {\n        action = 'showiy|unhideiy|unhideinterface',\n        description = 'Shows IY again',\n        run = function(self)\n            showWindow(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/init.luau" ] = "return {\n    require('./discord'),\n    require('./console'),\n    require('./scripts'),\n    require('./serverinfo'),\n    require('./gameinfo'),\n    require('./creatorid'),\n    require('./rejoin'),\n    require('./autorejoin'),\n    require('./serverhop'),\n    require('./selfkick'),\n    require('./gameteleport'),\n    require('./antiafk'),\n    require('./datalimit'),\n    require('./replicationlag'),\n    require('./setfpscap'),\n    require('./removeads'),\n    require('./saveinstance'),\n    require('./clearerror'),\n    require('./antigameplaypaused'),\n    require('./clientantikick'),\n    require('./clientantiteleport'),\n    require('./allowrejoin'),\n    require('./cancelteleport'),\n    require('./volume'),\n    require('./antilag'),\n    require('./screen'),\n    require('./lastcommand'),\n    require('./notifyping'),\n    require('./render'),\n    require('./use2022materials'),\n    require('./alignmentkeys'),\n    require('./ctrllock'),\n    require('./exit'),\n    require('./breakloops'),\n    require('./notifyjobid'),\n    require('./copyids'),\n    require('./inviteprompt'),\n    require('./enable'),\n    require('./nilinstances'),\n    require('./mousesens'),\n    require('./friends'),\n    require('./respawn'),\n    require('./debug'),\n    require('./team'),\n    require('./handlekill'),\n    require('./autoclick'),\n    require('./watch'),\n    require('./keybinds'),\n    require('./promptrig'),\n}\n",
[ "src/commands/cmds/general/inviteprompt.luau" ] = "return {\n    action = 'inviteprompt',\n    description = 'Prompts the game invite window, so you can invite friends',\n    run = function(self)\n        local socialService = game:GetService('SocialService')\n        local ok, err = pcall(function()\n            socialService:PromptGameInvite(self.localPlayer)\n        end)\n\n        if not ok then\n            self:notify('Invite Prompt', 'could not open the invite prompt: ' .. tostring(err))\n        end\n    end,\n}\n",
[ "src/commands/cmds/general/keepiy.luau" ] = "local keepiy = require('../../systems/keepiy')\n\nreturn {\n    {\n        action = 'keepiy',\n        description = \n[[Runs IY again after you teleport, and keeps the interface open]],\n        run = function(self)\n            keepiy.enable(self)\n        end,\n    },\n    {\n        action = 'unkeepiy',\n        description = 'Turns keepiy off: IY stops running after you teleport',\n        run = function(self)\n            keepiy.disable(self)\n        end,\n    },\n    {\n        action = 'togglekeepiy',\n        description = 'Toggles keepiy',\n        run = function(self)\n            keepiy.toggle(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/keybinds.luau" ] = "return {\n    {\n        action = 'clickdelete',\n        description = 'Go to Settings > Keybinds > Add for click delete',\n        run = function(self)\n            local target = self.playerService:getMouse().Target\n            local character = self.playerService:getCharacter()\n\n            if not target then\n                self:notify('Click delete', 'nothing under the mouse')\n\n                return\n            end\n            if target:IsA('Terrain') then\n                self:notify('Click delete', 'terrain cannot be deleted')\n\n                return\n            end\n            if character and target:IsDescendantOf(character) then\n                self:notify('Click delete', 'that part belongs to your character')\n\n                return\n            end\n\n            local name = target:GetFullName()\n\n            target:Destroy()\n            self:notify('Click delete', `deleted {name}`)\n        end,\n    },\n    {\n        action = 'clickteleport',\n        description = 'Go to Settings > Keybinds > Add for click teleport',\n        run = function(self)\n            self:run('mousetp')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/lastcommand.luau" ] = "local argsManager = require('../../systems/argsManager')\n\nreturn {\n    action = 'lastcommand|lastcmd',\n    description = 'Executes the previous command used',\n    run = function(self)\n        local last = self.privateEnv.lastCommand\n\n        if not last then\n            self:notify('Last Command', 'no command was used yet')\n\n            return\n        end\n\n        self:run(last.name, argsManager.new(last.args), true)\n    end,\n}\n",
[ "src/commands/cmds/general/mousesens.luau" ] = "return {\n    action = 'mousesensitivity|ms',\n    description = 'Sets your mouse delta sensitivity',\n    args = {\n        kind = 'number',\n        name = 'sensitivity',\n    },\n    run = function(self, args)\n        self.robloxServices.UserInputService.MouseDeltaSensitivity = args:nextValue()\n    end,\n}\n",
[ "src/commands/cmds/general/nilinstances.luau" ] = "return {\n    action = 'clearnilinstances|nonilinstances|cni',\n    description = 'Destroys every nil instance (needs getnilinstances)',\n    run = function(self)\n        if not getnilinstances then\n            self:notify('Incompatible Exploit', \n[[Your exploit does not support this command (missing getnilinstances)]])\n\n            return\n        end\n\n        for _, object in getnilinstances()do\n            object:Destroy()\n        end\n    end,\n}\n",
[ "src/commands/cmds/general/noprompts.luau" ] = "return {\n    action = 'noprompts',\n    description = 'Prevents the game from showing you purchase/premium prompts',\n}\n",
[ "src/commands/cmds/general/notifyjobid.luau" ] = "return {\n    action = 'notifyjobid',\n    description = 'Notifies the JobId and PlaceId of the current server',\n    run = function(self)\n        self:notify('JobId / PlaceId', `{game.JobId} / {game.PlaceId}`)\n    end,\n}\n",
[ "src/commands/cmds/general/notifyping.luau" ] = "return {\n    action = 'notifyping|ping',\n    description = 'Notify yourself your ping',\n    run = function(self)\n        local ping = self.localPlayer:GetNetworkPing()\n\n        self:notify('Ping', `{math.round(ping * 1000)}ms`)\n    end,\n}\n",
[ "src/commands/cmds/general/promptrig.luau" ] = "local function promptRig(self, rigName)\n    local humanoid = self.playerService:getHumanoid()\n\n    if not humanoid then\n        self:notify('Rig', 'your character is not loaded')\n\n        return\n    end\n\n    local avatarEditor = self.robloxServices.AvatarEditorService\n\n    task.spawn(function()\n        avatarEditor:PromptSaveAvatar(humanoid.HumanoidDescription, Enum.HumanoidRigType[rigName])\n\n        local result = avatarEditor.PromptSaveAvatarCompleted:Wait()\n\n        if result == Enum.AvatarPromptResult.Success then\n            self:run('reset')\n        end\n    end)\nend\n\nreturn {\n    {\n        action = 'promptr6',\n        description = 'Prompts the game to switch your rig type to R6',\n        run = function(self)\n            promptRig(self, 'R6')\n        end,\n    },\n    {\n        action = 'promptr15',\n        description = 'Prompts the game to switch your rig type to R15',\n        run = function(self)\n            promptRig(self, 'R15')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/rejoin.luau" ] = "return {\n    action = 'rejoin|rj',\n    description = 'Makes you rejoin the game',\n    run = function(self)\n        self.playerService:teleportToJobId(game.JobId)\n    end,\n}\n",
[ "src/commands/cmds/general/removeads.luau" ] = "local function tryDelete(object)\n    if not object:IsA('PackageLink') then\n        return\n    end\n    if object.Parent:FindFirstChild('ADpart') then\n        object.Parent:Destroy()\n    end\n    if object.Parent:FindFirstChild('AdGuiAdornee') then\n        object.Parent.Parent:Destroy()\n    end\nend\n\nreturn {\n    action = 'removeads|adblock',\n    description = 'Automatically removes ad billboards',\n    run = function(self)\n        if self.privateEnv.adBlockConn then\n            return\n        end\n\n        for _, object in workspace:GetDescendants()do\n            tryDelete(object)\n        end\n\n        self.privateEnv.adBlockConn = self:connect(workspace.DescendantAdded, function(\n            object\n        )\n            task.defer(tryDelete, object)\n        end)\n    end,\n}\n",
[ "src/commands/cmds/general/removecommand.luau" ] = "return {\n    action = 'removecmd|deletecmd',\n    description = 'Removes a command until the script is reloaded',\n}\n",
[ "src/commands/cmds/general/render.luau" ] = "return {\n    {\n        action = 'norender',\n        description = \n[[Disable 3d Rendering to decrease the amount of CPU the client uses]],\n        run = function(self)\n            self.runService:Set3dRenderingEnabled(false)\n        end,\n    },\n    {\n        action = 'render',\n        description = 'Enable 3d Rendering',\n        run = function(self)\n            self.runService:Set3dRenderingEnabled(true)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/replicationlag.luau" ] = "return {\n    action = 'replicationlag|backtrack',\n    description = 'Set IncomingReplicationLag',\n    args = {\n        kind = 'number',\n    },\n    run = function(self, args)\n        self.gameNetworkSettings.IncomingReplicationLag = args:nextValue()\n    end,\n}\n",
[ "src/commands/cmds/general/respawn.luau" ] = "local function respawn(self)\n    local localPlayer = self.localPlayer\n    local character = localPlayer.Character\n\n    if not character then\n        return\n    end\n\n    local humanoid = character:FindFirstChildWhichIsA('Humanoid')\n\n    if humanoid then\n        humanoid:ChangeState(Enum.HumanoidStateType.Dead)\n    end\n\n    character:ClearAllChildren()\n\n    local fakeCharacter = Instance.new('Model')\n\n    fakeCharacter.Parent = workspace\n\n    task.wait()\n\n    localPlayer.Character = fakeCharacter\n\n    task.wait()\n\n    localPlayer.Character = character\n\n    fakeCharacter:Destroy()\nend\n\nreturn {\n    {\n        action = 'respawn',\n        description = 'Respawns your character in place (client side)',\n        run = function(self)\n            respawn(self)\n        end,\n    },\n    {\n        action = 'refresh|re',\n        description = 'Respawns your character and puts you back where you were',\n        run = function(self)\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            local localPlayer = self.localPlayer\n            local position = root.CFrame\n            local cameraCFrame = workspace.CurrentCamera.CFrame\n\n            respawn(self)\n            task.spawn(function()\n                local newCharacter = localPlayer.CharacterAdded:Wait()\n                local newRoot = newCharacter:WaitForChild('HumanoidRootPart', 10)\n\n                if not newRoot then\n                    return\n                end\n\n                newRoot.CFrame = position\n                workspace.CurrentCamera.CFrame = cameraCFrame\n            end)\n        end,\n    },\n    {\n        action = 'reset',\n        description = 'Resets your character',\n        run = function(self)\n            self.playerService:resetCharacter()\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/saveinstance.luau" ] = "return {\n    {\n        action = 'saveinstance|savegame|saveplace|savep',\n        description = 'Uses saveinstance to save the game',\n        run = function(self)\n            local saveinstance = self:expectExploit('saveinstance')\n\n            if not saveinstance then\n                return\n            end\n\n            self:notify('Saveinstance', 'saving the game, this can take a while')\n            task.spawn(function()\n                local ok, err = pcall(saveinstance)\n\n                if ok then\n                    self:notify('Saveinstance', 'saved')\n                else\n                    self:notify('Saveinstance', `failed: {tostring(err)}`)\n                end\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/screen.luau" ] = "return {\n    {\n        action = 'record|rec',\n        description = 'Starts Roblox recorder',\n        run = function(self)\n            self.coreGui:ToggleRecording()\n        end,\n    },\n    {\n        action = 'screenshot|scrnshot',\n        description = 'Takes a screenshot',\n        run = function(self)\n            self.coreGui:TakeScreenshot()\n        end,\n    },\n    {\n        action = 'togglefullscreen|togglefs',\n        description = 'Toggles fullscreen',\n        run = function(self)\n            self.guiService:ToggleFullscreen()\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/scripts.luau" ] = "local SLOW_LOAD = 3\nlocal loading = {}\n\nlocal function fetchScript(self, label, path, chunkName, ...)\n    if loading[path] then\n        self:notify(label, 'is already loading')\n        return\n    end\n\n    loading[path] = true\n    self:notify(label, 'started loading')\n\n    local finished = false\n    local arguments = table.pack(...)\n\n    task.delay(SLOW_LOAD, function()\n        if not finished then\n            self:notify(label, 'is taking a while to load, still loading...')\n        end\n    end)\n\n    local trace\n    local success, result = xpcall(function()\n        local chunk, err = self.fetchService.load(path, chunkName)\n        assert(type(chunk) == 'function', err or ('No executable source for ' .. path))\n        return chunk(table.unpack(arguments, 1, arguments.n))\n    end, function(err)\n        trace = debug.traceback(tostring(err), 2)\n        return err\n    end)\n\n    finished = true\n    loading[path] = nil\n\n    if not success then\n        if type(self.reportError) == 'function' then\n            self:reportError(label, result, trace)\n        else\n            self:notify(label, 'failed: ' .. tostring(result))\n        end\n        return\n    end\n\n    self:notify(label, 'finished loading')\n    return result\nend\nlocal function oldConsole(self)\n    fetchScript(self, 'Old Console', 'backups/oldconsole.luau', 'iy/oldconsole')\nend\nlocal function dexExplorer(self, byMoon)\n    if byMoon == true then\n        fetchScript(self, 'Dex Explorer', 'backups/explorer.luau', 'iy/explorer')\n    else\n        fetchScript(self, 'Dex Explorer', 'backups/dexPlusPlus.luau', 'iy/dexPlusPlus')\n    end\nend\nlocal function emoteMenu(self, args)\n    local keycode = args:nextValue()\n    local notifyEnabled = args:nextValue()\n\n    fetchScript(self, 'Emote Menu', 'backups/emotes/main.luau', 'iy/7yd7/emotes.luau', {\n        notifyFunction = function(options)\n            if notifyEnabled ~= false then\n                self:notify(options.Title or 'Emote Menu', options.Content or '')\n            end\n        end,\n        isMobile = self.isMobile,\n        keycode = keycode,\n    })\nend\nlocal function cobaltSpy(self)\n    fetchScript(self, 'Cobalt', 'backups/cobalt.luau', 'iy/cobalt')\nend\nlocal function remoteSpy(self)\n    fetchScript(self, 'Remote Spy', 'backups/remotespy/main.luau', 'iy/remotespy')\nend\nlocal function audioLogger(self)\n    fetchScript(self, 'Audio Logger', 'backups/audiologger.luau', 'iy/audiologger')\nend\n\nreturn {\n    {\n        action = 'oldconsole',\n        description = 'Loads an old-themed Roblox console',\n        run = function(self)\n            task.spawn(oldConsole, self)\n        end,\n    },\n    {\n        action = 'explorer|dex',\n        description = 'Opens the dex Explorer',\n        args = {\n            name = 'load dex by moon',\n            kind = 'boolean',\n            optional = true,\n        },\n        run = function(self, args)\n            task.spawn(dexExplorer, self, args:nextValue())\n        end,\n    },\n    {\n        action = 'emotemenu|7yd7',\n        description = 'Opens animations/emotes menu By 7yd7',\n        run = function(self, args)\n            task.spawn(emoteMenu, self, args)\n        end,\n        args = {\n            {\n                kind = 'keycode',\n                name = 'open menu',\n                optional = true,\n            },\n            {\n                kind = 'boolean',\n                name = 'notify',\n                optional = true,\n            },\n        },\n    },\n    {\n        action = 'cobalt|remotespy|rspy|cspy',\n        description = \n[[Opens Cobalt to intercept incoming and outgoing network traffic]],\n        run = function(self)\n            task.spawn(cobaltSpy, self)\n        end,\n    },\n    {\n        action = 'simplespy|simplespy|sspy',\n        description = \n[[Opens Simple Spy V3 to intercept remote calls from the client to the server]],\n        run = function(self)\n            task.spawn(remoteSpy, self)\n        end,\n    },\n    {\n        action = 'audiologger|alogger',\n        description = 'Opens Edges audio logger',\n        run = function(self)\n            task.spawn(audioLogger, self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/selfkick.luau" ] = "return {\n    action = 'selfkick|kickmyself',\n    description = 'Kick your self from the server',\n    args = {\n        kind = 'string',\n        name = 'kick message',\n        optional = true,\n    },\n    run = function(self, args)\n        local msg = args:nextValue()\n\n        self.localPlayer:Kick(msg)\n    end,\n}\n",
[ "src/commands/cmds/general/serverhop.luau" ] = "local MAX_PAGES = 3\n\nlocal function fetchPage(request, placeId, cursor)\n    local url = `https://games.roblox.com/v1/games/{placeId}/servers/Public?sortOrder=Asc&limit=100`\n\n    if cursor then\n        url = url .. '&cursor=' .. cursor\n    end\n\n    local response = request({\n        Url = url,\n        Method = 'GET',\n    })\n\n    return game:GetService('HttpService'):JSONDecode(response.Body)\nend\n\nreturn {\n    {\n        action = 'serverhop|shop',\n        description = 'Teleports you to a different server',\n        run = function(self)\n            local request = self:expectExploit('httprequest')\n\n            if not request then\n                return\n            end\n\n            self:notify('Serverhop', 'looking for a server with free space...')\n            task.spawn(function()\n                local found = {}\n                local cursor = nil\n\n                for _ = 1, MAX_PAGES do\n                    local ok, page = pcall(fetchPage, request, game.PlaceId, cursor)\n\n                    if not ok or type(page) ~= 'table' then\n                        break\n                    end\n\n                    for _, server in page.data or {}do\n                        if server.id ~= game.JobId and server.playing < server.maxPlayers then\n                            table.insert(found, server.id)\n                        end\n                    end\n\n                    cursor = page.nextPageCursor\n\n                    if not cursor then\n                        break\n                    end\n                end\n\n                if #found == 0 then\n                    self:notify('Serverhop', 'no other server with free space was found')\n\n                    return\n                end\n\n                self.playerService:teleportToJobId(found[math.random(1, #found)])\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/serverinfo.luau" ] = "return {\n    action = 'serverinfo|info|sinfo',\n    description = 'Gives you info about the server',\n    run = function(self)\n        self.infiniteYield:createInfoMenu()\n    end,\n}\n",
[ "src/commands/cmds/general/setfpscap.luau" ] = "return {\n    action = 'setfpscap|fpscap|maxfps',\n    description = 'limits your FPS',\n    args = {\n        kind = 'number',\n        min = 1,\n        max = 10000,\n    },\n    run = function(self, args)\n        local cap = args:nextValue()\n\n        self.executorEnv.setfpscap(cap)\n    end,\n}\n",
[ "src/commands/cmds/general/showguis.luau" ] = "local function unbind(self, tag)\n    local garbage = self:collectGarbage(tag)\n\n    if not garbage then\n        return\n    end\n\n    for object, originalValue in garbage do\n        object.Visible = originalValue\n    end\n\n    local binded = self:registerGarbage('bindedHideGuis')\n\n    binded[tag] = nil\nend\nlocal function bind(self, tag, value)\n    local binded = self:registerGarbage('bindedHideGuis')\n\n    for key, _ in binded do\n        unbind(self, key)\n    end\n\n    binded[tag] = true\n\n    local garbage = self:createGarbage(tag)\n    local playerGui = self.localPlayer.PlayerGui\n\n    for _, object in playerGui:GetDescendants()do\n        if object:IsA('GuiObject') and object.Visible ~= value then\n            local original = object.Visible\n\n            object.Visible = value\n            garbage[object] = original\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'showguis',\n        description = 'Shows any invisible GUIs',\n        run = function(self)\n            bind(self, 'visibleGuiObjects', true)\n        end,\n    },\n    {\n        action = 'unshowguis',\n        description = 'Undoes showguis',\n        run = function(self)\n            unbind(self, 'visibleGuiObjects')\n        end,\n    },\n    {\n        action = 'hideguis',\n        description = 'Hides any GUIs in PlayerGui',\n        run = function(self)\n            bind(self, 'invisibleGuiObjects', false)\n        end,\n    },\n    {\n        action = 'unhideguis',\n        description = 'Undoes hideguis',\n        run = function(self)\n            unbind(self, 'invisibleGuiObjects')\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/showprompts.luau" ] = "return {\n    {\n        action = 'noprompts|nopurchaseprompts',\n        description = 'Prevents the game from showing you purchase/premium prompts',\n        run = function(self)\n            self.coreGui.PurchasePromptApp.Enabled = false\n        end,\n    },\n    {\n        action = 'showprompts|showpurchaseprompts',\n        description = 'Allows the game to show purchase/premium prompts again',\n        run = function(self)\n            self.coreGui.PurchasePromptApp.Enabled = true\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/team.luau" ] = "return {\n    {\n        action = 'team',\n        description = 'Changes your team. Sometimes fools localscripts. (CLIENT)',\n        args = {\n            kind = 'team',\n        },\n        run = function(self, args)\n            local teamName = args:nextValue()\n            local team = self.robloxServices.Teams:FindFirstChild(teamName)\n\n            if not team then\n                self:notify('Invalid Team', tostring(teamName) .. ' is not a valid team')\n\n                return\n            end\n\n            local root = self.playerService:getRootPart()\n            local firetouchinterest = self.executorEnv.firetouchinterest\n\n            if root and firetouchinterest then\n                for _, object in workspace:GetDescendants()do\n                    if object:IsA('SpawnLocation') and object.BrickColor == team.TeamColor and object.AllowTeamChangeOnTouch then\n                        firetouchinterest(object, root, 0)\n                        firetouchinterest(object, root, 1)\n\n                        break\n                    end\n                end\n            else\n                self.localPlayer.Team = team\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/togglegui.luau" ] = "local coreGuiTypeNames = {\n    ['inventory'] = Enum.CoreGuiType.Backpack,\n    ['leaderboard'] = Enum.CoreGuiType.PlayerList,\n    ['emotes'] = Enum.CoreGuiType.EmotesMenu,\n}\n\nfor _, item in Enum.CoreGuiType:GetEnumItems()do\n    coreGuiTypeNames[string.lower(item.Name)] = item\nend\n\nreturn {\n    action = 'togglecoregui|togglegui|tcgui',\n    description = 'Toggles visibility of coregui items',\n    args = {\n        {\n            kind = 'string',\n            options = 'inventory|playerlist|chat|reset|emotes|all',\n            name = 'gui name',\n        },\n        {\n            kind = 'boolean',\n            name = 'enabled',\n        },\n    },\n    run = function(self, args)\n        local input = args:nextValue()\n        local enabled = args:nextValue()\n\n        if input == 'reset' then\n            self.starterGui:SetCore('ResetButtonCallback', enabled)\n\n            return\n        end\n\n        local coreGuiType = coreGuiTypeNames[input]\n\n        if coreGuiType then\n            self.starterGui:SetCoreGuiEnabled(coreGuiType, enabled)\n        end\n    end,\n}\n",
[ "src/commands/cmds/general/use2022materials.luau" ] = "return {\n    {\n        action = 'use2022materials|2022materials',\n        description = 'Enables 2022 material textures',\n        run = function(self)\n            self.rbxServices.MaterialService.Use2022Materials = true\n        end,\n    },\n    {\n        action = 'unuse2022materials|un2022materials',\n        description = 'Disables 2022 material textures',\n        run = function(self)\n            self.rbxServices.MaterialService.Use2022Materials = false\n        end,\n    },\n}\n",
[ "src/commands/cmds/general/volume.luau" ] = "return {\n    action = 'volume|vol',\n    description = 'Adjusts your game volume on a scale of 0 to 10',\n    args = {\n        kind = 'number',\n        clamp = {0, 10},\n    },\n    run = function(self, args)\n        local volume = 1 / args:nextValue()\n\n        self.userGameSettings.MasterVolume = volume\n    end,\n}\n",
[ "src/commands/cmds/general/watch.luau" ] = "local robloxServices = require('../../../framework/services/rbxServices')\nlocal Players = robloxServices.Players\nlocal TITLE_ROLE = 'Rolewatch'\nlocal TITLE_STAFF = 'Staffwatch'\nlocal STAFF_WORDS = {\n    'admin',\n    'mod',\n    'staff',\n    'owner',\n    'dev',\n    'support',\n    'manager',\n}\n\nlocal function roleOf(player, groupId)\n    local ok, role = pcall(function()\n        return player:GetRoleInGroup(groupId)\n    end)\n\n    return if ok then role else nil\nend\nlocal function stopWatch(self, name)\n    local garbage = self:collectGarbage(name)\n\n    if not garbage then\n        return false\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\n\n    return true\nend\nlocal function checkRolePlayer(self, garbage, player)\n    if player == self.localPlayer then\n        return\n    end\n\n    local role = roleOf(player, garbage.groupId)\n\n    if not role or role:lower() ~= garbage.roleName then\n        return\n    end\n\n    self:notify(TITLE_ROLE, `{player.Name} has the role '{role}'`)\n\n    if self.privateEnv.rolewatchLeave then\n        self.localPlayer:Kick('rolewatch: a watched player joined')\n    end\nend\nlocal function isStaff(player)\n    if game.CreatorType ~= Enum.CreatorType.Group then\n        return player.UserId == game.CreatorId\n    end\n\n    local role = roleOf(player, game.CreatorId)\n\n    if not role or role == 'Guest' then\n        return false\n    end\n\n    local lowered = role:lower()\n\n    for _, word in STAFF_WORDS do\n        if lowered:find(word, 1, true) then\n            return true\n        end\n    end\n\n    return false\nend\n\nreturn {\n    {\n        action = 'rolewatch',\n        description = 'Notify if someone from a watched group joins the server',\n        args = {\n            {\n                kind = 'number',\n                name = 'group id',\n            },\n            {\n                kind = 'string',\n                name = 'role name',\n            },\n        },\n        run = function(self, args)\n            local groupId = args:nextValue()\n            local roleName = args:nextValue()\n\n            stopWatch(self, 'rolewatch')\n\n            local garbage = self:createGarbage('rolewatch')\n\n            garbage.groupId = groupId\n            garbage.roleName = roleName:lower()\n\n            for _, player in Players:GetPlayers()do\n                checkRolePlayer(self, garbage, player)\n            end\n\n            garbage.connection = self:connect(Players.PlayerAdded, function(\n                player\n            )\n                checkRolePlayer(self, garbage, player)\n            end)\n\n            self:notify(TITLE_ROLE, `watching for the role '{roleName}' in group {groupId}`)\n        end,\n    },\n    {\n        action = 'rolewatchstop|unrolewatch',\n        description = 'Disable Rolewatch',\n        run = function(self)\n            if stopWatch(self, 'rolewatch') then\n                self:notify(TITLE_ROLE, 'disabled')\n            end\n        end,\n    },\n    {\n        action = 'rolewatchleave',\n        description = \n[[Toggle if you should leave the game if someone from a watched group joins the server]],\n        run = function(self)\n            local leave = not self.privateEnv.rolewatchLeave\n\n            self.privateEnv.rolewatchLeave = leave\n\n            self:notify(TITLE_ROLE, if leave then'you will leave when a watched player joins'else'you will stay when a watched player joins')\n        end,\n    },\n    {\n        action = 'staffwatch',\n        description = 'Notify if a staff member of the game joins the server',\n        run = function(self)\n            stopWatch(self, 'staffwatch')\n\n            local garbage = self:createGarbage('staffwatch')\n\n            local function check(player)\n                if player ~= self.localPlayer and isStaff(player) then\n                    self:notify(TITLE_STAFF, `staff member {player.Name} is in the server`)\n                end\n            end\n\n            for _, player in Players:GetPlayers()do\n                check(player)\n            end\n\n            garbage.connection = self:connect(Players.PlayerAdded, check)\n\n            self:notify(TITLE_STAFF, 'watching for staff')\n        end,\n    },\n    {\n        action = 'unstaffwatch',\n        description = 'Disable Staffwatch',\n        run = function(self)\n            if stopWatch(self, 'staffwatch') then\n                self:notify(TITLE_STAFF, 'disabled')\n            end\n        end,\n    },\n    {\n        action = 'findfriendgroups',\n        description = 'Notifies you if any players are friends with each other',\n        run = function(self)\n            local list = Players:GetPlayers()\n            local pairsFound = {}\n\n            for i = 1, #list do\n                for j = i + 1, #list do\n                    local first, second = list[i], list[j]\n                    local ok, friends = pcall(function()\n                        return first:IsFriendsWith(second.UserId)\n                    end)\n\n                    if ok and friends then\n                        table.insert(pairsFound, `{first.Name} & {second.Name}`)\n                    end\n                end\n            end\n\n            if #pairsFound == 0 then\n                self:notify('Friend groups', 'no friends were found between the players in this server')\n            else\n                self:notify('Friend groups', table.concat(pairsFound, ', '))\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/interface/dialog.luau" ] = "local MAX_BUTTONS = 3\n\nlocal function splitButton(text)\n    local label, command = text:match('^%s*(.-)%s*>%s*(.-)%s*$')\n\n    if not label then\n        return text:match('^%s*(.-)%s*$'), nil\n    end\n    if command == '' then\n        command = nil\n    end\n\n    return label, command\nend\n\nreturn {\n    action = 'dialog',\n    description = \n[[Shows a dialog in the notifications with up to three buttons. \"Label>command\" runs a command when the button is tapped]],\n    args = {\n        {\n            kind = 'string',\n            name = 'title',\n        },\n        {\n            kind = 'string',\n            name = 'message',\n        },\n        {\n            kind = 'string',\n            name = 'button 1',\n        },\n        {\n            kind = 'string',\n            name = 'button 2',\n            optional = true,\n        },\n        {\n            kind = 'string',\n            name = 'button 3',\n            optional = true,\n        },\n    },\n    run = function(self, args)\n        local title = args:nextValue()\n        local message = args:nextValue()\n        local choices = {}\n\n        for index = 1, MAX_BUTTONS do\n            local text = args:nextValue()\n\n            if text == nil then\n                break\n            end\n\n            local label, command = splitButton(text)\n\n            if label == '' then\n                self:notify('Dialog', `button {index} needs a label`)\n\n                return\n            end\n\n            local onTap = nil\n\n            if command then\n                local commandRunner = require('../../systems/commandRunner')\n                local valid, reason = commandRunner.checkText(command)\n\n                if not valid then\n                    self:notify('Dialog', `button \"{label}\": {reason}`)\n\n                    return\n                end\n\n                onTap = function()\n                    local success, failure = commandRunner.runText(command)\n\n                    if not success then\n                        self:notify('Dialog', failure or 'the command did not run')\n                    end\n                end\n            end\n\n            table.insert(choices, {\n                text = label,\n                primary = index == 1,\n                onTap = onTap,\n            })\n        end\n\n        self:ask(title, message, choices)\n    end,\n}\n",
[ "src/commands/cmds/interface/guidelete.luau" ] = "return {\n    {\n        platform = 'PC',\n        action = 'guidelete',\n        description = 'Enables backspace to delete GUI',\n    },\n    {\n        platform = 'PC',\n        action = 'unguidelete|noguidelete',\n        description = 'Disables guidelete',\n    },\n}\n",
[ "src/commands/cmds/interface/guiscale.luau" ] = "local scaleConfig = require('../../../framework/settings').ui.scale\n\nreturn {\n    action = 'guiscale|uiscale',\n    description = \n[[Changes the size of the gui. [number] accepts decimals and whole numbers.]],\n    args = {\n        kind = 'number',\n        clamp = {\n            scaleConfig.minScale,\n            scaleConfig.maxScale,\n        },\n    },\n    run = function(self, args)\n        local scale = args:nextValue()\n\n        self.infiniteYield:setScale(scale)\n    end,\n}\n",
[ "src/commands/cmds/interface/hideguis.luau" ] = "return {\n    {\n        action = 'hideguis',\n        description = 'Hides any GUIs in PlayerGui',\n    },\n    {\n        action = 'unhideguis',\n        description = 'Undoes hideguis',\n    },\n}\n",
[ "src/commands/cmds/interface/hideiy.luau" ] = "local keyboardService = require('../../../framework/services/keyboardService')\n\nlocal function clearListener(self)\n    local garbage = self:collectGarbage('hideiy')\n\n    if garbage and garbage.connection then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function listenForShowKeys(self, interface)\n    clearListener(self)\n\n    local garbage = self:registerGarbage('hideiy')\n\n    garbage.connection = keyboardService:onBindingPressed('prefix', function()\n        if interface.mainFrame.Visible then\n            return\n        end\n\n        interface:showCommandBar()\n    end)\nend\nlocal function hideWindow(self)\n    local interface = self.infiniteYield\n\n    if not interface or not interface.mainFrame then\n        self:notify('IY', 'the main window is not created yet')\n\n        return\n    end\n    if not interface.mainFrame.Visible then\n        self:notify('IY', 'already hidden')\n\n        return\n    end\n\n    interface:hideWindow()\n    listenForShowKeys(self, interface)\n\n    local prefixName = keyboardService:getBindingName('prefix')\n\n    self:notify('IY', `hidden. Press {prefixName} or tap the IY button to type a command`)\nend\nlocal function showWindow(self)\n    clearListener(self)\n\n    local interface = self.infiniteYield\n\n    if interface then\n        interface:showWindow()\n    end\nend\n\nreturn {\n    {\n        action = 'hideiy|hideinterface',\n        description = 'Hides the main IY GUI',\n        run = function(self)\n            hideWindow(self)\n        end,\n    },\n    {\n        action = 'showiy|unhideiy|unhideinterface',\n        description = 'Shows IY again',\n        run = function(self)\n            showWindow(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/interface/init.luau" ] = "return {\n    require('./guiscale'),\n    require('./showprompts'),\n    require('./togglegui'),\n    require('./showguis'),\n    require('./hideiy'),\n}\n",
[ "src/commands/cmds/interface/keepiy.luau" ] = "local keepiy = require('../../systems/keepiy')\n\nreturn {\n    {\n        action = 'keepiy',\n        description = \n[[Runs IY again after you teleport, and keeps the interface open]],\n        run = function(self)\n            keepiy.enable(self)\n        end,\n    },\n    {\n        action = 'unkeepiy',\n        description = 'Turns keepiy off: IY stops running after you teleport',\n        run = function(self)\n            keepiy.disable(self)\n        end,\n    },\n    {\n        action = 'togglekeepiy',\n        description = 'Toggles keepiy',\n        run = function(self)\n            keepiy.toggle(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/interface/noprompts.luau" ] = "return {\n    action = 'noprompts',\n    description = 'Prevents the game from showing you purchase/premium prompts',\n}\n",
