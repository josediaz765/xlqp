[ "src/ui/components/commands.luau" ] = "local connectionService = require('../../framework/services/connectionService')\nlocal robloxServices = require('../../framework/services/rbxServices')\nlocal playerService = require('../../framework/services/playerService')\nlocal createService = require('../services/createService')\nlocal commandData = require('../../commands/systems/commandData')\nlocal commandParser = require('../../commands/systems/commandParser')\nlocal commandRunner = require('../../commands/systems/commandRunner')\nlocal inputUtils = require('../utils/inputUtils')\nlocal assetsService = require('../services/assetsService')\nlocal commandsList = require('../../commands/list')\nlocal signal = require('../../utils/signal')\nlocal logger = require('../../utils/logger')\nlocal tools = require('../../utils/tools')\nlocal scaleObject = require('../utils/scaleObject')\nlocal settingsData = require('../../storage/data/settings')\nlocal cmdsColors = require('../../framework/config/ui/colors').commands\nlocal isMobile = require('../../framework/environment/isMobile')\nlocal userInputService = robloxServices.UserInputService\nlocal runService = robloxServices.RunService\nlocal tweenService = robloxServices.TweenService\nlocal richFontSize = tools.richFontSize\nlocal colorFromRGB = tools.colorFromRGB\nlocal commands = {}\n\ncommands.__index = commands\n\nlocal FOCUS_FRAMES = 6\nlocal SEND_WIDTH = 24\nlocal SEND_HEIGHT = 18\nlocal SEND_ICON_INSET = 3\nlocal SEND_MARGIN = 5\nlocal SEND_GAP = 4\nlocal BAR_TWEEN_TIME = 0.2\nlocal BAR_FULL = UDim2.new(1, -2 * SEND_MARGIN, 0, SEND_HEIGHT)\nlocal BAR_WITH_SEND = UDim2.new(1, -(SEND_MARGIN + SEND_GAP + SEND_WIDTH + SEND_MARGIN), 0, SEND_HEIGHT)\nlocal SWIPE_DOWN_MIN = 50\n\nlocal function getCommand(commandName)\n    return commandsList.lookup[commandName]\nend\nlocal function zerofloor(number)\n    return math[(number < 0) and 'ceil' or 'floor'](number)\nend\nlocal function cleanInput(text)\n    text = text:gsub('[\\r\\n]+$', '')\n    text = text:gsub('[\\r\\n]+', ' ')\n\n    return text\nend\n\nfunction commands:refresh(text)\n    local statements = self.parser:parse(text)\n\n    self.parser:highlight(statements)\n    self:updateSearchBoxHighlight()\n\n    self:updateSearchedCommand()\nend\nfunction commands:applyCorrection()\n    local cmdInput = self.commandInput\n    local correction = cmdInput.correction\n    local raw = cmdInput.rawText\n    local newText = raw:sub(1, correction.from - 1) .. correction.text .. raw:sub(correction.to + 1)\n\n    if settingsData:getValue('spaceAfterCorrection') then\n        newText ..= ' '\n    end\n\n    self:writeText(newText)\nend\nfunction commands:ensureFocus()\n    local searchBox = self.searchBox\n\n    if not searchBox or not self.isEnabled or not self.interactive then\n        return\n    end\n\n    self.focusRequest = (self.focusRequest or 0) + 1\n\n    local request = self.focusRequest\n\n    task.spawn(function()\n        for _ = 1, FOCUS_FRAMES do\n            if request ~= self.focusRequest or not self.isEnabled or not self.interactive then\n                return\n            end\n            if searchBox:IsFocused() then\n                return\n            end\n            if searchBox.Parent ~= nil then\n                searchBox:CaptureFocus()\n                searchBox.CursorPosition = #searchBox.Text + 1\n            end\n\n            runService.Heartbeat:Wait()\n        end\n    end)\nend\nfunction commands:sendText()\n    local text = cleanInput(self.searchBox.Text)\n\n    if not text:match('%S') then\n        return\n    end\n\n    self:refresh(text)\n    self:sendInputCommand()\nend\nfunction commands:updateSendButton()\n    local sendButton = self.sendButton\n    local searchBox = self.searchBox\n\n    if not (sendButton and searchBox) then\n        return\n    end\n\n    local shown = not searchBox:IsFocused() and searchBox.Text:match('%S') ~= nil\n\n    if shown == self.sendShown then\n        return\n    end\n\n    self.sendShown = shown\n    sendButton.Visible = shown\n\n    self:tweenSearchBar(if shown then BAR_WITH_SEND else BAR_FULL)\nend\nfunction commands:tweenSearchBar(size)\n    local holder = self.searchBoxHolder\n\n    if not holder then\n        return\n    end\n    if self.barTween then\n        self.barTween:Cancel()\n\n        self.barTween = nil\n    end\n    if holder.Size == size then\n        return\n    end\n    if not self.isEnabled then\n        holder.Size = size\n\n        return\n    end\n\n    local tween = tweenService:Create(holder, TweenInfo.new(BAR_TWEEN_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = size})\n\n    self.barTween = tween\n\n    tween:Play()\nend\nfunction commands:captureFocus()\n    local searchBox = self.searchBox\n\n    if not searchBox or not self.isEnabled or not self.interactive then\n        return\n    end\n    if searchBox.Parent ~= nil then\n        searchBox:CaptureFocus()\n        searchBox.CursorPosition = #searchBox.Text + 1\n    end\nend\nfunction commands:setInteractive(enabled)\n    enabled = enabled == true\n\n    if self.interactive == enabled then\n        return\n    end\n\n    self.interactive = enabled\n\n    local searchBox = self.searchBox\n    if searchBox then\n        searchBox.Active = enabled\n        searchBox.TextEditable = enabled\n        pcall(function() searchBox.Interactable = enabled end)\n    end\n\n    self.scrollBar:setLocked(not enabled)\n\n    if not enabled then\n        self.focusRequest = (self.focusRequest or 0) + 1\n        local searchBox = self.searchBox\n\n        if searchBox and searchBox:IsFocused() then\n            searchBox:ReleaseFocus()\n        end\n    end\nend\nfunction commands:isInteractive()\n    return self.interactive\nend\nfunction commands:awake()\n    local cmdInput = self.commandInput\n    local searchBox = self.searchBox\n    local searchHolder = self.searchBoxHolder\n    local marker = self.inputMarker\n    local placeholder = searchHolder.Placeholder\n    local textChangedSignal = searchBox:GetPropertyChangedSignal('Text')\n    local function closeSearchBox()\n        if searchBox:IsFocused() then\n            searchBox:ReleaseFocus()\n        end\n    end\n    local function onEnterPressed()\n        if cmdInput.correction then\n            self:applyCorrection()\n            self:ensureFocus()\n\n            return true\n        end\n\n        self:sendInputCommand()\n\n        return false\n    end\n    local function updatePlaceholder()\n        local visible = not searchBox:IsFocused() and #searchBox.Text == 0\n\n        placeholder.Visible = visible\n\n        self:updateSearchBoxHighlight()\n\n        self:updateSendButton()\n    end\n\n    self.commandClickedSignal:Connect(function(data)\n        if not self.interactive then\n            return\n        end\n\n        self:writeText(data.aliases[1])\n        self:ensureFocus()\n    end)\n    connectionService:Connect(searchHolder.Activated, function()\n        if not self.interactive then\n            return\n        end\n\n        self:ensureFocus()\n    end)\n    connectionService:Connect(self.sendButton.Activated, function()\n        if not self.interactive then\n            return\n        end\n        if searchBox:IsFocused() then\n            searchBox:ReleaseFocus()\n        end\n\n        self:sendText()\n    end)\n    connectionService:Connect(searchBox.Focused, function()\n        if self.onInteraction then\n            self.onInteraction()\n        end\n\n        updatePlaceholder()\n\n        marker.Visible = false\n\n        if #searchBox.Text == 0 then\n            self:setComment('')\n        end\n    end)\n    connectionService:Connect(searchBox.FocusLost, function(enterPressed)\n        updatePlaceholder()\n\n        marker.Visible = false\n\n        connectionService:disconnect(self.markerConnection)\n\n        if enterPressed then\n            self:refresh(cleanInput(searchBox.Text))\n            onEnterPressed()\n        end\n    end)\n    connectionService:Connect(textChangedSignal, function()\n        if self.onInteraction then\n            self.onInteraction()\n        end\n\n        local text = searchBox.Text\n\n        if text:find('\\t') then\n            searchBox.Text = (text:gsub('\\t', ''))\n\n            return\n        end\n        if self.historyIndex and text ~= self.historyText then\n            self.historyIndex = nil\n        end\n\n        local isEnter = text:sub(-1) == '\\n' or text:sub(-1) == '\\r'\n\n        if text:find('[\\r\\n]') then\n            text = cleanInput(text)\n            searchBox.Text = text\n\n            if isEnter then\n                self:refresh(text)\n\n                if not onEnterPressed() then\n                    closeSearchBox()\n                end\n\n                return\n            end\n        end\n\n        self.lastText = text\n\n        updatePlaceholder()\n        self:refresh(text)\n    end)\n    connectionService:Connect(userInputService.InputBegan, function(input)\n        if not searchBox:IsFocused() then\n            return\n        end\n        if input.KeyCode == Enum.KeyCode.Up then\n            self:browseHistory(-1)\n        elseif input.KeyCode == Enum.KeyCode.Down then\n            self:browseHistory(1)\n        elseif input.KeyCode == Enum.KeyCode.Tab and self.commandInput.correction then\n            self:applyCorrection()\n            self:ensureFocus()\n        end\n    end)\nend\n\nlocal HISTORY_LIMIT = 50\n\nfunction commands:sendInputCommand()\n    local cmdInput = self.commandInput\n\n    if cmdInput.runError then\n        self:setComment(cmdInput.runError, 'error')\n\n        return\n    end\n\n    local statements = cmdInput.statements\n\n    for _, info in statements do\n        if not info.commandData then\n            return\n        end\n    end\n\n    if self.onCommandSent then\n        self.onCommandSent()\n    end\n\n    local rawText = cmdInput.rawText\n    local failure, failedName = nil, nil\n\n    for _, info in statements do\n        local success, reason = pcall(function()\n            self:runStatement(info)\n        end)\n\n        if not success then\n            failure = reason\n            failedName = info.commandData.name\n\n            break\n        end\n    end\n\n    if settingsData:getValue('clearOnEnter') then\n        self:writeText('')\n    end\n\n    self.historyIndex = nil\n\n    if failure then\n        self:setComment(`failed - {failure}`, 'error')\n        logger:error(`failed to run command '{failedName}': {failure}`)\n    else\n        self:addToHistory(rawText)\n    end\nend\nfunction commands:runStatement(info)\n    commandRunner.runStatement(info)\nend\nfunction commands:addToHistory(text)\n    local line = (text or ''):match('^(.-)%s*$')\n\n    if line == '' then\n        return\n    end\n\n    local history = self.history\n\n    if history[#history] == line then\n        return\n    end\n\n    table.insert(history, line)\n\n    if #history > HISTORY_LIMIT then\n        table.remove(history, 1)\n    end\nend\nfunction commands:browseHistory(direction)\n    local history = self.history\n\n    if #history == 0 then\n        return\n    end\n\n    local index\n\n    if self.historyIndex == nil then\n        if direction > 0 then\n            return\n        end\n\n        index = #history\n    else\n        index = self.historyIndex + direction\n    end\n    if index < 1 then\n        index = 1\n    end\n    if index > #history then\n        self.historyIndex = nil\n\n        self:setSearchText('')\n\n        return\n    end\n\n    self.historyIndex = index\n\n    self:setSearchText(history[index])\nend\nfunction commands:setSearchText(text)\n    self.historyText = text\n\n    self:writeText(text)\nend\nfunction commands:writeText(text)\n    self.searchBox.Text = text\n    self.lastText = text\n\n    self:refresh(text)\n    self.searchBox.CursorPosition = #text + 1\nend\nfunction commands:create()\n    self.searchBoxHolder = createService.new('ImageButton', {\n        Size = BAR_FULL,\n        Position = UDim2.new(0, SEND_MARGIN, 0, 0),\n        AnchorPoint = Vector2.new(0, 1),\n        BorderSizePixel = 0,\n        ClipsDescendants = true,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, 6),\n        }),\n        createService.new('TextLabel', 'Input', {\n            Size = UDim2.fromScale(0, 1),\n            Position = UDim2.new(0, 5, 0.5, 0),\n            AnchorPoint = Vector2.new(0, 0.5),\n            TextXAlignment = Enum.TextXAlignment.Left,\n            TextYAlignment = Enum.TextYAlignment.Center,\n            AutomaticSize = Enum.AutomaticSize.X,\n            BackgroundTransparency = 1,\n            TextSize = self.configs.textSize,\n            Visible = false,\n            RichText = true,\n            ThemeTag = {\n                TextColor3 = 'Colors.Text.Default',\n                Font = 'Font.MonoSpace',\n            },\n            createService.new('Frame', 'Holder', {\n                Size = UDim2.fromScale(0, 1),\n                Position = UDim2.fromScale(1, 0),\n            }),\n        }),\n        createService.new('TextLabel', 'Placeholder', {\n            Size = UDim2.new(1, -5, 1, 0),\n            Position = UDim2.new(0, 5, 0.5, 0),\n            AnchorPoint = Vector2.new(0, 0.5),\n            TextXAlignment = Enum.TextXAlignment.Left,\n            TextYAlignment = Enum.TextYAlignment.Center,\n            BackgroundTransparency = 1,\n            TextSize = self.configs.textSize - 1,\n            Text = self.configs.placeholderText,\n            ThemeTag = {\n                TextColor3 = 'Colors.Text.Dark',\n                Font = 'Font.MonoSpace',\n            },\n        }),\n    })\n\n    local searchHolder = self.searchBoxHolder\n    local inputHolder = searchHolder.Input.Holder\n\n    self.inputMarker = createService.new('Frame', 'Marker', inputHolder, {\n        Size = UDim2.new(0, 1.5, 1, -3),\n        Position = UDim2.new(1, 0.2, 0.5, 0),\n        AnchorPoint = Vector2.new(0, 0.5),\n        BorderSizePixel = 0,\n        Visible = false,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Primary',\n        },\n    })\n    self.inputComment = createService.new('TextLabel', 'Comment', inputHolder, {\n        Size = UDim2.fromScale(1, 1),\n        Position = UDim2.fromScale(1, 0.5),\n        AnchorPoint = Vector2.new(0, 0.5),\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Center,\n        BackgroundTransparency = 1,\n        TextSize = self.configs.textSize,\n        RichText = true,\n        Text = '',\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Default',\n            Font = 'Font.MonoSpace',\n        },\n    })\n    self.commandInfo = createService.new('TextLabel', 'Info', {\n        Size = UDim2.new(1, -25, 0, 0),\n        Position = UDim2.new(0, 10, 0, 0),\n        AutomaticSize = Enum.AutomaticSize.Y,\n        TextYAlignment = Enum.TextYAlignment.Center,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        Font = self.configs.textFont,\n        TextSize = self.configs.textSize - 5,\n        Visible = false,\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, 4),\n        }),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    self.searchBox = createService.new('TextBox', 'SearchBox', {\n        Active = true,\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        TextTransparency = 0,\n        Size = UDim2.new(1, -10, 1, 0),\n        Position = UDim2.new(0, 5, 0.5, 0),\n        AnchorPoint = Vector2.new(0, 0.5),\n        ClearTextOnFocus = false,\n        ShowNativeInput = true,\n        TextEditable = true,\n        TextSize = self.configs.textSize,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Center,\n        RichText = false,\n        Text = '',\n        MultiLine = false,\n        ZIndex = 2,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Default',\n            PlaceholderColor3 = 'Colors.Text.Dark',\n            Font = 'Font.MonoSpace',\n        },\n    })\n\n    pcall(function()\n        self.searchBox.Interactable = true\n    end)\n\n    self.commandsFolder = createService.new('Folder', 'Commands')\n\n    self:createSendButton()\nend\nfunction commands:createSendButton()\n    local sendButton = createService.new('TextButton', 'Send', {\n        AnchorPoint = Vector2.new(1, 1),\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, -SEND_MARGIN, 0, 0),\n        Size = UDim2.new(0, SEND_WIDTH, 0, SEND_HEIGHT),\n        Text = '',\n        Visible = false,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, 4),\n        }),\n    })\n    local sendIcon = createService.new('ImageLabel', 'Icon', sendButton, {\n        AnchorPoint = Vector2.new(0.5, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.fromScale(0.5, 0.5),\n        ScaleType = Enum.ScaleType.Fit,\n        Size = UDim2.new(1, -2 * SEND_ICON_INSET, 1, -2 * SEND_ICON_INSET),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    assetsService:loadImage(sendIcon, 'lucide-send')\n\n    self.sendIcon = sendIcon\n    self.sendButton = sendButton\n    self.sendShown = false\nend\nfunction commands:createCommandsData()\n    for pos, command in commandsList.original do\n        local cmdData = commandData.new(command)\n\n        command.commandData = cmdData\n        cmdData.position = pos - 1\n\n        table.insert(self.commandsData, cmdData)\n    end\nend\nfunction commands:updateSearchBoxHighlight()\n    local text = self.commandInput.highlightText\n    local searchHolder = self.searchBoxHolder\n    local input = searchHolder.Input\n    local scale = scaleObject:getScale()\n\n    input.Text = text\n    local focused = self.searchBox:IsFocused()\n    input.Visible = #text > 0 and not focused\n    self.searchBox.TextTransparency = if focused then 0 else 1\n    self.inputMarker.Visible = false\n\n    local totalHolderWidth = searchHolder.AbsoluteSize.X * scale\n    local halfHolderWidth = totalHolderWidth / 2\n    local currentInputWidth = input.AbsoluteSize.X * scale\n\n    if currentInputWidth <= halfHolderWidth then\n        input.AnchorPoint = Vector2.new(0, 0.5)\n        input.Position = UDim2.new(0, 5, 0.5, 0)\n    else\n        input.AnchorPoint = Vector2.new(1, 0.5)\n        input.Position = UDim2.new(0.5, 0, 0.5, 0)\n    end\nend\nfunction commands:updateSearchBoxPosition()\n    local searchBox = self.searchBox\n    local searchHolder = self.searchBoxHolder\n\n    if not self.isEnabled or not (searchBox and searchHolder) then\n        return\n    end\n    searchBox.Parent = searchHolder\n    searchBox.Position = UDim2.new(0, 5, 0.5, 0)\n    searchBox.Size = UDim2.new(1, -10, 1, 0)\nend\nfunction commands:updateSearchedCommand()\n    local query = (self.commandInput.commandName or ''):lower()\n\n    if query == self.filterQuery then\n        return\n    end\n\n    self.filterQuery = query\n    self.filteredData = {}\n    self.hoveredCommand = nil\n    self:clearHoverDescription()\n\n    for _, data in self.commandsData do\n        local matches = query == ''\n\n        if not matches and not data.isSection then\n            matches = data.name:lower():find(query, 1, true) ~= nil\n\n            if not matches then\n                for _, alias in data.aliases or {} do\n                    if alias:lower():find(query, 1, true) then\n                        matches = true\n                        break\n                    end\n                end\n            end\n        end\n\n        data.filteredPosition = if matches then #self.filteredData else nil\n\n        if matches then\n            table.insert(self.filteredData, data)\n        end\n    end\n\n    self.scrollBar:scrollTo(0, true)\n    self:update()\nend\nfunction commands:setComment(text, color)\n    if color ~= nil then\n        text = commandParser.colorFromName(text, color)\n    end\n\n    self.inputComment.Text = text\n    self.inputComment.Visible = #text > 0\nend\nfunction commands:updateElementColor(element, elementPos)\n    local transparency = if elementPos % 2 == 1 then 1 else 0.96\n\n    element.BackgroundTransparency = transparency\nend\nfunction commands:updateElements()\n    local elementPos = 0\n    local longestCommand = 0\n    local visibleCommands = {}\n    local scrollBar = self.scrollBar\n    local commandsFolder = self.commandsFolder\n\n    for pos, cmdData in self.commandsData do\n        local position = if self.filteredData then cmdData.filteredPosition else cmdData.position\n        local isVisible = position ~= nil and scrollBar:isVisible(position)\n\n        if not isVisible then\n            if cmdData.element then\n                cmdData.element.Parent = nil\n            end\n\n            continue\n        end\n\n        local element = cmdData.element\n\n        if not element then\n            element = self:createCommandElement(cmdData)\n            cmdData.element = element\n        end\n        if not cmdData.isSection then\n            if #cmdData.args > 0 and #cmdData.name > longestCommand then\n                longestCommand = #cmdData.name\n            end\n\n            table.insert(visibleCommands, cmdData)\n        end\n\n        self:updateElementColor(element, position + 1)\n\n        element.Parent = commandsFolder\n        element.Position = UDim2.fromOffset(0, elementPos * (element.Size.Y.Offset + self.configs.padding))\n\n        elementPos += 1\n    end\n    for key, cmdData in visibleCommands do\n        self:updateDisplayName(cmdData, longestCommand + 3)\n    end\n\n    self.visibleCommands = visibleCommands\nend\nfunction commands:setCommandInfo(text)\n    text = text or ''\n\n    if text == '' then\n        self.commandInfo.Visible = false\n\n        return\n    end\n\n    self.commandInfo.Visible = true\n    self.commandInfo.Text = text\nend\nfunction commands:createSection(data)\n    local sectionLabel = createService.new('TextLabel', 'Command', {\n        Size = UDim2.fromScale(1, 1),\n        Position = UDim2.fromOffset(5, 0),\n        BackgroundTransparency = 1,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Bottom,\n        RichText = true,\n        TextSize = self.configs.textSize - 3,\n        Text = `<b>#{data.sectionName}</b>`,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Darker',\n            Font = 'Font.MonoSpace',\n        },\n    })\n\n    return createService.new('Frame', {\n        Size = UDim2.new(1, -10, 0, self.configs.labelSize),\n        BackgroundTransparency = 1,\n        sectionLabel,\n    })\nend\nfunction commands:createCommandElement(data)\n    if data.isSection then\n        return self:createSection(data)\n    end\n\n    local commandLabel = createService.new('TextLabel', 'Command', {\n        Size = UDim2.fromScale(0, 1),\n        Position = UDim2.fromOffset(5, 0),\n        BackgroundTransparency = 1,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        AutomaticSize = Enum.AutomaticSize.X,\n        RichText = true,\n        TextSize = self.configs.textSize,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Default',\n            Font = 'Font.MonoSpace',\n        },\n    })\n\n    return createService.new('Frame', {\n        Size = UDim2.new(1, 0, 0, self.configs.labelSize),\n        AutomaticSize = Enum.AutomaticSize.X,\n        BackgroundTransparency = 1,\n        commandLabel,\n    })\nend\nfunction commands:createCommandDescription(data)\n    if data.isSection then\n        return\n    end\n    if not data.description then\n        return\n    end\n\n    local descriptionLabel = createService.new('TextLabel', 'Description', {\n        Size = UDim2.fromScale(1, 1),\n        Position = UDim2.fromOffset(25, 0),\n        BackgroundTransparency = 1,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        RichText = true,\n        TextSize = self.configs.textSize,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Dark',\n            Font = 'Font.MonoSpace',\n        },\n    })\n\n    return createService.new('Frame', 'Description', {\n        Size = UDim2.new(1, -30, 0, self.configs.labelSize),\n        BackgroundTransparency = 1,\n        descriptionLabel,\n    })\nend\nfunction commands:getCommandColor(cmdName, cmdData)\n    local command = getCommand(cmdName)\n    local colorName = if type(command.run) ~= 'function'\n        then'undefined'\n        elseif cmdData.isClient\n        then'client'\n        elseif cmdData.isDeprecated\n        then'deprecated'\n        else nil\n\n    if colorName ~= nil then\n        cmdName = colorFromRGB(cmdName, cmdsColors[colorName])\n    end\n\n    return cmdName\nend\nfunction commands:updateDisplayName(cmdData, spaceBeforeArgs)\n    local element = cmdData.element\n    local commandName = cmdData.name\n    local spaces = string.rep('\\u{2014}', (spaceBeforeArgs - #commandName) - 2)\n\n    commandName = self:getCommandColor(commandName, cmdData)\n\n    local displayName = `{commandName} {commandParser.colorFromName(spaces, 'comment')} `\n    local argsText = self.parser:highlightArgsType(cmdData.args)\n    local text = displayName .. argsText\n\n    if cmdData.isHolding then\n        cmdData.originalText = text\n    else\n        self:setCommandText(cmdData, text)\n    end\nend\nfunction commands:setCommandText(cmdData, text)\n    local element = cmdData.element\n\n    if not element then\n        return\n    end\n\n    element.Command.Text = text\nend\nfunction commands:getCommandText(cmdData)\n    local element = cmdData.element\n\n    return element and element.Command.Text or ''\nend\nfunction commands:calculateTotalSpace()\n    return #(self.filteredData or self.commandsData)\nend\nfunction commands:calculateVisibleSpace()\n    local scrollSize = self.scrollContainer.AbsoluteSize.Y\n\n    return math.floor(scrollSize / self:calculateLabelSize())\nend\nfunction commands:calculateLabelSize()\n    return self.configs.padding + self.configs.labelSize\nend\nfunction commands:getElementMouseIn()\n    for _, data in self.visibleCommands do\n        if playerService:isMouseInGuiObject(data.element) then\n            return data\n        end\n    end\nend\nfunction commands:horizontalScroll(xOffset)\n    for _, cmdData in self.visibleCommands do\n        local element = cmdData.element\n\n        element.Position = UDim2.fromOffset(math.min(element.Position.X.Offset + xOffset, 0), element.Position.Y.Offset)\n    end\nend\nfunction commands:showHoverDescription(description)\n    local comment = self.inputComment\n    local showing = self.hoverText ~= nil and comment.Text == self.hoverText\n\n    if not showing then\n        if comment.Text ~= '' then\n            self.hoverText = nil\n\n            return false\n        end\n\n        self.savedComment = comment.Text\n    end\n\n    self.hoverText = commandParser.colorFromName(description, 'comment')\n    comment.Text = self.hoverText\n    comment.Visible = true\n\n    return true\nend\nfunction commands:clearHoverDescription()\n    if self.hoverText == nil then\n        return\n    end\n\n    local comment = self.inputComment\n\n    if comment.Text == self.hoverText then\n        comment.Text = self.savedComment or ''\n        comment.Visible = #comment.Text > 0\n    end\n\n    self.hoverText = nil\n    self.savedComment = nil\nend\nfunction commands:updateHoverDescription()\n    local hovered = nil\n\n    if self.interactive and playerService:isMouseInGuiObject(self.scrollContainer) then\n        hovered = self:getElementMouseIn()\n    end\n\n    local description = hovered and hovered.description\n\n    if not description then\n        self.hoveredCommand = nil\n\n        self:clearHoverDescription()\n\n        return\n    end\n    if hovered == self.hoveredCommand then\n        return\n    end\n    if self:showHoverDescription(description) then\n        self.hoveredCommand = hovered\n    end\nend\nfunction commands:startedHoldingContainer(input)\n    if not self.interactive then\n        return\n    end\n    if not inputUtils.isPressingInput(input) then\n        return\n    end\n    if self.scrollBar:isScrollBarDisabled() then\n        return\n    end\n\n    self.scrollAxis = nil\n\n    self.scrollBar:disableScroll()\n\n    local playerMouse = playerService:getMouse()\n    local lblSize = self:calculateLabelSize()\n    local cmdData = self:getElementMouseIn()\n    local clickedAt = tick()\n\n    if cmdData and cmdData.description then\n        cmdData.isHolding = true\n\n        local desc = self.parser.colorFromName(cmdData.description, 'comment')\n\n        cmdData.originalText = self:getCommandText(cmdData)\n\n        self:setCommandText(cmdData, desc)\n    end\n\n    local lastMouseY = playerMouse.Y\n    local lastMouseX = playerMouse.X\n    local startMouseY = playerMouse.Y\n    local swipeFromTop = self.scrollBar.index <= 0\n    local downTravel = 0\n    local swiped = false\n    local mouseEvent\n\n    local function disconnect()\n        self.scrollBar:enableScroll()\n\n        if swipeFromTop and self.scrollAxis == 'y' and downTravel >= SWIPE_DOWN_MIN and self.onSwipeDown then\n            swiped = true\n\n            self.onSwipeDown()\n        end\n        if cmdData then\n            cmdData.isHolding = nil\n\n            if cmdData.originalText then\n                self:setCommandText(cmdData, cmdData.originalText)\n\n                cmdData.originalText = nil\n            end\n            if (tick() - clickedAt) <= 0.15 and not swiped then\n                self.commandClickedSignal:Fire(cmdData)\n            end\n        end\n        if mouseEvent then\n            mouseEvent:Disconnect()\n        end\n    end\n\n    inputUtils.onReleaseEvent(disconnect)\n\n    mouseEvent = inputUtils.onMouseEvent(function(inp)\n        if not self.interactive then\n            return\n        end\n\n        downTravel = playerMouse.Y - startMouseY\n\n        local deltaX = playerMouse.X - lastMouseX\n        local deltaY = playerMouse.Y - lastMouseY\n\n        if not self.scrollAxis then\n            if math.abs(deltaX) > 4 or math.abs(deltaY) > 4 then\n                self.scrollAxis = math.abs(deltaX) > math.abs(deltaY) and 'x' or 'y'\n            end\n\n            return\n        end\n        if self.scrollAxis == 'x' then\n            local xOffset = zerofloor(deltaX / 3)\n\n            if math.floor(xOffset) ~= 0 then\n                self:horizontalScroll(xOffset)\n\n                lastMouseX = playerMouse.X\n            end\n        else\n            local yOffset = zerofloor(deltaY / lblSize)\n\n            if math.floor(yOffset) ~= 0 then\n                self.scrollBar:scrollTo(self.scrollBar.index - yOffset)\n\n                lastMouseY = playerMouse.Y\n            end\n        end\n    end)\nend\nfunction commands:update()\n    self.scrollBar:setVisibleSpace(self:calculateVisibleSpace())\n    self.scrollBar:setTotalSpace(self:calculateTotalSpace())\n    self:updateElements()\nend\nfunction commands:enable()\n    if self.isEnabled then\n        return\n    end\n\n    local container = self.scrollContainer\n\n    self.isEnabled = true\n    self.commandsFolder.Parent = container\n    self.searchBoxHolder.Parent = self.scrollHolder\n    self.searchBox.Parent = self.searchBoxHolder\n    self.sendButton.Parent = self.scrollHolder\n    self.commandInfo.Parent = self.scrollHolder\n    self.scrollConnection = self.scrolledSignal:Connect(function()\n        self:updateElements()\n    end)\n    self.containerConnection = container.InputBegan:Connect(function(input)\n        self:startedHoldingContainer(input)\n    end)\n\n    self:update()\n    self:updateSearchBoxPosition()\n\n    if not isMobile then\n        self.hoverConnection = connectionService:Connect(runService.RenderStepped, function(\n        )\n            self:updateHoverDescription()\n        end)\n    end\nend\nfunction commands:disable()\n    if not self.isEnabled then\n        return\n    end\n\n    self.isEnabled = false\n    self.focusRequest = (self.focusRequest or 0) + 1\n    if self.searchBox:IsFocused() then self.searchBox:ReleaseFocus() end\n    self.commandsFolder.Parent = nil\n    self.searchBox.Parent = nil\n    self.searchBoxHolder.Parent = nil\n    self.sendButton.Parent = nil\n    self.commandInfo.Parent = nil\n\n    connectionService:disconnect(self.containerConnection)\n    connectionService:disconnect(self.markerConnection)\n    connectionService:disconnect(self.scrollConnection)\n    connectionService:disconnect(self.searchBoxConnection)\n    connectionService:disconnect(self.hoverConnection)\n\n    self.hoveredCommand = nil\n\n    self:clearHoverDescription()\nend\nfunction commands.new(config)\n    local function cfg(name)\n        return assert(config.configs[name], `missing config.configs['{name}']`)\n    end\n\n    local self = setmetatable({\n        scrollContainer = config.scrollContainer,\n        scrolledSignal = config.scrolledSignal,\n        scrollHolder = config.scrollHolder,\n        scrollBar = config.scrollBar,\n        screenGui = config.screenGui,\n        configs = {\n            placeholderText = cfg('placeholderText'),\n            padding = cfg('padding'),\n            labelSize = cfg('labelSize'),\n            textSize = cfg('textSize'),\n        },\n        commandClickedSignal = signal.new(),\n        interactive = true,\n        commandInput = {\n            bestMatch = nil,\n            bestMatches = {},\n            searchResult = {},\n            isValidCommand = false,\n            highlightText = '',\n            noHighlightText = '',\n            fullCommandText = '',\n            commandName = '',\n        },\n        visibleCommands = {},\n        commandsData = {},\n        history = {},\n        historyIndex = nil,\n        historyText = '',\n        lastText = '',\n    }, commands)\n\n    self.parser = commandParser.new(self.commandInput, function(text, color)\n        return self:setComment(text, color)\n    end)\n\n    return self\nend\n\nreturn commands\n",
[ "src/ui/components/mainFrame.luau" ] = "local createService = require('../services/createService')\nlocal mainFrame = {}\n\nfunction mainFrame:create()\n    local frame = createService.new('Frame', 'MainFrame', {\n        Active = true,\n        BorderSizePixel = 0,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n        createService.new('Frame', 'TopBar', {\n            Size = UDim2.fromOffset(250, 20),\n            BorderSizePixel = 0,\n            ThemeTag = {\n                BackgroundColor3 = 'Colors.Background',\n            },\n        }),\n    })\n    local topBar = frame.TopBar\n    local titleLabel = createService.new('TextLabel', 'Title', topBar, {\n        Size = UDim2.fromScale(1, 1),\n        BackgroundTransparency = 1,\n        TextSize = 16,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Default',\n            Font = 'Font.Normal',\n        },\n    })\n    local settingsButton = createService.new('ImageButton', topBar, {\n        Name = 'SettingsButton',\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -2, 0.5, 0),\n        AnchorPoint = Vector2.new(1, 0.5),\n        Size = UDim2.fromOffset(19, 19),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n    local referenceButton = createService.new('ImageButton', topBar, {\n        Name = 'ReferenceButton',\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -22, 0.5, 0),\n        AnchorPoint = Vector2.new(1, 0.5),\n        Size = UDim2.fromOffset(15, 15),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    return {\n        mainFrame = frame,\n        topBar = topBar,\n        titleLabel = titleLabel,\n        buttons = {\n            settings = settingsButton,\n            reference = referenceButton,\n        },\n    }\nend\n\nreturn mainFrame\n",
[ "src/ui/components/partpath.luau" ] = "local createService = require('../services/createService')\nlocal assetsService = require('../services/assetsService')\nlocal themeService = require('../services/themeService')\nlocal notifier = require('../notifier')\nlocal dragInstance = require('../utils/dragInstance')\nlocal coreGui = require('../coreGui')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal playerService = require('../../framework/services/playerService')\nlocal executorEnv = require('../../framework/environment/executor')\nlocal config = require('../../framework/config/ui/partpath')\nlocal getHierarchy = require('../../utils/getHierarchy')\nlocal highlight = require('../../utils/textHighlight')\nlocal tools = require('../../utils/tools')\nlocal windowConfig = config.window\nlocal textSizes = config.textSizes\nlocal buttonsConfig = config.buttons\nlocal SHOWN_POSITION = UDim2.new(0.5, -windowConfig.width / 2, 0, windowConfig.shownY)\nlocal HIDDEN_POSITION = UDim2.new(0.5, -windowConfig.width / 2, 0, windowConfig.hiddenY)\nlocal HOVER_COLOR = Color3.fromRGB(255, 255, 255)\nlocal SELECTED_COLOR = Color3.fromRGB(0, 166, 0)\nlocal partPath = {}\n\npartPath.__index = partPath\n\nfunction partPath.new()\n    return setmetatable({\n        frame = nil,\n        hoverBox = nil,\n        selectedBox = nil,\n        pathLabel = nil,\n        copyButton = nil,\n        isOpen = false,\n        path = nil,\n        selectedPart = nil,\n        onSelectPart = nil,\n        connections = {},\n    }, partPath)\nend\n\nlocal function createRow(body, layoutOrder, height, name)\n    return createService.new('Frame', name, body, {\n        BackgroundColor3 = Color3.new(1, 1, 1),\n        BackgroundTransparency = if layoutOrder % 2 == 1 then windowConfig.stripeTransparency else 1,\n        BorderSizePixel = 0,\n        LayoutOrder = layoutOrder,\n        Size = UDim2.new(1, 0, 0, height),\n    })\nend\nlocal function createTextRow(body, layoutOrder, name, look)\n    local row = createService.new('Frame', name, body, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundColor3 = Color3.new(1, 1, 1),\n        BackgroundTransparency = if layoutOrder % 2 == 1 then windowConfig.stripeTransparency else 1,\n        BorderSizePixel = 0,\n        LayoutOrder = layoutOrder,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIPadding', {\n            PaddingBottom = UDim.new(0, windowConfig.rowPadding),\n            PaddingLeft = UDim.new(0, windowConfig.textInset),\n            PaddingRight = UDim.new(0, windowConfig.textInset),\n            PaddingTop = UDim.new(0, windowConfig.rowPadding),\n        }),\n        createService.new('UIListLayout', {\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local label = createService.new('TextLabel', look.labelName, row, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        TextSize = look.textSize,\n        TextWrapped = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Top,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = look.color,\n        },\n    })\n\n    return row, label\nend\nlocal function breakPath(path)\n    local segments = {}\n    local current = ''\n\n    for index = 1, #path do\n        local char = string.sub(path, index, index)\n\n        if (char == '.' or char == '[') and current ~= '' then\n            table.insert(segments, current)\n\n            current = ''\n        end\n\n        current = current .. char\n    end\n\n    if current ~= '' then\n        table.insert(segments, current)\n    end\n\n    local lines = {}\n    local line = ''\n\n    for _, segment in segments do\n        if line ~= '' and #line + #segment > config.window.pathCharsPerLine then\n            table.insert(lines, line)\n\n            line = ''\n        end\n\n        line = line .. segment\n    end\n\n    if line ~= '' then\n        table.insert(lines, line)\n    end\n\n    return table.concat(lines, '\\n')\nend\nlocal function createSection(body, layoutOrder, title)\n    local row = createRow(body, layoutOrder, windowConfig.rowHeight, 'Section')\n\n    createService.new('TextLabel', 'Title', row, {\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(windowConfig.textInset, 0),\n        Size = UDim2.new(1, -windowConfig.textInset * 2, 1, 0),\n        RichText = true,\n        Text = `<b>{tools.escapeRichText(title)}</b>`,\n        TextSize = textSizes.section,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Center,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Darker',\n        },\n    })\n\n    return row\nend\nlocal function createButton(parent, name, text, position, size)\n    local button = createService.new('TextButton', name, parent, {\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = position,\n        Size = size,\n        Text = text,\n        TextSize = textSizes.button,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, buttonsConfig.cornerRadius),\n        }),\n    })\n\n    connectionService:Connect(button.MouseEnter, function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Buttons.Holding',\n        })\n    end)\n    connectionService:Connect(button.MouseLeave, function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        })\n    end)\n\n    return button\nend\n\nfunction partPath:create()\n    if self.frame then\n        return self.frame\n    end\n\n    local frame = createService.new('Frame', 'PartPath', {\n        Active = true,\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Position = HIDDEN_POSITION,\n        Size = UDim2.fromOffset(windowConfig.width, 0),\n        Visible = false,\n        createService.new('UIListLayout', {\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local topBar = createService.new('Frame', 'TopBar', frame, {\n        BorderSizePixel = 0,\n        LayoutOrder = 1,\n        Size = UDim2.new(1, 0, 0, windowConfig.topBarHeight),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n    })\n\n    createService.new('TextLabel', 'Title', topBar, {\n        BackgroundTransparency = 1,\n        Size = UDim2.fromScale(1, 1),\n        Text = windowConfig.title,\n        TextSize = textSizes.title,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n\n    local exitButton = createService.new('ImageButton', 'Exit', topBar, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -windowConfig.closeInset, 0.5, 0),\n        Size = UDim2.fromOffset(windowConfig.closeIconSize, windowConfig.closeIconSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    assetsService:loadImage(exitButton, 'close')\n\n    local body = createService.new('Frame', 'Body', frame, {\n        Active = true,\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BorderSizePixel = 0,\n        LayoutOrder = 2,\n        Size = UDim2.new(1, 0, 0, 0),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n        createService.new('UIPadding', {\n            PaddingBottom = UDim.new(0, windowConfig.verticalPadding),\n            PaddingTop = UDim.new(0, windowConfig.verticalPadding),\n        }),\n        createService.new('UIListLayout', {\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n\n    createSection(body, 1, config.headers.path)\n\n    local _, pathLabel = createTextRow(body, 2, 'PathRow', {\n        labelName = 'Path',\n        textSize = textSizes.value,\n        color = 'Colors.Text.Default',\n    })\n\n    pathLabel.RichText = true\n\n    createSection(body, 3, config.headers.actions)\n\n    local buttonRow = createRow(body, 4, windowConfig.buttonRowHeight, 'ButtonRow')\n    local half = windowConfig.buttonGap / 2\n    local inset = windowConfig.textInset\n    local buttonY = (windowConfig.buttonRowHeight - windowConfig.buttonHeight) / 2\n    local buttonSize = UDim2.new(0.5, -(inset + half), 0, windowConfig.buttonHeight)\n    local selectButton = createButton(buttonRow, 'SelectPart', buttonsConfig.selectPart, UDim2.new(0, inset, 0, buttonY), buttonSize)\n    local copyButton = createButton(buttonRow, 'CopyPath', buttonsConfig.copyPath, UDim2.new(0.5, half, 0, buttonY), buttonSize)\n    local _, helpLabel = createTextRow(body, 5, 'Help', {\n        labelName = 'HelpText',\n        textSize = textSizes.help,\n        color = 'Colors.Text.Darker',\n    })\n\n    helpLabel.Text = config.labels.help\n\n    local hoverBox = createService.new('SelectionBox', 'Hover', coreGui, {Color3 = HOVER_COLOR})\n    local selectedBox = createService.new('SelectionBox', 'Selected', coreGui, {Color3 = SELECTED_COLOR})\n\n    connectionService:Connect(exitButton.Activated, function()\n        self:close()\n    end)\n    connectionService:Connect(selectButton.Activated, function()\n        self:confirmSelection()\n    end)\n    connectionService:Connect(copyButton.Activated, function()\n        self:copyPath()\n    end)\n    dragInstance:addGuiObject(frame)\n\n    self.frame = frame\n    self.hoverBox = hoverBox\n    self.selectedBox = selectedBox\n    self.pathLabel = pathLabel\n    self.copyButton = copyButton\n\n    self:setPath(nil)\n\n    return frame\nend\nfunction partPath:open(onSelectPart)\n    self:create()\n\n    self.onSelectPart = onSelectPart\n\n    if self.isOpen then\n        return\n    end\n\n    self.isOpen = true\n    self.frame.Visible = true\n\n    self.frame:TweenPosition(SHOWN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, windowConfig.tweenTime, true)\n    self:startSelecting()\nend\nfunction partPath:close()\n    if not self.isOpen then\n        return\n    end\n\n    self.isOpen = false\n\n    self:disconnectMouse()\n    self:clearSelection()\n    self.frame:TweenPosition(HIDDEN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, windowConfig.tweenTime, true)\n    task.delay(windowConfig.tweenTime, function()\n        if not self.isOpen and self.frame then\n            self.frame.Visible = false\n        end\n    end)\nend\nfunction partPath:isPointerOverWindow()\n    return self.frame ~= nil and playerService:isMouseInGuiObject(self.frame)\nend\nfunction partPath:startSelecting()\n    self:disconnectMouse()\n\n    local mouse = playerService:getMouse()\n\n    table.insert(self.connections, mouse.Move:Connect(function()\n        local target = mouse.Target\n\n        if self:isPointerOverWindow() or target == self.selectedPart then\n            target = nil\n        end\n\n        self.hoverBox.Adornee = target\n    end))\n    table.insert(self.connections, mouse.Button1Down:Connect(function()\n        if self:isPointerOverWindow() then\n            return\n        end\n\n        local target = mouse.Target\n\n        if target then\n            self:selectPart(target)\n        end\n    end))\nend\nfunction partPath:disconnectMouse()\n    for _, connection in self.connections do\n        connection:Disconnect()\n    end\n\n    self.connections = {}\nend\nfunction partPath:selectPart(part)\n    self.selectedPart = part\n    self.selectedBox.Adornee = part\n    self.hoverBox.Adornee = nil\n\n    self:setPath(getHierarchy(part))\nend\nfunction partPath:setPath(path)\n    local label = self.pathLabel\n\n    self.path = path\n\n    if path then\n        themeService:addObject(label, {\n            TextColor3 = 'Colors.Text.Default',\n            Font = 'Font.MonoSpace',\n        })\n\n        label.RichText = true\n        label.Text = highlight:apply(breakPath(path))\n    else\n        themeService:addObject(label, {\n            TextColor3 = 'Colors.Text.Darker',\n            Font = 'Font.MonoSpace',\n        })\n\n        label.RichText = false\n        label.Text = config.labels.hint\n    end\nend\nfunction partPath:clearSelection()\n    self.selectedPart = nil\n    self.hoverBox.Adornee = nil\n    self.selectedBox.Adornee = nil\n\n    self:setPath(nil)\nend\nfunction partPath:confirmSelection()\n    local part = self.selectedPart\n\n    if not part or not part.Parent then\n        self:clearSelection()\n        notifier:notify(windowConfig.title, config.messages.noPart)\n\n        return\n    end\n    if self.onSelectPart then\n        self.onSelectPart(part)\n    end\nend\nfunction partPath:copyPath()\n    local path = self.path\n\n    if not path then\n        notifier:notify(windowConfig.title, config.messages.noPath)\n\n        return\n    end\n    if not executorEnv.setclipboard then\n        notifier:notify(windowConfig.title, config.messages.noClipboard)\n\n        return\n    end\n\n    executorEnv.setclipboard(path)\n\n    local button = self.copyButton\n\n    button.Text = buttonsConfig.copied\n\n    task.delay(buttonsConfig.feedbackTime, function()\n        button.Text = config.buttons.copyPath\n    end)\nend\nfunction partPath:destroy()\n    self.isOpen = false\n\n    self:disconnectMouse()\n\n    if self.hoverBox then\n        self.hoverBox:Destroy()\n    end\n    if self.selectedBox then\n        self.selectedBox:Destroy()\n    end\n    if self.frame then\n        self.frame:Destroy()\n    end\n\n    self.frame = nil\n    self.hoverBox = nil\n    self.selectedBox = nil\n    self.pathLabel = nil\n    self.copyButton = nil\nend\n\nreturn partPath\n",
[ "src/ui/components/reference.luau" ] = "local createService = require('../services/createService')\nlocal dragInstance = require('../utils/dragInstance')\nlocal scrollBarComponent = require('./scrollBar')\nlocal scaleObject = require('../utils/scaleObject')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal executorEnv = require('../../framework/environment/executor')\nlocal frameworkSettings = require('../../framework/settings')\nlocal referenceConfig = require('../../framework/config/ui/reference')\nlocal WINDOW_WIDTH = 500\nlocal TOP_BAR_HEIGHT = 20\nlocal CONTENT_HEIGHT = 300\nlocal WINDOW_HEIGHT = TOP_BAR_HEIGHT + CONTENT_HEIGHT\nlocal SCROLL_THICKNESS = 12\nlocal SCROLL_INCREMENT = 20\nlocal SCROLL_WHEEL_INCREMENT = 40\nlocal TWEEN_TIME = 0.5\nlocal COPY_FEEDBACK_TIME = 2\nlocal HIDDEN_POSITION = UDim2.new(0.5, -WINDOW_WIDTH / 2, 0, -500)\nlocal SHOWN_POSITION = UDim2.new(0.5, -WINDOW_WIDTH / 2, 0.5, -WINDOW_HEIGHT / 2)\nlocal RICH_TEXT_ESCAPES = {\n    ['&'] = '&amp;',\n    ['<'] = '&lt;',\n    ['>'] = '&gt;',\n}\nlocal CASES = referenceConfig.cases\nlocal SECTIONS = referenceConfig.sections\nlocal reference = {}\n\nreference.__index = reference\n\nlocal function escapeRichText(text)\n    return (text:gsub('[&<>]', RICH_TEXT_ESCAPES))\nend\nlocal function createTitle(text)\n    return createService.new('TextLabel', 'Header', {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        Text = text,\n        TextSize = 20,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            Font = 'Font.Bold',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\nend\nlocal function createParagraph(text, isBold)\n    return createService.new('TextLabel', isBold and 'Bold' or 'Text', {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        Text = text,\n        TextSize = 14,\n        TextWrapped = true,\n        RichText = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Top,\n        ThemeTag = {\n            Font = isBold and 'Font.Bold' or 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\nend\nlocal function createCases()\n    local holder = createService.new('Frame', 'Cases', {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, 2),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n\n    for order, entry in CASES do\n        local caseName, caseDescription = entry[1], entry[2]\n\n        createService.new('TextLabel', 'Case', holder, {\n            AutomaticSize = Enum.AutomaticSize.Y,\n            BackgroundTransparency = 1,\n            LayoutOrder = order,\n            RichText = true,\n            Size = UDim2.new(1, 0, 0, 0),\n            Text = `<b>{escapeRichText(caseName)}</b> {escapeRichText(caseDescription)}`,\n            TextSize = 14,\n            TextWrapped = true,\n            TextXAlignment = Enum.TextXAlignment.Left,\n            TextYAlignment = Enum.TextYAlignment.Top,\n            ThemeTag = {\n                Font = 'Font.Normal',\n                TextColor3 = 'Colors.Text.Default',\n            },\n        })\n    end\n\n    return holder\nend\nlocal function createInviteButton(link)\n    local button = createService.new('TextButton', 'InviteButton', {\n        BorderSizePixel = 0,\n        Size = UDim2.new(1, 0, 0, 25),\n        Text = `Copy Discord Invite Link ({link})`,\n        TextSize = 16,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Primary',\n            Font = 'Font.Bold',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    local defaultText = button.Text\n    local lastPress = nil\n\n    connectionService:Connect(button.Activated, function()\n        if executorEnv.setclipboard then\n            executorEnv.setclipboard(link)\n\n            button.Text = 'Copied'\n        else\n            button.Text = 'No Clipboard Function, type out the link'\n        end\n\n        local pressTime = tick()\n\n        lastPress = pressTime\n\n        task.wait(COPY_FEEDBACK_TIME)\n\n        if lastPress ~= pressTime then\n            return\n        end\n\n        button.Text = defaultText\n    end)\n\n    return button\nend\nlocal function createBlock(block)\n    local kind = block[1]\n\n    if kind == 'title' then\n        return createTitle(block[2])\n    elseif kind == 'cases' then\n        return createCases()\n    elseif kind == 'invite' then\n        return createInviteButton(frameworkSettings.links.discord)\n    end\n\n    return createParagraph(block[2], kind == 'bold')\nend\nlocal function createSection(order, blocks, isLast)\n    local section = createService.new('Frame', 'Section', {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        LayoutOrder = order,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIPadding', {\n            PaddingBottom = UDim.new(0, 8),\n            PaddingLeft = UDim.new(0, 8),\n            PaddingRight = UDim.new(0, 8),\n            PaddingTop = UDim.new(0, 5),\n        }),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, 4),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n\n    for blockOrder, block in blocks do\n        local element = createBlock(block)\n\n        element.LayoutOrder = blockOrder\n        element.Parent = section\n    end\n\n    if not isLast then\n        createService.new('Frame', 'Line', section, {\n            BorderSizePixel = 0,\n            LayoutOrder = #blocks + 1,\n            Size = UDim2.new(1, 0, 0, 1),\n            ThemeTag = {\n                BackgroundColor3 = 'Colors.Stroke',\n            },\n        })\n    end\n\n    return section\nend\n\nfunction reference.new()\n    return setmetatable({\n        isOpen = false,\n        onOpenChanged = nil,\n    }, reference)\nend\nfunction reference:setOpen(open)\n    self.isOpen = open\n\n    if self.onOpenChanged then\n        self.onOpenChanged(open)\n    end\nend\nfunction reference:open()\n    self:setOpen(true)\n    self.frame:TweenPosition(SHOWN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, TWEEN_TIME, true)\nend\nfunction reference:close()\n    self:setOpen(false)\n    self.frame:TweenPosition(HIDDEN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, TWEEN_TIME, true)\nend\nfunction reference:create()\n    local frame = createService.new('Frame', 'ReferenceFrame', {\n        Active = true,\n        BorderSizePixel = 0,\n        Position = HIDDEN_POSITION,\n        Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n    })\n    local topBar = createService.new('Frame', 'TopBar', frame, {\n        BorderSizePixel = 0,\n        Size = UDim2.new(1, 0, 0, TOP_BAR_HEIGHT),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n    })\n\n    createService.new('TextLabel', 'Title', topBar, {\n        BackgroundTransparency = 1,\n        Size = UDim2.fromScale(1, 1),\n        Text = 'Reference',\n        TextSize = 16,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n\n    local closeButton = createService.new('TextButton', 'Close', topBar, {\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -TOP_BAR_HEIGHT, 0, 0),\n        Size = UDim2.fromOffset(TOP_BAR_HEIGHT, TOP_BAR_HEIGHT),\n        Text = '',\n    })\n    local closeIcon = createService.new('ImageLabel', 'Icon', closeButton, {\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(5, 5),\n        Size = UDim2.fromOffset(10, 10),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n    local scrollBar = scrollBarComponent.new({\n        isHorizontal = false,\n        barThickness = SCROLL_THICKNESS,\n        increment = SCROLL_INCREMENT,\n        wheelIncrement = SCROLL_WHEEL_INCREMENT,\n    })\n    local scrollBarFrame = scrollBar:create()\n    local container = scrollBar.container\n    local content = createService.new('Frame', 'Content', container, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIListLayout', {\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n\n    createService.new('Frame', 'ScrollHolder', frame, {\n        Active = true,\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(0, TOP_BAR_HEIGHT),\n        Size = UDim2.new(1, 0, 0, CONTENT_HEIGHT),\n        scrollBarFrame,\n        container,\n    })\n\n    for order, blocks in SECTIONS do\n        local section = createSection(order, blocks, order == #SECTIONS)\n\n        section.Parent = content\n    end\n\n    local function applyScroll(index)\n        content.Position = UDim2.fromOffset(0, -index)\n    end\n    local function refreshScroll()\n        local scale = scaleObject:getScale()\n\n        scrollBar:setTotalSpace(math.ceil(content.AbsoluteSize.Y / scale))\n        scrollBar:setVisibleSpace(math.ceil(container.AbsoluteSize.Y / scale))\n        applyScroll(scrollBar.index)\n    end\n\n    connectionService:Connect(scrollBar.scrolledSignal, applyScroll)\n    connectionService:Connect(content:GetPropertyChangedSignal('AbsoluteSize'), refreshScroll)\n    connectionService:Connect(container:GetPropertyChangedSignal('AbsoluteSize'), refreshScroll)\n    connectionService:Connect(closeButton.Activated, function()\n        self:close()\n    end)\n    dragInstance:addGuiObject(frame)\n    dragInstance.dragStarted:Connect(function(object)\n        if object ~= frame then\n            return\n        end\n\n        scrollBar:disableScroll()\n    end)\n    dragInstance.dragEnded:Connect(function(object)\n        if object ~= frame then\n            return\n        end\n\n        scrollBar:enableScroll()\n    end)\n    refreshScroll()\n\n    self.frame = frame\n    self.closeIcon = closeIcon\n    self.scrollBar = scrollBar\n\n    return frame\nend\n\nreturn reference\n",
[ "src/ui/components/scrollBar.luau" ] = "local connectionService = require('../../framework/services/connectionService')\nlocal createService = require('../services/createService')\nlocal playerService = require('../../framework/services/playerService')\nlocal themeService = require('../services/themeService')\nlocal createArrow = require('../elements/arrow')\nlocal scaleObject = require('../utils/scaleObject')\nlocal signal = require('../../utils/signal')\nlocal inputUtils = require('../utils/inputUtils')\nlocal scrollBar = {}\n\nscrollBar.__index = scrollBar\n\nfunction scrollBar:awake()\n    local playerMouse = playerService:getMouse()\n    local scrollThumbFrame = self.scrollThumbFrame\n    local scrollThumb = self.scrollThumb\n    local scrollBar = self.scrollBar\n    local isPressingButton = false\n    local isPressingThumb = false\n    local pressingButton = nil\n\n    local function handleButtonPress(button, direction)\n        local function onStartedPressing()\n            if isPressingButton then\n                return\n            end\n            if not self:canScroll(direction) then\n                return\n            end\n\n            isPressingButton = true\n\n            self:scrollToDirection(direction)\n            inputUtils.onReleaseEvent(function()\n                isPressingButton = false\n            end)\n            task.wait(0.4)\n\n            while self:canScroll(direction) and isPressingButton do\n                self:scrollToDirection(direction)\n                task.wait(1 / 15)\n            end\n        end\n\n        connectionService:Connect(button.MouseButton1Down, onStartedPressing)\n    end\n\n    handleButtonPress(self.upButton, 'up')\n    handleButtonPress(self.downButton, 'down')\n\n    local function onWheel(sign)\n        if self.locked then\n            return\n        end\n\n        self:scrollTo(self.index + sign * self.wheelIncrement)\n    end\n\n    for _, target in {\n        scrollBar,\n        self.container,\n    }do\n        connectionService:Connect(target.MouseWheelForward, function()\n            onWheel(-1)\n        end)\n        connectionService:Connect(target.MouseWheelBackward, function()\n            onWheel(1)\n        end)\n    end\n\n    connectionService:Connect(scrollBar.InputBegan, function(input)\n        if not inputUtils.isPressingInput(input) then\n            return\n        end\n        if self:isScrollBarDisabled() then\n            return\n        end\n\n        local isHoldingFrame = not playerService:isMouseInGuiObject(scrollThumb)\n        local direction = self.isHorizontal and 'X' or 'Y'\n        local lastThumbPos = nil\n\n        isPressingThumb = true\n\n        themeService:updateObjectProperties(scrollThumb, {\n            BackgroundColor3 = 'Colors.Primary',\n        })\n\n        local mouseOffset = playerMouse[direction] - scrollThumb.AbsolutePosition[direction]\n        local mouseEvent\n\n        local function disconnect()\n            if mouseEvent then\n                mouseEvent:Disconnect()\n            end\n        end\n\n        inputUtils.onReleaseEvent(function()\n            disconnect()\n\n            isPressingThumb = false\n\n            themeService:updateObjectProperties(scrollThumb, {\n                BackgroundColor3 = 'Colors.OnPrimary',\n            })\n        end)\n\n        if isHoldingFrame then\n            local function updateDirection()\n                if self.locked then\n                    return\n                end\n\n                local scrollDir = (playerMouse[direction] >= scrollThumb.AbsolutePosition[direction] + scrollThumb.AbsoluteSize[direction]) and 1 or 0\n                local scrollSize = self.visibleSpace - 1\n\n                if scrollDir == 0 and (playerMouse[direction] < scrollThumb.AbsolutePosition[direction]) then\n                    self:scrollTo(self.index - scrollSize)\n                elseif scrollDir == 1 and (playerMouse[direction] >= scrollThumb.AbsolutePosition[direction] + scrollThumb.AbsoluteSize[direction]) then\n                    self:scrollTo(self.index + scrollSize)\n                end\n            end\n\n            while isPressingThumb do\n                updateDirection()\n                task.wait(1 / 4)\n            end\n\n            return\n        end\n\n        mouseEvent = inputUtils.onMouseEvent(function(input)\n            if not isPressingThumb then\n                return\n            end\n            if self.locked then\n                return\n            end\n\n            local thumbFrameSize = scrollThumbFrame.AbsoluteSize[direction] - scrollThumb.AbsoluteSize[direction]\n            local pos = playerMouse[direction] - scrollThumbFrame.AbsolutePosition[direction] - mouseOffset\n\n            if pos > thumbFrameSize then\n                pos = thumbFrameSize\n            elseif pos < 0 then\n                pos = 0\n            end\n            if lastThumbPos ~= pos then\n                lastThumbPos = pos\n\n                self:scrollTo(math.floor(0.5 + pos / thumbFrameSize * (self.totalSpace - self.visibleSpace)))\n            end\n        end)\n    end)\nend\nfunction scrollBar:create()\n    self.upButton = createService.new('ImageButton', self.upButtonName, {\n        BackgroundTransparency = 1,\n        AutoButtonColor = false,\n    })\n    self.downButton = createService.new('ImageButton', self.downButtoName, {\n        BackgroundTransparency = 1,\n        AutoButtonColor = false,\n    })\n\n    self:createButtonsArrows()\n\n    local scrollBar = createService.new('Frame', 'ScrollBar', {\n        Active = true,\n        BackgroundTransparency = 1,\n        self.upButton,\n        self.downButton,\n        createService.new('Frame', 'ScrollThumbFrame', {\n            BackgroundTransparency = 1,\n            AnchorPoint = self.isHorizontal and Vector2.new(0.5, 0) or Vector2.new(0, 0.5),\n            Position = self.isHorizontal and UDim2.fromScale(0.5, 0) or UDim2.fromScale(0, 0.5),\n            createService.new('Frame', 'ScrollThumb', {\n                AnchorPoint = self.isHorizontal and Vector2.new(0, 0.5) or Vector2.new(0.5, 0),\n                ThemeTag = {\n                    BackgroundColor3 = 'Colors.OnPrimary',\n                },\n                createService.new('UICorner', {\n                    CornerRadius = UDim.new(0, 4),\n                }),\n            }),\n            createService.new('Frame', 'MarkerFrame', {\n                BackgroundTransparency = 1,\n                Size = UDim2.fromScale(1, 1),\n            }),\n        }),\n    })\n\n    self.scrollBar = scrollBar\n    self.scrollThumbFrame = scrollBar.ScrollThumbFrame\n    self.scrollThumb = scrollBar.ScrollThumbFrame.ScrollThumb\n    self.markerFrame = scrollBar.ScrollThumbFrame.MarkerFrame\n    self.container = createService.new('Frame', 'Container', {\n        BackgroundTransparency = 1,\n        ClipsDescendants = true,\n        Active = true,\n    })\n\n    self:setScrollBarThickness(self.barThickness)\n    self:awake()\n    self:update()\n\n    return scrollBar\nend\nfunction scrollBar:createButtonsArrows()\n    local downButton = self.downButton\n    local upButton = self.upButton\n\n    createArrow(4, 0.55, downButton.Name).Parent = downButton\n    createArrow(4, 0.55, upButton.Name).Parent = upButton\nend\nfunction scrollBar:canScrollUp()\n    return self:isScrollBarEnabled() and self.index > 0\nend\nfunction scrollBar:canScrollDown()\n    local enabled = self:isScrollBarEnabled()\n\n    return enabled and self.index + self.visibleSpace < self.totalSpace\nend\nfunction scrollBar:canScroll(direction)\n    if self.locked then\n        return false\n    end\n    if direction == 'up' or direction == 'left' then\n        return self:canScrollUp()\n    elseif direction == 'down' or direction == 'right' then\n        return self:canScrollDown()\n    end\n\n    return false\nend\nfunction scrollBar:getScrollPercent()\n    local range = self.totalSpace - self.visibleSpace\n\n    if range <= 0 then\n        return 0\n    end\n\n    return self.index / range\nend\nfunction scrollBar:scrollTo(targetIndex, silent)\n    local maxIndex = math.max(0, self.totalSpace - self.visibleSpace)\n\n    self.index = math.clamp(targetIndex, 0, maxIndex)\n\n    self:update()\n\n    if not silent then\n        self.scrolledSignal:Fire(self.index)\n    end\nend\nfunction scrollBar:scrollUp()\n    self:scrollTo(self.index - self.increment)\nend\nfunction scrollBar:scrollDown()\n    self:scrollTo(self.index + self.increment)\nend\nfunction scrollBar:scrollToDirection(direction)\n    if direction == 'up' or direction == 'left' then\n        return self:scrollUp()\n    elseif direction == 'down' or direction == 'right' then\n        return self:scrollDown()\n    end\nend\nfunction scrollBar:isVisible(position)\n    local index = self.index\n\n    if position >= index and position < (index + self.visibleSpace) then\n        return true\n    end\n\n    return false\nend\nfunction scrollBar:setScrollPercent(percent)\n    local range = self.totalSpace - self.visibleSpace\n\n    self:scrollTo(math.floor(percent * range))\nend\nfunction scrollBar:update()\n    self:drawThumb()\nend\nfunction scrollBar:setScrollBarThickness(thickness)\n    local scrollThumbFrame = self.scrollThumbFrame\n    local downButton = self.downButton\n    local container = self.container\n    local scrollBar = self.scrollBar\n    local upButton = self.upButton\n\n    self.barThickness = thickness\n\n    if container then\n        container.Size = UDim2.new(1, self.isHorizontal and 0 or -thickness, 1, self.isHorizontal and \n-thickness or 0)\n    end\n    if scrollBar then\n        scrollBar.Size = self.isHorizontal and UDim2.new(1, 0, 0, thickness) or UDim2.new(0, thickness, 1, 0)\n        scrollBar.Position = self.isHorizontal and UDim2.new(0, 0, 1, -thickness) or UDim2.new(1, \n-thickness, 0, 0)\n    end\n    if scrollThumbFrame then\n        scrollThumbFrame.Size = self.isHorizontal and UDim2.new(1, -(thickness * 2), 0, thickness) or UDim2.new(0, thickness, 1, \n-(thickness * 2))\n    end\n    if downButton then\n        downButton.Size = UDim2.fromOffset(thickness, thickness)\n        downButton.Position = self.isHorizontal and UDim2.new(1, -thickness, 0, 0) or UDim2.new(0, 0, 1, \n-thickness)\n    end\n    if upButton then\n        upButton.Size = UDim2.fromOffset(thickness, thickness)\n        upButton.Position = UDim2.fromOffset(0, 0)\n    end\nend\nfunction scrollBar:updateArrowTransparency(button, transparent)\n    if not button:FindFirstChild('Arrow') then\n        return\n    end\n\n    for _, frame in button.Arrow:GetChildren()do\n        if not frame:IsA('GuiObject') then\n            continue\n        end\n\n        frame.Transparency = transparent and 0.6 or 0\n    end\nend\nfunction scrollBar:drawThumb()\n    local thumb = self.scrollThumb\n    local thumbFrame = self.scrollThumbFrame\n    local canUp = self:canScrollUp()\n    local canDown = self:canScrollDown()\n\n    self:updateArrowTransparency(self.upButton, not canUp)\n    self:updateArrowTransparency(self.downButton, not canDown)\n\n    if not thumb or not thumbFrame then\n        return\n    end\n    if not canUp and not canDown then\n        thumb.Visible = false\n\n        return\n    end\n\n    thumb.Visible = true\n\n    local percent = self:getScrollPercent()\n    local scale = scaleObject:getScale()\n    local thickness = self.barThickness\n\n    if self.isHorizontal then\n        local frameW = thumbFrame.AbsoluteSize.X / scale\n        local thumbW = math.max(thickness, (self.visibleSpace / self.totalSpace) * frameW)\n\n        thumb.Size = UDim2.new(0, thumbW, 1, -2)\n        thumb.Position = UDim2.new(0, percent * (frameW - thumbW), 0.5, 0)\n    else\n        local frameH = thumbFrame.AbsoluteSize.Y / scale\n        local thumbH = math.max(thickness, (self.visibleSpace / self.totalSpace) * frameH)\n\n        thumb.Size = UDim2.new(1, -2, 0, thumbH)\n        thumb.Position = UDim2.new(0.5, 0, 0, percent * (frameH - thumbH))\n    end\nend\nfunction scrollBar:addMarker(index, color)\n    self.markers[index] = color or Color3.new(1, 1, 0)\n\n    self:updateMarkers()\nend\nfunction scrollBar:removeMarker(index)\n    self.markers[index] = nil\n\n    self:updateMarkers()\nend\nfunction scrollBar:updateMarkers()\n    local markerFrame = self.markerFrame\n\n    if not markerFrame then\n        return\n    end\n\n    for _, child in pairs(markerFrame:GetChildren())do\n        child:Destroy()\n    end\n    for index, color in pairs(self.markers)do\n        if index >= self.totalSpace then\n            continue\n        end\n\n        local marker = Instance.new('Frame')\n\n        marker.BackgroundColor3 = color\n        marker.BorderSizePixel = 0\n        marker.BackgroundTransparency = 0\n        marker.Parent = markerFrame\n\n        local ratio = index / self.totalSpace\n\n        if self.isHorizontal then\n            marker.Position = UDim2.new(ratio, 0, 1, -4)\n            marker.Size = UDim2.new(0, 2, 0, 4)\n        else\n            marker.Position = UDim2.new(1, -4, ratio, 0)\n            marker.Size = UDim2.new(0, 4, 0, 2)\n        end\n\n        marker.Name = 'Marker_' .. tostring(index)\n    end\nend\nfunction scrollBar:setTotalSpace(total)\n    self.totalSpace = total\n\n    self:scrollTo(self.index, true)\n    self:update()\nend\nfunction scrollBar:setVisibleSpace(visible)\n    self.visibleSpace = visible\n\n    self:scrollTo(self.index, true)\n    self:update()\nend\nfunction scrollBar:disableScroll()\n    self.scrollBarEnabled = false\n\n    self:drawThumb()\nend\nfunction scrollBar:enableScroll()\n    self.scrollBarEnabled = true\n\n    self:drawThumb()\nend\nfunction scrollBar:isScrollBarEnabled()\n    return self.scrollBarEnabled\nend\nfunction scrollBar:isScrollBarDisabled()\n    return not self.scrollBarEnabled or self.locked\nend\nfunction scrollBar:setLocked(locked)\n    self.locked = locked == true\nend\nfunction scrollBar:isLocked()\n    return self.locked\nend\nfunction scrollBar.new(config)\n    local self = setmetatable({\n        isHorizontal = config.isHorizontal or false,\n        increment = config.increment or 1,\n        wheelIncrement = config.wheelIncrement or 3,\n        barThickness = config.barThickness or 16,\n        scrollBarEnabled = true,\n        locked = false,\n        index = 0,\n        visibleSpace = config.visibleSpace or 0,\n        totalSpace = config.totalSpace or 0,\n        markers = {},\n        scrollBar = config.scrollBar or nil,\n        scrollThumb = config.scrollThumb or nil,\n        scrollThumbFrame = config.scrollThumbFrame or nil,\n        markerFrame = config.markerFrame or nil,\n        scrolledSignal = signal.new(),\n    }, scrollBar)\n\n    self.upButtonName = self.isHorizontal and 'left' or 'up'\n    self.downButtoName = self.isHorizontal and 'right' or 'down'\n\n    return self\nend\n\nreturn scrollBar\n",
[ "src/ui/components/searchBox.luau" ] = "local signal = require('../../utils/signal')\nlocal searchBox = {}\n\nsearchBox.__index = searchBox\n\nfunction searchBox.new()\n    return setmetatable({}, searchBox)\nend\n\nreturn searchBox\n",
[ "src/ui/components/serverinfo.luau" ] = "local createService = require('../services/createService')\nlocal assetsService = require('../services/assetsService')\nlocal themeService = require('../services/themeService')\nlocal dragInstance = require('../utils/dragInstance')\nlocal notifier = require('../notifier')\nlocal tools = require('../../utils/tools')\nlocal scaleObject = require('../utils/scaleObject')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal executorEnv = require('../../framework/environment/executor')\nlocal localPlayer = require('../../framework/services/localPlayer')\nlocal robloxServices = require('../../framework/services/rbxServices')\nlocal privateEnv = require('../../framework/environment/private')\nlocal config = require('../../framework/config/ui/serverinfo')\nlocal textHighlight = require('../../utils/textHighlight')\nlocal SHOWN_POSITION = UDim2.new(0.5, -config.window.width / 2, 0, config.window.shownY)\nlocal HIDDEN_POSITION = UDim2.new(0.5, -config.window.width / 2, 0, config.window.hiddenY)\nlocal info = {}\n\nlocal function highlight(text)\n    return textHighlight:apply(text)\nend\nlocal function line(prefix, value)\n    return `{tools.escapeRichText(prefix)}{highlight(value)}`\nend\nlocal function copyToClipboard(value)\n    if value == nil then\n        return false\n    end\n    if executorEnv.setclipboard then\n        executorEnv.setclipboard(tostring(value))\n\n        return true\n    end\n\n    notifier:notify(config.messages.noClipboard)\n\n    return false\nend\nlocal function formatTime(totalSeconds)\n    local units = config.time\n    local hours = math.floor(totalSeconds / 3600)\n    local minutes = math.floor((totalSeconds % 3600) / 60)\n    local seconds = math.floor(totalSeconds % 60)\n\n    if hours > 0 then\n        return `{hours} {units.hour}, {minutes} {units.minute}, {seconds} {units.second}`\n    elseif minutes > 0 then\n        return `{minutes} {units.minute}, {seconds} {units.second}`\n    end\n\n    return `{seconds} {units.second}`\nend\nlocal function fetchPlaceName()\n    local success, productInfo = pcall(function()\n        return robloxServices.MarketplaceService:GetProductInfo(game.PlaceId)\n    end)\n\n    if success and productInfo then\n        return productInfo.Name\n    end\n\n    return config.messages.unknownPlace\nend\nlocal function createCopyButton(row, getValue)\n    local copyConfig = config.copyButton\n    local button = createService.new('TextButton', 'Copy', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, -config.window.textInset, 0.5, 0),\n        Size = UDim2.fromOffset(copyConfig.width, copyConfig.height),\n        Text = copyConfig.idleText,\n        TextSize = config.textSizes.copyButton,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, copyConfig.cornerRadius),\n        }),\n    })\n\n    connectionService:Connect(button.MouseEnter, function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Buttons.Holding',\n        })\n    end)\n    connectionService:Connect(button.MouseLeave, function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        })\n    end)\n    connectionService:Connect(button.Activated, function()\n        if not copyToClipboard(getValue()) then\n            return\n        end\n\n        button.Text = copyConfig.copiedText\n\n        task.wait(copyConfig.feedbackTime)\n\n        button.Text = copyConfig.idleText\n    end)\n\n    return button\nend\nlocal function createLine(body, layoutOrder, text, options)\n    local windowConfig = config.window\n    local inset = windowConfig.textInset\n    local copyWidth = 0\n\n    if options.getCopyValue then\n        copyWidth = config.copyButton.width + config.copyButton.gap\n    end\n\n    local row = createService.new('Frame', 'Row', body, {\n        BackgroundColor3 = Color3.new(1, 1, 1),\n        BackgroundTransparency = (layoutOrder % 2 == 1) and windowConfig.stripeTransparency or 1,\n        BorderSizePixel = 0,\n        LayoutOrder = layoutOrder,\n        Size = UDim2.new(1, 0, 0, windowConfig.rowHeight),\n    })\n    local label = createService.new('TextLabel', options.name, row, {\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(inset, 0),\n        RichText = true,\n        Size = UDim2.new(1, -(inset * 2 + copyWidth), 1, 0),\n        Text = text,\n        TextSize = options.textSize,\n        TextTruncate = Enum.TextTruncate.AtEnd,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Center,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = options.textColor,\n        },\n    })\n\n    if options.getCopyValue then\n        createCopyButton(row, options.getCopyValue)\n    end\n\n    return label\nend\nlocal function createSection(body, layoutOrder, title)\n    return createLine(body, layoutOrder, `<b>{tools.escapeRichText(title)}</b>`, {\n        name = 'Section',\n        textSize = config.textSizes.section,\n        textColor = 'Colors.Text.Darker',\n    })\nend\nlocal function createValueLine(body, layoutOrder, text, getCopyValue)\n    return createLine(body, layoutOrder, text, {\n        name = 'Value',\n        textSize = config.textSizes.value,\n        textColor = 'Colors.Text.Default',\n        getCopyValue = getCopyValue,\n    })\nend\nlocal function createWindow()\n    local windowConfig = config.window\n    local window = {\n        labels = {},\n        placeName = nil,\n    }\n    local frame = createService.new('Frame', 'ServerInfo', {\n        Active = true,\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Position = HIDDEN_POSITION,\n        Size = UDim2.fromOffset(windowConfig.width, 0),\n        createService.new('UIListLayout', {\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local topBar = createService.new('Frame', 'TopBar', frame, {\n        BorderSizePixel = 0,\n        LayoutOrder = 1,\n        Size = UDim2.new(1, 0, 0, windowConfig.topBarHeight),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n    })\n\n    createService.new('TextLabel', 'Title', topBar, {\n        BackgroundTransparency = 1,\n        Size = UDim2.fromScale(1, 1),\n        Text = windowConfig.title,\n        TextSize = config.textSizes.title,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n\n    local closeButton = createService.new('ImageButton', 'Exit', topBar, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -windowConfig.closeInset, 0.5, 0),\n        Size = UDim2.fromOffset(windowConfig.closeIconSize, windowConfig.closeIconSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    assetsService:loadImage(closeButton, 'close')\n    connectionService:Connect(closeButton.Activated, function()\n        info:close()\n    end)\n\n    local body = createService.new('Frame', 'Body', frame, {\n        Active = true,\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BorderSizePixel = 0,\n        LayoutOrder = 2,\n        Size = UDim2.new(1, 0, 0, 0),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n        createService.new('UIPadding', {\n            PaddingBottom = UDim.new(0, windowConfig.verticalPadding),\n            PaddingTop = UDim.new(0, windowConfig.verticalPadding),\n        }),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, windowConfig.rowGap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local labels = window.labels\n    local labelsConfig = config.labels\n    local loading = config.messages.loading\n    local layoutOrder = 0\n\n    local function nextOrder()\n        layoutOrder = layoutOrder + 1\n\n        return layoutOrder\n    end\n\n    createSection(body, nextOrder(), config.headers.localPlayer)\n\n    labels.playerId = createValueLine(body, nextOrder(), line(labelsConfig.playerId, localPlayer.UserId), function(\n    )\n        return localPlayer.UserId\n    end)\n    labels.appearance = createValueLine(body, nextOrder(), line(labelsConfig.appearance, localPlayer.CharacterAppearanceId), function(\n    )\n        return localPlayer.CharacterAppearanceId\n    end)\n\n    createSection(body, nextOrder(), config.headers.runTime)\n\n    labels.time = createValueLine(body, nextOrder(), highlight(loading))\n\n    createSection(body, nextOrder(), config.headers.statistics)\n\n    labels.players = createValueLine(body, nextOrder(), line(labelsConfig.players, loading))\n    labels.maxPlayers = createValueLine(body, nextOrder(), line(labelsConfig.maxPlayers, loading))\n    labels.placeId = createValueLine(body, nextOrder(), line(labelsConfig.placeId, game.PlaceId), function(\n    )\n        return game.PlaceId\n    end)\n    labels.gameId = createValueLine(body, nextOrder(), line(labelsConfig.gameId, game.GameId), function(\n    )\n        return game.GameId\n    end)\n    labels.placeName = createValueLine(body, nextOrder(), line(labelsConfig.placeName, loading), function(\n    )\n        return window.placeName\n    end)\n\n    dragInstance:addGuiObject(frame)\n\n    window.frame = frame\n\n    return window\nend\nlocal function updateWindow(window)\n    local labels = window.labels\n    local labelsConfig = config.labels\n    local players = robloxServices.Players\n\n    while info.window == window do\n        labels.players.Text = line(labelsConfig.players, #players:GetPlayers())\n        labels.maxPlayers.Text = line(labelsConfig.maxPlayers, players.MaxPlayers)\n        labels.time.Text = highlight(formatTime(workspace.DistributedGameTime))\n\n        task.wait(config.window.updateInterval)\n    end\nend\n\nfunction info:create()\n    if self.isEnabled then\n        notifier:notify(config.messages.alreadyEnabled)\n\n        return\n    end\n\n    self.isEnabled = true\n\n    local window = createWindow()\n\n    self.window = window\n\n    local tweenTime = config.window.tweenTime\n\n    window.frame.Parent = privateEnv.screenGui\n\n    window.frame:TweenPosition(SHOWN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, tweenTime, true)\n    task.spawn(function()\n        window.placeName = fetchPlaceName()\n        window.labels.placeName.Text = line(config.labels.placeName, window.placeName)\n    end)\n    task.spawn(updateWindow, window)\n\n    return window\nend\nfunction info:close()\n    local window = self.window\n\n    if not window then\n        return\n    end\n\n    local tweenTime = config.window.tweenTime\n\n    self.window = nil\n    self.isEnabled = false\n\n    window.frame:TweenPosition(HIDDEN_POSITION, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, tweenTime, true)\n    task.delay(tweenTime, function()\n        window.frame:Destroy()\n    end)\nend\n\nreturn info\n",
[ "src/ui/components/settings/aliasesEditor.luau" ] = "local aliasesData = require('../../../storage/data/aliases')\nlocal customAliases = require('../../../commands/systems/customAliases')\nlocal commandsList = require('../../../commands/list')\nlocal config = require('../../../framework/config/ui/settings')\nlocal notifier = require('../../notifier')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal VALUE = config.value\nlocal TEXT = config.pages.aliases\n\nlocal function trim(text)\n    return text:match('^%s*(.-)%s*$') or ''\nend\nlocal function hasReservedCharacter(alias)\n    return alias:find('[\\\\%^!,|&\"\\']') ~= nil\nend\nlocal function build(page, ctx)\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, config.pages.aliases.title, ctx.back)\n    widgets.header(list, TEXT.addTitle)\n\n    local aliasBox = widgets.textBox(list, TEXT.aliasHint)\n    local commandBox = widgets.textBox(list, TEXT.commandHint)\n    local addRow = widgets.row(list)\n\n    widgets.label(addRow, TEXT.addButton, 0)\n\n    local note = widgets.note(list, '')\n\n    widgets.header(list, TEXT.listTitle)\n    widgets.note(list, TEXT.listHint)\n\n    local rowsGroup = widgets.group(list)\n    local renderAliases\n\n    local function askUndo(alias, commandName)\n        notifier:ask(TEXT.undoTitle, string.format(TEXT.undoMessage, alias, commandName), {\n            {\n                text = TEXT.undo,\n                primary = true,\n                onTap = function()\n                    local added, reason = customAliases.add(commandsList, alias, commandName)\n\n                    if not added then\n                        notifier:notify(TEXT.notifyTitle, reason or '')\n\n                        return\n                    end\n                    if rowsGroup.Parent then\n                        note.Text = string.format(TEXT.restored, alias)\n\n                        renderAliases()\n                    end\n                end,\n            },\n        }, TEXT.undoTime)\n    end\n\n    function renderAliases()\n        widgets.clear(rowsGroup)\n\n        local aliases = aliasesData:getData()\n        local names = {}\n\n        for alias in aliases do\n            table.insert(names, alias)\n        end\n\n        table.sort(names)\n\n        local rows = widgets.list(rowsGroup)\n\n        if #names == 0 then\n            widgets.note(rows, TEXT.empty)\n\n            return\n        end\n\n        for _, alias in names do\n            local row = widgets.row(rows)\n\n            widgets.label(row, alias, VALUE.aliasWidth + 2 * PANEL.padding)\n            widgets.value(row, tostring(aliases[alias]), VALUE.aliasWidth)\n            row.Activated:Connect(function()\n                local removed, target = customAliases.remove(commandsList, alias)\n\n                if removed then\n                    note.Text = string.format(TEXT.removed, alias)\n\n                    askUndo(alias, target)\n                end\n\n                renderAliases()\n            end)\n        end\n    end\n\n    local function addAlias()\n        local alias = trim(aliasBox.Text)\n        local commandName = trim(commandBox.Text)\n\n        if alias == '' or commandName == '' then\n            note.Text = TEXT.missing\n\n            return\n        end\n        if alias:find('%s') then\n            note.Text = TEXT.spaces\n\n            return\n        end\n        if hasReservedCharacter(alias) then\n            note.Text = TEXT.badCharacters\n\n            return\n        end\n\n        local added, reason = customAliases.add(commandsList, alias, commandName)\n\n        if added then\n            note.Text = string.format(TEXT.added, alias:lower())\n            aliasBox.Text = ''\n            commandBox.Text = ''\n\n            renderAliases()\n        else\n            note.Text = reason or ''\n        end\n    end\n\n    addRow.Activated:Connect(addAlias)\n    aliasBox.FocusLost:Connect(function(enterPressed)\n        if enterPressed then\n            commandBox:CaptureFocus()\n        end\n    end)\n    commandBox.FocusLost:Connect(function(enterPressed)\n        if enterPressed then\n            addAlias()\n        end\n    end)\n    renderAliases()\nend\n\nreturn build\n",
[ "src/ui/components/settings/dialog.luau" ] = "local createService = require('../../services/createService')\nlocal widgets = require('./widgets')\nlocal config = require('../../../framework/config/ui/settings')\nlocal PANEL = config.panel\nlocal VALUE = config.value\nlocal TEXT = config.textSizes\nlocal DIALOG = config.dialog\nlocal dialog = {}\n\ndialog.__index = dialog\n\nfunction dialog.new(holder)\n    local overlay = createService.new('Frame', 'Dialog', holder, {\n        Active = true,\n        BackgroundColor3 = Color3.new(0, 0, 0),\n        BackgroundTransparency = DIALOG.dimTransparency,\n        BorderSizePixel = 0,\n        Size = UDim2.fromScale(1, 1),\n        Visible = false,\n        ZIndex = DIALOG.zIndex,\n    })\n    local card = createService.new('Frame', 'Card', overlay, {\n        AnchorPoint = Vector2.new(0.5, 0.5),\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BorderSizePixel = 0,\n        Position = UDim2.fromScale(0.5, 0.5),\n        Size = UDim2.new(1, -2 * DIALOG.margin, 0, 0),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n        createService.new('UIStroke', {\n            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,\n            Thickness = 1,\n            ThemeTag = {\n                Color = 'Colors.Border.Default',\n            },\n        }),\n        createService.new('UIPadding', {\n            PaddingBottom = UDim.new(0, DIALOG.padding),\n            PaddingLeft = UDim.new(0, DIALOG.padding),\n            PaddingRight = UDim.new(0, DIALOG.padding),\n            PaddingTop = UDim.new(0, DIALOG.padding),\n        }),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, DIALOG.gap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local title = createService.new('TextLabel', 'Title', card, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        LayoutOrder = 1,\n        Size = UDim2.new(1, 0, 0, 0),\n        Text = '',\n        TextSize = TEXT.label,\n        TextWrapped = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    local message = createService.new('TextLabel', 'Message', card, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        LayoutOrder = 2,\n        Size = UDim2.new(1, 0, 0, 0),\n        Text = '',\n        TextSize = TEXT.value,\n        TextWrapped = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Top,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    local buttons = createService.new('Frame', 'Buttons', card, {\n        BackgroundTransparency = 1,\n        LayoutOrder = 3,\n        Size = UDim2.new(1, 0, 0, PANEL.rowHeight),\n        createService.new('UIListLayout', {\n            FillDirection = Enum.FillDirection.Horizontal,\n            HorizontalAlignment = Enum.HorizontalAlignment.Right,\n            Padding = UDim.new(0, PANEL.rowGap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n            VerticalAlignment = Enum.VerticalAlignment.Center,\n        }),\n    })\n\n    return setmetatable({\n        overlay = overlay,\n        title = title,\n        message = message,\n        buttons = buttons,\n    }, dialog)\nend\nfunction dialog:show(title, message, choices)\n    self.title.Text = title\n    self.message.Text = message\n\n    widgets.clear(self.buttons)\n\n    for index, choice in choices do\n        local button = createService.new('TextButton', 'Button', self.buttons, {\n            AutoButtonColor = false,\n            BorderSizePixel = 0,\n            LayoutOrder = index,\n            Size = UDim2.fromOffset(DIALOG.buttonWidth, PANEL.rowHeight),\n            Text = choice.text,\n            TextSize = TEXT.label,\n            ThemeTag = {\n                BackgroundColor3 = if choice.primary then'Colors.Primary'else'Colors.Buttons.Default',\n                Font = 'Font.Normal',\n                TextColor3 = 'Colors.Text.Default',\n            },\n            createService.new('UICorner', {\n                CornerRadius = UDim.new(0, VALUE.cornerRadius),\n            }),\n        })\n\n        button.Activated:Connect(function()\n            self:hide()\n\n            if choice.onTap then\n                choice.onTap()\n            end\n        end)\n    end\n\n    self.overlay.Visible = true\nend\nfunction dialog:hide()\n    self.overlay.Visible = false\nend\n\nreturn dialog\n",
[ "src/ui/components/settings/eventBindsEditor.luau" ] = "local eventBinds = require('../../../commands/systems/eventBinds')\nlocal config = require('../../../framework/config/ui/settings')\nlocal notifier = require('../../notifier')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal VALUE = config.value\nlocal TEXT = config.pages.eventBinds\nlocal lastEventIndex = 1\n\nlocal function conditionsOf(bind)\n    local conditions = {}\n\n    for _, text in bind.conditions or {}do\n        table.insert(conditions, tostring(text))\n    end\n\n    return conditions\nend\nlocal function describeBind(bind)\n    local conditions = conditionsOf(bind)\n\n    if #conditions == 0 then\n        return bind.command\n    end\n\n    return `{bind.command}  [{table.concat(conditions, ', ')}]`\nend\nlocal function describeDelay(delay)\n    return `{delay}s`\nend\nlocal function readDelay(text)\n    local digits = text:gsub('%s', ''):gsub('s$', '')\n\n    return tonumber(digits)\nend\nlocal function build(page, ctx)\n    local events = eventBinds.events\n    local eventIndex = math.clamp(lastEventIndex, 1, #events)\n    local conditionBoxes = {}\n    local names = {}\n\n    for _, event in events do\n        table.insert(names, (event.name:gsub('^On', '')))\n    end\n\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, nil, ctx.back)\n\n    local selectEvent, setEventCount\n    local renderEvent\n    local renderBinds\n\n    selectEvent, setEventCount = widgets.choices(list, names, function(index)\n        eventIndex = index\n        lastEventIndex = index\n\n        renderEvent()\n    end, TEXT.columns)\n\n    local function refreshCounts()\n        for index, event in events do\n            setEventCount(index, #eventBinds.getBinds(event.name))\n        end\n    end\n\n    local eventHeader = widgets.header(list, '')\n    local conditionsGroup = widgets.group(list)\n    local commandBox, delayBox, addButton = widgets.formRow(list, TEXT.commandHint, TEXT.delayHint, TEXT.addButton)\n    local note = widgets.note(list, '')\n    local listHeader = widgets.header(list, '')\n    local bindsGroup = widgets.group(list)\n\n    local function currentEvent()\n        return events[eventIndex]\n    end\n    local function refuse(message)\n        note.Text = message\n\n        notifier:notify(TEXT.notifyTitle, message)\n    end\n    local function askUndo(event, index, bind)\n        local message = string.format(TEXT.undoMessage, bind.command, event.name)\n        local details = {}\n        local conditions = conditionsOf(bind)\n\n        if (bind.delay or 0) > 0 then\n            table.insert(details, string.format(TEXT.undoDelay, describeDelay(bind.delay)))\n        end\n        if #conditions > 0 then\n            table.insert(details, `[{table.concat(conditions, ', ')}]`)\n        end\n        if #details > 0 then\n            message ..= '\\n' .. table.concat(details, '  ')\n        end\n\n        notifier:ask(TEXT.undoTitle, message, {\n            {\n                text = TEXT.undo,\n                primary = true,\n                onTap = function()\n                    if eventBinds.restore(event.name, index, bind) then\n                        if bindsGroup.Parent then\n                            note.Text = string.format(TEXT.restored, bind.command)\n\n                            refreshCounts()\n\n                            if currentEvent() == event then\n                                renderBinds()\n                            end\n                        end\n                    end\n                end,\n            },\n        }, TEXT.undoTime)\n    end\n    local function renderConditions()\n        widgets.clear(conditionsGroup)\n\n        conditionBoxes = {}\n\n        local conditionList = widgets.list(conditionsGroup)\n\n        for index, condition in currentEvent().conditions do\n            local _, box = widgets.inputRow(conditionList, condition.label, TEXT.conditionHints[condition.kind] or '', condition.default)\n\n            conditionBoxes[index] = box\n        end\n    end\n\n    function renderBinds()\n        refreshCounts()\n        widgets.clear(bindsGroup)\n\n        local event = currentEvent()\n        local rows = widgets.list(bindsGroup)\n        local binds = eventBinds.getBinds(event.name)\n\n        listHeader.Text = string.format(TEXT.listTitle, event.name) .. (if#binds > 0 then` ({#binds})`else'')\n\n        if #binds == 0 then\n            widgets.note(rows, TEXT.empty)\n\n            return\n        end\n\n        widgets.note(rows, TEXT.listHint)\n\n        for index, bind in binds do\n            local row = widgets.row(rows)\n\n            widgets.label(row, describeBind(bind), VALUE.delayWidth + 2 * PANEL.padding)\n\n            local delayInput = widgets.valueInput(row, describeDelay(bind.delay or 0), VALUE.delayWidth)\n\n            delayInput.FocusLost:Connect(function()\n                if not delayInput.Parent then\n                    return\n                end\n\n                local delay = readDelay(delayInput.Text)\n\n                if delay == nil or delay < 0 then\n                    delayInput.Text = describeDelay(bind.delay or 0)\n\n                    refuse(if delay == nil then TEXT.badDelay else TEXT.negativeDelay)\n\n                    return\n                end\n                if eventBinds.setDelay(event.name, index, delay) then\n                    delayInput.Text = describeDelay(delay)\n                    note.Text = string.format(TEXT.delayChanged, bind.command, describeDelay(delay))\n                end\n            end)\n            row.Activated:Connect(function()\n                local removed = eventBinds.remove(event.name, index)\n\n                if removed then\n                    note.Text = string.format(TEXT.removed, removed.command)\n\n                    renderBinds()\n                    askUndo(event, index, removed)\n                end\n            end)\n        end\n    end\n    function renderEvent()\n        eventHeader.Text = string.format(TEXT.header, currentEvent().name, currentEvent().description)\n        note.Text = ''\n\n        selectEvent(eventIndex)\n        renderConditions()\n        renderBinds()\n    end\n\n    local function addBind()\n        local delay = if delayBox.Text == ''then 0 else readDelay(delayBox.Text)\n\n        if delay == nil then\n            refuse(TEXT.badDelay)\n\n            return\n        end\n        if delay < 0 then\n            refuse(TEXT.negativeDelay)\n\n            return\n        end\n\n        local conditions = {}\n\n        for index, box in conditionBoxes do\n            conditions[index] = box.Text\n        end\n\n        local event = currentEvent()\n        local added, reason = eventBinds.add(event.name, commandBox.Text, delay, conditions)\n\n        if added then\n            commandBox.Text = ''\n\n            renderBinds()\n\n            note.Text = string.format(TEXT.added, event.name)\n        else\n            refuse(reason or TEXT.notAdded)\n        end\n    end\n\n    addButton.Activated:Connect(addBind)\n\n    for _, box in {commandBox, delayBox}do\n        box.FocusLost:Connect(function(enterPressed)\n            if enterPressed then\n                addBind()\n            end\n        end)\n    end\n\n    renderEvent()\nend\n\nreturn build\n",
[ "src/ui/components/settings/importExportEditor.luau" ] = "local themeService = require('../../services/themeService')\nlocal notifier = require('../../notifier')\nlocal widgets = require('./widgets')\nlocal frameworkSettings = require('../../../framework/settings')\nlocal executorEnv = require('../../../framework/environment/executor')\nlocal config = require('../../../framework/config/ui/settings')\nlocal datas = require('../../../storage')\nlocal json = require('../../../utils/json')\nlocal TEXT = config.pages.importExport\nlocal PARTS = {\n    'settings',\n    'aliases',\n    'eventBinds',\n    'waypoints',\n}\n\nlocal function exportText()\n    local data = {\n        version = frameworkSettings.version,\n    }\n\n    for _, name in PARTS do\n        data[name] = datas[name]:getData()\n    end\n\n    return json.encode(data, 'export') or ''\nend\nlocal function isUsableTheme(name)\n    if type(name) ~= 'string' then\n        return false\n    end\n\n    for _, entry in themeService:getThemes()do\n        if entry.key == name:lower() and entry.usable then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function importText(text)\n    if text:match('^%s*$') then\n        return nil, TEXT.empty\n    end\n\n    local data = json.decode(text, 'import')\n\n    if type(data) ~= 'table' then\n        return nil, TEXT.notAnExport\n    end\n\n    local imported = {}\n\n    for _, name in PARTS do\n        if type(data[name]) == 'table' then\n            datas[name]:replaceData(data[name])\n            table.insert(imported, name)\n        end\n    end\n\n    if #imported == 0 then\n        return nil, TEXT.notAnExport\n    end\n\n    local selected = datas.settings:getValue(config.keys.theme)\n\n    if isUsableTheme(selected) then\n        themeService:selectTheme(selected)\n    end\n\n    return imported\nend\nlocal function build(page, ctx)\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, TEXT.title, ctx.back)\n    widgets.header(list, TEXT.exportTitle)\n\n    local exportRow = widgets.row(list)\n\n    widgets.label(exportRow, TEXT.exportRow, 0)\n    widgets.note(list, TEXT.exportHint)\n    widgets.header(list, TEXT.importTitle)\n\n    local box = widgets.textBox(list, TEXT.placeholder)\n\n    box.MultiLine = true\n    box.TextWrapped = true\n    box.TextYAlignment = Enum.TextYAlignment.Top\n    box.Size = UDim2.new(1, 0, 0, 96)\n\n    local importRow = widgets.row(list)\n\n    widgets.label(importRow, TEXT.importRow, 0)\n    widgets.note(list, TEXT.importHint)\n    widgets.note(list, TEXT.restartNote)\n    exportRow.Activated:Connect(function()\n        local text = exportText()\n\n        if executorEnv.setclipboard then\n            executorEnv.setclipboard(text)\n            notifier:notify(TEXT.notifyTitle, TEXT.copied)\n        else\n            box.Text = text\n\n            notifier:notify(TEXT.notifyTitle, TEXT.copyFailed)\n        end\n    end)\n    importRow.Activated:Connect(function()\n        local imported, reason = importText(box.Text)\n\n        if imported then\n            box.Text = ''\n\n            notifier:notify(TEXT.notifyTitle, string.format(TEXT.imported, table.concat(imported, ', ')))\n        else\n            notifier:notify(TEXT.notifyTitle, reason or TEXT.notAnExport)\n        end\n    end)\nend\n\nreturn build\n",
[ "src/ui/components/settings/init.luau" ] = "local createService = require('../../services/createService')\nlocal connectionService = require('../../../framework/services/connectionService')\nlocal settingsData = require('../../../storage/data/settings')\nlocal config = require('../../../framework/config/ui/settings')\nlocal frameworkSettings = require('../../../framework/settings')\nlocal robloxServices = require('../../../framework/services/rbxServices')\nlocal uiTweens = require('../../../framework/services/tweenService')\nlocal widgets = require('./widgets')\nlocal buildThemePicker = require('./themePicker')\nlocal keybindPages = require('./keybindsEditor')\nlocal buildImportExport = require('./importExportEditor')\nlocal buildAliasesEditor = require('./aliasesEditor')\nlocal buildWaypointsEditor = require('./waypointsEditor')\nlocal buildPluginsEditor = require('./pluginsEditor')\nlocal buildEventBindsEditor = require('./eventBindsEditor')\nlocal PANEL = config.panel\nlocal BOX = config.box\nlocal ROW = config.row\nlocal VALUE = config.value\nlocal TweenService = robloxServices.TweenService\nlocal SHOWN_Y = PANEL.shownY\nlocal HIDDEN_Y = PANEL.hiddenY\nlocal FLOAT_SIZE = PANEL.floatBackSize\nlocal FLOAT_REST = UDim2.new(1, -(PANEL.floatBackMargin + PANEL.scrollBarThickness), 0, PANEL.floatBackMargin)\nlocal FLOAT_SQUARE = UDim2.fromOffset(FLOAT_SIZE, FLOAT_SIZE)\nlocal FLOAT_FLAT = UDim2.fromOffset(FLOAT_SIZE * PANEL.floatBackFlat, FLOAT_SIZE)\nlocal FLOAT_START = UDim2.new(1, 0, 0, -FLOAT_SIZE * PANEL.floatBackOut)\nlocal PAGES = {\n    theme = buildThemePicker,\n    keybinds = keybindPages.interface,\n    commands = keybindPages.commands,\n    importExport = buildImportExport,\n    aliases = buildAliasesEditor,\n    waypoints = buildWaypointsEditor,\n    plugins = buildPluginsEditor,\n    eventBinds = buildEventBindsEditor,\n}\nlocal settings = {}\n\nsettings.__index = settings\n\nlocal function saveFlag(key, enabled)\n    settingsData:setValue(key, enabled == true)\n    settingsData:save()\nend\nlocal function readFlag(key)\n    return settingsData:getValue(key) == true\nend\nlocal function slide(frame, position, onDone)\n    frame:TweenPosition(position, Enum.EasingDirection.InOut, Enum.EasingStyle.Quart, PANEL.tweenTime, true, onDone)\nend\n\nfunction settings.isKeepMenuOpen()\n    return readFlag(config.keys.keepMenuOpen)\nend\nfunction settings.setKeepMenuOpen(enabled)\n    saveFlag(config.keys.keepMenuOpen, enabled)\nend\nfunction settings.isKeepIY()\n    return readFlag(config.keys.keepIY)\nend\nfunction settings.setKeepIY(enabled)\n    saveFlag(config.keys.keepIY, enabled)\nend\nfunction settings:createOption(list, option)\n    local row = widgets.row(list)\n\n    if option.icon then\n        widgets.icon(row, option.icon)\n    end\n    if option.kind == 'switch' then\n        local key = config.keys[option.setting]\n\n        widgets.label(row, option.label, BOX.size + 2 * PANEL.padding)\n\n        local _, fill = widgets.box(row)\n\n        local function refresh()\n            fill.Visible = readFlag(key)\n        end\n\n        row.Activated:Connect(function()\n            local enabled = not readFlag(key)\n\n            saveFlag(key, enabled)\n            refresh()\n\n            if self.onSwitch then\n                self.onSwitch(option.setting, enabled)\n            end\n        end)\n        refresh()\n\n        return refresh\n    end\n    if option.kind == 'keybind' then\n        widgets.label(row, option.label, VALUE.keybindWidth + 2 * PANEL.padding)\n\n        local refresh, stop = widgets.keybind(row, option.binding)\n\n        table.insert(self.stoppers, stop)\n\n        return refresh\n    end\n\n    local hasPage = PAGES[option.action] ~= nil\n\n    if hasPage then\n        widgets.chevron(row)\n    end\n\n    widgets.label(row, option.label, if hasPage then ROW.chevronSize + 2 * PANEL.padding else 0)\n    row.Activated:Connect(function()\n        if PAGES[option.action] then\n            self:openPage(option.action)\n        elseif self.onButton then\n            self.onButton(option.action)\n        end\n    end)\n\n    return nil\nend\nfunction settings:createOptions()\n    local list = widgets.list(self.panel)\n\n    for _, section in config.sections do\n        widgets.header(list, section.title)\n\n        for _, option in section.options do\n            local refresh = self:createOption(list, option)\n\n            if refresh then\n                table.insert(self.refreshers, refresh)\n            end\n        end\n    end\n\n    local footer = config.footer:gsub('{name}', frameworkSettings.applicationName):gsub('{version}', frameworkSettings.version)\n\n    widgets.footer(list, footer)\nend\nfunction settings:createPages()\n    for name, build in PAGES do\n        local frame = widgets.page(self.holder, `{name}Page`, UDim2.fromScale(1, HIDDEN_Y))\n\n        frame.Visible = false\n        self.pages[name] = {\n            frame = frame,\n            build = build,\n        }\n    end\nend\nfunction settings.new(options)\n    return setmetatable({\n        onSwitch = options.onSwitch,\n        onButton = options.onButton,\n        onOpenChanged = options.onOpenChanged,\n        isOpen = false,\n        isShown = false,\n        holder = nil,\n        panel = nil,\n        current = nil,\n        pages = {},\n        refreshers = {},\n        stoppers = {},\n        pageStoppers = {},\n        pageConnections = {},\n        backRow = nil,\n        floatingBack = nil,\n        floatingIcon = nil,\n        floatingShown = false,\n        floatingTween = nil,\n        backIcon = nil,\n    }, settings)\nend\nfunction settings:create(parent, listArea)\n    local holder = createService.new('Frame', 'SettingsHolder', parent, {\n        AnchorPoint = listArea.AnchorPoint,\n        BackgroundTransparency = 1,\n        ClipsDescendants = true,\n        Position = listArea.Position,\n        Size = listArea.Size,\n        Visible = false,\n    })\n\n    self.holder = holder\n    self.panel = widgets.page(holder, 'Settings', UDim2.fromScale(0, HIDDEN_Y))\n    self.current = self.panel\n\n    self:createOptions()\n    self:createPages()\n    self:createFloatingBack(holder)\n\n    return holder\nend\nfunction settings:createFloatingBack(holder)\n    local button = createService.new('TextButton', 'FloatingBack', holder, {\n        AnchorPoint = Vector2.new(1, 0),\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = FLOAT_REST,\n        Size = FLOAT_SQUARE,\n        Text = '',\n        Visible = false,\n        ZIndex = 2,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Holding',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n        createService.new('UIStroke', {\n            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,\n            Thickness = 1,\n            ThemeTag = {\n                Color = 'Colors.Border.Default',\n            },\n        }),\n    })\n    local icon = widgets.icon(button, config.pages.backIcon)\n\n    icon.AnchorPoint = Vector2.new(0.5, 0.5)\n    icon.Position = UDim2.fromScale(0.5, 0.5)\n    icon.Size = UDim2.fromScale(ROW.iconSize / PANEL.floatBackSize, ROW.iconSize / PANEL.floatBackSize)\n    icon.ZIndex = button.ZIndex + 1\n\n    button.Activated:Connect(function()\n        self:back()\n    end)\n\n    self.floatingBack = button\n    self.floatingIcon = icon\nend\nfunction settings:syncFloatingIcon()\n    local icon, source = self.floatingIcon, self.backIcon\n\n    if icon and source and source.Image ~= '' and icon.Image ~= source.Image then\n        icon.Image = source.Image\n    end\nend\nfunction settings:updateFloatingBack()\n    local button = self.floatingBack\n\n    if not button then\n        return\n    end\n\n    local page = self.current\n    local row = self.backRow\n    local show = false\n\n    if self.isShown and page ~= self.panel and row and row.Parent then\n        show = row.AbsolutePosition.Y + row.AbsoluteSize.Y <= page.AbsolutePosition.Y\n    end\n    if show then\n        self:syncFloatingIcon()\n    end\n    if show == self.floatingShown then\n        return\n    end\n\n    self.floatingShown = show\n\n    if show then\n        self:showFloatingBack()\n    else\n        self:hideFloatingBack()\n    end\nend\nfunction settings:showFloatingBack()\n    local button = self.floatingBack\n\n    if not button.Visible then\n        button.Position = FLOAT_START\n        button.Size = FLOAT_FLAT\n        button.Visible = true\n    end\n\n    self:tweenFloatingBack(FLOAT_REST, FLOAT_SQUARE, Enum.EasingStyle.Back, Enum.EasingDirection.Out)\nend\nfunction settings:hideFloatingBack()\n    local button = self.floatingBack\n\n    if not button.Visible then\n        return\n    end\n\n    self:tweenFloatingBack(FLOAT_START, FLOAT_FLAT, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function(\n    )\n        button.Visible = false\n    end)\nend\nfunction settings:tweenFloatingBack(position, size, style, direction, onDone)\n    local button = self.floatingBack\n\n    self:stopFloatingTween()\n\n    local duration = uiTweens:getScale(PANEL.floatBackTime)\n\n    if duration <= 0 then\n        button.Position = position\n        button.Size = size\n\n        if onDone then\n            onDone()\n        end\n\n        return\n    end\n\n    local tween = TweenService:Create(button, TweenInfo.new(duration, style, direction), {\n        Position = position,\n        Size = size,\n    })\n\n    self.floatingTween = tween\n\n    tween.Completed:Connect(function(playback)\n        if playback ~= Enum.PlaybackState.Completed then\n            return\n        end\n        if self.floatingTween == tween then\n            self.floatingTween = nil\n        end\n        if onDone then\n            onDone()\n        end\n    end)\n    tween:Play()\nend\nfunction settings:stopFloatingTween()\n    local tween = self.floatingTween\n\n    if not tween then\n        return\n    end\n\n    self.floatingTween = nil\n\n    tween:Cancel()\nend\nfunction settings:refresh()\n    for _, refresh in self.refreshers do\n        refresh()\n    end\nend\nfunction settings:stopWaiting()\n    for _, stop in self.stoppers do\n        stop()\n    end\n    for _, stop in self.pageStoppers do\n        stop()\n    end\nend\nfunction settings:buildPage(page)\n    widgets.clear(page.frame)\n\n    self.pageStoppers = {}\n\n    for _, connection in self.pageConnections do\n        connection:Disconnect()\n    end\n\n    table.clear(self.pageConnections)\n    page.build(page.frame, {\n        back = function()\n            self:back()\n        end,\n        stoppers = self.pageStoppers,\n    })\n\n    self.backRow = page.frame:FindFirstChild('BackRow')\n    self.backIcon = if self.backRow then self.backRow:FindFirstChild('Icon')else nil\n\n    if self.backIcon then\n        table.insert(self.pageConnections, self.backIcon:GetPropertyChangedSignal('Image'):Connect(function(\n        )\n            self:syncFloatingIcon()\n        end))\n        self:syncFloatingIcon()\n    end\n\n    table.insert(self.pageConnections, page.frame:GetPropertyChangedSignal('CanvasPosition'):Connect(function(\n    )\n        self:updateFloatingBack()\n    end))\nend\nfunction settings:hideWhenGone(frame)\n    return function(completed)\n        if completed and frame ~= self.current then\n            frame.Visible = false\n        end\n    end\nend\nfunction settings:openPage(name)\n    local page = self.pages[name]\n\n    if not page or not self.isShown or self.current ~= self.panel then\n        return\n    end\n\n    self:stopWaiting()\n\n    page.frame.Visible = true\n\n    self:buildPage(page)\n\n    page.frame.CanvasPosition = Vector2.zero\n    page.frame.Position = UDim2.fromScale(1, SHOWN_Y)\n    self.current = page.frame\n\n    slide(self.panel, UDim2.fromScale(-1, SHOWN_Y), self:hideWhenGone(self.panel))\n    slide(page.frame, UDim2.fromScale(0, SHOWN_Y))\n    self:updateFloatingBack()\nend\nfunction settings:back()\n    if self.current == self.panel then\n        return\n    end\n\n    self:stopWaiting()\n\n    local leaving = self.current\n\n    self.panel.Visible = true\n\n    slide(leaving, UDim2.fromScale(1, SHOWN_Y), self:hideWhenGone(leaving))\n    slide(self.panel, UDim2.fromScale(0, SHOWN_Y))\n\n    self.current = self.panel\n\n    self:updateFloatingBack()\nend\nfunction settings:reset()\n    self.current = self.panel\n    self.panel.Visible = true\n    self.panel.Position = UDim2.fromScale(0, HIDDEN_Y)\n\n    for _, page in self.pages do\n        page.frame.Visible = false\n        page.frame.Position = UDim2.fromScale(1, HIDDEN_Y)\n    end\nend\nfunction settings:toggle()\n    self.isOpen = not self.isOpen\n\n    self:setShown(self.isOpen)\n\n    if self.onOpenChanged then\n        self.onOpenChanged(self.isOpen)\n    end\nend\nfunction settings:setShown(shown)\n    if not self.panel or self.isShown == shown then\n        return\n    end\n\n    self.isShown = shown\n\n    local current = self.current\n\n    self:updateFloatingBack()\n\n    if shown then\n        self.holder.Visible = true\n\n        slide(current, UDim2.fromScale(0, SHOWN_Y))\n\n        return\n    end\n\n    self:stopWaiting()\n    slide(current, UDim2.fromScale(0, HIDDEN_Y), function(completed)\n        if completed and not self.isShown then\n            self.holder.Visible = false\n\n            if not self.isOpen then\n                self:reset()\n            end\n        end\n    end)\nend\nfunction settings:watchCommandBar(searchBox)\n    connectionService:Connect(searchBox.Focused, function()\n        self:setShown(false)\n    end)\n    connectionService:Connect(searchBox.FocusLost, function()\n        self:setShown(self.isOpen)\n    end)\nend\n\nreturn settings\n",
[ "src/ui/components/settings/keybindsEditor.luau" ] = "local keyboardService = require('../../../framework/services/keyboardService')\nlocal keybindsConfig = require('../../../framework/config/services/keybinds')\nlocal config = require('../../../framework/config/ui/settings')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal VALUE = config.value\n\nlocal function namesIn(group)\n    local names = {}\n\n    for name, binding in keybindsConfig.bindings do\n        if binding.group == group then\n            table.insert(names, name)\n        end\n    end\n\n    table.sort(names)\n\n    return names\nend\nlocal function fixedKeyLines(groups)\n    local lines = {}\n\n    for _, group in groups do\n        for _, name in namesIn(group)do\n            local binding = keybindsConfig.bindings[name]\n\n            for _, keyName in binding.also or {}do\n                local keyCode = (Enum.KeyCode)[keyName]\n\n                if keyCode then\n                    table.insert(lines, string.format(config.pages.keybinds.alwaysWorks, keyboardService:getKeyName(keyCode), binding.label or name))\n                end\n            end\n        end\n    end\n\n    return lines\nend\nlocal function makePage(pageConfig)\n    return function(page, ctx)\n        local list = widgets.list(page)\n\n        widgets.pageTop(list, pageConfig.title, ctx.back)\n\n        local refreshers = {}\n        local keys = {}\n\n        for _, group in pageConfig.groups do\n            if group.title then\n                widgets.header(list, group.title)\n            end\n\n            table.insert(keys, group.key)\n\n            for _, name in namesIn(group.key)do\n                local binding = keybindsConfig.bindings[name]\n                local row = widgets.row(list)\n\n                widgets.label(row, binding.label or name, VALUE.keybindWidth + 2 * PANEL.padding)\n\n                local refresh, stop = widgets.keybind(row, name)\n\n                table.insert(refreshers, refresh)\n                table.insert(ctx.stoppers, stop)\n            end\n        end\n\n        local fixedLines = fixedKeyLines(keys)\n\n        if #fixedLines > 0 then\n            widgets.note(list, table.concat(fixedLines, '\\n'))\n        end\n\n        local reset = widgets.row(list)\n\n        widgets.label(reset, pageConfig.reset, 0)\n        reset.Activated:Connect(function()\n            for _, stop in ctx.stoppers do\n                stop()\n            end\n            for _, key in keys do\n                for _, name in namesIn(key)do\n                    keyboardService:resetBinding(name)\n                end\n            end\n            for _, refresh in refreshers do\n                refresh()\n            end\n        end)\n    end\nend\n\nreturn {\n    interface = makePage({\n        title = config.pages.keybinds.title,\n        reset = config.pages.keybinds.reset,\n        groups = {\n            {\n                key = 'interface',\n            },\n        },\n    }),\n    commands = makePage({\n        title = config.pages.commands.title,\n        reset = config.pages.commands.reset,\n        groups = keybindsConfig.groups,\n    }),\n}\n",
[ "src/ui/components/settings/pluginsEditor.luau" ] = "local plugins = require('../../../commands/systems/plugins')\nlocal commandsList = require('../../../commands/list')\nlocal config = require('../../../framework/config/ui/settings')\nlocal notifier = require('../../notifier')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal VALUE = config.value\nlocal TEXT = config.pages.plugins\n\nlocal function trim(text)\n    return text:match('^%s*(.-)%s*$') or ''\nend\nlocal function build(page, ctx)\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, TEXT.title, ctx.back)\n    widgets.header(list, TEXT.addTitle)\n\n    local fileBox = widgets.textBox(list, TEXT.fileHint)\n    local addRow = widgets.row(list)\n\n    widgets.label(addRow, TEXT.addButton, 0)\n\n    local note = widgets.note(list, string.format(TEXT.folderHint, plugins.FOLDER))\n\n    widgets.note(list, TEXT.trustHint)\n\n    local installedHeader = widgets.header(list, TEXT.installedTitle)\n    local installedGroup = widgets.group(list)\n\n    widgets.header(list, TEXT.folderTitle)\n\n    local folderGroup = widgets.group(list)\n    local render\n\n    local function refuse(message)\n        note.Text = message\n\n        notifier:notify(TEXT.errorTitle, message)\n    end\n    local function addPlugin(name)\n        local success, detail = plugins.add(commandsList, name)\n\n        if success then\n            note.Text = string.format(TEXT.added, name, detail)\n\n            render()\n\n            return true\n        end\n\n        refuse(tostring(detail))\n\n        return false\n    end\n    local function describeState(plugin)\n        if plugin.loaded then\n            return string.format(TEXT.stateLoaded, plugin.name, plugin.commands)\n        end\n        if plugin.error then\n            return string.format(TEXT.stateFailed, plugin.name, plugin.error)\n        end\n\n        return string.format(TEXT.stateUnknown, plugin.name)\n    end\n    local function renderInstalled()\n        widgets.clear(installedGroup)\n\n        local installed = plugins.getInstalled()\n        local rows = widgets.list(installedGroup)\n\n        installedHeader.Text = TEXT.installedTitle .. (if#installed > 0 then` ({#installed})`else'')\n\n        if #installed == 0 then\n            widgets.note(rows, TEXT.noneInstalled)\n\n            return\n        end\n\n        widgets.note(rows, TEXT.installedHint)\n\n        local gap = PANEL.rowGap\n        local removeOffset = PANEL.padding\n        local reloadOffset = removeOffset + VALUE.buttonWidth + gap\n        local rightSpace = reloadOffset + VALUE.reloadWidth + PANEL.padding\n\n        for _, plugin in installed do\n            local row = widgets.row(rows)\n            local remove = widgets.rowButton(row, TEXT.remove, removeOffset, VALUE.buttonWidth)\n            local reload = widgets.rowButton(row, TEXT.reload, reloadOffset, VALUE.reloadWidth)\n            local label = if plugin.loaded then string.format(TEXT.loadedLabel, plugin.name, plugin.commands)else string.format(TEXT.failedLabel, plugin.name)\n\n            widgets.label(row, label, rightSpace, if plugin.loaded then nil else'Colors.Text.Darker')\n            row.Activated:Connect(function()\n                note.Text = describeState(plugin)\n            end)\n            reload.Activated:Connect(function()\n                local success, detail = plugins.reload(commandsList, plugin.name)\n\n                if success then\n                    note.Text = string.format(TEXT.reloaded, plugin.name, detail)\n\n                    render()\n                else\n                    render()\n                    refuse(tostring(detail))\n                end\n            end)\n            remove.Activated:Connect(function()\n                if plugins.remove(commandsList, plugin.name) then\n                    note.Text = string.format(TEXT.removed, plugin.name)\n\n                    render()\n                end\n            end)\n        end\n    end\n    local function renderFolder()\n        widgets.clear(folderGroup)\n\n        local names, reason = plugins.getAvailable()\n        local rows = widgets.list(folderGroup)\n\n        if not names then\n            widgets.note(rows, reason or '')\n\n            return\n        end\n        if #names == 0 then\n            widgets.note(rows, TEXT.noneInFolder)\n\n            return\n        end\n\n        local addOffset = PANEL.padding\n\n        for _, name in names do\n            local row = widgets.row(rows)\n            local add = widgets.rowButton(row, TEXT.add, addOffset, VALUE.buttonWidth)\n\n            widgets.label(row, name, VALUE.buttonWidth + 2 * PANEL.padding)\n            row.Activated:Connect(function()\n                addPlugin(name)\n            end)\n            add.Activated:Connect(function()\n                addPlugin(name)\n            end)\n        end\n\n        local allRow = widgets.row(rows)\n\n        widgets.label(allRow, string.format(TEXT.addAll, #names), 0)\n        allRow.Activated:Connect(function()\n            local added = 0\n            local failed = {}\n\n            for _, name in names do\n                local success, detail = plugins.add(commandsList, name)\n\n                if success then\n                    added += 1\n                else\n                    table.insert(failed, `{name}: {detail}`)\n                end\n            end\n\n            local message = string.format(TEXT.addedAll, added)\n\n            if #failed > 0 then\n                message ..= string.format(TEXT.failedAll, #failed)\n\n                for _, line in failed do\n                    warn(`plugin {line}`)\n                end\n            end\n\n            note.Text = message\n\n            render()\n        end)\n    end\n\n    function render()\n        renderInstalled()\n        renderFolder()\n    end\n\n    local function addFromBox()\n        local name = trim(fileBox.Text)\n\n        if name == '' then\n            refuse(TEXT.missingName)\n\n            return\n        end\n        if addPlugin(name) then\n            fileBox.Text = ''\n        end\n    end\n\n    addRow.Activated:Connect(addFromBox)\n    fileBox.FocusLost:Connect(function(enterPressed)\n        if enterPressed then\n            addFromBox()\n        end\n    end)\n    render()\nend\n\nreturn build\n",
[ "src/ui/components/settings/themePicker.luau" ] = "local createService = require('../../services/createService')\nlocal themeService = require('../../services/themeService')\nlocal settingsData = require('../../../storage/data/settings')\nlocal config = require('../../../framework/config/ui/settings')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal BOX = config.box\nlocal TEXT = config.textSizes\nlocal CHECK_SIZE = 14\nlocal CHECK_HIT = 20\nlocal CHECK_GAP = 4\n\nlocal function createSwatchRow(list, entry, onPick)\n    list.order += 1\n\n    local options = themeService:getPrimaryOptions()\n    local row = createService.new('Frame', 'Primary', list.parent, {\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, PANEL.rowHeight),\n        Visible = false,\n    })\n\n    createService.new('TextLabel', 'Label', row, {\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(config.row.labelInset, 0),\n        Size = UDim2.new(1, -config.row.labelInset, 1, 0),\n        Text = config.pages.theme.primary,\n        TextSize = TEXT.value,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Darker',\n        },\n    })\n\n    local visuals = {}\n\n    for index, option in options do\n        local slot = #options - index\n        local hit = createService.new('TextButton', 'Pick', row, {\n            AnchorPoint = Vector2.new(1, 0.5),\n            AutoButtonColor = false,\n            BackgroundTransparency = 1,\n            Position = UDim2.new(1, -(PANEL.padding + slot * (CHECK_HIT + CHECK_GAP)), 0.5, 0),\n            Size = UDim2.fromOffset(CHECK_HIT, CHECK_HIT),\n            Text = '',\n        })\n        local visual = createService.new('Frame', 'Check', hit, {\n            AnchorPoint = Vector2.new(0.5, 0.5),\n            BackgroundColor3 = themeService:getPrimaryColor(entry.theme, option.key),\n            BackgroundTransparency = 1,\n            BorderSizePixel = 0,\n            Position = UDim2.fromScale(0.5, 0.5),\n            Size = UDim2.fromOffset(CHECK_SIZE, CHECK_SIZE),\n            createService.new('UICorner', {\n                CornerRadius = UDim.new(0, BOX.cornerRadius),\n            }),\n            createService.new('UIStroke', {\n                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,\n                Color = themeService:getPrimaryColor(entry.theme, option.key),\n                Thickness = 1.5,\n            }),\n        })\n\n        visuals[option.key] = visual\n\n        hit.Activated:Connect(function()\n            onPick(option.key)\n        end)\n    end\n\n    local function redraw()\n        local picked = themeService:getPrimaryKey(entry.key)\n\n        for key, visual in visuals do\n            visual.BackgroundTransparency = if key == picked then 0 else 1\n        end\n    end\n\n    return row, redraw\nend\nlocal function build(page, ctx)\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, config.pages.theme.title, ctx.back)\n\n    local items = {}\n\n    local function redraw()\n        local inUse = themeService.selectedKey\n\n        for _, item in items do\n            local selected = inUse == item.entry.key\n\n            item.fill.Visible = selected\n            item.swatchRow.Visible = selected\n\n            if selected and item.redrawSwatches then\n                item.redrawSwatches()\n            end\n        end\n    end\n    local function select(entry)\n        themeService:selectTheme(entry.key)\n        settingsData:setValue(config.keys.theme, entry.key)\n        settingsData:save()\n        redraw()\n    end\n\n    for _, entry in themeService:getThemes()do\n        local row = widgets.row(list)\n\n        if entry.usable then\n            widgets.label(row, entry.name, BOX.size + 2 * PANEL.padding)\n            row.Activated:Connect(function()\n                select(entry)\n            end)\n        else\n            widgets.label(row, `{entry.name} {config.pages.theme.incomplete}`, BOX.size + 2 * PANEL.padding, 'Colors.Text.Darker')\n        end\n\n        local _, fill = widgets.box(row)\n        local item = {\n            entry = entry,\n            fill = fill,\n        }\n\n        if entry.usable then\n            local swatchRow, redrawSwatches = createSwatchRow(list, entry, function(\n                primaryKey\n            )\n                themeService:setPrimary(entry.key, primaryKey)\n                redraw()\n            end)\n\n            item.swatchRow = swatchRow\n            item.redrawSwatches = redrawSwatches\n        else\n            local empty = createService.new('Frame', 'Primary', list.parent, {\n                Visible = false,\n                Size = UDim2.new(1, 0, 0, 0),\n                BackgroundTransparency = 1,\n            })\n\n            item.swatchRow = empty\n        end\n\n        table.insert(items, item)\n    end\n\n    redraw()\nend\n\nreturn build\n",
[ "src/ui/components/settings/waypointsEditor.luau" ] = "local waypoints = require('../../../commands/systems/waypoints')\nlocal playerService = require('../../../framework/services/playerService')\nlocal config = require('../../../framework/config/ui/settings')\nlocal notifier = require('../../notifier')\nlocal widgets = require('./widgets')\nlocal PANEL = config.panel\nlocal BOX = config.box\nlocal VALUE = config.value\nlocal TEXT = config.pages.waypoints\nlocal lastModeIndex = 1\n\nlocal function trim(text)\n    return text:match('^%s*(.-)%s*$') or ''\nend\nlocal function build(page, ctx)\n    local modes = TEXT.modes\n    local modeIndex = math.clamp(lastModeIndex, 1, #modes)\n    local list = widgets.list(page)\n\n    widgets.pageTop(list, TEXT.title, ctx.back)\n    widgets.header(list, TEXT.newTitle)\n\n    local nameBox, positionBox, addButton = widgets.formRow(list, TEXT.nameHint, TEXT.positionHint, TEXT.addButton, VALUE.positionWidth)\n    local note = widgets.note(list, TEXT.formHint)\n\n    widgets.header(list, TEXT.modeTitle)\n\n    local labels = {}\n\n    for _, mode in modes do\n        table.insert(labels, mode.label)\n    end\n\n    local selectMode = widgets.choices(list, labels, function(index)\n        modeIndex = index\n        lastModeIndex = index\n    end, #modes)\n\n    selectMode(modeIndex)\n\n    local markersRow = widgets.row(list)\n\n    widgets.label(markersRow, TEXT.markers, BOX.size + 2 * PANEL.padding)\n\n    local _, markersFill = widgets.box(markersRow)\n    local listHeader = widgets.header(list, '')\n    local waypointsGroup = widgets.group(list)\n\n    widgets.header(list, TEXT.clearTitle)\n\n    local clearGameRow = widgets.row(list)\n\n    widgets.label(clearGameRow, TEXT.clearGame, 0)\n\n    local clearAllRow = widgets.row(list)\n\n    widgets.label(clearAllRow, TEXT.clearAll, 0)\n\n    local renderWaypoints\n\n    local function refuse(message)\n        note.Text = message\n\n        notifier:notify(TEXT.notifyTitle, message)\n    end\n    local function drawMarkersSwitch()\n        markersFill.Visible = waypoints.isShown()\n    end\n    local function goTo(waypoint)\n        local mode = modes[modeIndex].mode\n        local where = waypoints.format(waypoint.position)\n\n        if not waypoints.go(waypoint, mode) then\n            refuse(TEXT.cantGo)\n\n            return\n        end\n\n        local message = if mode == 'tween'\n            then TEXT.wentTween\n            elseif mode == 'walk'\n            then TEXT.wentWalk\n            else TEXT.went\n\n        note.Text = string.format(message, waypoint.name, where)\n    end\n    local function askUndo(waypoint)\n        notifier:ask(TEXT.undoTitle, string.format(TEXT.undoMessage, waypoint.name, waypoints.format(waypoint.position)), {\n            {\n                text = TEXT.undo,\n                primary = true,\n                onTap = function()\n                    if waypoints.find(waypoint.name) then\n                        notifier:notify(TEXT.notifyTitle, string.format(TEXT.nameTaken, waypoint.name))\n\n                        return\n                    end\n\n                    waypoints.save(waypoint.name, waypoint.position)\n                    waypoints.refreshMarkers()\n\n                    if waypointsGroup.Parent then\n                        note.Text = string.format(TEXT.restored, waypoint.name)\n\n                        renderWaypoints()\n                    end\n                end,\n            },\n        }, TEXT.undoTime)\n    end\n    local function removeWaypoint(waypoint)\n        if not waypoints.remove(waypoint.name) then\n            return\n        end\n\n        waypoints.refreshMarkers()\n\n        note.Text = string.format(TEXT.removed, waypoint.name)\n\n        renderWaypoints()\n        askUndo(waypoint)\n    end\n\n    function renderWaypoints()\n        widgets.clear(waypointsGroup)\n\n        local waypointList = waypoints.list()\n        local rows = widgets.list(waypointsGroup)\n\n        listHeader.Text = TEXT.listTitle .. (if#waypointList > 0 then` ({#waypointList})`else'')\n\n        drawMarkersSwitch()\n\n        if #waypointList == 0 then\n            widgets.note(rows, TEXT.empty)\n\n            return\n        end\n\n        widgets.note(rows, TEXT.listHint)\n\n        for _, waypoint in waypointList do\n            local row = widgets.row(rows)\n            local delete = widgets.rowButton(row, TEXT.delete, PANEL.padding, VALUE.buttonWidth)\n\n            widgets.label(row, waypoint.name, VALUE.buttonWidth + 2 * PANEL.padding)\n            row.Activated:Connect(function()\n                goTo(waypoint)\n            end)\n            delete.Activated:Connect(function()\n                removeWaypoint(waypoint)\n            end)\n        end\n    end\n\n    local function addWaypoint()\n        local name = trim(nameBox.Text)\n\n        if name == '' then\n            refuse(TEXT.missingName)\n\n            return\n        end\n\n        local position\n        local text = trim(positionBox.Text)\n\n        if text == '' then\n            local root = playerService:getRootPart()\n\n            if not root then\n                refuse(TEXT.noCharacter)\n\n                return\n            end\n\n            position = root.Position\n        else\n            position = waypoints.parsePosition(text)\n\n            if not position then\n                refuse(TEXT.badPosition)\n\n                return\n            end\n        end\n\n        local replaced = waypoints.save(name, position)\n\n        waypoints.refreshMarkers()\n\n        nameBox.Text = ''\n        positionBox.Text = ''\n        note.Text = string.format(if replaced then TEXT.updated else TEXT.saved, name, waypoints.format(position))\n\n        renderWaypoints()\n    end\n\n    addButton.Activated:Connect(addWaypoint)\n\n    for _, box in {nameBox, positionBox}do\n        box.FocusLost:Connect(function(enterPressed)\n            if enterPressed then\n                addWaypoint()\n            end\n        end)\n    end\n\n    markersRow.Activated:Connect(function()\n        if waypoints.isShown() then\n            waypoints.hide()\n        elseif waypoints.count() == 0 then\n            refuse(TEXT.noMarkers)\n        else\n            waypoints.show()\n        end\n\n        drawMarkersSwitch()\n    end)\n\n    local function askClear(everyGame)\n        local count = if everyGame then waypoints.countAll()else waypoints.count()\n\n        if count == 0 then\n            note.Text = TEXT.nothingToClear\n\n            return\n        end\n\n        local message = string.format(if everyGame then TEXT.confirmAll else TEXT.confirmGame, count)\n\n        notifier:ask(TEXT.confirmTitle, message, {\n            {\n                text = TEXT.confirmCancel,\n            },\n            {\n                text = TEXT.confirmClear,\n                primary = true,\n                onTap = function()\n                    local cleared = if everyGame then waypoints.clearAll()else waypoints.clearPlace()\n\n                    waypoints.hide()\n\n                    if waypointsGroup.Parent then\n                        note.Text = string.format(TEXT.cleared, cleared)\n\n                        renderWaypoints()\n                    end\n                end,\n            },\n        })\n    end\n\n    clearGameRow.Activated:Connect(function()\n        askClear(false)\n    end)\n    clearAllRow.Activated:Connect(function()\n        askClear(true)\n    end)\n    renderWaypoints()\nend\n\nreturn build\n",
[ "src/ui/components/settings/widgets.luau" ] = "local createService = require('../../services/createService')\nlocal assetsService = require('../../services/assetsService')\nlocal themeService = require('../../services/themeService')\nlocal keyboardService = require('../../../framework/services/keyboardService')\nlocal config = require('../../../framework/config/ui/settings')\nlocal PANEL = config.panel\nlocal ROW = config.row\nlocal BOX = config.box\nlocal VALUE = config.value\nlocal TEXT = config.textSizes\nlocal BADGE = config.badge\nlocal widgets = {}\n\nlocal function paintRow(row, stripe, hovered)\n    themeService:updateObjectProperties(row, {\n        BackgroundColor3 = if hovered then'Colors.Buttons.Holding'else'Colors.Buttons.Default',\n    })\n\n    row.BackgroundTransparency = if hovered then 0 else stripe\nend\n\nfunction widgets.page(holder, name, position)\n    return createService.new('ScrollingFrame', name, holder, {\n        Active = true,\n        AutomaticCanvasSize = Enum.AutomaticSize.Y,\n        BorderSizePixel = 0,\n        CanvasSize = UDim2.new(),\n        ElasticBehavior = Enum.ElasticBehavior.Never,\n        Position = position,\n        ScrollBarThickness = PANEL.scrollBarThickness,\n        ScrollingDirection = Enum.ScrollingDirection.Y,\n        Size = UDim2.fromScale(1, 1),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n            ScrollBarImageColor3 = 'Colors.ScrollBar.Thumb',\n        },\n        createService.new('UIPadding', {\n            PaddingLeft = UDim.new(0, PANEL.padding),\n            PaddingRight = UDim.new(0, PANEL.padding),\n            PaddingTop = UDim.new(0, PANEL.padding),\n            PaddingBottom = UDim.new(0, PANEL.padding),\n        }),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, PANEL.rowGap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\nend\n\nlocal function forgetTree(root)\n    themeService:removeObject(root)\n\n    for _, descendant in root:GetDescendants()do\n        themeService:removeObject(descendant)\n    end\nend\n\nfunction widgets.clear(parent)\n    for _, child in parent:GetChildren()do\n        if not (child:IsA('UIListLayout') or child:IsA('UIPadding')) then\n            forgetTree(child)\n            child:Destroy()\n        end\n    end\nend\nfunction widgets.list(parent)\n    return {\n        parent = parent,\n        order = 0,\n        index = 0,\n    }\nend\nfunction widgets.group(list)\n    list.order += 1\n\n    return createService.new('Frame', 'Group', list.parent, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIListLayout', {\n            Padding = UDim.new(0, PANEL.rowGap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\nend\nfunction widgets.header(list, title)\n    list.order += 1\n\n    list.index = 0\n\n    return createService.new('TextLabel', 'Header', list.parent, {\n        BackgroundTransparency = 1,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, PANEL.headerHeight),\n        Text = title,\n        TextSize = TEXT.header,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Darker',\n        },\n    })\nend\nfunction widgets.row(list)\n    list.order += 1\n    list.index += 1\n\n    local stripe = if list.index % 2 == 1 then PANEL.stripeTransparency else 1\n    local row = createService.new('TextButton', 'Option', list.parent, {\n        AutoButtonColor = false,\n        BackgroundTransparency = stripe,\n        BorderSizePixel = 0,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, PANEL.rowHeight),\n        Text = '',\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n    })\n\n    row.MouseEnter:Connect(function()\n        paintRow(row, stripe, true)\n    end)\n    row.MouseLeave:Connect(function()\n        paintRow(row, stripe, false)\n    end)\n\n    return row\nend\nfunction widgets.pageTop(list, title, onBack)\n    local back = widgets.row(list)\n\n    back.Name = 'BackRow'\n\n    widgets.icon(back, config.pages.backIcon)\n    widgets.label(back, config.pages.back, 0)\n    back.Activated:Connect(onBack)\n\n    if title then\n        widgets.header(list, title)\n    end\nend\nfunction widgets.label(row, text, rightSpace, color)\n    return createService.new('TextLabel', 'Label', row, {\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(ROW.labelInset, 0),\n        Size = UDim2.new(1, -(ROW.labelInset + rightSpace), 1, 0),\n        Text = text,\n        TextSize = TEXT.label,\n        TextTruncate = Enum.TextTruncate.AtEnd,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = color or 'Colors.Text.Default',\n        },\n    })\nend\nfunction widgets.icon(row, iconName)\n    local icon = createService.new('ImageLabel', 'Icon', row, {\n        AnchorPoint = Vector2.new(0, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(0, ROW.iconInset, 0.5, 0),\n        Size = UDim2.fromOffset(ROW.iconSize, ROW.iconSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    assetsService:loadImage(icon, iconName)\n\n    return icon\nend\nfunction widgets.chevron(row)\n    local icon = createService.new('ImageLabel', 'Chevron', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -PANEL.padding, 0.5, 0),\n        Rotation = 180,\n        Size = UDim2.fromOffset(ROW.chevronSize, ROW.chevronSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Text.Darker',\n        },\n    })\n\n    assetsService:loadImage(icon, config.pages.backIcon)\n\n    return icon\nend\nfunction widgets.rowButton(row, text, rightOffset, width)\n    local button = createService.new('TextButton', 'RowButton', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, -rightOffset, 0.5, 0),\n        Size = UDim2.fromOffset(width, VALUE.height + 4),\n        Text = text,\n        TextSize = TEXT.value,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\n\n    button.MouseEnter:Connect(function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Primary',\n        })\n    end)\n    button.MouseLeave:Connect(function()\n        themeService:updateObjectProperties(button, {\n            BackgroundColor3 = 'Colors.Background',\n        })\n    end)\n\n    return button\nend\nfunction widgets.box(row)\n    local box = createService.new('Frame', 'Box', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, -PANEL.padding, 0.5, 0),\n        Size = UDim2.fromOffset(BOX.size, BOX.size),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, BOX.cornerRadius),\n        }),\n        createService.new('UIStroke', {\n            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,\n            Thickness = 1,\n            ThemeTag = {\n                Color = 'Colors.Border.Default',\n            },\n        }),\n    })\n    local fill = createService.new('Frame', 'Fill', box, {\n        BorderSizePixel = 0,\n        Position = UDim2.fromOffset(BOX.inset, BOX.inset),\n        Size = UDim2.new(1, -2 * BOX.inset, 1, -2 * BOX.inset),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Primary',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, BOX.fillCornerRadius),\n        }),\n    })\n\n    return box, fill\nend\nfunction widgets.value(row, text, width)\n    local value = createService.new('Frame', 'Value', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, -PANEL.padding, 0.5, 0),\n        Size = UDim2.fromOffset(width, VALUE.height),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\n    local label = createService.new('TextLabel', 'Text', value, {\n        BackgroundTransparency = 1,\n        Size = UDim2.fromScale(1, 1),\n        Text = text,\n        TextSize = TEXT.value,\n        TextTruncate = Enum.TextTruncate.AtEnd,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n\n    return value, label\nend\nfunction widgets.valueInput(row, text, width)\n    return createService.new('TextBox', 'ValueInput', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BorderSizePixel = 0,\n        ClearTextOnFocus = false,\n        Position = UDim2.new(1, -PANEL.padding, 0.5, 0),\n        Size = UDim2.fromOffset(width, VALUE.height),\n        Text = text,\n        TextSize = TEXT.value,\n        TextXAlignment = Enum.TextXAlignment.Center,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\nend\nfunction widgets.keybind(row, bindingName, onChanged)\n    local value, text = widgets.value(row, '', VALUE.keybindWidth)\n    local cancelWait = nil\n\n    local function refresh()\n        local waiting = cancelWait ~= nil\n\n        text.Text = if waiting then'press a key'else keyboardService:getBindingName(bindingName)\n\n        themeService:updateObjectProperties(value, {\n            BackgroundColor3 = if waiting then'Colors.Primary'else'Colors.Buttons.Default',\n        })\n    end\n    local function stop()\n        if cancelWait then\n            local cancel = cancelWait\n\n            cancelWait = nil\n\n            cancel()\n        end\n\n        refresh()\n    end\n\n    row.Activated:Connect(function()\n        if cancelWait then\n            stop()\n\n            return\n        end\n\n        cancelWait = keyboardService:capture(function(keyCode)\n            cancelWait = nil\n\n            keyboardService:setBinding(bindingName, keyCode)\n            refresh()\n\n            if onChanged then\n                onChanged()\n            end\n        end, function()\n            cancelWait = nil\n\n            refresh()\n        end)\n\n        refresh()\n    end)\n    refresh()\n\n    return refresh, stop\nend\nfunction widgets.textBox(list, placeholder)\n    list.order += 1\n\n    return createService.new('TextBox', 'Input', list.parent, {\n        BorderSizePixel = 0,\n        ClearTextOnFocus = false,\n        LayoutOrder = list.order,\n        PlaceholderText = placeholder,\n        Size = UDim2.new(1, 0, 0, PANEL.rowHeight),\n        Text = '',\n        TextSize = TEXT.value,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n            Font = 'Font.MonoSpace',\n            PlaceholderColor3 = 'Colors.Text.Darker',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UIPadding', {\n            PaddingLeft = UDim.new(0, ROW.labelInset / 2),\n            PaddingRight = UDim.new(0, PANEL.padding),\n        }),\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\nend\n\nlocal function countBadge(button)\n    return createService.new('TextLabel', 'Badge', button, {\n        AnchorPoint = Vector2.new(1, 0),\n        AutomaticSize = Enum.AutomaticSize.X,\n        BorderSizePixel = 0,\n        Position = UDim2.new(1, BADGE.overhang, 0, -BADGE.overhang),\n        Size = UDim2.fromOffset(0, BADGE.height),\n        Text = '',\n        TextSize = TEXT.badge,\n        Visible = false,\n        ZIndex = button.ZIndex + 1,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Primary',\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, BADGE.height / 2),\n        }),\n        createService.new('UIPadding', {\n            PaddingLeft = UDim.new(0, 3),\n            PaddingRight = UDim.new(0, 3),\n        }),\n        createService.new('UIStroke', {\n            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,\n            Thickness = 1,\n            ThemeTag = {\n                Color = 'Colors.Background',\n            },\n        }),\n    })\nend\n\nfunction widgets.choices(list, labels, onSelect, columns)\n    list.order += 1\n\n    local gap = PANEL.rowGap\n    local frame = createService.new('Frame', 'Choices', list.parent, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, 0),\n        createService.new('UIGridLayout', {\n            CellPadding = UDim2.fromOffset(gap, gap),\n            CellSize = UDim2.new(1 / columns, -gap * (columns - 1) / columns - 1, 0, PANEL.rowHeight - 3),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n        }),\n    })\n    local buttons = {}\n    local badges = {}\n\n    local function select(index)\n        for position, button in buttons do\n            themeService:updateObjectProperties(button, {\n                BackgroundColor3 = if position == index then'Colors.Primary'else'Colors.Buttons.Default',\n            })\n        end\n    end\n\n    for index, label in labels do\n        local button = createService.new('TextButton', 'Choice', frame, {\n            AutoButtonColor = false,\n            BorderSizePixel = 0,\n            LayoutOrder = index,\n            Text = label,\n            TextSize = TEXT.value,\n            TextTruncate = Enum.TextTruncate.AtEnd,\n            ThemeTag = {\n                BackgroundColor3 = 'Colors.Buttons.Default',\n                Font = 'Font.MonoSpace',\n                TextColor3 = 'Colors.Text.Default',\n            },\n            createService.new('UICorner', {\n                CornerRadius = UDim.new(0, VALUE.cornerRadius),\n            }),\n        })\n\n        buttons[index] = button\n        badges[index] = countBadge(button)\n\n        button.Activated:Connect(function()\n            select(index)\n            onSelect(index)\n        end)\n    end\n\n    local function setCount(index, count)\n        local badge = badges[index]\n\n        if not badge then\n            return\n        end\n\n        badge.Text = tostring(count)\n        badge.Visible = count > 0\n    end\n\n    return select, setCount\nend\nfunction widgets.inputRow(list, label, placeholder, text)\n    local row = widgets.row(list)\n\n    widgets.label(row, label, VALUE.inputWidth + 2 * PANEL.padding)\n\n    local input = createService.new('TextBox', 'Input', row, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BorderSizePixel = 0,\n        ClearTextOnFocus = false,\n        PlaceholderText = placeholder,\n        Position = UDim2.new(1, -PANEL.padding, 0.5, 0),\n        Size = UDim2.fromOffset(VALUE.inputWidth, VALUE.height),\n        Text = text or '',\n        TextSize = TEXT.value,\n        TextTruncate = Enum.TextTruncate.AtEnd,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n            Font = 'Font.MonoSpace',\n            PlaceholderColor3 = 'Colors.Text.Darker',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UIPadding', {\n            PaddingLeft = UDim.new(0, 4),\n            PaddingRight = UDim.new(0, 4),\n        }),\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\n\n    return row, input\nend\nfunction widgets.formRow(list, commandHint, delayHint, addLabel, secondWidth)\n    list.order += 1\n\n    local gap = PANEL.rowGap\n    local addWidth = VALUE.addWidth\n    local delayWidth = secondWidth or VALUE.formDelayWidth\n    local holder = createService.new('Frame', 'Form', list.parent, {\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, PANEL.rowHeight),\n    })\n\n    local function box(name, hint, anchor, position, size)\n        return createService.new('TextBox', name, holder, {\n            AnchorPoint = anchor,\n            BorderSizePixel = 0,\n            ClearTextOnFocus = false,\n            PlaceholderText = hint,\n            Position = position,\n            Size = size,\n            Text = '',\n            TextSize = TEXT.value,\n            TextTruncate = Enum.TextTruncate.AtEnd,\n            TextXAlignment = Enum.TextXAlignment.Left,\n            ThemeTag = {\n                BackgroundColor3 = 'Colors.Buttons.Default',\n                Font = 'Font.MonoSpace',\n                PlaceholderColor3 = 'Colors.Text.Darker',\n                TextColor3 = 'Colors.Text.Default',\n            },\n            createService.new('UIPadding', {\n                PaddingLeft = UDim.new(0, 6),\n                PaddingRight = UDim.new(0, 4),\n            }),\n            createService.new('UICorner', {\n                CornerRadius = UDim.new(0, VALUE.cornerRadius),\n            }),\n        })\n    end\n\n    local commandBox = box('Command', commandHint, Vector2.zero, UDim2.fromOffset(0, 0), UDim2.new(1, \n-(addWidth + delayWidth + 2 * gap), 1, 0))\n    local delayBox = box('Delay', delayHint, Vector2.new(1, 0), UDim2.new(1, -(addWidth + gap), 0, 0), UDim2.new(0, delayWidth, 1, 0))\n    local addButton = createService.new('TextButton', 'Add', holder, {\n        AnchorPoint = Vector2.new(1, 0),\n        AutoButtonColor = false,\n        BorderSizePixel = 0,\n        Position = UDim2.fromScale(1, 0),\n        Size = UDim2.new(0, addWidth, 1, 0),\n        Text = addLabel,\n        TextSize = TEXT.label,\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Primary',\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0, VALUE.cornerRadius),\n        }),\n    })\n\n    return commandBox, delayBox, addButton\nend\nfunction widgets.footer(list, text)\n    list.order += 1\n\n    return createService.new('TextLabel', 'Footer', list.parent, {\n        BackgroundTransparency = 1,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, PANEL.headerHeight),\n        Text = text,\n        TextSize = TEXT.footer,\n        TextXAlignment = Enum.TextXAlignment.Center,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Darker',\n        },\n    })\nend\nfunction widgets.note(list, text)\n    list.order += 1\n\n    return createService.new('TextLabel', 'Note', list.parent, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        LayoutOrder = list.order,\n        Size = UDim2.new(1, 0, 0, 0),\n        Text = text,\n        TextSize = TEXT.value,\n        TextWrapped = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Top,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Darker',\n        },\n        createService.new('UIPadding', {\n            PaddingLeft = UDim.new(0, ROW.labelInset),\n        }),\n    })\nend\n\nreturn widgets\n",
[ "src/ui/coreGui.luau" ] = "local rbxServices = require('../framework/services/rbxServices')\nlocal executorEnv = require('../framework/environment/executor')\n\nlocal function getCoreGui()\n    local coreGui = rbxServices.CoreGui\n    local gethui = executorEnv.gethui\n\n    if typeof(gethui) == 'function' then\n        local success, folder = pcall(gethui)\n\n        if success and typeof(folder) == 'Instance' then\n            coreGui = folder\n        end\n    end\n    if coreGui == rbxServices.CoreGui then\n        local robloxGui = coreGui:FindFirstChild('RobloxGui')\n\n        coreGui = if robloxGui ~= nil then robloxGui else coreGui\n    end\n\n    return coreGui\nend\n\nreturn getCoreGui()\n",
[ "src/ui/elements/arrow.luau" ] = "local createService = require('../services/createService')\nlocal directions = {\n    ['up'] = function(num, index)\n        local stepY = 1 / num\n        local scaleX = index / num\n        local lineSize = UDim2.fromScale(scaleX, stepY)\n        local position = UDim2.fromScale(0.5 - (scaleX / 2), (index - 1) * stepY)\n\n        return lineSize, position\n    end,\n    ['down'] = function(num, index)\n        local stepY = 1 / num\n        local scaleX = index / num\n        local lineSize = UDim2.fromScale(scaleX, stepY)\n        local position = UDim2.fromScale(0.5 - (scaleX / 2), 1 - (index * stepY))\n\n        return lineSize, position\n    end,\n    ['left'] = function(num, index)\n        local stepX = 1 / num\n        local scaleY = index / num\n        local lineSize = UDim2.fromScale(stepX, scaleY)\n        local position = UDim2.fromScale((index - 1) * stepX, 0.5 - (scaleY / 2))\n\n        return lineSize, position\n    end,\n    ['right'] = function(num, index)\n        local stepX = 1 / num\n        local scaleY = index / num\n        local lineSize = UDim2.fromScale(stepX, scaleY)\n        local position = UDim2.fromScale(1 - (index * stepX), 0.5 - (scaleY / 2))\n\n        return lineSize, position\n    end,\n}\n\nreturn function(num, scale, direction)\n    local calculator = directions[direction]\n\n    if not calculator then\n        error('r u ok? Invalid direction: ' .. tostring(direction))\n    end\n\n    local arrowFrame = createService.new('Frame', 'Arrow', {\n        BackgroundTransparency = 1,\n        Size = UDim2.fromScale(1, 1),\n        AnchorPoint = Vector2.new(0.5, 0.5),\n        Position = UDim2.fromScale(0.5, 0.5),\n        createService.new('UIScale', {Scale = scale}),\n    })\n\n    for index = 1, num do\n        local lineSize, position = calculator(num, index)\n\n        createService.new('Frame', `line_{index}`, {\n            BackgroundColor3 = Color3.fromRGB(220, 220, 220),\n            BorderSizePixel = 0,\n            Size = lineSize,\n            Position = position,\n            Parent = arrowFrame,\n            ThemeTag = {\n                BackgroundColor3 = 'Colors.Icons',\n            },\n        })\n    end\n\n    return arrowFrame\nend\n",
[ "src/ui/init.luau" ] = "local frameworkSettings = require('../framework/settings')\nlocal notificationsConfig = require('../framework/config/ui/notifier')\nlocal privateEnv = require('../framework/environment/private')\nlocal executorEnv = require('../framework/environment/executor')\nlocal connectionService = require('../framework/services/connectionService')\nlocal robloxServices = require('../framework/services/rbxServices')\nlocal keyboardService = require('../framework/services/keyboardService')\nlocal isMobile = require('../framework/environment/isMobile')\nlocal playerService = require('../framework/services/playerService')\nlocal settingsData = require('../storage/data/settings')\nlocal logger = require('../utils/logger')\nlocal tools = require('../utils/tools')\nlocal createService = require('./services/createService')\nlocal assetsService = require('./services/assetsService')\nlocal themeService = require('./services/themeService')\nlocal themes = require('./themes')\nlocal coreGui = require('./coreGui')\nlocal notifier = require('./notifier')\nlocal titleFormatter = require('./utils/titleFormatter')\nlocal scaleObject = require('./utils/scaleObject')\nlocal notificationPlacement = require('./utils/notificationPlacement')\nlocal mainFrameComponent = require('./components/mainFrame')\nlocal scrollBarComponent = require('./components/scrollBar')\nlocal commandsComponent = require('./components/commands')\nlocal referenceComponent = require('./components/reference')\nlocal serverInfoComponent = require('./components/serverinfo')\nlocal chatLogsComponent = require('./components/chatlogs')\nlocal settingsComponent = require('./components/settings')\nlocal partPathComponent = require('./components/partpath')\nlocal dragInstance = require('./utils/dragInstance')\nlocal mainFrameDock = require('./utils/mainFrameDock')\nlocal REFERENCE_SCREEN_HEIGHT = 450\nlocal uiScale = scaleObject.uiScale\nlocal interface = {awoken = false}\n\nlocal function resolveTheme(name)\n    local theme = type(name) == 'string' and themes[name:lower()]\n\n    if theme and theme.Colors and theme.Font then\n        return name\n    end\n\n    return frameworkSettings.theme.defaultTheme\nend\nlocal function clampAxis(udim, sizeOffset, screenPx, scale)\n    local current = (udim.Scale * screenPx) / scale + udim.Offset\n    local maxInt = math.floor(screenPx / scale - sizeOffset)\n\n    if math.floor(current) >= maxInt then\n        return 1, -sizeOffset\n    end\n\n    return 0, math.clamp(math.floor(current), 0, math.max(maxInt, 0))\nend\n\nfunction interface:awake()\n    if self.awoken then\n        return self.screenGui\n    end\n\n    self.awoken = true\n\n    self:setupTheme()\n    self:setupScreenGui()\n    self:setupScale()\n    self:setupMainFrame()\n    self:createQuickCapture()\n    self:createReference()\n    self:createPartPath()\n    self:createNotifications()\n    self:setupListeners()\n    self:updateNotificationsPosition()\n    logger:log('interface started')\n\n    return self.screenGui\nend\nfunction interface:setupTheme()\n    logger:debug('interface: initializing theme service')\n    themeService:init({\n        theme = resolveTheme(frameworkSettings.theme.selectedTheme),\n    })\nend\nfunction interface:setupScreenGui()\n    local screenGui = self:createScreenGui()\n\n    screenGui.Parent = coreGui\n    privateEnv.screenGui = screenGui\n    uiScale.Parent = screenGui\nend\nfunction interface:setupScale()\n    self:setScale(settingsData:getValue('interface.uiScale') or 1)\nend\nfunction interface:setupMainFrame()\n    local mainFrame = self:createMainFrame()\n\n    self:createCommands()\n    self:dragMainFrame(mainFrame)\n    self.commands:enable()\n\n    mainFrame.Parent = self.screenGui\nend\nfunction interface:setupListeners()\n    self.prefixConnection = keyboardService:onBindingPressed('prefix', function()\n        if robloxServices.UserInputService:GetFocusedTextBox() then return end\n        task.spawn(function()\n            robloxServices.RunService.RenderStepped:Wait()\n            self:showCommandBar()\n        end)\n    end, true)\n    connectionService:Connect(self.screenGui:GetPropertyChangedSignal('AbsoluteSize'), function(\n    )\n        self:updateMainFramePosition()\n    end)\n    connectionService:Connect(self.mainFrame:GetPropertyChangedSignal('AbsolutePosition'), function(\n    )\n        self:updateNotificationsPosition()\n    end)\n    connectionService:Connect(self.mainFrame:GetPropertyChangedSignal('AbsoluteSize'), function(\n    )\n        self:updateNotificationsPosition()\n    end)\n    connectionService:Connect(robloxServices.RunService.RenderStepped, function()\n        self:updateNotificationsPosition()\n    end)\nend\nfunction interface:createScreenGui()\n    local screenGui = createService.new('ScreenGui', {\n        IgnoreGuiInset = true,\n        Name = tools.randomString(math.random(30, 50)),\n        DisplayOrder = (2 ^ 31) - 1,\n    })\n\n    self.screenGui = screenGui\n\n    return screenGui\nend\nfunction interface:calculateScale(newScale)\n    return (self.screenGui.AbsoluteSize.Y / REFERENCE_SCREEN_HEIGHT) * newScale\nend\nfunction interface:setScale(newScale)\n    newScale = math.abs(newScale)\n\n    if newScale >= 3 then\n        newScale = self:calculateScale(newScale)\n    end\n    if settingsData:getValue('interface.uiScale') ~= newScale then\n        settingsData:setValue('interface.uiScale', newScale)\n        settingsData:save()\n    end\n\n    scaleObject:setScale(newScale)\n    self:updateMainFramePosition()\nend\nfunction interface:calculateMainFramePosition(pos)\n    local mainFrame = self.mainFrame\n    local screenGui = self.screenGui\n    local scale = scaleObject:getScale()\n    local size = mainFrame.Size\n\n    pos = pos or mainFrame.Position\n\n    local xScale, xOffset = clampAxis(pos.X, size.X.Offset, screenGui.AbsoluteSize.X, scale)\n    local yScale, yOffset = clampAxis(pos.Y, size.Y.Offset, screenGui.AbsoluteSize.Y, scale)\n\n    return UDim2.new(xScale, xOffset, yScale, yOffset)\nend\nfunction interface:updateMainFramePosition()\n    if not self.mainFrame then\n        return\n    end\n    if self.dock then\n        self.dock:reflow()\n    else\n        self.mainFrame.Position = self:calculateMainFramePosition()\n    end\n\n    self:updateNotificationsPosition()\nend\nfunction interface:createMainScroll(mainFrame)\n    local scrollBar = scrollBarComponent.new({\n        isHorizontal = false,\n        barThickness = 12,\n    })\n    local scrollBarFrame = scrollBar:create()\n    local container = scrollBar.container\n    local scrollHolder = createService.new('Frame', 'ScrollHolder', mainFrame, {\n        Size = UDim2.new(1, 0, 0, 180),\n        Position = UDim2.fromScale(0.5, 1),\n        AnchorPoint = Vector2.new(0.5, 1),\n        BackgroundTransparency = 1,\n        Active = true,\n        scrollBarFrame,\n        container,\n    })\n\n    self.scrollHolder = scrollHolder\n    self.scrollBar = scrollBar\n    self.scrollContainer = container\n\n    return scrollBar\nend\nfunction interface:createMainFrame()\n    local elements = mainFrameComponent:create()\n    local mainFrame = elements.mainFrame\n\n    elements.titleLabel.Text = titleFormatter.getDisplayName()\n    self.mainFrame = mainFrame\n    self.topBar = elements.topBar\n    self.buttons = elements.buttons\n\n    assetsService:loadImage(self.buttons.settings, 'settings')\n    assetsService:loadImage(self.buttons.reference, 'reference')\n    self:createMainScroll(mainFrame)\n\n    self.settings = settingsComponent.new({\n        onOpenChanged = function(open)\n            self:paintTopButton(self.buttons.settings, open)\n        end,\n        onSwitch = function(setting, enabled)\n            if setting == 'keepMenuOpen' and self.dock then\n                self.dock:setKeepOpen(enabled)\n            end\n            if setting == 'keepIY' and enabled and executorEnv.queueteleport == nil then\n                self:setKeepIY(false)\n                notifier:notify('Keepiy', 'your exploit does not support queueteleport')\n            end\n        end,\n    })\n\n    self.settings:create(mainFrame, self.scrollHolder)\n    connectionService:Connect(self.buttons.settings.Activated, function()\n        self.settings:toggle()\n    end)\n\n    return mainFrame\nend\nfunction interface:createCommands()\n    local scrollBar = self.scrollBar\n    local commands = commandsComponent.new({\n        scrolledSignal = scrollBar.scrolledSignal,\n        scrollContainer = self.scrollContainer,\n        scrollHolder = self.scrollHolder,\n        screenGui = self.screenGui,\n        scrollBar = scrollBar,\n        configs = {\n            placeholderText = frameworkSettings.ui.commands.placeholderText,\n            padding = frameworkSettings.ui.commands.padding,\n            labelSize = frameworkSettings.ui.commands.labelSize,\n            textSize = frameworkSettings.ui.commands.textSize,\n        },\n    })\n\n    logger:log('created commands interface')\n    commands:create()\n    logger:log('initialized commands')\n    commands:createCommandsData()\n    logger:log('awaked commands module')\n    commands:awake()\n\n    self.commands = commands\n    commands.onCommandSent = function()\n        if self.dock then\n            self.dock:unlockSwipe()\n        end\n    end\n    commands.onInteraction = function()\n        if self.dock then\n            self.dock:noteInteraction()\n        end\n    end\n\n    self.settings:watchCommandBar(commands.searchBox)\n\n    if isMobile then\n        commands.onSwipeDown = function()\n            if self.dock then\n                self.dock:onListSwipeDown()\n            end\n        end\n\n        connectionService:Connect(commands.searchBox.Focused, function()\n            self.commandBarUsedAt = os.clock()\n        end)\n        connectionService:Connect(commands.searchBox.FocusLost, function(\n            enterPressed\n        )\n            self.commandBarUsedAt = os.clock()\n\n            if enterPressed and self.dock then\n                self.dock:onMobileEnter(function()\n                    return commands.searchBox:IsFocused()\n                end)\n            end\n        end)\n    else\n        connectionService:Connect(commands.searchBox.FocusLost, function(\n            enterPressed\n        )\n            if self.dock then\n                self.dock:onCommandBarClosed(enterPressed)\n            end\n        end)\n    end\n\n    return commands\nend\nfunction interface:createInfoMenu()\n    return serverInfoComponent:create()\nend\nfunction interface:chatLogs(tab)\n    return chatLogsComponent:open(tab or 'chat')\nend\nfunction interface:dragMainFrame(mainFrame)\n    mainFrame.Size = frameworkSettings.ui.window.windowSize\n    mainFrame.Position = UDim2.fromOffset(1e5, 1e5)\n    mainFrame.Position = self:calculateMainFramePosition()\n    self.dock = mainFrameDock.new({\n        frame = mainFrame,\n        screenGui = self.screenGui,\n        topBarHeight = self.topBar.Size.Y.Offset,\n        keepOpen = settingsComponent.isKeepMenuOpen(),\n        clampPosition = function(pos)\n            return self:calculateMainFramePosition(pos)\n        end,\n        getScale = function()\n            return scaleObject:getScale()\n        end,\n        commandBarInUse = function()\n            return self:isCommandBarInUse()\n        end,\n        isMoving = function()\n            return self:isCharacterMoving()\n        end,\n        onInteractive = function(enabled)\n            if self.commands then\n                self.commands:setInteractive(enabled)\n            end\n        end,\n        hoverToOpen = not isMobile,\n        onMinimize = function()\n            self:releaseCommandFocus()\n\n            if self.hidden then\n                self:hideWindow()\n            end\n        end,\n    })\n\n    dragInstance:addGuiObject(mainFrame, self.topBar)\n    dragInstance:setFilter(mainFrame, function(pos)\n        return self.dock:clampDrag(pos)\n    end)\n    dragInstance.dragStarted:Connect(function(object)\n        if object ~= mainFrame then\n            return\n        end\n\n        self.dock:cancel()\n        self.dock:setDragging(true)\n        self.scrollBar:disableScroll()\n    end)\n    dragInstance.dragEnded:Connect(function(object, gesture)\n        if object ~= mainFrame then\n            return\n        end\n\n        self.scrollBar:enableScroll()\n        self.dock:setDragging(false)\n        self.dock:onDragEnded(gesture)\n    end)\nend\n\nlocal COMMAND_BAR_GRACE = 0.3\n\nfunction interface:isCommandBarInUse()\n    local searchBox = self.commands and self.commands.searchBox\n\n    if searchBox and searchBox:IsFocused() then\n        return true\n    end\n\n    return os.clock() - (self.commandBarUsedAt or 0) < COMMAND_BAR_GRACE\nend\nfunction interface:isCharacterMoving()\n    local humanoid = playerService:getHumanoid()\n\n    if not humanoid then\n        return false\n    end\n    if humanoid.MoveDirection.Magnitude > 0.05 then\n        return true\n    end\n\n    local root = humanoid.RootPart\n\n    if not root then\n        return false\n    end\n\n    local velocity = root.AssemblyLinearVelocity\n\n    return Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 1\nend\nfunction interface:releaseCommandFocus()\n    local searchBox = self.commands and self.commands.searchBox\n\n    if searchBox and searchBox:IsFocused() then\n        searchBox:ReleaseFocus()\n    end\nend\nfunction interface:showWindow()\n    self.hidden = false\n\n    self:revealWindow()\nend\nfunction interface:revealWindow()\n    if not self.mainFrame then\n        return\n    end\n\n    self.mainFrame.Visible = true\n\n    if self.dock then\n        self.dock:reveal()\n    end\nend\nfunction interface:hideWindow()\n    if not self.mainFrame then\n        return\n    end\n\n    self.hidden = true\n    self.mainFrame.Visible = false\n\n    if self.dock then\n        self.dock:sleep()\n    end\n\n    self:releaseCommandFocus()\nend\nfunction interface:showCommandBar()\n    local searchBox = self.commands and self.commands.searchBox\n\n    if not searchBox then\n        return\n    end\n\n    if self.dock then\n        self.dock:cancel()\n        self.dock:moveTo(if self.dock.state == 'minimized' then 'expanded' else self.dock.state, 0)\n    end\n    self:showWindow()\n    self.commands:setInteractive(true)\n    self.commands:updateSearchBoxPosition()\n    self.commands:captureFocus()\n    self.commands:ensureFocus()\nend\nfunction interface:setKeepIY(enabled)\n    settingsComponent.setKeepIY(enabled)\n\n    if self.settings then\n        self.settings:refresh()\n    end\nend\nfunction interface:createQuickCapture()\n    if not isMobile then\n        return\n    end\n\n    local quickCapture = createService.new('TextButton', tools.randomString(math.random(30, 50)), self.screenGui, {\n        BackgroundTransparency = 0.14,\n        Position = UDim2.fromScale(0.5, 0.15),\n        AnchorPoint = Vector2.new(0.5, 0.5),\n        Size = UDim2.new(0, 25, 0, 25),\n        Font = Enum.Font.SourceSansBold,\n        Text = 'XLQP',\n        TextSize = 16,\n        ZIndex = 10,\n        ThemeTag = {\n            TextColor3 = 'Colors.Text.Default',\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n        createService.new('UICorner', {\n            CornerRadius = UDim.new(0.5, 0),\n        }),\n    })\n\n    self.dock:addWindowPart(quickCapture)\n    dragInstance:addGuiObject(quickCapture)\n    connectionService:Connect(quickCapture.Activated, function()\n        self:showCommandBar()\n    end)\n\n    self.quickCapture = quickCapture\n\n    return quickCapture\nend\nfunction interface:paintTopButton(button, active)\n    if not button then\n        return\n    end\n\n    themeService:addObject(button, {\n        ImageColor3 = if active then'Colors.Primary'else'Colors.Icons',\n    })\nend\nfunction interface:createReference()\n    local reference = referenceComponent.new()\n    local referenceFrame = reference:create()\n\n    reference.onOpenChanged = function(open)\n        self:paintTopButton(self.buttons.reference, open)\n    end\n\n    assetsService:loadImage(reference.closeIcon, 'close')\n\n    referenceFrame.Parent = self.screenGui\n    self.reference = reference\n\n    connectionService:Connect(self.buttons.reference.Activated, function()\n        reference:open()\n    end)\n\n    return reference\nend\nfunction interface:createPartPath()\n    local partPathWindow = partPathComponent.new()\n    local frame = partPathWindow:create()\n\n    frame.Parent = self.screenGui\n    self.partPathWindow = partPathWindow\n\n    return partPathWindow\nend\nfunction interface:openPartPath(onSelectPart)\n    if not self.partPathWindow then\n        return\n    end\n\n    self.partPathWindow:open(onSelectPart)\nend\nfunction interface:createNotifications()\n    local container = notifier:getContainer(self.screenGui)\n\n    self.notificationsContainer = container\n    notifier.onLayoutChanged = function()\n        self:updateNotificationsPosition()\n    end\n\n    self:updateNotificationsPosition()\n\n    return container\nend\nfunction interface:updateNotificationsPosition()\n    local container = self.notificationsContainer\n    local mainFrame = self.mainFrame\n    local screenGui = self.screenGui\n\n    if not (container and mainFrame and screenGui) then\n        return\n    end\n\n    local scale = scaleObject:getScale()\n    local screenSize = screenGui.AbsoluteSize / scale\n    local position = mainFrame.Position\n    local spot = notificationPlacement.compute({\n        x = {\n            scale = position.X.Scale,\n            offset = position.X.Offset,\n        },\n        y = {\n            scale = position.Y.Scale,\n            offset = position.Y.Offset,\n        },\n        width = mainFrame.Size.X.Offset,\n        height = mainFrame.Size.Y.Offset,\n    }, {\n        width = screenSize.X,\n        height = screenSize.Y,\n    }, {\n        width = container.Size.X.Offset,\n    }, notificationsConfig.gapToWindow)\n\n    notifier:setRoom(spot.room)\n\n    container.AnchorPoint = Vector2.new(spot.anchorX, spot.anchorY)\n    container.Position = UDim2.new(spot.x.scale, spot.x.offset, spot.y.scale, spot.y.offset)\nend\nfunction interface:destroy()\n    notifier:destroy()\n\n    if self.dock then\n        self.dock:destroy()\n\n        self.dock = nil\n    end\n\n    chatLogsComponent:reset()\n\n    if self.partPathWindow then\n        self.partPathWindow:destroy()\n\n        self.partPathWindow = nil\n    end\n    if self.screenGui then\n        self.screenGui:Destroy()\n    end\n\n    self.screenGui = nil\n    self.awoken = false\nend\n\nreturn interface\n",
[ "src/ui/notifier.luau" ] = "local createService = require('./services/createService')\nlocal assetsService = require('./services/assetsService')\nlocal themeService = require('./services/themeService')\nlocal scaleObject = require('./utils/scaleObject')\nlocal connectionService = require('../framework/services/connectionService')\nlocal robloxServices = require('../framework/services/rbxServices')\nlocal config = require('../framework/config/ui/notifier')\nlocal textHighlight = require('../utils/textHighlight')\nlocal ICON_MARGIN = 4\nlocal TITLE_GAP = 8\nlocal BODY_BOTTOM = 5\nlocal TEXT_INSET = 5\nlocal BODY_CHROME = config.titleHeight + BODY_BOTTOM + TEXT_INSET * 2\nlocal notifier = {\n    container = nil,\n    items = {},\n    nextOrder = 0,\n    queue = {},\n    room = math.huge,\n}\n\nlocal function createPopup(parent, order)\n    local popup = createService.new('Frame', 'Notification', parent, {\n        BorderSizePixel = 0,\n        ClipsDescendants = true,\n        LayoutOrder = order,\n        Size = UDim2.fromOffset(config.size.X.Offset, 0),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Background',\n        },\n    })\n    local titleInset = ICON_MARGIN + config.iconSize + TITLE_GAP\n    local titleLabel = createService.new('TextLabel', 'Title', popup, {\n        AnchorPoint = Vector2.new(0.5, 0),\n        BackgroundTransparency = 1,\n        Position = UDim2.fromScale(0.5, 0),\n        Size = UDim2.new(1, -titleInset * 2, 0, config.titleHeight),\n        Text = '',\n        TextSize = config.titleTextSize,\n        TextTruncate = Enum.TextTruncate.AtEnd,\n        ThemeTag = {\n            Font = 'Font.Normal',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    local descHolder = createService.new('Frame', 'Description', popup, {\n        AnchorPoint = Vector2.new(0.5, 1),\n        ClipsDescendants = true,\n        Position = UDim2.new(0.5, 0, 1, -BODY_BOTTOM),\n        Size = UDim2.new(1, -10, 1, -(config.titleHeight + BODY_BOTTOM)),\n        ThemeTag = {\n            BackgroundColor3 = 'Colors.Buttons.Default',\n        },\n    })\n\n    createService.new('UICorner', descHolder, {\n        CornerRadius = UDim.new(0, config.cornerRadius),\n    })\n\n    local textLabel = createService.new('TextLabel', 'Text', descHolder, {\n        AutomaticSize = Enum.AutomaticSize.Y,\n        BackgroundTransparency = 1,\n        Position = UDim2.fromOffset(TEXT_INSET, TEXT_INSET),\n        Size = UDim2.new(1, -TEXT_INSET * 2, 0, 0),\n        Text = '',\n        TextSize = config.textSize,\n        RichText = true,\n        TextWrapped = true,\n        TextXAlignment = Enum.TextXAlignment.Left,\n        TextYAlignment = Enum.TextYAlignment.Top,\n        ThemeTag = {\n            Font = 'Font.MonoSpace',\n            TextColor3 = 'Colors.Text.Default',\n        },\n    })\n    local pinButton = createService.new('ImageButton', 'PinButton', popup, {\n        AnchorPoint = Vector2.new(0, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(0, ICON_MARGIN, 0, config.titleHeight / 2),\n        Size = UDim2.fromOffset(config.iconSize, config.iconSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n    local closeButton = createService.new('ImageButton', 'CloseButton', popup, {\n        AnchorPoint = Vector2.new(1, 0.5),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(1, -ICON_MARGIN, 0, config.titleHeight / 2),\n        Size = UDim2.fromOffset(config.iconSize, config.iconSize),\n        ThemeTag = {\n            ImageColor3 = 'Colors.Icons',\n        },\n    })\n\n    assetsService:loadImage(pinButton, 'pin')\n    assetsService:loadImage(closeButton, 'close')\n\n    return popup, titleLabel, textLabel, pinButton, closeButton, descHolder\nend\nlocal function createActions(descHolder, choices, connections)\n    local row = createService.new('Frame', 'Actions', descHolder, {\n        AnchorPoint = Vector2.new(0.5, 1),\n        BackgroundTransparency = 1,\n        Position = UDim2.new(0.5, 0, 1, -TEXT_INSET),\n        Size = UDim2.new(1, -TEXT_INSET * 2, 0, config.actionHeight),\n        ZIndex = 2,\n        createService.new('UIListLayout', {\n            FillDirection = Enum.FillDirection.Horizontal,\n            HorizontalAlignment = Enum.HorizontalAlignment.Right,\n            Padding = UDim.new(0, config.actionGap),\n            SortOrder = Enum.SortOrder.LayoutOrder,\n            VerticalAlignment = Enum.VerticalAlignment.Center,\n        }),\n    })\n    local buttons = {}\n\n    for index, choice in choices do\n        local primary = choice.primary == true\n        local button = createService.new('TextButton', 'Action', row, {\n            AutoButtonColor = false,\n            AutomaticSize = Enum.AutomaticSize.X,\n            BorderSizePixel = 0,\n            LayoutOrder = index,\n            Size = UDim2.fromOffset(0, config.actionHeight),\n            Text = choice.text,\n            TextSize = config.textSize,\n            ZIndex = 2,\n            ThemeTag = {\n                BackgroundColor3 = if choice.primary then'Colors.Primary'else'Colors.Background',\n                Font = 'Font.Normal',\n                TextColor3 = 'Colors.Text.Default',\n            },\n            createService.new('UICorner', {\n                CornerRadius = UDim.new(0, config.cornerRadius),\n            }),\n            createService.new('UIPadding', {\n                PaddingLeft = UDim.new(0, config.actionPadding),\n                PaddingRight = UDim.new(0, config.actionPadding),\n            }),\n            createService.new('UISizeConstraint', {\n                MinSize = Vector2.new(config.actionMinWidth, 0),\n            }),\n        })\n\n        local function paint(hovered)\n            if primary then\n                button.BackgroundTransparency = if hovered then 0.2 else 0\n            else\n                themeService:updateObjectProperties(button, {\n                    BackgroundColor3 = if hovered then'Colors.Buttons.Holding'else'Colors.Background',\n                })\n            end\n        end\n\n        table.insert(connections, connectionService:Connect(button.MouseEnter, function(\n        )\n            paint(true)\n        end))\n        table.insert(connections, connectionService:Connect(button.MouseLeave, function(\n        )\n            paint(false)\n        end))\n\n        buttons[index] = button\n    end\n\n    return buttons\nend\nlocal function disconnectItem(item)\n    for _, connection in item.connections do\n        connectionService:disconnect(connection)\n    end\n\n    table.clear(item.connections)\nend\n\nfunction notifier:getContainer(screenGui)\n    if self.container then\n        return self.container\n    end\n\n    local container = createService.new('Frame', 'Notifications', screenGui, {\n        BackgroundTransparency = 1,\n        BorderSizePixel = 0,\n        Size = UDim2.fromOffset(config.size.X.Offset, 0),\n    })\n\n    createService.new('UIListLayout', container, {\n        Padding = UDim.new(0, config.spacing),\n        SortOrder = Enum.SortOrder.LayoutOrder,\n    })\n\n    self.container = container\n\n    container.ChildAdded:Connect(function()\n        self:refreshLayout()\n    end)\n    container.ChildRemoved:Connect(function()\n        self:refreshLayout()\n    end)\n\n    local pending = self.queue\n\n    self.queue = {}\n\n    for _, item in pending do\n        self:add(item.title, item.message, item.duration, item.choices)\n    end\n\n    return container\nend\nfunction notifier:getStackHeight()\n    local container = self.container\n\n    if not container then\n        return 0\n    end\n\n    local count = 0\n    local height = 0\n\n    for _, child in container:GetChildren()do\n        if child:IsA('GuiObject') then\n            count += 1\n            height += child.Size.Y.Offset\n        end\n    end\n\n    if count > 1 then\n        height += (count - 1) * config.spacing\n    end\n\n    return height\nend\nfunction notifier:refreshLayout()\n    local container = self.container\n\n    if not container then\n        return\n    end\n\n    container.Size = UDim2.fromOffset(config.size.X.Offset, self:getStackHeight())\n\n    if self.onLayoutChanged then\n        self.onLayoutChanged()\n    end\nend\nfunction notifier:tweenHeight(item, height)\n    if item.tween then\n        item.tween:Cancel()\n    end\n\n    local info = TweenInfo.new(config.tweenTime, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)\n\n    item.tween = robloxServices.TweenService:Create(item.frame, info, {\n        Size = UDim2.fromOffset(config.size.X.Offset, height),\n    })\n\n    item.tween:Play()\nend\nfunction notifier:wantedHeight(item)\n    local scale = math.max(scaleObject:getScale(), 0.01)\n    local textHeight = item.textLabel.AbsoluteSize.Y / scale\n    local minHeight = if item.actionsHeight > 0 then 0 else config.size.Y.Offset\n    local height = math.max(textHeight + BODY_CHROME + item.actionsHeight, minHeight)\n\n    return math.min(height, config.maxHeight, self.room)\nend\nfunction notifier:fitHeight(item, instant)\n    if item.removed or not item.textLabel then\n        return\n    end\n\n    local height = self:wantedHeight(item)\n\n    if height == item.height then\n        return\n    end\n\n    item.height = height\n\n    if instant then\n        if item.tween then\n            item.tween:Cancel()\n        end\n\n        item.frame.Size = UDim2.fromOffset(config.size.X.Offset, height)\n    else\n        self:tweenHeight(item, height)\n    end\nend\nfunction notifier:setRoom(room)\n    if room == self.room then\n        return\n    end\n\n    self.room = room\n\n    for _, item in self.items do\n        self:fitHeight(item, true)\n    end\n\n    self:trimToRoom()\nend\nfunction notifier:liveHeight()\n    local height = 0\n\n    for _, item in self.items do\n        height += item.height\n    end\n\n    if #self.items > 1 then\n        height += (#self.items - 1) * config.spacing\n    end\n\n    return height\nend\nfunction notifier:trimToRoom()\n    while#self.items > 1 and self:liveHeight() > self.room do\n        local oldest = nil\n\n        for index, item in self.items do\n            if index == #self.items then\n                break\n            end\n            if not item.pinned then\n                oldest = item\n\n                break\n            end\n        end\n\n        if not oldest then\n            break\n        end\n\n        self:remove(oldest)\n    end\nend\nfunction notifier:pin(item)\n    if item.pinned or item.removed then\n        return\n    end\n\n    item.pinned = true\n    item.titleLabel.Text = item.title .. ' (Pinned)'\n\n    themeService:addObject(item.pinButton, {\n        ImageColor3 = 'Colors.Primary',\n    })\n\n    local titleLabel = item.titleLabel\n\n    task.spawn(function()\n        titleLabel.TextTransparency = 0.5\n\n        task.wait(config.flashTime)\n\n        titleLabel.TextTransparency = 0\n    end)\nend\nfunction notifier:remove(item)\n    if item.removed then\n        return\n    end\n\n    item.removed = true\n\n    local index = table.find(self.items, item)\n\n    if index then\n        table.remove(self.items, index)\n    end\n\n    disconnectItem(item)\n    self:tweenHeight(item, 0)\n    task.delay(config.tweenTime, function()\n        item.frame:Destroy()\n    end)\nend\nfunction notifier:trim()\n    while#self.items > config.maxVisible do\n        local oldest = nil\n\n        for _, item in self.items do\n            if not item.pinned then\n                oldest = item\n\n                break\n            end\n        end\n\n        if not oldest then\n            break\n        end\n\n        self:remove(oldest)\n    end\nend\nfunction notifier:add(title, message, duration, choices)\n    self.nextOrder += 1\n\n    local item = {\n        title = title,\n        pinned = false,\n        removed = false,\n        connections = {},\n        height = config.size.Y.Offset,\n        actionsHeight = if choices then config.actionHeight + config.actionsTopGap + TEXT_INSET else 0,\n    }\n    local descHolder\n\n    item.frame, item.titleLabel, item.textLabel, item.pinButton, item.closeButton, descHolder = createPopup(self.container, self.nextOrder)\n    item.titleLabel.Text = title\n    item.textLabel.Text = textHighlight:apply(message)\n\n    table.insert(item.connections, connectionService:Connect(item.pinButton.Activated, function(\n    )\n        self:pin(item)\n    end))\n\n    local sticky = choices ~= nil and type(duration) ~= 'number'\n\n    if sticky then\n        item.pinned = true\n        item.pinButton.Visible = false\n    end\n    if choices then\n        local buttons = createActions(descHolder, choices, item.connections)\n\n        for index, button in buttons do\n            local choice = choices[index]\n\n            table.insert(item.connections, connectionService:Connect(button.Activated, function(\n            )\n                if item.removed then\n                    return\n                end\n\n                self:remove(item)\n\n                if choice.onTap then\n                    choice.onTap()\n                end\n            end))\n        end\n    end\n\n    table.insert(item.connections, connectionService:Connect(item.closeButton.Activated, function(\n    )\n        self:remove(item)\n    end))\n    table.insert(item.connections, connectionService:Connect(item.textLabel:GetPropertyChangedSignal('AbsoluteSize'), function(\n    )\n        self:fitHeight(item)\n    end))\n    table.insert(self.items, item)\n    self:tweenHeight(item, item.height)\n    item.frame:GetPropertyChangedSignal('Size'):Connect(function()\n        self:refreshLayout()\n    end)\n    self:refreshLayout()\n\n    if not sticky then\n        local waitTime = if type(duration) == 'number'then duration else config.defaultTime\n\n        task.delay(waitTime, function()\n            if not item.pinned then\n                self:remove(item)\n            end\n        end)\n    end\n\n    self:trim()\n    self:trimToRoom()\nend\nfunction notifier:notify(title, message, duration)\n    if message == nil then\n        message = title\n        title = config.defaultTitle\n    end\n\n    title = tostring(title)\n\n    if not self.container then\n        table.insert(self.queue, {\n            title = title,\n            message = message,\n            duration = duration,\n        })\n\n        return\n    end\n\n    self:add(title, message, duration)\nend\nfunction notifier:ask(title, message, choices, duration)\n    title = tostring(title)\n\n    if not self.container then\n        table.insert(self.queue, {\n            title = title,\n            message = message,\n            choices = choices,\n            duration = duration,\n        })\n\n        return\n    end\n\n    self:add(title, message, duration, choices)\nend\nfunction notifier:destroy()\n    for _, item in self.items do\n        disconnectItem(item)\n    end\n\n    table.clear(self.items)\n    table.clear(self.queue)\n\n    self.container = nil\nend\n\nreturn notifier\n",
[ "src/ui/services/assetsService.luau" ] = "local executorEnv = require('../../framework/environment/executor')\nlocal frameworkSettings = require('../../framework/settings')\nlocal assetsPath = frameworkSettings.storage.imagePath\nlocal fileSystem = require('../../storage/fileSystem')\nlocal fetchService = require('../../framework/services/fetchService')\nlocal logger = require('../../utils/logger')\nlocal assets = require('../themes/icons/interface')\nlocal LOADED_ASSETS = {}\nlocal LOADING_ASSETS = {}\nlocal getcustomasset = executorEnv.getcustomasset\nlocal assetsService = {}\n\nfunction assetsService:newCustomAsset(assetName, assetPath)\n    logger:assert(not LOADED_ASSETS[assetName], 'asset is already loaded')\n\n    local customAssetId = fileSystem:getCustomAsset(assetPath)\n\n    if customAssetId == nil then\n        customAssetId = assets[assetName]\n        LOADED_ASSETS[assetName] = customAssetId\n\n        return customAssetId\n    end\n\n    logger:log(`new custom asset to '{assetPath}': '{customAssetId}'`)\n\n    return customAssetId\nend\nfunction assetsService:get(assetName)\n    if LOADED_ASSETS[assetName] then\n        return LOADED_ASSETS[assetName]\n    end\n    if type(getcustomasset) ~= 'function' then\n        return assets[assetName]\n    end\n\n    local assetPath = assetsPath:format(assetName)\n\n    logger:log(`loading asset: '{assetPath}'`)\n\n    if fileSystem:exist(assetPath) then\n        return self:newCustomAsset(assetName, assetPath)\n    end\n\n    local imageRaw = fetchService.fetch(assetPath)\n\n    if imageRaw == nil then\n        local assetid = assets[assetName]\n\n        assetid = if type(assetid) == 'number'then`rbxassetid://{assetid}`else assetid\n        LOADED_ASSETS[assetName] = assetid\n\n        return assetid\n    end\n\n    fileSystem:writeFile(assetPath, imageRaw)\n    logger:log(`created a file to asset: '{assetPath}'`)\n\n    return self:newCustomAsset(assetName, assetPath)\nend\nfunction assetsService:loadImage(object, assetName)\n    logger:assert(assets[assetName], `invalid asset name: {assetName}`)\n\n    local assetid = LOADED_ASSETS[assetName]\n\n    if assetid ~= nil then\n        object.Image = assetid\n\n        return\n    end\n\n    object.Image = ''\n\n    if LOADING_ASSETS[assetName] then\n        table.insert(LOADING_ASSETS[assetName], object)\n\n        return\n    end\n\n    LOADING_ASSETS[assetName] = {object}\n\n    task.defer(function()\n        local fetchedAssetId = self:get(assetName)\n\n        if not fetchedAssetId then\n            return\n        end\n\n        for _, targetObject in LOADING_ASSETS[assetName]do\n            targetObject.Image = fetchedAssetId\n        end\n\n        LOADING_ASSETS[assetName] = nil\n    end)\nend\n\nreturn assetsService\n",
[ "src/ui/services/createService.luau" ] = "local services = require('../../framework/services')\nlocal logger = require('../../utils/logger')\nlocal specialProps = services.specialProps\nlocal themeService = require('./themeService')\n\nfunction specialProps.ThemeTag(object, value)\n    if type(value) ~= 'table' then\n        logger:error(\"expected a 'table' when setting a theme tag\")\n\n        return\n    end\n\n    themeService:addObject(object, value)\nend\n\nreturn require('../../framework/services/createService')\n",
[ "src/ui/services/dragService.luau" ] = "local inputUtils = require('../utils/inputUtils')\nlocal rbxServices = require('../../framework/services/rbxServices')\nlocal signal = require('../../utils/signal')\nlocal userInputService = rbxServices.UserInputService\nlocal LERP_VALUE = 0.28\nlocal BUTTON_DEBOUNCE = 0.2\nlocal CLICK_TRAVEL = 10\nlocal dragService = {}\n\ndragService.__index = dragService\n\nlocal function isMouse(input)\n    return input.UserInputType ~= Enum.UserInputType.Touch\nend\nlocal function isPressMove(press, input)\n    if input == press.input then\n        return true\n    end\n\n    return press.isMouse and input.UserInputType == Enum.UserInputType.MouseMovement\nend\nlocal function isPressEnd(press, input)\n    if input == press.input then\n        return true\n    end\n\n    return press.isMouse and input.UserInputType == press.input.UserInputType\nend\n\nfunction dragService:_resetDrag()\n    for _, connection in self._pressConnections do\n        connection:Disconnect()\n    end\n\n    table.clear(self._pressConnections)\n\n    self._press = nil\n    self.isDragging = false\n    self.draggingObject = nil\n    self.dragStart = nil\n    self.startPos = nil\n    self.lastPos = nil\n    self.pressTime = 0\n    self.travel = 0\nend\nfunction dragService:_endPress(press)\n    if self._press ~= press then\n        return\n    end\n\n    local wasDragging = self.isDragging\n    local object = self.draggingObject\n    local gesture = nil\n\n    if wasDragging then\n        gesture = {\n            duration = os.clock() - self.pressTime,\n            travel = self.travel,\n            dy = self.lastPos.Y - self.dragStart.Y,\n        }\n    end\n\n    self:_resetDrag()\n\n    if wasDragging then\n        self.dragEnded:Fire(object, gesture)\n    end\nend\nfunction dragService:_beginDrag(press)\n    if self.isDragging or self._press ~= press then\n        return\n    end\n\n    self.isDragging = true\n    self.draggingObject = press.object\n\n    self.dragStarted:Fire(press.object)\nend\nfunction dragService:_onPressMoved(press, input)\n    if self._press ~= press or not isPressMove(press, input) then\n        return\n    end\n    if press.isButton and not self.isDragging then\n        if (input.Position - self.dragStart).Magnitude <= CLICK_TRAVEL then\n            return\n        end\n\n        self:_beginDrag(press)\n    end\n    if self.isDragging then\n        self:update(press.object, input)\n    end\nend\nfunction dragService:_startPress(object, input)\n    local press = {\n        object = object,\n        input = input,\n        isMouse = isMouse(input),\n        isButton = object:IsA('GuiButton'),\n    }\n\n    self._press = press\n    self.dragStart = input.Position\n    self.lastPos = input.Position\n    self.startPos = object.Position\n    self.pressTime = os.clock()\n    self.travel = 0\n    self._pressConnections = {\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                self:_endPress(press)\n            end\n        end),\n        userInputService.InputChanged:Connect(function(changed)\n            self:_onPressMoved(press, changed)\n        end),\n        userInputService.InputEnded:Connect(function(ended)\n            if isPressEnd(press, ended) then\n                self:_endPress(press)\n            end\n        end),\n    }\n\n    if not press.isButton then\n        self:_beginDrag(press)\n\n        return\n    end\n\n    task.delay(BUTTON_DEBOUNCE, function()\n        self:_beginDrag(press)\n    end)\nend\nfunction dragService:addGuiObject(object, handle)\n    return (handle or object).InputBegan:Connect(function(input)\n        if not inputUtils.isPressingInput(input) then\n            return\n        end\n        if self._press then\n            return\n        end\n\n        self:_startPress(object, input)\n    end)\nend\nfunction dragService:update(object, input)\n    local delta = input.Position - self.dragStart\n    local scaleSize = (self._uiScale and self._uiScale.Scale) or 1\n\n    self.lastPos = input.Position\n    self.travel = math.max(self.travel, delta.Magnitude)\n\n    local newPosition = UDim2.new(self.startPos.X.Scale, self.startPos.X.Offset + (delta.X / scaleSize), self.startPos.Y.Scale, self.startPos.Y.Offset + (delta.Y / scaleSize))\n\n    if self.filters[object] ~= nil then\n        local customPos = self.filters[object](newPosition, scaleSize)\n\n        newPosition = customPos or newPosition\n    end\n\n    object.Position = object.Position:Lerp(newPosition, LERP_VALUE)\n\n    self.onDragged:Fire(object)\nend\nfunction dragService:canDragObject(object)\n    return (not self.isDragging) or (self.draggingObject == object)\nend\nfunction dragService:setFilter(object, callback)\n    self.filters[object] = callback\nend\nfunction dragService.new(uiScale)\n    return setmetatable({\n        isDragging = false,\n        draggingObject = nil,\n        _uiScale = uiScale,\n        dragStart = nil,\n        startPos = nil,\n        lastPos = nil,\n        pressTime = 0,\n        travel = 0,\n        _press = nil,\n        _pressConnections = {},\n        filters = {},\n        onDragged = signal.new(),\n        dragStarted = signal.new(),\n        dragEnded = signal.new(),\n    }, dragService)\nend\n\nreturn dragService\n",
[ "src/ui/services/themeService.luau" ] = "local themes = require('../themes')\nlocal themeConfig = require('../../framework/config/ui/themes')\nlocal settingsData = require('../../storage/data/settings')\nlocal logger = require('../../utils/logger')\nlocal tools = require('../../utils/tools')\nlocal themeService = {\n    objects = {},\n    selectedTheme = nil,\n    selectedKey = nil,\n}\nlocal PRIMARY_PREFIX = 'themePrimary.'\n\nfunction themeService:isUsable(theme)\n    return theme ~= nil and theme.Colors ~= nil and theme.Font ~= nil\nend\nfunction themeService:getThemes()\n    local list = {}\n\n    for key, theme in themes do\n        table.insert(list, {\n            key = key,\n            name = theme.DisplayName,\n            theme = theme,\n            usable = self:isUsable(theme),\n        })\n    end\n\n    table.sort(list, function(a, b)\n        return a.name < b.name\n    end)\n\n    return list\nend\nfunction themeService:getPrimaryOptions()\n    return themeConfig.options\nend\n\nlocal function findOption(key)\n    for _, option in themeConfig.options do\n        if option.key == key then\n            return option\n        end\n    end\n\n    return nil\nend\n\nfunction themeService:getPrimaryKey(themeName)\n    local saved = settingsData:getValue(PRIMARY_PREFIX .. themeName:lower())\n\n    if type(saved) == 'string' and findOption(saved) then\n        return saved\n    end\n\n    return themeConfig.defaultKey\nend\nfunction themeService:getPrimaryColor(theme, primaryKey)\n    local option = findOption(primaryKey)\n\n    if option and option.color then\n        return option.color\n    end\n\n    return theme.Colors.Primary\nend\n\nlocal function withPrimary(theme, primaryKey)\n    local option = findOption(primaryKey)\n\n    if not option or option.color == nil then\n        return theme\n    end\n\n    local colors = table.clone(theme.Colors)\n\n    colors.Primary = option.color\n    colors.OnPrimary = option.color:Lerp(Color3.new(0, 0, 0), themeConfig.darken)\n\n    local copy = table.clone(theme)\n\n    copy.Colors = colors\n\n    return copy\nend\n\nfunction themeService:selectTheme(themeName)\n    logger:expect(themeName, {\n        'string',\n    }, \"'themeService:selectTheme' #1\")\n\n    local key = themeName:lower()\n    local theme = themes[key]\n\n    if not theme then\n        logger:error(`'{themeName}' isn't a valid theme`)\n\n        return\n    end\n\n    self.selectedKey = key\n    self.selectedTheme = if self:isUsable(theme)then withPrimary(theme, self:getPrimaryKey(key))else theme\n\n    self:updateObjects()\n\n    return self\nend\nfunction themeService:setPrimary(themeName, primaryKey)\n    local key = themeName:lower()\n\n    settingsData:setValue(PRIMARY_PREFIX .. key, primaryKey)\n    settingsData:save()\n\n    if self.selectedKey == key then\n        self:selectTheme(key)\n    end\nend\nfunction themeService:updateObject(object)\n    self:updateObjectProperties(object, self.objects[object])\nend\nfunction themeService:updateObjectProperties(object, properties)\n    for property, value in properties do\n        object[property] = tools.getDeep(self.selectedTheme, value)\n    end\nend\nfunction themeService:updateObjects()\n    for object, _ in self.objects do\n        self:updateObject(object)\n    end\nend\nfunction themeService:addObject(object, themeTag)\n    self.objects[object] = themeTag\n\n    self:updateObject(object)\nend\nfunction themeService:removeObject(object)\n    self.objects[object] = nil\nend\nfunction themeService:init(config)\n    logger:expect(config, {\n        'table',\n    }, \"'themeService:init' #1\")\n\n    if config.theme ~= nil then\n        self:selectTheme(config.theme)\n    end\nend\n\nreturn themeService\n",
[ "src/ui/themes/classic.luau" ] = "local palette = require('../../framework/config/ui/colors').text\n\nreturn {\n    DisplayName = 'Classic',\n    Font = {\n        Normal = Enum.Font.BuilderSans,\n        Medium = Enum.Font.BuilderSansMedium,\n        Bold = Enum.Font.BuilderSansBold,\n        ExtraBold = Enum.Font.BuilderSansExtraBold,\n        MonoSpace = Enum.Font.RobotoMono,\n    },\n    Colors = {\n        Background = Color3.fromRGB(36, 36, 37),\n        Primary = Color3.fromRGB(88, 101, 242),\n        OnPrimary = Color3.fromRGB(61, 67, 135),\n        Stroke = Color3.fromRGB(45, 45, 45),\n        Error = palette.red,\n        Icons = Color3.fromRGB(232, 233, 235),\n        ScrollBar = {\n            Thumb = Color3.fromRGB(78, 78, 79),\n            Arrow = Color3.fromRGB(232, 233, 235),\n            Background = Color3.fromRGB(26, 26, 26),\n        },\n        Buttons = {\n            Holding = Color3.fromRGB(78, 78, 79),\n            Default = Color3.fromRGB(46, 46, 47),\n        },\n        Border = {\n            Holding = Color3.fromRGB(60, 60, 60),\n            Default = Color3.fromRGB(38, 38, 38),\n        },\n        Text = {\n            Default = palette.green,\n            Dark = palette.purple,\n            Darker = palette.red,\n        },\n        Slider = {\n            SliderBar = Color3.fromRGB(1, 76, 105),\n            SliderNumber = palette.green,\n        },\n    },\n}\n",
[ "src/ui/themes/dark.luau" ] = "local palette = require('../../framework/config/ui/colors').text\n\nreturn {\n    DisplayName = 'Dark',\n    Font = {\n        Normal = Enum.Font.BuilderSans,\n        Medium = Enum.Font.BuilderSansMedium,\n        Bold = Enum.Font.BuilderSansBold,\n        ExtraBold = Enum.Font.BuilderSansExtraBold,\n        MonoSpace = Enum.Font.RobotoMono,\n    },\n    Colors = {\n        Background = Color3.fromRGB(19, 19, 19),\n        Primary = Color3.fromRGB(88, 101, 242),\n        OnPrimary = Color3.fromRGB(61, 67, 135),\n        Stroke = Color3.fromRGB(45, 45, 45),\n        Error = palette.red,\n        Icons = Color3.fromRGB(232, 233, 235),\n        ScrollBar = {\n            Thumb = Color3.fromRGB(60, 60, 60),\n            Arrow = Color3.fromRGB(232, 233, 235),\n            Background = Color3.fromRGB(26, 26, 26),\n        },\n        Buttons = {\n            Holding = Color3.fromRGB(42, 42, 42),\n            Default = Color3.fromRGB(34, 34, 34),\n        },\n        Border = {\n            Holding = Color3.fromRGB(60, 60, 60),\n            Default = Color3.fromRGB(38, 38, 38),\n        },\n        Text = {\n            Default = palette.green,\n            Dark = palette.purple,\n            Darker = palette.red,\n        },\n        Slider = {\n            SliderBar = Color3.fromRGB(1, 76, 105),\n            SliderNumber = palette.green,\n        },\n    },\n}\n",
