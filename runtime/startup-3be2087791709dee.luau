[ "src/commands/cmds/interface/togglegui.luau" ] = "local coreGuiTypeNames = {\n    ['inventory'] = Enum.CoreGuiType.Backpack,\n    ['leaderboard'] = Enum.CoreGuiType.PlayerList,\n    ['emotes'] = Enum.CoreGuiType.EmotesMenu,\n}\n\nfor _, item in Enum.CoreGuiType:GetEnumItems()do\n    coreGuiTypeNames[string.lower(item.Name)] = item\nend\n\nreturn {\n    action = 'togglecoregui|togglegui|tcgui',\n    description = 'Toggles visibility of coregui items',\n    args = {\n        {\n            kind = 'string',\n            options = 'inventory|playerlist|chat|reset|emotes|all',\n            name = 'gui name',\n        },\n        {\n            kind = 'boolean',\n            name = 'enabled',\n        },\n    },\n    run = function(self, args)\n        local input = args:nextValue()\n        local enabled = args:nextValue()\n\n        if input == 'reset' then\n            self.starterGui:SetCore('ResetButtonCallback', enabled)\n\n            return\n        end\n\n        local coreGuiType = coreGuiTypeNames[input]\n\n        if coreGuiType then\n            self.starterGui:SetCoreGuiEnabled(coreGuiType, enabled)\n        end\n    end,\n}\n",
[ "src/commands/cmds/lighting/ambient.luau" ] = "return {\n    client = true,\n    action = 'ambient',\n    description = 'Changes ambient',\n    args = {\n        kind = 'color3',\n    },\n    run = function(self, args)\n        local color = args:nextValue()\n        local lighting = self.robloxServices.Lighting\n\n        lighting.Ambient = color\n        lighting.OutdoorAmbient = color\n    end,\n}\n",
[ "src/commands/cmds/lighting/brightness.luau" ] = "return {\n    client = true,\n    action = 'brightness',\n    description = 'Changes the brightness lighting property',\n    args = {\n        kind = 'number',\n    },\n    run = function(self, args)\n        self.robloxServices.Lighting.Brightness = args:nextValue()\n    end,\n}\n",
[ "src/commands/cmds/lighting/daynight.luau" ] = "return {\n    {\n        client = true,\n        action = 'day',\n        description = 'Changes the time to day for the client',\n        run = function(self)\n            self.robloxServices.Lighting.ClockTime = 14\n        end,\n    },\n    {\n        client = true,\n        action = 'night',\n        description = 'Changes the time to night for the client',\n        run = function(self)\n            self.robloxServices.Lighting.ClockTime = 0\n        end,\n    },\n}\n",
[ "src/commands/cmds/lighting/fullbright.luau" ] = "local function applyFullbright(self)\n    local lighting = self.robloxServices.Lighting\n\n    lighting.Brightness = 2\n    lighting.ClockTime = 14\n    lighting.FogEnd = 100000\n    lighting.GlobalShadows = false\n    lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)\nend\nlocal function stopLoop(self)\n    local garbage = self:collectGarbage('loopfullbright')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'fullbright|fb',\n        description = 'Makes the map brighter / more visible (CLIENT)',\n        run = function(self)\n            applyFullbright(self)\n        end,\n    },\n    {\n        action = 'loopfullbright|loopfb',\n        description = 'Makes the map brighter / more visible but looped (CLIENT)',\n        run = function(self)\n            stopLoop(self)\n\n            local garbage = self:createGarbage('loopfullbright')\n\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                applyFullbright(self)\n            end)\n        end,\n    },\n    {\n        action = 'unloopfullbright|unloopfb',\n        description = 'Unloops fullbright',\n        run = function(self)\n            stopLoop(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/lighting/globalshadows.luau" ] = "return {\n    {\n        client = true,\n        action = 'globalshadows|gshadows',\n        description = 'Enables global shadows',\n        run = function(self)\n            self.robloxServices.Lighting.GlobalShadows = true\n        end,\n    },\n    {\n        client = true,\n        action = 'noglobalshadows|nogshadows|unglobalshadows',\n        description = 'Disables global shadows',\n        run = function(self)\n            self.robloxServices.Lighting.GlobalShadows = false\n        end,\n    },\n}\n",
[ "src/commands/cmds/lighting/init.luau" ] = "return {\n    require('./fullbright'),\n    require('./ambient'),\n    require('./daynight'),\n    require('./nofog'),\n    require('./brightness'),\n    require('./globalshadows'),\n    require('./light'),\n}\n",
[ "src/commands/cmds/lighting/light.luau" ] = "local privateEnv = require('../../../framework/environment/private')\nlocal resolvePlayers = require('../../systems/resolvePlayers')\nlocal lighting = require('../../../framework/services/rbxServices').Lighting\nlocal lightProps = {\n    'Ambient',\n    'OutdoorAmbient',\n    'Brightness',\n    'ClockTime',\n    'FogEnd',\n    'FogStart',\n    'GlobalShadows',\n}\nlocal originalSettings = {}\n\nlocal function restoreLighting()\n    for property, value in originalSettings do\n        lighting[property] = value\n    end\nend\nlocal function storeOriginalLighting()\n    if privateEnv.originalLighting then\n        originalSettings = privateEnv.originalLighting\n\n        return\n    end\n\n    for _, property in lightProps do\n        originalSettings[property] = lighting[property]\n    end\n\n    privateEnv.originalLighting = originalSettings\nend\n\nstoreOriginalLighting()\n\nreturn {\n    {\n        action = 'restorelighting|rlighting',\n        description = 'Restores Lighting properties',\n        run = restoreLighting,\n    },\n    {\n        action = 'light',\n        description = 'Gives your player dynamic light (CLIENT)',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'radius',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local players = resolvePlayers(args:nextValue())\n            local radius = args:nextValue() or 10\n\n            for _, target in players do\n                local root = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                if not root then\n                    return\n                end\n\n                local light = Instance.new('PointLight')\n\n                light.Range = radius\n                light.Brightness = 5\n                light.Parent = root\n\n                table.insert(self:registerGarbage('dynamicLights'), light)\n            end\n        end,\n    },\n    {\n        action = 'nolight|unlight',\n        description = 'Removes dynamic light from your player',\n        run = function(self)\n            for _, light in self:collectGarbage('dynamicLights') or {}do\n                light:Destroy()\n            end\n\n            local character = self.playerService:getCharacter()\n\n            if character then\n                for _, object in character:GetDescendants()do\n                    if object:IsA('PointLight') then\n                        object:Destroy()\n                    end\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/lighting/nofog.luau" ] = "return {\n    client = true,\n    action = 'nofog',\n    description = 'Removes fog',\n    run = function(self)\n        local lighting = self.robloxServices.Lighting\n\n        lighting.FogEnd = 100000\n\n        for _, object in lighting:GetDescendants()do\n            if object:IsA('Atmosphere') then\n                object:Destroy()\n            end\n        end\n    end,\n}\n",
[ "src/commands/cmds/playerinfo.luau" ] = "local resolvePlayers = require('../systems/resolvePlayers')\nlocal chatSender = require('../systems/chatSender')\nlocal DAY = 86400\nlocal USERS_API = 'https://users.roblox.com/v1/users/'\n\nlocal function joinDate(self, player)\n    local request = self.executorEnv.httprequest\n\n    if request then\n        local ok, created = pcall(function()\n            local response = request({\n                Url = USERS_API .. tostring(player.UserId),\n                Method = 'GET',\n            })\n\n            return self.robloxServices.HttpService:JSONDecode(response.Body).created\n        end)\n\n        if ok and type(created) == 'string' then\n            return created:sub(1, 10)\n        end\n    end\n\n    return '~' .. os.date('!%Y-%m-%d', os.time() - player.AccountAge * DAY)\nend\nlocal function chat(self, message)\n    local sent, reason = chatSender.send(message)\n\n    if not sent then\n        self:notify('Chat', `could not send the message: {reason}`)\n    end\nend\n\nreturn {\n    {\n        action = 'inspect|examine',\n        description = 'Opens InspectMenu for a certain player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            self.guiService:InspectPlayerFromUserId(target.UserId)\n        end,\n    },\n    {\n        action = 'age|playerage',\n        description = 'Tells you the age of a player',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self:notify('Account age', `{player.Name}'s account is {player.AccountAge} day(s) old`)\n            end\n        end,\n    },\n    {\n        action = 'chatage',\n        description = 'Chats the age of a player',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                chat(self, `{player.Name}'s account is {player.AccountAge} day(s) old`)\n            end\n        end,\n    },\n    {\n        action = 'joindate|jd',\n        description = 'Tells you the date the player joined Roblox',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self:notify('Join date', `{player.Name} joined Roblox on {joinDate(self, player)}`)\n            end\n        end,\n    },\n    {\n        action = 'chatjoindate|cjd',\n        description = 'Chats the date the player joined Roblox',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                chat(self, `{player.Name} joined Roblox on {joinDate(self, player)}`)\n            end\n        end,\n    },\n    {\n        action = 'copyname|copyuser',\n        description = 'Copies a players full username to your clipboard',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                return\n            end\n\n            setclipboard(target.Name)\n            self:notify('Copy name', `copied {target.Name}`)\n        end,\n    },\n    {\n        action = 'userid|id',\n        description = 'Notifies a players user ID',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                self:notify('User ID', `{player.Name}: {player.UserId}`)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/plugins/init.luau" ] = "local plugins = require('../../systems/plugins')\n\nreturn {\n    {\n        action = 'addplugin|plugin',\n        description = 'Add a plugin via command',\n        args = {\n            kind = 'string',\n            name = 'plugin name',\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            if not text then\n                return\n            end\n\n            local success, detail = plugins.add(self.commandsList, text)\n\n            if success then\n                self:notify('Plugins', `Added '{text}' ({detail} command(s))`)\n            else\n                self:notify('Plugin Error', detail)\n            end\n        end,\n    },\n    {\n        action = 'removeplugin|deleteplugin',\n        description = 'Remove a plugin via command',\n        args = {\n            kind = 'plugin',\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n\n            if not name then\n                return\n            end\n            if plugins.remove(self.commandsList, name) then\n                self:notify('Plugins', `Removed '{name}'`)\n            end\n        end,\n    },\n    {\n        action = 'reloadplugin',\n        description = 'Reloads a plugin',\n        args = {\n            kind = 'plugin',\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n\n            if not name then\n                return\n            end\n\n            local success, detail = plugins.reload(self.commandsList, name)\n\n            if success then\n                self:notify('Plugins', `Reloaded '{name}' ({detail} command(s))`)\n            else\n                self:notify('Plugin Error', detail)\n            end\n        end,\n    },\n    {\n        action = 'addallplugins|loadallplugins',\n        description = 'Adds all plugins from the infiniteYield/plugins folder',\n        run = function(self)\n            local result, reason = plugins.addAll(self.commandsList)\n\n            if not result then\n                self:notify('Plugin Error', reason)\n\n                return\n            end\n\n            local message = `Added {#result.added} plugin(s)`\n\n            if #result.failed > 0 then\n                message ..= `, {#result.failed} failed (see console)`\n\n                for _, line in result.failed do\n                    warn(`plugin {line}`)\n                end\n            end\n\n            self:notify('Plugins', message)\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/anchor.luau" ] = "local function setRootAnchored(self, anchored)\n    local root = self.playerService:getRootPart()\n\n    if root then\n        root.Anchored = anchored\n    end\nend\n\nreturn {\n    {\n        action = 'anchor',\n        description = 'Anchors your characters RootPart',\n        run = function(self)\n            setRootAnchored(self, true)\n        end,\n    },\n    {\n        action = 'unanchor',\n        description = 'Unanchors your characters RootPart',\n        run = function(self)\n            setRootAnchored(self, false)\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/clientbring.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function removeLoopBring(self, targets)\n    local garbage = self:getGarbage('loopbring')\n\n    if not garbage then\n        return\n    end\n    if targets then\n        for _, target in targets do\n            garbage.targets[target] = nil\n        end\n    else\n        garbage.targets = {}\n    end\n    if next(garbage.targets) == nil then\n        self:collectGarbage('loopbring')\n\n        if garbage.id then\n            self.loopService:remove(garbage.id)\n        end\n    end\nend\n\nreturn {\n    {\n        action = 'clientbring|cbring',\n        description = 'Bring a player (CLIENT)',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, target in resolvePlayers(args:nextValue())do\n                local character = target.Character\n                local targetRoot = character and character:FindFirstChild('HumanoidRootPart')\n\n                if targetRoot then\n                    local humanoid = character:FindFirstChildOfClass('Humanoid')\n\n                    if humanoid then\n                        humanoid.Sit = false\n                    end\n\n                    task.wait()\n\n                    local root = self.playerService:getRootPart()\n\n                    if root then\n                        targetRoot.CFrame = root.CFrame + Vector3.new(3, 1, 0)\n                    end\n                end\n            end\n        end,\n    },\n    {\n        action = 'loopbring',\n        description = 'Loop brings a player to you (useful for killing) (CLIENT)',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'distance',\n                optional = true,\n            },\n            {\n                kind = 'number',\n                name = 'bring delay',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local targets = resolvePlayers(args:nextValue())\n            local distance = args:nextValue() or 3\n            local delay = args:nextValue() or 0\n            local garbage = self:registerGarbage('loopbring')\n\n            garbage.targets = garbage.targets or {}\n            garbage.distance = distance\n\n            for _, target in targets do\n                if target ~= self.localPlayer then\n                    garbage.targets[target] = true\n                end\n            end\n\n            if garbage.id then\n                self.loopService:remove(garbage.id)\n            end\n\n            garbage.id = self.loopService:add(function()\n                local root = self.playerService:getRootPart()\n\n                for target in garbage.targets do\n                    if target.Parent == nil then\n                        garbage.targets[target] = nil\n                    else\n                        local targetRoot = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                        if root and targetRoot then\n                            targetRoot.CFrame = root.CFrame + Vector3.new(garbage.distance, 1, 0)\n                        end\n                    end\n                end\n            end, delay)\n        end,\n    },\n    {\n        action = 'unloopbring|noloopbring',\n        description = 'Undoes loopbring',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            if text then\n                removeLoopBring(self, resolvePlayers(text))\n            else\n                removeLoopBring(self, nil)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/flashback.luau" ] = "local connectionService = require('../../../framework/services/connectionService')\nlocal localPlayer = require('../../../framework/services/localPlayer')\nlocal lastDeath = nil\n\nlocal function watchCharacter(character)\n    local humanoid = character:WaitForChild('Humanoid', 10)\n\n    if not humanoid then\n        return\n    end\n\n    connectionService:Connect(humanoid.Died, function()\n        local root = character:FindFirstChild('HumanoidRootPart')\n\n        if root then\n            lastDeath = root.CFrame\n        end\n    end)\nend\n\nconnectionService:Connect(localPlayer.CharacterAdded, watchCharacter)\n\nif localPlayer.Character then\n    task.spawn(watchCharacter, localPlayer.Character)\nend\n\nreturn {\n    action = 'flashback|diedtp',\n    description = 'Teleports you to where you last died',\n    run = function(self)\n        if not lastDeath then\n            self:notify('flashback', 'you have not died yet')\n\n            return\n        end\n\n        self.playerService:teleportTo(lastDeath)\n    end,\n}\n",
[ "src/commands/cmds/teleport/freeze.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal FLOAT_NAME = 'IYFloatPlatform'\n\nreturn {\n    {\n        client = true,\n        action = 'freeze|fr',\n        description = 'Freezes a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, target in resolvePlayers(args:nextValue())do\n                local character = target.Character\n\n                if character then\n                    for _, part in character:GetDescendants()do\n                        if part:IsA('BasePart') and not part.Anchored then\n                            part.Anchored = true\n                        end\n                    end\n                end\n            end\n        end,\n    },\n    {\n        client = true,\n        action = 'unfreeze|thaw|unfr',\n        description = 'Unfreezes a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, target in resolvePlayers(args:nextValue())do\n                local character = target.Character\n\n                if character then\n                    for _, part in character:GetDescendants()do\n                        if part:IsA('BasePart') and part.Anchored and part.Name ~= FLOAT_NAME then\n                            part.Anchored = false\n                        end\n                    end\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/freezeanimations.luau" ] = "local function setAnimationSpeed(self, speed)\n    local character = self.playerService:getCharacter()\n\n    if not character then\n        return\n    end\n\n    local controller = character:FindFirstChildOfClass('Humanoid') or character:FindFirstChildOfClass('AnimationController')\n\n    if not controller then\n        return\n    end\n\n    for _, track in controller:GetPlayingAnimationTracks()do\n        track:AdjustSpeed(speed)\n    end\nend\n\nreturn {\n    {\n        action = 'freezeanims',\n        description = \n[[Freezes your animations / pauses your animations - Does not work on default animations]],\n        run = function(self)\n            setAnimationSpeed(self, 0)\n        end,\n    },\n    {\n        action = 'unfreezeanims',\n        description = 'Unfreezes your animations / plays your animations',\n        run = function(self)\n            setAnimationSpeed(self, 1)\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/goto.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function stopLoopGoto(self)\n    local garbage = self:collectGarbage('loopgoto')\n\n    if garbage and garbage.id then\n        self.loopService:remove(garbage.id)\n    end\nend\nlocal function findCharacter(players)\n    for _, player in players do\n        if player.Character then\n            return player.Character\n        end\n    end\n\n    return nil\nend\nlocal function getSpotNear(character)\n    local pivot = character:GetPivot()\n    local position = pivot.Position\n\n    return CFrame.new(position + pivot.LookVector * 3, position)\nend\n\nreturn {\n    {\n        action = 'goto|to',\n        description = 'Go to a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local character = findCharacter(resolvePlayers(args:nextValue()))\n\n            if not character then\n                return\n            end\n\n            self.playerService:waitForStreamPlayerCharacter(character)\n            self.playerService:teleportTo(getSpotNear(character))\n        end,\n    },\n    {\n        action = 'tweengoto|tgoto|tweento|tto',\n        description = 'Tween to a player (bypasses some anti cheats)',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'tween speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local character = findCharacter(resolvePlayers(args:nextValue()))\n\n            if not character then\n                return\n            end\n\n            local speed = args:nextValue() or self.privateEnv.tweenSpeed\n\n            self.playerService:tweenTeleportTo({\n                target = getSpotNear(character),\n                speed = speed,\n            })\n        end,\n    },\n    {\n        action = 'loopgoto',\n        description = 'Loop teleport to a player',\n        args = {\n            {\n                kind = 'player',\n            },\n            {\n                kind = 'number',\n                name = 'distance',\n                optional = true,\n            },\n            {\n                kind = 'number',\n                name = 'delay',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            stopLoopGoto(self)\n\n            local target = resolvePlayers(args:nextValue())[1]\n            local distance = args:nextValue() or 3\n            local delay = args:nextValue() or 0\n\n            if not target then\n                return\n            end\n\n            self.playerService:unseat()\n\n            local garbage = self:createGarbage('loopgoto')\n\n            garbage.id = self.loopService:add(function()\n                if target.Parent == nil then\n                    stopLoopGoto(self)\n\n                    return\n                end\n\n                local character = target.Character\n\n                if character then\n                    self.playerService:setRootCFrame(character:GetPivot() + Vector3.new(distance, 1, 0))\n                end\n            end, delay)\n        end,\n    },\n    {\n        action = 'unloopgoto|noloopgoto',\n        description = 'Stops teleporting you to a player',\n        run = function(self)\n            stopLoopGoto(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/gotopos.luau" ] = "return {\n    {\n        action = 'tpposition|tppos',\n        description = 'Teleports you to certain coordinates',\n        args = {\n            kind = 'vector3',\n        },\n        run = function(self, args)\n            self.playerService:teleportTo(args:nextValue())\n        end,\n    },\n    {\n        action = 'tweentpposition|ttppos',\n        description = 'Tween to coordinates (bypasses some anti cheats)',\n        args = {\n            {\n                kind = 'vector3',\n            },\n            {\n                kind = 'number',\n                name = 'tween speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local position = args:nextValue()\n            local speed = args:nextValue() or self.privateEnv.tweenSpeed\n\n            self.playerService:tweenTeleportTo({\n                target = position,\n                speed = speed,\n            })\n        end,\n    },\n    {\n        action = 'offset',\n        description = 'Offsets you by certain coordinates',\n        args = {\n            kind = 'vector3',\n        },\n        run = function(self, args)\n            local character = self.playerService:getCharacter()\n\n            if character then\n                character:TranslateBy(args:nextValue())\n            end\n        end,\n    },\n    {\n        action = 'tweenoffset|toffset',\n        description = 'Tween offset (bypasses some anti cheats)',\n        args = {\n            {\n                kind = 'vector3',\n            },\n            {\n                kind = 'number',\n                name = 'tween speed',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            local offset = args:nextValue()\n            local speed = args:nextValue() or self.privateEnv.tweenSpeed\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            self.playerService:tweenTeleportTo({\n                target = root.Position + offset,\n                speed = speed,\n            })\n        end,\n    },\n    {\n        action = 'thru',\n        description = \n[[Teleports you [num] studs ahead of where your character is facing]],\n        args = {\n            kind = 'number',\n            optional = true,\n        },\n        run = function(self, args)\n            local distance = args:nextValue() or 5\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            local look = root.CFrame.LookVector\n            local position = root.CFrame.Position + look * distance\n\n            self.playerService:teleportTo(CFrame.new(position, position + look))\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/init.luau" ] = "return {\n    require('./tweenspeed'),\n    require('./goto'),\n    require('./vehiclegoto'),\n    require('./pulsetp'),\n    require('./clientbring'),\n    require('./freeze'),\n    require('./freezeanimations'),\n    require('./anchor'),\n    require('./gotopos'),\n    require('./playerpos'),\n    require('./walktopos'),\n    require('./spawnpoint'),\n    require('./flashback'),\n    require('./walltp'),\n    require('./teleporttool'),\n    require('./parts'),\n    require('./mouse'),\n    require('./walk'),\n    require('./pathfind'),\n}\n",
[ "src/commands/cmds/teleport/mouse.luau" ] = "return {\n    action = 'mouseteleport|mousetp',\n    description = 'Teleports you to the spot your mouse is pointing at',\n    run = function(self)\n        local root = self.playerService:getRootPart()\n        local mouse = self.playerService:getMouse()\n\n        if not (root and mouse.Hit) then\n            return\n        end\n\n        local target = mouse.Hit.Position + Vector3.new(0, 3, 0)\n\n        self.playerService:teleportTo(CFrame.new(target) * (root.CFrame - root.CFrame.Position))\n    end,\n}\n",
[ "src/commands/cmds/teleport/parts.luau" ] = "local function travelTo(self, targetCFrame, tween)\n    self.playerService:unseat()\n    task.wait(self.privateEnv.gotopartDelay or 0.1)\n\n    if tween then\n        self.playerService:tweenTeleportTo({\n            target = targetCFrame,\n            speed = self.privateEnv.tweenSpeed,\n        })\n    else\n        self.playerService:setRootCFrame(targetCFrame)\n    end\nend\nlocal function createGotoCommand(config)\n    return {\n        action = config.action,\n        description = config.description,\n        args = {\n            kind = config.kind,\n            name = config.argName,\n        },\n        run = function(self, args)\n            local query = (args:nextValue() or ''):lower()\n\n            for _, object in workspace:GetDescendants()do\n                if object:IsA(config.className) and object[config.field]:lower() == query then\n                    travelTo(self, config.cframeOf(object), config.tween)\n                end\n            end\n        end,\n    }\nend\nlocal function createBringCommand(config)\n    return {\n        action = config.action,\n        description = config.description,\n        args = {\n            kind = config.kind,\n            name = config.argName,\n        },\n        run = function(self, args)\n            local query = (args:nextValue() or ''):lower()\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            for _, object in workspace:GetDescendants()do\n                if object:IsA(config.className) and object[config.field]:lower() == query then\n                    object.CFrame = root.CFrame\n                end\n            end\n        end,\n    }\nend\nlocal function partCFrame(object)\n    return object.CFrame\nend\nlocal function modelCFrame(object)\n    return object:GetPivot()\nend\n\nreturn {\n    createGotoCommand({\n        action = 'gotopart|topart',\n        description = 'Teleports you to every part with the given name',\n        kind = 'string',\n        argName = 'part name',\n        className = 'BasePart',\n        field = 'Name',\n        cframeOf = partCFrame,\n        tween = false,\n    }),\n    createGotoCommand({\n        action = 'tweengotopart|tgotopart|ttopart',\n        description = 'Tweens you to every part with the given name',\n        kind = 'string',\n        argName = 'part name',\n        className = 'BasePart',\n        field = 'Name',\n        cframeOf = partCFrame,\n        tween = true,\n    }),\n    createGotoCommand({\n        action = 'gotopartclass|gpc',\n        description = 'Teleports you to every part with the given class name',\n        kind = 'className',\n        argName = 'class name',\n        className = 'BasePart',\n        field = 'ClassName',\n        cframeOf = partCFrame,\n        tween = false,\n    }),\n    createGotoCommand({\n        action = 'tweengotopartclass|tgpc',\n        description = 'Tweens you to every part with the given class name',\n        kind = 'className',\n        argName = 'class name',\n        className = 'BasePart',\n        field = 'ClassName',\n        cframeOf = partCFrame,\n        tween = true,\n    }),\n    createGotoCommand({\n        action = 'gotomodel|tomodel',\n        description = 'Teleports you to every model with the given name',\n        kind = 'string',\n        argName = 'model name',\n        className = 'Model',\n        field = 'Name',\n        cframeOf = modelCFrame,\n        tween = false,\n    }),\n    createGotoCommand({\n        action = 'tweengotomodel|tgotomodel|ttomodel',\n        description = 'Tweens you to every model with the given name',\n        kind = 'string',\n        argName = 'model name',\n        className = 'Model',\n        field = 'Name',\n        cframeOf = modelCFrame,\n        tween = true,\n    }),\n    createBringCommand({\n        action = 'bringpart',\n        description = 'Brings every part with the given name to you',\n        kind = 'string',\n        argName = 'part name',\n        className = 'BasePart',\n        field = 'Name',\n    }),\n    createBringCommand({\n        action = 'bringpartclass|bpc',\n        description = 'Brings every part with the given class name to you',\n        kind = 'className',\n        argName = 'class name',\n        className = 'BasePart',\n        field = 'ClassName',\n    }),\n    {\n        action = 'gotopartdelay',\n        description = \n[[Sets the delay before the goto part commands teleport (default is 0.1)]],\n        args = {\n            kind = 'number',\n            name = 'delay',\n            optional = true,\n        },\n        run = function(self, args)\n            self.privateEnv.gotopartDelay = args:nextValue() or 0.1\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/pathfind.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\nlocal robloxServices = require('../../../framework/services/rbxServices')\nlocal PathfindingService = robloxServices.PathfindingService\nlocal REPATH_DISTANCE = 5\nlocal REPATH_INTERVAL = 2\nlocal IDLE_CHECK = 0.2\nlocal WAYPOINT_CHECK = 0.1\nlocal WAYPOINT_TIMEOUT = 3\n\nlocal function cancelMovement(self)\n    local root = self.playerService:getRootPart()\n    local humanoid = self.playerService:getHumanoid()\n\n    if root and humanoid then\n        humanoid:MoveTo(root.Position)\n    end\nend\nlocal function stopPathfind(self)\n    local garbage = self:collectGarbage('pathfind')\n\n    if not garbage then\n        return false\n    end\n\n    garbage.running = false\n\n    cancelMovement(self)\n\n    return true\nend\nlocal function computePoints(root, goal)\n    local path = PathfindingService:CreatePath()\n    local computed = pcall(function()\n        path:ComputeAsync(root.Position, goal)\n    end)\n\n    if not computed or path.Status ~= Enum.PathStatus.Success then\n        return {\n            {\n                position = goal,\n                jump = false,\n            },\n        }\n    end\n\n    local points = {}\n\n    for _, waypoint in path:GetWaypoints()do\n        table.insert(points, {\n            position = waypoint.Position,\n            jump = waypoint.Action == Enum.PathWaypointAction.Jump,\n        })\n    end\n\n    if #points > 1 and (points[1].position - root.Position).Magnitude < 2 then\n        table.remove(points, 1)\n    end\n    if #points == 0 then\n        return {\n            {\n                position = goal,\n                jump = false,\n            },\n        }\n    end\n\n    return points\nend\nlocal function targetMoved(route, target)\n    return route == nil or (target - route.goal).Magnitude > REPATH_DISTANCE\nend\nlocal function walkToPoint(humanoid, root, point, shouldStop)\n    local finished = false\n    local connection = humanoid.MoveToFinished:Connect(function()\n        finished = true\n    end)\n\n    if point.jump then\n        humanoid.Jump = true\n    end\n\n    humanoid:MoveTo(point.position)\n\n    local waited = 0\n    local stopped = false\n\n    while not finished and waited < WAYPOINT_TIMEOUT and humanoid.Parent do\n        if shouldStop() then\n            stopped = true\n\n            break\n        end\n\n        local flatDistance = Vector3.new(root.Position.X - point.position.X, 0, root.Position.Z - point.position.Z).Magnitude\n        local heightDifference = math.abs(root.Position.Y - point.position.Y)\n\n        if flatDistance < 3 and heightDifference < 4 then\n            break\n        end\n\n        task.wait(WAYPOINT_CHECK)\n\n        waited += WAYPOINT_CHECK\n    end\n\n    connection:Disconnect()\n\n    return not stopped\nend\nlocal function startPathfind(self, follow, getGoal)\n    stopPathfind(self)\n\n    local garbage = self:createGarbage('pathfind')\n\n    garbage.running = true\n\n    task.spawn(function()\n        local route = nil\n\n        while garbage.running do\n            local goal = getGoal()\n\n            if not goal then\n                break\n            end\n\n            local humanoid = self.playerService:getHumanoid()\n            local root = self.playerService:getRootPart()\n\n            if not (humanoid and root) then\n                route = nil\n\n                task.wait(IDLE_CHECK)\n\n                continue\n            end\n\n            local finished = route ~= nil and route.index > #route.points\n            local expired = follow and route ~= nil and not finished and os.clock() - route.computedAt > REPATH_INTERVAL\n\n            if targetMoved(route, goal) or expired then\n                local points = computePoints(root, goal)\n\n                if not garbage.running then\n                    break\n                end\n\n                route = {\n                    goal = goal,\n                    points = points,\n                    index = 1,\n                    computedAt = os.clock(),\n                }\n            elseif finished then\n                if not follow then\n                    break\n                end\n\n                task.wait(IDLE_CHECK)\n            else\n                local current = route\n                local walked = walkToPoint(humanoid, root, current.points[current.index], function(\n                )\n                    if not garbage.running then\n                        return true\n                    end\n\n                    local now = getGoal()\n\n                    return now == nil or (follow and targetMoved(current, now))\n                end)\n\n                if walked then\n                    current.index += 1\n                end\n            end\n        end\n\n        if self:getGarbage('pathfind') == garbage then\n            self:collectGarbage('pathfind')\n        end\n    end)\nend\n\nreturn {\n    {\n        action = 'pathfindwalkto|pathfindfollow',\n        description = 'Follow a player using pathfinding',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n\n            if not target then\n                self:notify('Pathfind', 'player not found')\n\n                return\n            end\n\n            startPathfind(self, true, function()\n                local root = target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n                return root and root.Position\n            end)\n        end,\n    },\n    {\n        action = 'pathfindwalktowaypoint|pathfindwalktowp|pftowp',\n        description = 'Walk to a waypoint using pathfinding',\n        args = {\n            kind = 'waypoint',\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n            local places = self.storage.waypoints:getValue(tostring(game.PlaceId))\n            local coords = type(places) == 'table' and name and places[name]\n\n            if not coords then\n                self:notify('Pathfind', `there is no waypoint named '{name}'`)\n\n                return\n            end\n\n            local position = self:unstringify(coords, 'Vector3')\n\n            startPathfind(self, false, function()\n                return position\n            end)\n        end,\n    },\n    {\n        action = 'unpathfind|nopathfind|pathfindstop',\n        description = 'Stops pathfindwalkto and pathfindwalktowaypoint',\n        run = function(self)\n            if stopPathfind(self) then\n                self:notify('Pathfind', 'stopped')\n            else\n                self:notify('Pathfind', 'nothing is walking right now')\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/playerpos.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function getPositionText(self, text)\n    local target = self.localPlayer\n\n    if text then\n        target = resolvePlayers(text)[1]\n    end\n\n    local character = target and target.Character\n    local part = character and (character:FindFirstChild('HumanoidRootPart') or character:FindFirstChildWhichIsA('BasePart'))\n\n    if not part then\n        return nil\n    end\n\n    local position = part.Position\n\n    return tostring(math.round(position.X)) .. ', ' .. tostring(math.round(position.Y)) .. ', ' .. tostring(math.round(position.Z))\nend\n\nreturn {\n    {\n        action = 'notifyposition|notifypos',\n        description = 'Notifies you the coordinates of a character',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local text = getPositionText(self, args:nextValue())\n\n            if text then\n                self:notify('Position', text)\n            else\n                self:notify('Position', 'character is not loaded')\n            end\n        end,\n    },\n    {\n        action = 'getposition|getpos',\n        description = 'Notifies you the coordinates of a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            for _, player in resolvePlayers(args:nextValue())do\n                local text = getPositionText(self, player.Name)\n\n                self:notify(`{player.Name} Position`, text or 'character is not loaded')\n            end\n        end,\n    },\n    {\n        action = 'copyposition|copypos',\n        description = 'Copies the coordinates of a character to your clipboard',\n        args = {\n            kind = 'player',\n            optional = true,\n        },\n        run = function(self, args)\n            local setclipboard = self:expectExploit('setclipboard')\n\n            if not setclipboard then\n                return\n            end\n\n            local text = getPositionText(self, args:nextValue())\n\n            if text then\n                setclipboard(text)\n            else\n                self:notify('Position', 'character is not loaded')\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/pulsetp.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    action = 'pulsetp|ptp',\n    description = 'Teleports you to a player for a specified amount of time',\n    args = {\n        {\n            kind = 'player',\n        },\n        {\n            kind = 'number',\n            name = 'time amount',\n            optional = true,\n        },\n    },\n    run = function(self, args)\n        local target = resolvePlayers(args:nextValue())[1]\n        local seconds = args:nextValue() or 1\n        local targetRoot = target and target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n        if not targetRoot then\n            return\n        end\n\n        local startRoot = self.playerService:getRootPart()\n\n        if not startRoot then\n            return\n        end\n\n        local startCFrame = startRoot.CFrame\n\n        self.playerService:teleportTo(targetRoot.CFrame + Vector3.new(3, 1, 0))\n        task.wait(seconds)\n        self.playerService:setRootCFrame(startCFrame)\n    end,\n}\n",
[ "src/commands/cmds/teleport/spawnpoint.luau" ] = "local function stopSpawnPoint(self)\n    local garbage = self:collectGarbage('spawnpoint')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\n\n    return garbage ~= nil\nend\n\nreturn {\n    {\n        action = 'spawnpoint|spawn',\n        description = 'Sets a position where you will spawn',\n        args = {\n            kind = 'number',\n            name = 'delay',\n            optional = true,\n        },\n        run = function(self, args)\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            local delay = args:nextValue() or 0.1\n\n            stopSpawnPoint(self)\n\n            local garbage = self:createGarbage('spawnpoint')\n\n            garbage.cframe = root.CFrame\n            garbage.delay = delay\n            garbage.connection = self:connect(self.localPlayer.CharacterAdded, function(\n                character\n            )\n                character:WaitForChild('HumanoidRootPart', 10)\n                task.wait(garbage.delay)\n                self.playerService:setRootCFrame(garbage.cframe)\n            end)\n\n            self:notify('Spawn Point', 'Spawn point created')\n        end,\n    },\n    {\n        action = 'nospawnpoint|nospawn',\n        description = 'Removes your custom spawn point',\n        run = function(self)\n            if stopSpawnPoint(self) then\n                self:notify('Spawn Point', 'Removed spawn point')\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/teleporttool.luau" ] = "return {\n    action = 'teleporttool|tptool',\n    description = 'Gives you a teleport tool',\n    run = function(self)\n        local backpack = self.localPlayer:FindFirstChildOfClass('Backpack')\n\n        if not backpack then\n            self:notify('Teleport Tool', 'your backpack is not loaded')\n\n            return\n        end\n\n        local tool = Instance.new('Tool')\n\n        tool.Name = 'Teleport Tool'\n        tool.RequiresHandle = false\n        tool.Parent = backpack\n\n        self:connect(tool.Activated, function()\n            local root = self.playerService:getRootPart()\n            local mouse = self.playerService:getMouse()\n\n            if not (root and mouse.Hit) then\n                return\n            end\n\n            local target = mouse.Hit.Position + Vector3.new(0, 3, 0)\n\n            self.playerService:teleportTo(CFrame.new(target) * (root.CFrame - root.CFrame.Position))\n        end)\n    end,\n}\n",
[ "src/commands/cmds/teleport/tweenspeed.luau" ] = "return {\n    action = 'tweenspeed|tspeed',\n    description = \n[[Sets how fast the tween commands move you, in studs per second (default is 100)]],\n    args = {\n        kind = 'number',\n        name = 'tween speed',\n        optional = true,\n    },\n    run = function(self, args)\n        self.privateEnv.tweenSpeed = args:nextValue()\n    end,\n}\n",
[ "src/commands/cmds/teleport/vehiclegoto.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nreturn {\n    action = 'vehiclegoto|vgoto|vehicletp|vtp',\n    description = 'Go to a player while in a vehicle',\n    args = {\n        kind = 'player',\n    },\n    run = function(self, args)\n        local humanoid = self.playerService:getHumanoid()\n        local seat = humanoid and humanoid.SeatPart\n\n        if not seat then\n            self:notify('vehiclegoto', 'you are not sitting in a vehicle')\n\n            return\n        end\n\n        local target = resolvePlayers(args:nextValue())[1]\n        local targetRoot = target and target.Character and target.Character:FindFirstChild('HumanoidRootPart')\n\n        if not targetRoot then\n            return\n        end\n\n        local vehicle = seat:FindFirstAncestorWhichIsA('Model')\n\n        if vehicle then\n            vehicle:PivotTo(targetRoot:GetPivot())\n        end\n    end,\n}\n",
[ "src/commands/cmds/teleport/walk.luau" ] = "local function stopTpWalk(self)\n    local garbage = self:collectGarbage('tpwalk')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\nlocal function getWallwalk(self)\n    local cached = self.privateEnv.wallwalkSetEnabled\n\n    if cached then\n        return cached\n    end\n\n    local success, setEnabled = pcall(function()\n        local chunk, err = self.fetchService.load('backups/wallwalker.luau', 'iy/wallwalker')\n        assert(type(chunk) == 'function', err or 'Wallwalk source is unavailable')\n        local controller = chunk()\n        assert(type(controller) == 'function', 'Wallwalk did not return a controller')\n        return controller\n    end)\n\n    if not success then\n        self:notify('Wallwalk', 'could not load: ' .. tostring(setEnabled))\n\n        return\n    end\n\n    self.privateEnv.wallwalkSetEnabled = setEnabled\n\n    return setEnabled\nend\n\nreturn {\n    {\n        action = 'tpwalk|teleportwalk',\n        description = 'Teleports you to your move direction',\n        args = {\n            {\n                kind = 'number',\n                name = 'distance',\n                optional = true,\n            },\n            {\n                kind = 'boolean',\n                name = 'stack distance',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            stopTpWalk(self)\n\n            local speed = args:nextValue() or 1\n            local stack = args:nextValue()\n\n            if stack then\n                self.privateEnv.tpwalkStack = (self.privateEnv.tpwalkStack or 0) + speed\n            end\n\n            local character = self.playerService:getCharacter()\n            local humanoid = self.playerService:getHumanoid()\n\n            if not (character and humanoid) then\n                return\n            end\n\n            local garbage = self:createGarbage('tpwalk')\n\n            garbage.connection = self:connect(self.runService.Heartbeat, function(\n                delta\n            )\n                if not (character.Parent and humanoid.Parent) then\n                    stopTpWalk(self)\n\n                    return\n                end\n\n                local direction = humanoid.MoveDirection\n\n                if direction.Magnitude > 0 then\n                    local total = speed + (self.privateEnv.tpwalkStack or 0)\n\n                    character:TranslateBy(direction * total * delta * 10)\n                end\n            end)\n        end,\n    },\n    {\n        action = 'untpwalk|unteleportwalk',\n        description = 'Undoes tpwalk / teleportwalk',\n        run = function(self)\n            self.privateEnv.tpwalkStack = 0\n\n            stopTpWalk(self)\n        end,\n    },\n    {\n        action = 'wallwalk|walkonwalls',\n        description = 'Walk on walls',\n        run = function(self)\n            local previous = self:collectGarbage('wallwalk')\n\n            if previous and previous.active then\n                previous.stop()\n                self:notify('Wallwalk', 'disabled')\n\n                return\n            end\n\n            local setEnabled = getWallwalk(self)\n\n            if not setEnabled then\n                return\n            end\n\n            local ok, err = pcall(setEnabled, true)\n\n            if not ok then\n                self:notify('Wallwalk', `could not start: {tostring(err)}`)\n\n                return\n            end\n\n            local garbage = self:createGarbage('wallwalk')\n\n            garbage.active = true\n            garbage.stop = function()\n                garbage.active = false\n\n                pcall(setEnabled, false)\n            end\n\n            self:notify('Wallwalk', 'walk on any surface; run wallwalk again to turn it off')\n        end,\n    },\n    {\n        action = 'unwallwalk|nowallwalk',\n        description = 'Turns off wallwalk',\n        run = function(self)\n            local previous = self:collectGarbage('wallwalk')\n            local wasOn = previous ~= nil and previous.active == true\n\n            if previous and previous.stop then\n                previous.stop()\n            end\n\n            self:notify('Wallwalk', if wasOn then'disabled'else'it is not running')\n        end,\n    },\n}\n",
[ "src/commands/cmds/teleport/walktopos.luau" ] = "return {\n    action = 'walktoposition|walktopos',\n    description = 'Makes you walk to a coordinate',\n    args = {\n        kind = 'vector3',\n    },\n    run = function(self, args)\n        local position = args:nextValue()\n        local humanoid = self.playerService:getHumanoid()\n\n        if humanoid and humanoid.SeatPart then\n            humanoid.Sit = false\n\n            task.wait(0.1)\n        end\n\n        humanoid = self.playerService:getHumanoid()\n\n        if humanoid then\n            humanoid.WalkToPoint = position\n        end\n    end,\n}\n",
[ "src/commands/cmds/teleport/walltp.luau" ] = "local function stopWallTp(self)\n    local garbage = self:collectGarbage('walltp')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'walltp',\n        description = 'Teleports you above/over any wall you run into',\n        run = function(self)\n            stopWallTp(self)\n\n            local character = self.playerService:getCharacter()\n            local torso = character and (character:FindFirstChild('UpperTorso') or character:FindFirstChild('Torso'))\n\n            if not torso then\n                return\n            end\n\n            local garbage = self:createGarbage('walltp')\n\n            garbage.connection = self:connect(torso.Touched, function(hit)\n                local root = self.playerService:getRootPart()\n                local humanoid = self.playerService:getHumanoid()\n\n                if not (root and humanoid and hit.Parent) then\n                    return\n                end\n                if not hit:IsA('BasePart') then\n                    return\n                end\n                if hit.Position.Y <= root.Position.Y - humanoid.HipHeight then\n                    return\n                end\n\n                local look = root.CFrame.LookVector\n                local hitRoot = hit.Parent:FindFirstChild('HumanoidRootPart')\n\n                if hitRoot then\n                    self.playerService:setRootCFrame(hit.CFrame * CFrame.new(look.X, hitRoot.Size.Z / 2 + humanoid.HipHeight, look.Z))\n                else\n                    self.playerService:setRootCFrame(hit.CFrame * CFrame.new(look.X, hit.Size.Y / 2 + humanoid.HipHeight, look.Z))\n                end\n            end)\n        end,\n    },\n    {\n        action = 'nowalltp|unwalltp',\n        description = 'Disables walltp',\n        run = function(self)\n            stopWallTp(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/visual/esp.luau" ] = "local EspManager = require('../../systems/espManager')\nlocal resolvePlayers = require('../../systems/resolvePlayers')\nlocal robloxServices = require('../../../framework/services/rbxServices')\nlocal privateEnv = require('../../../framework/environment/private')\nlocal Players = robloxServices.Players\nlocal DEFAULT_TRANSPARENCY = 0.3\nlocal GREEN = Color3.fromRGB(0, 255, 0)\nlocal RED = Color3.fromRGB(255, 0, 0)\nlocal WHITE = Color3.fromRGB(255, 255, 255)\nlocal PART_GREEN = Color3.fromRGB(50, 205, 50)\n\nlocal function characters()\n    local list = {}\n    local me = Players.LocalPlayer\n\n    for _, player in Players:GetPlayers()do\n        if player ~= me and player.Character then\n            table.insert(list, player.Character)\n        end\n    end\n\n    return list\nend\nlocal function playerColor(character)\n    local player = Players:GetPlayerFromCharacter(character)\n\n    if player then\n        return player.TeamColor.Color\n    end\n\n    return WHITE\nend\nlocal function teamColor(character)\n    local player = Players:GetPlayerFromCharacter(character)\n\n    if player and player.TeamColor == Players.LocalPlayer.TeamColor then\n        return GREEN\n    end\n\n    return RED\nend\nlocal function constantColor(color)\n    return function()\n        return color\n    end\nend\nlocal function namedParts(names)\n    return function()\n        local list = {}\n\n        for _, object in workspace:GetDescendants()do\n            if object:IsA('BasePart') and names[object.Name:lower()] then\n                table.insert(list, object)\n            end\n        end\n\n        return list\n    end\nend\nlocal function espText(character, meters, studs)\n    local player = Players:GetPlayerFromCharacter(character)\n    local humanoid = character:FindFirstChildOfClass('Humanoid')\n    local health = 0\n\n    if humanoid then\n        health = math.floor(humanoid.Health * 10 + 0.5) / 10\n    end\n\n    return ('Name: %s | Health: %g | Studs: %d'):format(player and player.Name or character.Name, health, studs)\nend\nlocal function stopManager(self, name)\n    local garbage = self:collectGarbage(name)\n\n    if garbage and garbage.manager then\n        garbage.manager:destroy()\n    end\nend\nlocal function startManager(self, name, options)\n    stopManager(self, name)\n\n    options.tag = name\n\n    local manager = EspManager.new(options)\n    local garbage = self:createGarbage(name)\n\n    garbage.manager = manager\n\n    manager:start()\nend\nlocal function startEsp(self, color)\n    if self:hasGarbage('chams') then\n        self:notify('ESP', 'Disable chams (nochams) before using esp')\n\n        return\n    end\n\n    startManager(self, 'esp', {\n        source = characters,\n        color = color,\n        showBoxes = true,\n        showText = true,\n    })\nend\n\nlocal LOCATE_PREFIX = 'locate:'\n\nlocal function locateName(player)\n    return LOCATE_PREFIX .. player.Name\nend\nlocal function startLocate(self, player)\n    startManager(self, locateName(player), {\n        source = function()\n            local character = player.Character\n\n            if character then\n                return {character}\n            end\n\n            return {}\n        end,\n        color = playerColor,\n        showBoxes = true,\n        showText = true,\n    })\nend\n\nreturn {\n    {\n        action = 'esp',\n        description = 'View all players and their status',\n        run = function(self)\n            startEsp(self, playerColor)\n        end,\n    },\n    {\n        action = 'espteam',\n        description = 'ESP but teammates are green and bad guys are red',\n        run = function(self)\n            startEsp(self, teamColor)\n        end,\n    },\n    {\n        action = 'noesp|unesp|unespteam',\n        description = 'Removes ESP',\n        run = function(self)\n            stopManager(self, 'esp')\n        end,\n    },\n    {\n        action = 'esptransparency',\n        description = 'Changes the transparency of ESP related commands',\n        args = {\n            kind = 'number',\n        },\n        run = function(self, args)\n            local value = args:nextValue()\n\n            privateEnv.espTransparency = math.clamp(value or DEFAULT_TRANSPARENCY, 0, 1)\n        end,\n    },\n    {\n        action = 'partesp',\n        description = 'Highlights a part',\n        args = {\n            kind = 'string',\n            name = 'part name',\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n\n            if not name then\n                self:notify('partesp', 'Write the name of a part')\n\n                return\n            end\n\n            local names = privateEnv.partEspNames or {}\n\n            privateEnv.partEspNames = names\n            names[name:lower()] = true\n\n            if not self:hasGarbage('partesp') then\n                startManager(self, 'partesp', {\n                    source = namedParts(names),\n                    color = constantColor(PART_GREEN),\n                    showBoxes = true,\n                    showText = false,\n                    interval = 1,\n                })\n            end\n        end,\n    },\n    {\n        action = 'unpartesp|nopartesp',\n        description = 'removes partesp',\n        args = {\n            kind = 'string',\n            name = 'part name',\n        },\n        run = function(self, args)\n            local names = privateEnv.partEspNames or {}\n\n            privateEnv.partEspNames = names\n\n            local name = args:nextValue()\n\n            if name then\n                names[name:lower()] = nil\n            else\n                table.clear(names)\n            end\n            if next(names) == nil then\n                stopManager(self, 'partesp')\n            end\n        end,\n    },\n    {\n        action = 'chams',\n        description = 'ESP but without text in the way',\n        run = function(self)\n            if self:hasGarbage('esp') then\n                self:notify('Chams', 'Disable ESP (noesp) before using chams')\n\n                return\n            end\n\n            startManager(self, 'chams', {\n                source = characters,\n                color = playerColor,\n                showBoxes = true,\n                showText = false,\n            })\n        end,\n    },\n    {\n        action = 'nochams|unchams',\n        description = 'Removes chams',\n        run = function(self)\n            stopManager(self, 'chams')\n        end,\n    },\n    {\n        action = 'locate',\n        description = 'View a single player and their status',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            if not text then\n                return\n            end\n\n            for _, player in resolvePlayers(text)do\n                if player ~= Players.LocalPlayer then\n                    startLocate(self, player)\n                end\n            end\n        end,\n    },\n    {\n        action = 'unlocate|nolocate',\n        description = 'Removes locate',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local text = args:nextValue()\n\n            if not text then\n                local names = {}\n\n                for name in pairs(self.garbages)do\n                    if name:sub(1, #LOCATE_PREFIX) == LOCATE_PREFIX then\n                        table.insert(names, name)\n                    end\n                end\n                for _, name in names do\n                    stopManager(self, name)\n                end\n\n                return\n            end\n\n            local names = {}\n\n            for _, player in resolvePlayers(text)do\n                table.insert(names, locateName(player))\n            end\n\n            if not resolvePlayers.isSelector(text) then\n                local wanted = text:lower()\n\n                for name in pairs(self.garbages)do\n                    if name:sub(1, #LOCATE_PREFIX) == LOCATE_PREFIX then\n                        local playerName = name:sub(#LOCATE_PREFIX + 1):lower()\n\n                        if playerName:sub(1, #wanted) == wanted then\n                            table.insert(names, name)\n                        end\n                    end\n                end\n            end\n\n            for _, name in names do\n                stopManager(self, name)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/visual/hitboxes.luau" ] = "local function setHitboxes(self, enabled)\n    local ok = pcall(function()\n        settings():GetService('RenderSettings').ShowBoundingBoxes = enabled\n    end)\n\n    if not ok then\n        self:notify('Hitboxes', 'this executor cannot change the hitbox display')\n    end\nend\n\nreturn {\n    {\n        client = true,\n        action = 'hitboxes|showhitboxes',\n        description = 'Shows player hitboxes (CLIENT)',\n        run = function(self)\n            setHitboxes(self, true)\n        end,\n    },\n    {\n        client = true,\n        action = 'unhitboxes|nohitboxes|unshowhitboxes',\n        description = 'Hides player hitboxes (CLIENT)',\n        run = function(self)\n            setHitboxes(self, false)\n        end,\n    },\n}\n",
[ "src/commands/cmds/visual/hovername.luau" ] = "local function findPlayer(self, target)\n    if not target then\n        return nil\n    end\n\n    local model = target:FindFirstAncestorOfClass('Model')\n\n    if not model then\n        return nil\n    end\n\n    return self.players:GetPlayerFromCharacter(model)\nend\nlocal function stopHovername(self)\n    local garbage = self:collectGarbage('hovername')\n\n    if not garbage then\n        return false\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\n    if garbage.gui then\n        garbage.gui:Destroy()\n    end\n\n    return true\nend\nlocal function createGui(self)\n    local gui = Instance.new('ScreenGui')\n\n    gui.Name = 'HovernameGui'\n    gui.ResetOnSpawn = false\n\n    local hiddenParent = self.executorEnv.gethui and self.executorEnv.gethui()\n\n    gui.Parent = hiddenParent or self.coreGui\n\n    local label = Instance.new('TextLabel')\n\n    label.Name = 'Name'\n    label.BackgroundTransparency = 1\n    label.Size = UDim2.fromOffset(200, 20)\n    label.Font = Enum.Font.SourceSansBold\n    label.TextSize = 16\n    label.TextColor3 = Color3.new(1, 1, 1)\n    label.TextStrokeTransparency = 0\n    label.TextXAlignment = Enum.TextXAlignment.Left\n    label.Visible = false\n    label.Parent = gui\n\n    return gui, label\nend\n\nreturn {\n    {\n        action = 'hovername',\n        description = \n[[Shows a players username when your mouse is hovered over them]],\n        run = function(self)\n            stopHovername(self)\n\n            local mouse = self.playerService:getMouse()\n            local gui, label = createGui(self)\n            local garbage = self:createGarbage('hovername')\n\n            garbage.gui = gui\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                local player = findPlayer(self, mouse.Target)\n\n                if player then\n                    label.Text = player.Name\n                    label.Position = UDim2.fromOffset(mouse.X + 18, mouse.Y + 12)\n                    label.Visible = true\n                else\n                    label.Visible = false\n                end\n            end)\n        end,\n    },\n    {\n        action = 'unhovername|nohovername',\n        description = 'Turns off hovername',\n        run = function(self)\n            stopHovername(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/visual/init.luau" ] = "return {\n    require('./esp'),\n    require('./xray'),\n    require('./hovername'),\n    require('./hitboxes'),\n}\n",
[ "src/commands/cmds/visual/xray.luau" ] = "local function applyXray(self)\n    local enabled = self.privateEnv.xrayEnabled == true\n\n    for _, object in workspace:GetDescendants()do\n        if object:IsA('BasePart') then\n            local parent = object.Parent\n            local grandParent = parent and parent.Parent\n            local isCharacter = (parent and parent:FindFirstChildWhichIsA('Humanoid')) or (grandParent and grandParent:FindFirstChildWhichIsA('Humanoid'))\n\n            if not isCharacter then\n                object.LocalTransparencyModifier = enabled and 0.5 or 0\n            end\n        end\n    end\nend\nlocal function stopLoop(self)\n    local garbage = self:collectGarbage('loopxray')\n\n    if garbage then\n        garbage.connection:Disconnect()\n    end\nend\n\nreturn {\n    {\n        action = 'xray',\n        description = 'Makes all parts in workspace transparent',\n        run = function(self)\n            self.privateEnv.xrayEnabled = true\n\n            applyXray(self)\n        end,\n    },\n    {\n        action = 'unxray|noxray',\n        description = 'Restores transparency to all parts in workspace',\n        run = function(self)\n            self.privateEnv.xrayEnabled = false\n\n            applyXray(self)\n        end,\n    },\n    {\n        action = 'loopxray',\n        description = 'Makes all parts in workspace transparent but looped',\n        run = function(self)\n            stopLoop(self)\n\n            local garbage = self:createGarbage('loopxray')\n\n            garbage.connection = self:connect(self.runService.RenderStepped, function(\n            )\n                self.privateEnv.xrayEnabled = true\n\n                applyXray(self)\n            end)\n        end,\n    },\n    {\n        action = 'unloopxray',\n        description = 'Unloops xray',\n        run = function(self)\n            stopLoop(self)\n\n            self.privateEnv.xrayEnabled = false\n\n            applyXray(self)\n        end,\n    },\n    {\n        action = 'togglexray',\n        description = 'Toggles xray',\n        run = function(self)\n            self.privateEnv.xrayEnabled = not self.privateEnv.xrayEnabled\n\n            applyXray(self)\n        end,\n    },\n}\n",
[ "src/commands/cmds/waypoints/init.luau" ] = "local waypoints = require('../../systems/waypoints')\nlocal TITLE = 'Waypoints'\n\nlocal function getWaypoint(self, name)\n    local waypoint = waypoints.find(name)\n\n    if not waypoint then\n        self:notify(TITLE, `there is no waypoint named '{name}'`)\n    end\n\n    return waypoint\nend\nlocal function goTo(self, args, mode)\n    local waypoint = getWaypoint(self, args:nextValue())\n\n    if not waypoint then\n        return\n    end\n\n    local speed = args:nextValue()\n\n    speed = if typeof(speed) == 'number'then speed else nil\n\n    waypoints.go(waypoint, mode, speed)\nend\n\nreturn {\n    {\n        action = 'setwaypoint|swp|setwp|spos|savepos|setpos',\n        description = 'Sets a waypoint at your position',\n        args = {\n            kind = 'string',\n            name = 'waypoint name',\n        },\n        run = function(self, args)\n            local root = self:getRoot()\n\n            if not root then\n                return\n            end\n\n            local name = args:nextValue()\n\n            waypoints.save(name, root.Position)\n            waypoints.refreshMarkers()\n            self:notify(TITLE, `saved waypoint '{name}' at {waypoints.format(root.Position)}`)\n        end,\n    },\n    {\n        action = 'waypointpos|wpp',\n        description = 'Sets a waypoint with specified coordinates',\n        args = {\n            {\n                kind = 'string',\n                name = 'waypoint name',\n            },\n            {\n                kind = 'vector3',\n                name = 'position',\n            },\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n            local position = args:nextValue()\n\n            waypoints.save(name, position)\n            waypoints.refreshMarkers()\n            self:notify(TITLE, `saved waypoint '{name}' at {waypoints.format(position)}`)\n        end,\n    },\n    {\n        action = 'waypoints|positions',\n        description = 'Shows a list of currently active waypoints',\n        run = function(self)\n            local list = waypoints.list()\n\n            if #list == 0 then\n                self:notify(TITLE, 'there are no waypoints in this game')\n\n                return\n            end\n\n            local lines = {}\n\n            for _, waypoint in list do\n                table.insert(lines, `{waypoint.name} {waypoints.format(waypoint.position)}`)\n            end\n\n            self:notify(TITLE, table.concat(lines, ', '))\n        end,\n    },\n    {\n        action = 'showwaypoints|showwp|showwps',\n        description = 'Shows all currently set waypoints',\n        run = function(self)\n            if waypoints.count() == 0 then\n                self:notify(TITLE, 'there are no waypoints to show')\n\n                return\n            end\n\n            waypoints.show()\n        end,\n    },\n    {\n        action = 'hidewaypoints|hidewp|hidewps',\n        description = 'Hides shown waypoints',\n        run = function()\n            waypoints.hide()\n        end,\n    },\n    {\n        action = \n[[waypoint|wp|gotowaypoint|gotowp|gwp|loadpos|lpos|loadposition]],\n        description = 'Teleports player to a waypoint',\n        args = {\n            kind = 'waypoint',\n            name = 'waypoint',\n        },\n        run = function(self, args)\n            goTo(self, args, 'teleport')\n        end,\n    },\n    {\n        action = 'tweenwaypoint|twp|tweengotowaypoint|tgotowp',\n        description = 'Tweens player to a waypoint',\n        args = {\n            {\n                kind = 'waypoint',\n                name = 'waypoint',\n            },\n            {\n                name = 'tween_speed',\n                kind = 'number',\n                optional = true,\n            },\n        },\n        run = function(self, args)\n            goTo(self, args, 'tween')\n        end,\n    },\n    {\n        action = 'walktowaypoint|wtwp|walktowp',\n        description = 'Walks player to a waypoint',\n        args = {\n            kind = 'waypoint',\n            name = 'waypoint',\n        },\n        run = function(self, args)\n            goTo(self, args, 'walk')\n        end,\n    },\n    {\n        action = 'deletewaypoint|dwp|deletepos|dpos',\n        description = 'Deletes a waypoint',\n        args = {\n            kind = 'waypoint',\n            name = 'waypoint',\n        },\n        run = function(self, args)\n            local waypoint = getWaypoint(self, args:nextValue())\n\n            if not waypoint then\n                return\n            end\n\n            waypoints.remove(waypoint.name)\n            waypoints.refreshMarkers()\n            self:notify(TITLE, `deleted waypoint '{waypoint.name}'`)\n        end,\n    },\n    {\n        action = 'clearwaypoints|cwp|clearpositions|clearpos|cpos',\n        description = 'Clears all waypoints from every game',\n        args = {\n            kind = 'boolean',\n            name = 'confirm',\n            optional = true,\n        },\n        run = function(self, args)\n            local confirm = args:nextValue()\n\n            if not confirm then\n                self:notify(TITLE, \"cancelled, use 'true' to confirm\")\n\n                return\n            end\n\n            local total = waypoints.clearAll()\n\n            waypoints.hide()\n            self:notify(TITLE, `deleted {total} waypoints from every game`)\n        end,\n    },\n    {\n        action = 'cleargamewaypoints|cgamewp',\n        description = 'Clears all waypoints for the game you are in',\n        args = {\n            kind = 'boolean',\n            name = 'confirm',\n            optional = true,\n        },\n        run = function(self, args)\n            local confirm = args:nextValue()\n\n            if not confirm then\n                self:notify(TITLE, \"cancelled, use 'true' to confirm\")\n\n                return\n            end\n\n            local count = waypoints.clearPlace()\n\n            waypoints.hide()\n            self:notify(TITLE, `deleted {count} waypoints from this game`)\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/cleanup.luau" ] = "return {\n    {\n        action = 'deleteinvisparts|deleteinvisibleparts|dip',\n        description = 'Deletes invisible collidable parts',\n        run = function()\n            for _, object in workspace:GetDescendants()do\n                if object:IsA('BasePart') and object.Transparency == 1 and object.CanCollide then\n                    object:Destroy()\n                end\n            end\n        end,\n    },\n    {\n        action = 'removeterrain|rterrain|noterrain',\n        description = 'Clears all the terrain',\n        run = function()\n            local terrain = workspace:FindFirstChildOfClass('Terrain')\n\n            if terrain then\n                terrain:Clear()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/clienttools.luau" ] = "local embeddedResources = require('../../../framework/resources')\nlocal F3X_SOURCE_URL = nil\n\nreturn {\n    {\n        client = true,\n        action = 'btools',\n        description = 'Gives you building tools (DOES NOT REPLICATE)',\n        run = function(self)\n            local backpack = self.localPlayer:FindFirstChildWhichIsA('Backpack')\n\n            if not backpack then\n                self:notify('Btools', 'your backpack is not loaded')\n\n                return\n            end\n\n            for _, binType in Enum.BinType:GetEnumItems()do\n                local tool = Instance.new('HopperBin')\n\n                tool.BinType = binType\n                tool.Name = 'Building Tool'\n                tool.Parent = backpack\n            end\n        end,\n    },\n    {\n        client = true,\n        action = 'f3x',\n        description = 'Gives you F3X building tools (DOES NOT REPLICATE)',\n        run = function(self)\n            if F3X_SOURCE_URL == nil then\n                self:notify('F3X', \n[[no script link is set, fill in F3X_SOURCE_URL at the top of workspace/clienttools.luau]])\n\n                return\n            end\n\n            local loadstring = self:expectExploit('loadstring')\n\n            if not loadstring then\n                return\n            end\n\n            local ok, err = pcall(function()\n                loadstring(embeddedResources.httpGet(game, F3X_SOURCE_URL))()\n            end)\n\n            if not ok then\n                self:notify('F3X', `failed to load: {tostring(err)}`)\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/deletepart.luau" ] = "local function confirmed(self, confirm, description)\n    if confirm == false then\n        self:notify('Delete', 'cancelled: ' .. description)\n\n        return false\n    end\n\n    return true\nend\n\nreturn {\n    {\n        client = true,\n        action = 'delete|remove',\n        description = \n[[Removes any part with a certain name from the workspace (DOES NOT REPLICATE)]],\n        args = {\n            {\n                kind = 'string',\n                name = 'object name',\n            },\n            {\n                kind = 'boolean',\n                name = 'confirm',\n            },\n        },\n        run = function(self, args)\n            local name = args:nextValue()\n            local confirm = args:nextValue()\n\n            if not confirmed(self, confirm, name) then\n                return\n            end\n\n            local wanted = name:lower()\n\n            for _, object in workspace:GetDescendants()do\n                if object.Name:lower() == wanted then\n                    object:Destroy()\n                end\n            end\n\n            self:notify('Item(s) Deleted', 'Deleted ' .. name)\n        end,\n    },\n    {\n        client = true,\n        action = 'deleteclass|dc',\n        description = \n[[Removes any part with a certain classname from the workspace (DOES NOT REPLICATE)]],\n        args = {\n            {\n                kind = 'className',\n            },\n            {\n                kind = 'boolean',\n                name = 'confirm',\n            },\n        },\n        run = function(self, args)\n            local className = args:nextValue()\n            local confirm = args:nextValue()\n\n            if not confirmed(self, confirm, className) then\n                return\n            end\n\n            local wanted = className:lower()\n\n            for _, object in workspace:GetDescendants()do\n                if object.ClassName:lower() == wanted then\n                    object:Destroy()\n                end\n            end\n\n            self:notify('Item(s) Deleted', 'Deleted items with ClassName ' .. className)\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/fire.luau" ] = "local function matchName(object, name)\n    return name == '' or object.Name:lower() == name or (object.Parent ~= nil and object.Parent.Name:lower() == name)\nend\nlocal function getPromptPosition(prompt)\n    local parent = prompt.Parent\n\n    if parent == nil then\n        return nil\n    elseif parent:IsA('Attachment') then\n        return parent.WorldPosition\n    elseif parent:IsA('BasePart') then\n        return parent.Position\n    elseif parent:IsA('Model') then\n        return parent:GetPivot().Position\n    end\n\n    return nil\nend\nlocal function getClosestPrompt(self)\n    local root = self.playerService:getRootPart()\n\n    if not root then\n        return nil\n    end\n\n    local closestPrompt = nil\n    local closestDistance = math.huge\n\n    for _, descendant in workspace:GetDescendants()do\n        if descendant:IsA('ProximityPrompt') and descendant.Enabled then\n            local position = getPromptPosition(descendant)\n\n            if not position then\n                continue\n            end\n\n            local distance = (position - root.Position).Magnitude\n\n            if distance < closestDistance then\n                closestPrompt, closestDistance = descendant, distance\n            end\n        end\n    end\n\n    return closestPrompt\nend\nlocal function teleportToPrompt(self, prompt)\n    local root = self.playerService:getRootPart()\n    local position = getPromptPosition(prompt)\n\n    if root and position then\n        root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))\n    end\nend\n\nreturn {\n    {\n        action = 'fireclickdetectors|firecd|firecds',\n        description = \n[[Uses all click detectors in a game or uses the optional name]],\n        args = {\n            kind = 'object',\n            optional = true,\n        },\n        run = function(self, args)\n            local fireclickdetector = self:expectExploit('fireclickdetector')\n\n            if not fireclickdetector then\n                return\n            end\n\n            local name = (args:nextValue() or ''):lower()\n\n            for _, descendant in workspace:GetDescendants()do\n                if descendant:IsA('ClickDetector') and matchName(descendant, name) then\n                    fireclickdetector(descendant)\n                end\n            end\n        end,\n    },\n    {\n        action = 'fireproximityprompts|firepp',\n        description = \n[[Uses all proximity prompts in a game or uses the optional name]],\n        args = {\n            kind = 'object',\n            optional = true,\n        },\n        run = function(self, args)\n            local fireproximityprompt = self:expectExploit('fireproximityprompt')\n\n            if not fireproximityprompt then\n                return\n            end\n\n            local name = (args:nextValue() or ''):lower()\n\n            for _, descendant in workspace:GetDescendants()do\n                if descendant:IsA('ProximityPrompt') and matchName(descendant, name) then\n                    fireproximityprompt(descendant)\n                end\n            end\n        end,\n    },\n    {\n        action = 'fireclosestprompt|fcp',\n        description = 'Uses the closest proximity prompt to your character',\n        args = {\n            optional = true,\n            kind = 'boolean',\n            name = 'teleport to prompt',\n        },\n        run = function(self, args)\n            local fireproximityprompt = self:expectExploit('fireproximityprompt')\n\n            if not fireproximityprompt then\n                return\n            end\n\n            local closestPrompt = getClosestPrompt(self)\n\n            if not closestPrompt then\n                self:notify(\"Can't find any ProximityPrompt on workspace\")\n\n                return\n            end\n            if args:nextValue() then\n                teleportToPrompt(self, closestPrompt)\n                task.wait(0.25)\n            end\n\n            fireproximityprompt(closestPrompt)\n            self:notify(`fired prompt: {closestPrompt:GetFullName()}`)\n        end,\n    },\n    {\n        action = 'firetouchinterests|touchinterests',\n        description = 'Uses all touchinterests in a game or uses the optional name',\n        args = {\n            kind = 'object',\n            optional = true,\n        },\n        run = function(self, args)\n            local firetouchinterest = self:expectExploit('firetouchinterest')\n\n            if not firetouchinterest then\n                return\n            end\n\n            local root = self.playerService:getRootPart()\n\n            if not root then\n                return\n            end\n\n            local name = (args:nextValue() or ''):lower()\n\n            for _, descendant in workspace:GetDescendants()do\n                if descendant:IsA('TouchTransmitter') and descendant.Parent:IsA('BasePart') and matchName(descendant.Parent, name) then\n                    firetouchinterest(descendant.Parent, root, 0)\n                    firetouchinterest(descendant.Parent, root, 1)\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/init.luau" ] = "return {\n    require('./clienttools'),\n    require('./partname'),\n    require('./deletepart'),\n    require('./lockworkspace'),\n    require('./invisibleparts'),\n    require('./limits'),\n    require('./world'),\n    require('./cleanup'),\n    require('./fire'),\n    require('./unanchored'),\n}\n",
[ "src/commands/cmds/workspace/invisibleparts.luau" ] = "return {\n    {\n        client = true,\n        action = 'invisibleparts|invisparts',\n        description = 'Shows invisible parts',\n        run = function(self)\n            local shown = self.privateEnv.shownParts or {}\n\n            self.privateEnv.shownParts = shown\n\n            for _, object in workspace:GetDescendants()do\n                if object:IsA('BasePart') and object.Transparency == 1 then\n                    if not table.find(shown, object) then\n                        table.insert(shown, object)\n                    end\n\n                    object.Transparency = 0\n                end\n            end\n        end,\n    },\n    {\n        client = true,\n        action = 'uninvisibleparts|uninvisparts',\n        description = 'Makes parts affected by invisparts return to normal',\n        run = function(self)\n            for _, object in self.privateEnv.shownParts or {}do\n                object.Transparency = 1\n            end\n\n            self.privateEnv.shownParts = {}\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/limits.luau" ] = "local function createLimitCommand(action, description, className)\n    return {\n        action = action,\n        description = description,\n        run = function()\n            for _, object in workspace:GetDescendants()do\n                if object:IsA(className) then\n                    object.MaxActivationDistance = math.huge\n                end\n            end\n        end,\n    }\nend\n\nreturn {\n    createLimitCommand('noclickdetectorlimits|nocdlimits|removecdlimits', 'Removes the activation distance limit of ClickDetectors', 'ClickDetector'),\n    createLimitCommand('noproximitypromptlimits|nopplimits|removepplimits', 'Removes the activation distance limit of ProximityPrompts', 'ProximityPrompt'),\n    {\n        action = 'instantproximityprompts|instantpp',\n        description = \n[[Fires proximity prompts as soon as they are held (needs fireproximityprompt)]],\n        run = function(self)\n            local fireproximityprompt = self.executorEnv.fireproximityprompt\n\n            if not fireproximityprompt then\n                self:notify('Incompatible Exploit', \n[[Your exploit does not support this command (missing fireproximityprompt)]])\n\n                return\n            end\n            if self:hasGarbage('instantpp') then\n                self:notify('instant proximity prompts is already enabled')\n\n                return\n            end\n\n            local garbage = self:createGarbage('instantpp')\n\n            garbage.connection = self:connect(self.proximityPromptService.PromptButtonHoldBegan, function(\n                prompt\n            )\n                fireproximityprompt(prompt)\n            end)\n        end,\n    },\n    {\n        action = 'uninstantproximityprompts|uninstantpp',\n        description = 'Disables instant proximity prompts',\n        run = function(self)\n            local garbage = self:collectGarbage('instantpp')\n\n            if garbage and garbage.connection then\n                garbage.connection:Disconnect()\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/lockworkspace.luau" ] = "return {\n    {\n        action = 'lockworkspace|lockws',\n        description = 'Locks the whole workspace',\n        run = function(self)\n            local garbage = self:createGarbage('lockworkspace')\n\n            if not garbage then\n                self:notify('Lock workspace', 'the workspace is already locked')\n\n                return\n            end\n\n            local character = self.playerService:getCharacter()\n\n            for _, object in workspace:GetDescendants()do\n                if object:IsA('BasePart') and not (character and object:IsDescendantOf(character)) then\n                    garbage[object] = object.Locked\n                    object.Locked = true\n                end\n            end\n\n            self:notify('Lock workspace', 'locked the parts in the workspace')\n        end,\n    },\n    {\n        action = 'unlockworkspace|unlockws',\n        description = 'Unlocks the whole workspace',\n        run = function(self)\n            local garbage = self:collectGarbage('lockworkspace')\n\n            if not garbage then\n                return\n            end\n\n            for object, original in garbage do\n                if object.Parent then\n                    object.Locked = original\n                end\n            end\n\n            self:notify('Lock workspace', 'unlocked')\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/nofog.luau" ] = "return {\n    action = 'nofog',\n    description = 'Removes fog (CLIENT)',\n}\n",
[ "src/commands/cmds/workspace/partname.luau" ] = "local function uniqueName(places, baseName)\n    local taken = {}\n\n    for name in places do\n        taken[name:lower()] = true\n    end\n\n    if not taken[baseName:lower()] then\n        return baseName\n    end\n\n    local number = 1\n\n    while taken[baseName:lower() .. number] do\n        number += 1\n    end\n\n    return baseName .. number\nend\nlocal function saveWaypoint(self, part)\n    local waypoints = self.storage.waypoints\n    local places = waypoints:register(tostring(game.PlaceId), {})\n    local name = uniqueName(places, part.Name)\n\n    places[name] = self:stringify(part.Position)\n\n    waypoints:save()\n\n    return name\nend\n\nreturn {\n    {\n        action = 'partname|partpath',\n        description = \n[[Opens a window: click a part to see its path & name, then Select Part saves it as a waypoint]],\n        run = function(self)\n            self.infiniteYield:openPartPath(function(part)\n                local name = saveWaypoint(self, part)\n\n                self:notify('Modified Waypoints', 'Created waypoint: ' .. name)\n            end)\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/unanchored.luau" ] = "local resolvePlayers = require('../../systems/resolvePlayers')\n\nlocal function isCharacterPart(part)\n    local parent = part.Parent\n\n    if parent and parent:FindFirstChildWhichIsA('Humanoid') then\n        return true\n    end\n\n    local grandParent = parent and parent.Parent\n\n    return grandParent ~= nil and grandParent:FindFirstChildWhichIsA('Humanoid') ~= nil\nend\nlocal function looseParts(self)\n    local character = self.playerService:getCharacter()\n    local list = {}\n\n    for _, part in workspace:GetDescendants()do\n        if part:IsA('BasePart') and not part.Anchored and not (character and part:IsDescendantOf(character)) and not isCharacterPart(part) then\n            table.insert(list, part)\n        end\n    end\n\n    return list\nend\n\nreturn {\n    {\n        action = 'tpunanchored|tpua',\n        description = 'Teleports unanchored parts to a player',\n        args = {\n            kind = 'player',\n        },\n        run = function(self, args)\n            local target = resolvePlayers(args:nextValue())[1]\n            local head = target and target.Character and target.Character:FindFirstChild('Head')\n\n            if not head then\n                return\n            end\n\n            local garbage = self:registerGarbage('tpunanchored')\n\n            garbage.forces = garbage.forces or {}\n\n            for _, part in looseParts(self)do\n                local force = Instance.new('BodyPosition')\n\n                force.MaxForce = Vector3.one * math.huge\n                force.Position = head.Position\n                force.Parent = part\n\n                table.insert(garbage.forces, force)\n            end\n        end,\n    },\n    {\n        action = 'freezeunanchored|freezeua|animsunanchored',\n        description = 'Freezes unanchored parts',\n        run = function(self)\n            if self:hasGarbage('freezeua') then\n                self:notify('Freeze', 'unanchored parts are already frozen, use thawunanchored')\n\n                return\n            end\n\n            local garbage = self:createGarbage('freezeua')\n\n            garbage.parts = {}\n\n            for _, part in looseParts(self)do\n                part.Anchored = true\n\n                table.insert(garbage.parts, part)\n            end\n\n            self:notify('Freeze', `froze {#garbage.parts} unanchored part(s)`)\n        end,\n    },\n    {\n        action = 'thawunanchored|thawua|unfreezeua',\n        description = 'Thaws unanchored parts',\n        run = function(self)\n            local forces = self:collectGarbage('tpunanchored')\n\n            if forces then\n                for _, force in forces.forces or {}do\n                    force:Destroy()\n                end\n            end\n\n            local frozen = self:collectGarbage('freezeua')\n\n            if frozen then\n                for _, part in frozen.parts do\n                    if part.Parent then\n                        part.Anchored = false\n                    end\n                end\n            end\n        end,\n    },\n}\n",
[ "src/commands/cmds/workspace/world.luau" ] = "local DEFAULT_GRAVITY = workspace.Gravity\nlocal DEFAULT_DESTROY_HEIGHT = -500\n\nreturn {\n    {\n        action = 'gravity|grav',\n        description = 'Sets the workspace gravity (no value resets it)',\n        args = {\n            kind = 'number',\n            name = 'gravity',\n            optional = true,\n        },\n        run = function(self, args)\n            workspace.Gravity = args:nextValue() or DEFAULT_GRAVITY\n        end,\n    },\n    {\n        action = 'destroyheight|dh',\n        description = \n[[Sets the height where fallen parts get destroyed (default is -500)]],\n        args = {\n            kind = 'number',\n            name = 'height',\n            optional = true,\n        },\n        run = function(self, args)\n            workspace.FallenPartsDestroyHeight = args:nextValue() or DEFAULT_DESTROY_HEIGHT\n        end,\n    },\n}\n",
[ "src/commands/controllers/argsController.luau" ] = "local playerService = require('../../framework/services/playerService')\nlocal waypointsData = require('../../storage/data/waypoints')\nlocal logger = require('../../utils/logger')\nlocal tools = require('../../utils/tools')\nlocal argsController = {}\n\nlocal function newWarn(message)\n    return {\n        success = false,\n        message = message,\n    }\nend\nlocal function validateString(text)\n    return {\n        success = true,\n        value = text,\n        color = 'string',\n    }\nend\nlocal function validateBoolean(text)\n    local booleans = {\n        'true',\n        'false',\n        'yes',\n        'no',\n        'enabled',\n        'disabled',\n    }\n    local found = table.find(booleans, text)\n\n    return {\n        success = found ~= nil,\n        value = found and (found % 2) == 1,\n        display = text,\n        options = {\n            'false',\n            'true',\n        },\n        message = ' - invalid boolean',\n        color = 'boolean',\n    }\nend\n\nlocal validators = {\n    ['className'] = true,\n    ['player'] = true,\n    ['string'] = validateString,\n    ['text'] = validateString,\n    ['boolean'] = validateBoolean,\n}\n\nfunction validators.number(text, arg)\n    local number = tonumber(text)\n    local result = {\n        value = number,\n        success = false,\n        display = `<b>{number}</b>`,\n    }\n\n    if number == nil then\n        result.message = ' - invalid number'\n\n        return result\n    end\n    if arg.clamp then\n        arg.min, arg.max = arg.clamp[1], arg.clamp[2]\n    end\n    if arg.min and number < arg.min then\n        result.message = ` - the <b>MIN</b> is <b>{arg.min}</b>`\n\n        return result\n    end\n    if arg.max and number > arg.max then\n        result.message = ` - the <b>MAX</b> is <b>{arg.max}</b>`\n\n        return result\n    end\n    if arg.floor and math.floor(number) ~= number then\n        result.message = ` - only floors`\n\n        return result\n    end\n    if math.floor(number * 1e5) / 1e5 ~= number then\n        result.message = ` - too big`\n\n        return result\n    end\n\n    result.color = 'number'\n    result.success = true\n\n    return result\nend\nfunction validators.waypoint(text)\n    local waypoint = waypointsData:getValue(text)\n    local waypoints = tools.unlookupify(waypointsData:getData())\n\n    if #waypoints == 0 then\n        return newWarn(' - no waypoints created')\n    end\n\n    return {\n        success = waypoint ~= nil,\n        options = waypoints,\n        value = text,\n        message = ' - invalid waypoint',\n    }\nend\nfunction validators.vector3(text)\n    local split = text:split(',')\n\n    if #split > 3 then\n        return newWarn(' - too many args')\n    end\n\n    for key, str in split do\n        if str == '' then\n            str = '0'\n        end\n\n        local result = validators.number(str, {})\n\n        if not result.success then\n            return result\n        end\n\n        split[key] = result.value\n    end\n\n    if #split ~= 3 then\n        return {\n            success = false,\n            comment = true,\n            message = `: {({\n                'X',\n                'Y',\n                'Z',\n            })[#split + 1]}`,\n        }\n    end\n\n    local vector = Vector3.new(unpack(split))\n\n    return {\n        success = true,\n        value = vector,\n        display = `({vector})`,\n        color = 'others',\n    }\nend\nfunction argsController:validate(argConfig, text)\n    local validate = validators[argConfig.kind]\n\n    if validate == true then\n        return {\n            success = true,\n            value = text,\n            display = text,\n        }\n    end\n    if type(validate) == 'function' then\n        return validate(text, argConfig)\n    end\n\n    return newWarn(` - missing parser {argConfig.kind}`)\nend\n\nreturn argsController\n",
[ "src/commands/controllers/commandsController.luau" ] = "local privateEnv = require('../../framework/environment/private')\nlocal executorEnv = require('../../framework/environment/executor')\nlocal commandsList = require('../list')\nlocal signal = require('../../utils/signal')\nlocal logger = require('../../utils/logger')\nlocal usedCmdsData = require('../../storage').usedCmds\nlocal storageConfig = require('../../framework/config/storage')\nlocal robloxServices = require('../../framework/services/rbxServices')\nlocal frameworkSettings = require('../../framework/settings')\nlocal searchController = require('./searchController')\nlocal argsManager = require('../systems/argsManager')\nlocal customAliases = require('../systems/customAliases')\nlocal pluginsSystem = require('../systems/plugins')\nlocal rankConfig = frameworkSettings.commands.cmdsRank\nlocal MAX_TIMES_USED = rankConfig.maxTimesUsed\nlocal DECREASE_PER_USE = rankConfig.decreasePerUse\nlocal INCREASE_PER_USE = rankConfig.increasePerUse\nlocal garbages = privateEnv.iyGarbages or {}\n\nprivateEnv.iyGarbages = garbages\n\nlocal commandsController = {garbages = garbages}\n\nfunction commandsController:registerGarbage(name)\n    return self:getGarbage(name) or self:createGarbage(name)\nend\nfunction commandsController:createGarbage(name)\n    local garbage = self.garbages[name]\n\n    if garbage == nil then\n        garbage = {}\n        self.garbages[name] = garbage\n    end\n\n    return garbage\nend\nfunction commandsController:getCommandData(name)\n    return commandsList.lookup[name:lower()]\nend\nfunction commandsController:hasGarbage(name)\n    return self.garbages[name] ~= nil\nend\nfunction commandsController:getGarbage(name)\n    return self.garbages[name]\nend\nfunction commandsController:collectGarbage(name)\n    local garbage = self.garbages[name]\n\n    if garbage ~= nil then\n        self.garbages[name] = nil\n\n        return garbage\n    end\nend\nfunction commandsController:commandUsed(targetFlag)\n    local currentValue = usedCmdsData:getValue(targetFlag) or 0\n    local newValue = math.clamp(currentValue + INCREASE_PER_USE, 0, MAX_TIMES_USED)\n\n    usedCmdsData:setValue(targetFlag, newValue)\n\n    for currentFlag, value in usedCmdsData:getData()do\n        if currentFlag == targetFlag then\n            continue\n        end\n\n        local forceDecay = (newValue == MAX_TIMES_USED)\n\n        if (forceDecay or value < newValue) and value > 0 then\n            value -= DECREASE_PER_USE\n\n            if value == 0 then\n                value = nil\n            end\n\n            usedCmdsData:setValue(currentFlag, value)\n        end\n    end\n\n    usedCmdsData:save()\nend\n\nlocal function snapshotArgs(args)\n    local values = {}\n\n    if args and args.args then\n        for index, arg in args.args do\n            values[index] = {\n                value = arg.value,\n            }\n        end\n    end\n\n    return values\nend\n\nlocal runningThreads = setmetatable({}, {\n    __mode = 'k',\n})\nlocal ERROR_FOLDER = `{storageConfig.privateFolder}/error-logs`\n\nlocal function saveErrorLog(cmdName, message, trace)\n    local writefile = executorEnv.writefile\n\n    if not writefile then\n        return nil\n    end\n    if executorEnv.makefolder then\n        pcall(executorEnv.makefolder, storageConfig.privateFolder)\n        pcall(executorEnv.makefolder, ERROR_FOLDER)\n    end\n\n    local path = `{ERROR_FOLDER}/{os.time()}-{cmdName}.txt`\n    local content = table.concat({\n        `command: {cmdName}`,\n        `time: {os.date('%Y-%m-%d %H:%M:%S')}`,\n        `error: {message}`,\n        '',\n        'traceback:',\n        trace or '(not available)',\n    }, '\\n')\n    local success = pcall(writefile, path, content)\n\n    if success then\n        return path\n    end\n\n    return nil\nend\n\nfunction commandsController:reportError(cmdName, err, trace)\n    local message = tostring(err)\n    local path = saveErrorLog(cmdName, message, trace)\n    local text = message\n\n    if path then\n        text ..= `\\nsaved to {path}`\n    end\n\n    self:notify(`'{cmdName}' failed`, text)\nend\nfunction commandsController:run(cmdName, args, asUser)\n    logger:expect(cmdName, {\n        'string',\n    }, \"'commandsController:run' #1\")\n    logger:expect(args, {\n        'table',\n        'nil',\n    }, \"'commandsController:run' #2\")\n\n    local cmdData = commandsList.lookup[cmdName]\n\n    logger:assert(cmdData, 'invalid command')\n\n    args = args or argsManager.new({})\n\n    local thread = coroutine.running()\n    local frame = runningThreads[thread]\n    local wasNested = frame ~= nil\n    local nested = wasNested and not asUser\n\n    if not nested then\n        self:commandUsed(cmdData.name)\n\n        local snapshot = snapshotArgs(args)\n\n        self.privateEnv.lastArgs = self.privateEnv.lastArgs or {}\n        self.privateEnv.lastArgs[cmdData.name] = snapshot\n\n        if cmdData.name ~= 'lastcommand' then\n            self.privateEnv.lastCommand = {\n                name = cmdData.name,\n                args = snapshot,\n            }\n        end\n    end\n    if cmdData.run == nil then\n        logger:warn(`missing command run func: {cmdData.name}`)\n\n        return\n    end\n    if not wasNested then\n        frame = {reported = false}\n        runningThreads[thread] = frame\n    end\n\n    local trace = nil\n    local ok, err = xpcall(function()\n        cmdData.run(self, args)\n    end, function(message)\n        trace = debug.traceback(tostring(message), 2)\n\n        return message\n    end)\n\n    if not wasNested then\n        runningThreads[thread] = nil\n    end\n    if not ok then\n        if not frame.reported then\n            frame.reported = true\n\n            self:reportError(cmdData.name, err, trace)\n        end\n\n        error(err, 0)\n    end\nend\nfunction commandsController:getLastArgs(name)\n    local stored = self.privateEnv.lastArgs\n\n    return stored and stored[name]\nend\n\nlocal function getUsage(alias)\n    local command = commandsList.lookup[alias:lower()]\n\n    if command == nil then\n        return 0\n    end\n\n    return usedCmdsData:getValue(command.name) or 0\nend\n\nfunction commandsController:search(query, onlyBests)\n    local matches = searchController:searchAtArray(commandsList.array, query, onlyBests)\n    local lowerQuery = query:lower()\n    local ranked = {}\n\n    for index, alias in matches do\n        table.insert(ranked, {\n            alias = alias,\n            index = index,\n            isPrefix = alias:lower():sub(1, #lowerQuery) == lowerQuery,\n            usage = getUsage(alias),\n        })\n    end\n\n    table.sort(ranked, function(a, b)\n        if a.isPrefix ~= b.isPrefix then\n            return a.isPrefix\n        end\n        if a.usage ~= b.usage then\n            return a.usage > b.usage\n        end\n\n        return a.index < b.index\n    end)\n\n    local bestMatches = {}\n\n    for position, entry in ranked do\n        bestMatches[position] = entry.alias\n    end\n\n    return bestMatches\nend\nfunction commandsController:init(config)\n    logger:assert(config, \"'commandsController:init' #1 expected a config to init\")\n\n    local connectionService = require('../../framework/services/connectionService')\n    local stringifier = require('../../utils/stringifier')\n    local notifier = require('../../ui/notifier')\n\n    function self:notify(...)\n        return notifier:notify(...)\n    end\n    function self:ask(...)\n        return notifier:ask(...)\n    end\n    function self:stringify(...)\n        return stringifier:stringify(...)\n    end\n    function self:unstringify(...)\n        return stringifier:unstringify(...)\n    end\n    function self:connect(...)\n        return connectionService:Connect(...)\n    end\n    function self:expectExploit(name)\n        local value = executorEnv[name]\n\n        if value ~= nil then\n            return value\n        end\n\n        self:notify('Incompatible Exploit', `Your exploit does not support this command (missing {name})`)\n    end\n    function self:getRoot()\n        local root = self.playerService:getRootPart()\n\n        if root then\n            return root\n        end\n\n        self:notify('Character', 'your character is not loaded')\n    end\n\n    self.getRootPart = self.getRoot\n    self.Connect = self.connect\n\n    local isMobile = require('../../framework/environment/isMobile')\n\n    self.isMobile = isMobile\n    self.isPC = not isMobile\n    self.localPlayer = require('../../framework/services/localPlayer')\n    self.executorEnv = executorEnv\n    self.privateEnv = privateEnv\n    self.infiniteYield = config.infiniteYield\n    self.playerService = config.playerService\n    self.fetchService = config.fetchService\n    self.signals = {\n        onCameraReset = signal.new(),\n    }\n    self.config = {\n        links = frameworkSettings.links,\n    }\n    self.userSettings = UserSettings()\n    self.gameSettings = settings()\n    self.userGameSettings = self.userSettings:GetService('UserGameSettings')\n    self.gameNetworkSettings = self.gameSettings:GetService('NetworkSettings')\n    self.loopService = require('../services/loopService')\n    self.storage = require('../../storage')\n    self.robloxServices = robloxServices\n    self.rbxServices = robloxServices\n    self.teleportService = robloxServices.TeleportService\n    self.groupService = robloxServices.GroupService\n    self.runService = robloxServices.RunService\n    self.starterGui = robloxServices.StarterGui\n    self.coreGui = robloxServices.CoreGui\n    self.players = robloxServices.Players\n    self.guiService = robloxServices.GuiService\n    self.networkClient = robloxServices.NetworkClient\n    self.proximityPromptService = robloxServices.ProximityPromptService\n    self.commandsList = commandsList\n\n    customAliases.restore(commandsList)\n\n    for name, reason in pluginsSystem.restore(commandsList)do\n        logger:warn(`plugin '{name}' could not be loaded: {reason}`)\n    end\nend\n\nreturn commandsController\n",
[ "src/commands/controllers/searchController.luau" ] = "local searchController = {}\n\nfunction searchController:searchAtArray(array, query, onlyBests)\n    if query == '' then\n        return {}\n    end\n\n    local lowerQuery = query:lower()\n    local bestMatches = {}\n    local regularMatches = {}\n\n    for _, text in array do\n        local lowerText = tostring(text):lower()\n\n        if #lowerText < #lowerQuery then\n            continue\n        end\n\n        local startPos = lowerText:find(lowerQuery, 1, true)\n\n        if startPos == 1 then\n            table.insert(bestMatches, text)\n        elseif startPos and not onlyBests then\n            table.insert(regularMatches, text)\n        end\n    end\n    for _, text in regularMatches do\n        table.insert(bestMatches, text)\n    end\n\n    return bestMatches\nend\n\nreturn searchController\n",
[ "src/commands/list.luau" ] = "local logger = require('../utils/logger')\n\nlocal function createCommands(commandsInfo)\n    local cmdsInfo = {}\n    local lookup = {}\n    local array = {}\n\n    local function newCommand(command)\n        logger:expect(command.action, {\n            'string',\n        }, 'command action')\n        table.insert(cmdsInfo, command)\n\n        local aliases = {}\n        local args = command.args or {}\n\n        command.args = args\n\n        for _, text in command.action:split('|')do\n            if not command.name then\n                command.name = text\n            end\n\n            lookup[text] = command\n\n            table.insert(aliases, text)\n            table.insert(array, text)\n        end\n\n        table.sort(aliases, function(aliasA, aliasB)\n            return #aliasA < #aliasB\n        end)\n\n        if #args == 0 and next(args) then\n            command.args = {args}\n        end\n\n        command.aliases = aliases\n        command.action = nil\n    end\n\n    for _, section in commandsInfo do\n        logger:expect(section.name, {\n            'string',\n        }, 'section name')\n        logger:expect(section.commands, {\n            'table',\n        }, 'section commands')\n        table.insert(cmdsInfo, {\n            isSection = true,\n            sectionName = section.name,\n        })\n\n        for _, command in section.commands do\n            if #command == 0 then\n                logger:assert(next(command), 'the command cannot be empty')\n                newCommand(command)\n\n                continue\n            end\n\n            for key = 1, #command do\n                newCommand(command[key])\n            end\n        end\n    end\n\n    return {\n        array = array,\n        lookup = lookup,\n        original = cmdsInfo,\n    }\nend\n\nreturn createCommands({\n    {\n        name = 'general',\n        commands = require('./cmds/general'),\n    },\n    {\n        name = 'interface',\n        commands = require('./cmds/interface'),\n    },\n    {\n        name = 'character',\n        commands = require('./cmds/character'),\n    },\n    {\n        name = 'waypoints',\n        commands = require('./cmds/waypoints'),\n    },\n    {\n        name = 'teleport',\n        commands = require('./cmds/teleport'),\n    },\n    {\n        name = 'communication',\n        commands = require('./cmds/communication'),\n    },\n    {\n        name = 'visual',\n        commands = require('./cmds/visual'),\n    },\n    {\n        name = 'camera',\n        commands = require('./cmds/camera'),\n    },\n    {\n        name = 'workspace',\n        commands = require('./cmds/workspace'),\n    },\n    {\n        name = 'lighting',\n        commands = require('./cmds/lighting'),\n    },\n    {\n        name = 'aliases',\n        commands = require('./cmds/aliases'),\n    },\n    {\n        name = 'plugins',\n        commands = require('./cmds/plugins'),\n    },\n})\n",
[ "src/commands/services/eventListeners.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal eventBinds = require('../systems/eventBinds')\nlocal Players = robloxServices.Players\nlocal TextChatService = robloxServices.TextChatService\nlocal eventListeners = {}\nlocal started = false\nlocal legacyChat = false\nlocal playerConnections = {}\nlocal characterConnections = {}\n\nlocal function connectFor(bucket, player, signal, callback)\n    local connection = connectionService:Connect(signal, callback)\n    local list = bucket[player] or {}\n\n    bucket[player] = list\n\n    table.insert(list, connection)\nend\nlocal function disconnectFor(bucket, player)\n    local list = bucket[player]\n\n    bucket[player] = nil\n\n    for _, connection in list or {}do\n        connectionService:disconnect(connection)\n    end\nend\nlocal function watchCharacter(player, character)\n    disconnectFor(characterConnections, player)\n    task.spawn(function()\n        local humanoid = character:WaitForChild('Humanoid', 10)\n\n        if not humanoid or not humanoid:IsA('Humanoid') or player.Character ~= character then\n            return\n        end\n\n        local lastHealth = humanoid.Health\n\n        connectFor(characterConnections, player, humanoid.HealthChanged, function(\n            health\n        )\n            if health < lastHealth then\n                eventBinds.fire('OnDamage', player.Name, health)\n            end\n\n            lastHealth = health\n        end)\n        connectFor(characterConnections, player, humanoid.Died, function()\n            eventBinds.fire('OnDied', player.Name)\n\n            local creator = humanoid:FindFirstChild('creator')\n            local killer = if creator and creator:IsA('ObjectValue')then creator.Value else nil\n\n            if killer and killer:IsA('Player') then\n                eventBinds.fire('OnKilled', player.Name, killer.Name)\n            end\n        end)\n    end)\nend\nlocal function followPlayer(player)\n    connectFor(playerConnections, player, player.CharacterAdded, function(\n        character\n    )\n        eventBinds.fire('OnSpawn', player.Name)\n        watchCharacter(player, character)\n    end)\n\n    if legacyChat then\n        connectFor(playerConnections, player, player.Chatted, function(message)\n            eventBinds.fire('OnChatted', player.Name, message)\n        end)\n    end\n    if player.Character then\n        watchCharacter(player, player.Character)\n    end\nend\nlocal function onMessageReceived(message)\n    local source = message.TextSource\n\n    if not source or message.Status == Enum.TextChatMessageStatus.InvalidTextChannelPermissions then\n        return\n    end\n\n    local player = Players:GetPlayerByUserId(source.UserId)\n\n    if player then\n        eventBinds.fire('OnChatted', player.Name, message.Text)\n    end\nend\nlocal function onPlayerRemoving(player)\n    eventBinds.fire('OnLeave', player.Name)\n    disconnectFor(playerConnections, player)\n    disconnectFor(characterConnections, player)\nend\n\nfunction eventListeners.start()\n    if started then\n        return\n    end\n\n    started = true\n    legacyChat = TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService\n\n    connectionService:Connect(Players.PlayerAdded, function(player)\n        eventBinds.fire('OnJoin', player.Name)\n        followPlayer(player)\n    end)\n    connectionService:Connect(Players.PlayerRemoving, onPlayerRemoving)\n\n    if not legacyChat then\n        connectionService:Connect(TextChatService.MessageReceived, onMessageReceived)\n    end\n\n    for _, player in Players:GetPlayers()do\n        followPlayer(player)\n    end\n\n    eventBinds.fire('OnExecute')\nend\n\nreturn eventListeners\n",
[ "src/commands/services/loopService.luau" ] = "local privateEnv = require('../../framework/environment/private')\nlocal logger = require('../../utils/logger')\nlocal loopService = {\n    _callbacks = {},\n    _nextId = 0,\n}\n\nlocal function runLoop(self)\n    while true do\n        task.wait()\n\n        if next(self._callbacks) == nil then\n            privateEnv.loopThread = nil\n\n            return\n        end\n\n        local now = os.clock()\n\n        for _, data in self._callbacks do\n            if now - data.lastCall >= data.cooldown then\n                data.lastCall = now\n\n                task.defer(data.func)\n            end\n        end\n    end\nend\n\nfunction loopService:start()\n    if privateEnv.loopThread ~= nil then\n        return\n    end\n\n    privateEnv.loopThread = task.defer(runLoop, self)\nend\nfunction loopService:stop()\n    local thread = privateEnv.loopThread\n\n    privateEnv.loopThread = nil\n\n    table.clear(self._callbacks)\n\n    if thread ~= nil then\n        task.cancel(thread)\n    end\nend\nfunction loopService:add(callback, cooldown)\n    logger:expect(callback, {\n        'function',\n    }, \"'loopService:add' #1\")\n    logger:expect(cooldown, {\n        'number',\n        'nil',\n    }, \"'loopService:add' #2\")\n\n    self._nextId += 1\n\n    local id = self._nextId\n\n    self._callbacks[id] = {\n        func = callback,\n        cooldown = math.max(cooldown or 0, 0),\n        lastCall = -math.huge,\n    }\n\n    self:start()\n\n    return id\nend\nfunction loopService:remove(id)\n    logger:expect(id, {\n        'number',\n    }, \"'loopService:remove' #1\")\n\n    self._callbacks[id] = nil\nend\n\nreturn loopService\n",
[ "src/commands/systems/argsManager.luau" ] = "local argsManager = {}\n\nargsManager.__index = argsManager\n\nfunction argsManager:next()\n    local index = self.index\n\n    self.index += 1\n\n    return self.args[index]\nend\nfunction argsManager:nextValue()\n    local arg = self:next()\n\n    return arg and arg.value\nend\nfunction argsManager.new(args)\n    for _, arg in args do\n        local argData = arg.argData\n    end\n\n    return setmetatable({\n        args = args,\n        index = 1,\n    }, argsManager)\nend\n\nreturn argsManager\n",
[ "src/commands/systems/argsValidator.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal resolvePlayers = require('./resolvePlayers')\nlocal commandsList = require('../list')\nlocal waypointsData = require('../../storage/data/waypoints')\nlocal aliasesData = require('../../storage/data/aliases')\nlocal pluginsData = require('../../storage/data/plugins')\nlocal tools = require('../../utils/tools')\nlocal argsValidator = {}\n\nlocal function fail(message, options, comment)\n    return {\n        success = false,\n        message = message,\n        options = options,\n        comment = comment,\n    }\nend\n\nfunction argsValidator.normalizeOptions(options)\n    if type(options) == 'string' then\n        return string.split(options, '|')\n    end\n\n    return options or {}\nend\nfunction argsValidator.getOptions(arg, result)\n    local options = (result and result.options) or arg.options\n\n    return argsValidator.normalizeOptions(options)\nend\n\nlocal function findOption(options, text)\n    local lowered = text:lower()\n\n    for _, option in options do\n        local name = tostring(option)\n\n        if name:lower() == lowered then\n            return name\n        end\n    end\n\n    return nil\nend\nlocal function keysOf(tab)\n    if type(tab) ~= 'table' then\n        return {}\n    end\n\n    return tools.unlookupify(tab)\nend\nlocal function validateFreeText(text)\n    return {\n        success = true,\n        value = text,\n        color = 'string',\n    }\nend\nlocal function validateString(text, arg)\n    local options = argsValidator.normalizeOptions(arg.options)\n\n    if #options == 0 then\n        return validateFreeText(text)\n    end\n\n    local match = findOption(options, text)\n\n    if match then\n        return {\n            success = true,\n            value = match,\n            color = 'string',\n        }\n    end\n\n    return fail(' - invalid option', options)\nend\n\nlocal BOOLEAN_WORDS = {\n    ['true'] = true,\n    ['yes'] = true,\n    ['enabled'] = true,\n    ['false'] = false,\n    ['no'] = false,\n    ['disabled'] = false,\n}\n\nlocal function validateBoolean(text)\n    local value = BOOLEAN_WORDS[text:lower()]\n\n    if value == nil then\n        return fail(' - invalid boolean', {\n            'false',\n            'true',\n        })\n    end\n\n    return {\n        success = true,\n        value = value,\n        color = 'boolean',\n    }\nend\nlocal function validateNumber(text, arg)\n    local number = tonumber(text)\n\n    if number == nil or number ~= number or math.abs(number) == math.huge then\n        return fail(' - invalid number')\n    end\n\n    local min, max = arg.min, arg.max\n\n    if arg.clamp then\n        min, max = arg.clamp[1], arg.clamp[2]\n    end\n    if min and number < min then\n        return fail(` - the <b>MIN</b> is <b>{min}</b>`)\n    end\n    if max and number > max then\n        return fail(` - the <b>MAX</b> is <b>{max}</b>`)\n    end\n    if arg.floor and math.floor(number) ~= number then\n        return fail(' - whole numbers only')\n    end\n    if tonumber(string.format('%.5f', number)) ~= number then\n        return fail(' - too many decimal places')\n    end\n\n    return {\n        success = true,\n        value = number,\n        display = `<b>{text}</b>`,\n        color = 'number',\n    }\nend\nlocal function validateVector3(text)\n    local parts = text:split(',')\n\n    if #parts > 3 then\n        return fail(' - too many args')\n    end\n\n    local values = {}\n\n    for index, part in parts do\n        if part:match('^%s*$') then\n            part = '0'\n        end\n\n        local result = validateNumber(part, {})\n\n        if not result.success then\n            return result\n        end\n\n        values[index] = result.value\n    end\n\n    if #values ~= 3 then\n        return {\n            success = false,\n            comment = true,\n            message = `: {({\n                'X',\n                'Y',\n                'Z',\n            })[#values + 1]}`,\n        }\n    end\n\n    local vector = Vector3.new(values[1], values[2], values[3])\n\n    return {\n        success = true,\n        value = vector,\n        display = `({vector})`,\n        color = 'others',\n    }\nend\nlocal function validateColor3(text)\n    local hex = text:match('^#?(%x%x%x%x%x%x)$')\n\n    if hex then\n        local r = tonumber(hex:sub(1, 2), 16)\n        local g = tonumber(hex:sub(3, 4), 16)\n        local b = tonumber(hex:sub(5, 6), 16)\n\n        return {\n            success = true,\n            value = Color3.fromRGB(r, g, b),\n            color = 'others',\n        }\n    end\n\n    local parts = text:split(',')\n\n    if #parts ~= 3 then\n        return fail(' - use R,G,B or #hex')\n    end\n\n    local values = {}\n\n    for index, part in parts do\n        local result = validateNumber(part, {\n            min = 0,\n            max = 255,\n            floor = true,\n        })\n\n        if not result.success then\n            return result\n        end\n\n        values[index] = result.value\n    end\n\n    return {\n        success = true,\n        value = Color3.fromRGB(values[1], values[2], values[3]),\n        color = 'others',\n    }\nend\nlocal function validatePlayer(text)\n    if text == '' then\n        return fail(' - player missing')\n    end\n\n    local parts = resolvePlayers.parts(text)\n\n    if #parts == 0 then\n        return fail(' - player missing')\n    end\n\n    for _, part in parts do\n        if #resolvePlayers(part) == 0 then\n            if resolvePlayers.hasOperators(part) then\n                return fail(' - no players match this')\n            end\n            if resolvePlayers.isSelector(part) then\n                return fail(' - no players match this selector')\n            end\n\n            local names = {}\n\n            for _, player in robloxServices.Players:GetPlayers()do\n                table.insert(names, player.Name)\n            end\n\n            return fail(' - player not found', names)\n        end\n    end\n\n    return {\n        success = true,\n        value = text,\n        color = 'valid',\n    }\nend\n\nlocal COMMON_CLASSES = {\n    'BasePart',\n    'Part',\n    'MeshPart',\n    'Model',\n    'Folder',\n    'Script',\n    'LocalScript',\n    'ModuleScript',\n    'Sound',\n    'Humanoid',\n    'Tool',\n    'ClickDetector',\n    'ProximityPrompt',\n    'TouchTransmitter',\n    'SpawnLocation',\n    'Seat',\n    'VehicleSeat',\n}\n\nlocal function validateClassName(text)\n    local isValid = pcall(function()\n        local instance = Instance.new(text)\n\n        instance:Destroy()\n    end)\n\n    if isValid then\n        return {\n            success = true,\n            value = text,\n            color = 'valid',\n        }\n    end\n\n    return fail(' - invalid class name', COMMON_CLASSES)\nend\nlocal function validateWaypoint(text)\n    local names = keysOf(waypointsData:getValue(tostring(game.PlaceId)))\n\n    if #names == 0 then\n        return fail(' - no waypoints created')\n    end\n\n    local match = findOption(names, text)\n\n    if match then\n        return {\n            success = true,\n            value = match,\n            color = 'valid',\n        }\n    end\n\n    return fail(' - invalid waypoint', names)\nend\nlocal function validateTeam(text)\n    local names = {}\n\n    for _, team in robloxServices.Teams:GetTeams()do\n        table.insert(names, team.Name)\n    end\n\n    if #names == 0 then\n        return fail(' - there are no teams')\n    end\n\n    local match = findOption(names, text)\n\n    if match then\n        return {\n            success = true,\n            value = match,\n            color = 'valid',\n        }\n    end\n\n    return fail(' - invalid team', names)\nend\nlocal function validateKeycode(text)\n    local lowered = text:lower()\n    local names = {}\n    local found\n\n    for _, item in Enum.KeyCode:GetEnumItems()do\n        table.insert(names, item.Name)\n\n        if item.Name:lower() == lowered then\n            found = item\n        end\n    end\n\n    if found then\n        return {\n            success = true,\n            value = found,\n            color = 'valid',\n        }\n    end\n\n    return fail(' - invalid key', names)\nend\nlocal function validateCommand(text)\n    local command = commandsList.lookup[text:lower()]\n\n    if command then\n        return {\n            success = true,\n            value = command.name,\n            color = 'valid',\n        }\n    end\n\n    return fail(' - invalid command', commandsList.array)\nend\nlocal function validateStoredName(store, text, emptyMessage, invalidMessage)\n    local names = keysOf(store:getData())\n\n    if #names == 0 then\n        return fail(emptyMessage)\n    end\n\n    local match = findOption(names, text)\n\n    if match then\n        return {\n            success = true,\n            value = match,\n            color = 'valid',\n        }\n    end\n\n    return fail(invalidMessage, names)\nend\nlocal function validateAlias(text)\n    return validateStoredName(aliasesData, text, ' - no custom aliases', ' - invalid alias')\nend\nlocal function validatePlugin(text)\n    return validateStoredName(pluginsData, text, ' - no plugins installed', ' - invalid plugin')\nend\n\nlocal validators = {\n    string = validateString,\n    text = validateString,\n    object = validateFreeText,\n    boolean = validateBoolean,\n    number = validateNumber,\n    vector3 = validateVector3,\n    color3 = validateColor3,\n    player = validatePlayer,\n    waypoint = validateWaypoint,\n    className = validateClassName,\n    team = validateTeam,\n    keycode = validateKeycode,\n    command = validateCommand,\n    alias = validateAlias,\n    plugin = validatePlugin,\n}\n\nfunction argsValidator:validate(arg, text)\n    local validate = validators[arg.kind]\n\n    if not validate then\n        return fail(` - missing parser {arg.kind}`)\n    end\n\n    return validate(text, arg)\nend\n\nreturn argsValidator\n",
[ "src/commands/systems/chatLogs.luau" ] = "local rbxServices = require('../../framework/services/rbxServices')\nlocal executorEnv = require('../../framework/environment/executor')\nlocal storageConfig = require('../../framework/config/storage')\nlocal storage = require('../../storage')\nlocal logger = require('../../utils/logger')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal chatSender = require('./chatSender')\nlocal nameColor = require('../../utils/nameColor')\nlocal MAX_ENTRIES = 500\nlocal FALLBACK_AVATAR = 'https://files.catbox.moe/i968v2.jpg'\nlocal WEBHOOK_KEY = 'logsWebhook'\nlocal chatLogs = {\n    chatEnabled = false,\n    joinEnabled = false,\n    started = false,\n    entries = {\n        chat = {},\n        join = {},\n    },\n    listeners = {},\n}\nlocal avatarCache = {}\n\nlocal function addEntry(kind, entry)\n    entry.time = os.date('%H:%M:%S')\n\n    local list = chatLogs.entries[kind]\n\n    table.insert(list, entry)\n\n    if #list > MAX_ENTRIES then\n        table.remove(list, 1)\n    end\n\n    for _, listener in chatLogs.listeners do\n        task.spawn(listener, kind, entry)\n    end\nend\n\nfunction chatLogs.getWebhook()\n    local url = storage.settings:getValue(WEBHOOK_KEY)\n\n    if type(url) == 'string' and url ~= '' then\n        return url\n    end\n\n    return nil\nend\nfunction chatLogs.setWebhook(url)\n    storage.settings:setValue(WEBHOOK_KEY, url)\n    storage.settings:save()\nend\n\nlocal function getAvatar(player)\n    local id = player.UserId\n\n    if avatarCache[id] then\n        return avatarCache[id]\n    end\n\n    local avatar = FALLBACK_AVATAR\n    local request = executorEnv.httprequest\n\n    if request then\n        local success, data = pcall(function()\n            local response = request({\n                Url = `https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds={id}&size=420x420&format=Png&isCircular=false`,\n                Method = 'GET',\n            })\n\n            return rbxServices.HttpService:JSONDecode(response.Body).data\n        end)\n        local first = success and type(data) == 'table' and data[1]\n\n        if type(first) == 'table' and first.state == 'Completed' and first.imageUrl then\n            avatar = first.imageUrl\n        end\n    end\n\n    avatarCache[id] = avatar\n\n    return avatar\nend\nlocal function sendWebhook(player, message)\n    local url = chatLogs.getWebhook()\n    local request = executorEnv.httprequest\n\n    if not (url and request) then\n        return\n    end\n\n    task.spawn(function()\n        local body = rbxServices.HttpService:JSONEncode({\n            content = message,\n            avatar_url = getAvatar(player),\n            username = player.Name,\n            allowed_mentions = {parse = {}},\n        })\n        local success, reason = pcall(request, {\n            Url = url,\n            Method = 'POST',\n            Headers = {\n                ['Content-Type'] = 'application/json',\n            },\n            Body = body,\n        })\n\n        if not success then\n            logger:warn(`chat logs webhook failed: {reason}`)\n        end\n    end)\nend\nlocal function onChat(player, message)\n    if not chatLogs.chatEnabled then\n        return\n    end\n\n    addEntry('chat', {\n        name = player.Name,\n        message = message,\n        color = nameColor.forPlayer(player, chatSender.isLegacy()),\n    })\n    sendWebhook(player, message)\nend\n\nfunction chatLogs.start()\n    if chatLogs.started then\n        return\n    end\n\n    chatLogs.started = true\n\n    local players = rbxServices.Players\n\n    local function hookPlayer(player)\n        if chatSender.isLegacy() then\n            connectionService:Connect(player.Chatted, function(message)\n                onChat(player, message)\n            end)\n        end\n    end\n\n    for _, player in players:GetPlayers()do\n        hookPlayer(player)\n    end\n\n    connectionService:Connect(players.PlayerAdded, function(player)\n        if chatLogs.joinEnabled then\n            addEntry('join', {\n                name = player.Name,\n                userId = player.UserId,\n                color = nameColor.forPlayer(player, chatSender.isLegacy()),\n            })\n        end\n\n        hookPlayer(player)\n    end)\n\n    if not chatSender.isLegacy() then\n        connectionService:Connect(rbxServices.TextChatService.MessageReceived, function(\n            textChatMessage\n        )\n            local source = textChatMessage.TextSource\n\n            if not source or textChatMessage.Status == Enum.TextChatMessageStatus.InvalidTextChannelPermissions then\n                return\n            end\n\n            local player = players:GetPlayerByUserId(source.UserId)\n\n            if not player then\n                return\n            end\n\n            local message = textChatMessage.Text\n\n            if textChatMessage.WasRewritten then\n                message = `(rephrased) {textChatMessage.RewrittenText}`\n            end\n\n            onChat(player, message)\n        end)\n    end\nend\nfunction chatLogs.setChat(enabled)\n    chatLogs.chatEnabled = enabled\n\n    if enabled then\n        chatLogs.start()\n    end\nend\nfunction chatLogs.setJoin(enabled)\n    chatLogs.joinEnabled = enabled\n\n    if enabled then\n        chatLogs.start()\n    end\nend\nfunction chatLogs.onEntry(callback)\n    table.insert(chatLogs.listeners, callback)\nend\nfunction chatLogs.clear(kind)\n    table.clear(chatLogs.entries[kind])\nend\nfunction chatLogs.save(kind)\n    local writefile = executorEnv.writefile\n\n    if not writefile then\n        return false, 'your exploit does not support writing files'\n    end\n\n    local lines = {}\n\n    for _, entry in chatLogs.entries[kind]do\n        if kind == 'chat' then\n            table.insert(lines, `[{entry.time}] {entry.name}: {entry.message}`)\n        else\n            table.insert(lines, `[{entry.time}] {entry.name} ({entry.userId}) joined`)\n        end\n    end\n\n    if #lines == 0 then\n        return false, 'nothing to save yet'\n    end\n\n    local folder = storageConfig.privateFolder\n\n    if executorEnv.makefolder then\n        pcall(executorEnv.makefolder, folder)\n    end\n\n    local path = `{folder}/logs/{kind}/{os.time()}.txt`\n    local success, reason = pcall(writefile, path, table.concat(lines, '\\n'))\n\n    if success then\n        return true, path\n    end\n\n    return false, tostring(reason)\nend\n\nreturn chatLogs\n",
[ "src/commands/systems/chatSender.luau" ] = "local rbxServices = require('../../framework/services/rbxServices')\nlocal chatSender = {}\n\nfunction chatSender.isLegacy()\n    return rbxServices.TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService\nend\nfunction chatSender.send(message)\n    message = tostring(message)\n\n    local success, reason = pcall(function()\n        if chatSender.isLegacy() then\n            rbxServices.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, 'All')\n        else\n            rbxServices.TextChatService.TextChannels.RBXGeneral:SendAsync(message)\n        end\n    end)\n\n    return success, if success then nil else tostring(reason)\nend\n\nreturn chatSender\n",
[ "src/commands/systems/commandData.luau" ] = "local commandData = {}\n\ncommandData.__index = commandData\n\nfunction commandData.new(command)\n    return setmetatable({\n        isClient = command.client or command.isClient or command.onlyClient,\n        isDeprecated = command.deprecated or command.isDeprecated,\n        name = command.name,\n        isSection = command.isSection,\n        sectionName = command.sectionName,\n        aliases = command.aliases,\n        args = command.args,\n        name = command.name,\n        description = command.description,\n    }, commandData)\nend\n\nreturn commandData\n",
[ "src/commands/systems/commandParser.luau" ] = "local commandsController = require('../controllers/commandsController')\nlocal searchController = require('../controllers/searchController')\nlocal commandsList = require('../list')\nlocal colors = require('../../framework/config/ui/colors')\nlocal tools = require('../../utils/tools')\nlocal argsValidator = require('./argsValidator')\nlocal colorFromRGB = tools.colorFromRGB\nlocal esc = tools.escapeRichText\nlocal SEPARATOR = '\\\\'\nlocal LOOP_CHAR = '^'\nlocal INFINITE = 'inf'\nlocal REPEAT_CHAR = '!'\nlocal startStringChars = tools.lookupify({\n    '`',\n    \"'\",\n    '\"',\n})\nlocal whiteSpaceChars = tools.lookupify({\n    ' ',\n    '\\t',\n    '\\n',\n    '\\r',\n})\nlocal skipWhiteSpaceChars = tools.lookupify({\n    ',',\n    '|',\n    '&',\n})\n\nlocal function getCommand(commandName)\n    return commandsList.lookup[commandName]\nend\nlocal function colorFromName(text, name, fallBack)\n    local acolors = colors.args\n\n    return colorFromRGB(text, acolors[name] or fallBack or acolors.others)\nend\nlocal function removeWhiteSpace(text)\n    local result = text:gsub('.', function(char)\n        return whiteSpaceChars[char] and '_' or char\n    end)\n\n    return result\nend\nlocal function argName(arg, index)\n    if arg.name then\n        return `'{removeWhiteSpace(arg.name)}'`\n    end\n\n    return `#{index}`\nend\nlocal function findClosingQuote(command, quote, openAt)\n    local searchAt = openAt + 1\n\n    while true do\n        local found = command:find(quote, searchAt, true)\n\n        if not found then\n            return nil\n        end\n        if command:sub(found - 1, found - 1) ~= '\\\\' then\n            return found\n        end\n\n        searchAt = found + 1\n    end\nend\nlocal function readIdentifier(command, startAt)\n    local buffer = {}\n    local pos = startAt\n    local length = #command\n\n    while pos <= length do\n        local char = command:sub(pos, pos)\n\n        if whiteSpaceChars[char] or char == SEPARATOR then\n            break\n        end\n\n        table.insert(buffer, char)\n\n        pos += 1\n\n        if skipWhiteSpaceChars[char] then\n            while pos <= length and whiteSpaceChars[command:sub(pos, pos)] do\n                pos += 1\n            end\n        end\n    end\n\n    return table.concat(buffer), pos - 1\nend\nlocal function makeToken(kind, value, command, from, to, usedChar)\n    return {\n        kind = kind,\n        value = value,\n        usedChar = usedChar,\n        from = from,\n        to = to,\n        raw = command:sub(from, to),\n    }\nend\nlocal function splitMatch(candidate, query)\n    if query == '' then\n        return '', '', candidate\n    end\n\n    local startAt, endAt = candidate:lower():find(query:lower(), 1, true)\n\n    if not startAt then\n        return '', '', candidate\n    end\n\n    return candidate:sub(1, startAt - 1), candidate:sub(startAt, endAt), candidate:sub(endAt + 1)\nend\nlocal function quoteIfNeeded(text, usedChar)\n    if usedChar then\n        return usedChar .. text .. usedChar\n    end\n    if text:find('%s') then\n        return `\"{text}\"`\n    end\n\n    return text\nend\nlocal function wrapQuotes(richText, usedChar)\n    if usedChar then\n        return esc(usedChar) .. richText .. esc(usedChar)\n    end\n\n    return richText\nend\nlocal function makeCorrection(from, to, replacement, usedChar)\n    return {\n        from = from,\n        to = to,\n        text = quoteIfNeeded(replacement, usedChar),\n    }\nend\nlocal function parseLoop(spec)\n    local parts = spec:split(LOOP_CHAR)\n\n    if #parts > 2 then\n        return nil, ' - invalid loop'\n    end\n\n    local count\n\n    if parts[1]:lower() == INFINITE then\n        count = math.huge\n    else\n        count = tonumber(parts[1])\n\n        if count == nil or count < 1 or count ~= math.floor(count) then\n            return nil, ' - invalid loop count'\n        end\n    end\n\n    local delay = 0\n\n    if parts[2] ~= nil then\n        delay = tonumber(parts[2])\n\n        if delay == nil or delay < 0 then\n            return nil, ' - invalid loop delay'\n        end\n    end\n\n    return {\n        count = count,\n        delay = delay,\n    }\nend\n\nlocal commandParser = {}\n\ncommandParser.__index = commandParser\ncommandParser.colorFromName = colorFromName\ncommandParser.removeWhiteSpace = removeWhiteSpace\n\nfunction commandParser:parse(command)\n    local cmdInput = self.cmdInput\n    local statements = {}\n    local allTokens = {}\n    local length = #command\n    local current = {\n        tokens = {},\n        start = 1,\n    }\n    local pos = 1\n\n    table.insert(statements, current)\n\n    while pos <= length do\n        local char = command:sub(pos, pos)\n\n        if whiteSpaceChars[char] then\n            pos += 1\n        elseif char == SEPARATOR then\n            current.stop = pos\n            current = {\n                tokens = {},\n                start = pos + 1,\n            }\n\n            table.insert(statements, current)\n\n            pos += 1\n        else\n            local token\n            local closeAt = startStringChars[char] and findClosingQuote(command, char, pos)\n\n            if closeAt then\n                local value = (command:sub(pos + 1, closeAt - 1):gsub('\\\\' .. char, char))\n\n                token = makeToken('string', value, command, pos, closeAt, char)\n                pos = closeAt + 1\n            else\n                local value, lastAt = readIdentifier(command, pos)\n\n                token = makeToken('identifier', value, command, pos, lastAt)\n                pos = lastAt + 1\n            end\n\n            table.insert(current.tokens, token)\n            table.insert(allTokens, token)\n        end\n    end\n\n    current.stop = length + 1\n\n    for _, statement in statements do\n        local firstToken = statement.tokens[1]\n        local lastToken = statement.tokens[#statement.tokens]\n        local afterAt = if lastToken then lastToken.to + 1 else statement.start\n\n        statement.lead = if firstToken then command:sub(statement.start, firstToken.from - 1)else''\n        statement.spaces = command:sub(afterAt, statement.stop - 1)\n    end\n\n    local values = {}\n\n    for _, token in allTokens do\n        table.insert(values, token.value)\n    end\n\n    local lastStatement = statements[#statements]\n\n    cmdInput.rawText = command\n    cmdInput.parsed = allTokens\n    cmdInput.spacesAtEnd = lastStatement.spaces\n    cmdInput.noHighlightText = table.concat(values, ' ') .. lastStatement.spaces\n\n    return statements\nend\nfunction commandParser:parseArg(arg, token, index, info)\n    local text = token.value\n    local result = argsValidator:validate(arg, text)\n    local isValid = result.success and #text > 0\n    local parsedData = {\n        success = isValid,\n        text = text,\n    }\n\n    if isValid then\n        parsedData.value = result.value\n    end\n\n    info.args[index] = parsedData\n\n    if isValid then\n        local display = if result.display then wrapQuotes(result.display, token.usedChar)else esc(token.raw)\n\n        return {\n            success = true,\n            display = colorFromName(display, result.color or 'valid'),\n        }\n    end\n\n    local options = argsValidator.getOptions(arg, result)\n    local bestMatch = nil\n\n    if #text > 0 then\n        bestMatch = searchController:searchAtArray(options, text)[1]\n    end\n    if bestMatch then\n        local left, typed, right = splitMatch(bestMatch, text)\n\n        info.correction = makeCorrection(token.from, token.to, bestMatch, token.usedChar)\n\n        local inner = esc(left) .. colorFromName(esc(typed), 'warn') .. esc(right)\n\n        return {\n            success = false,\n            suggestion = true,\n            display = colorFromName(wrapQuotes(inner, token.usedChar), 'comment'),\n        }\n    end\n\n    return {\n        success = false,\n        display = colorFromName(esc(token.raw), result.color or 'warn'),\n        message = result.message,\n        comment = result.comment,\n    }\nend\nfunction commandParser:parsePending(arg, info, statement)\n    local result = argsValidator:validate(arg, '')\n    local options = argsValidator.getOptions(arg, result)\n\n    if #options == 0 then\n        return nil\n    end\n\n    local best = options[1]\n\n    if not arg.optional then\n        info.correction = {\n            from = statement.stop,\n            to = statement.stop - 1,\n            text = quoteIfNeeded(best),\n        }\n    else\n        info.hasGhost = true\n    end\n\n    return colorFromName(esc(best), 'comment')\nend\nfunction commandParser:highlightArgs(\n    info,\n    cmdData,\n    statement,\n    hasSpaces,\n    buffer,\n    isLast\n)\n    local tokens = statement.tokens\n    local args = cmdData.args\n    local argCount = #args\n    local typedCount = #tokens - 1\n    local lastProcessed = 1\n    local failure = nil\n\n    for index, arg in args do\n        local token = tokens[index + 1]\n\n        if token == nil then\n            if hasSpaces then\n                local ghost = self:parsePending(arg, info, statement)\n\n                if ghost then\n                    table.insert(buffer, ghost)\n                end\n            end\n\n            break\n        end\n\n        local result = self:parseArg(arg, token, index, info)\n\n        lastProcessed = index + 1\n\n        if result.display then\n            table.insert(buffer, result.display)\n        end\n        if not result.success then\n            failure = {\n                index = index,\n                result = result,\n            }\n\n            break\n        end\n    end\n\n    for i = lastProcessed + 1, math.min(#tokens, argCount + 1)do\n        table.insert(buffer, esc(tokens[i].raw))\n    end\n\n    if #tokens > argCount + 1 then\n        local extraText = self.cmdInput.rawText:sub(tokens[argCount + 2].from, tokens[#tokens].to)\n\n        table.insert(buffer, colorFromName(`<b>{esc(extraText)}</b>`, 'warn'))\n\n        info.runError = ' - extra arg'\n        info.comment = {\n            text = ' - extra arg',\n            color = 'warn',\n        }\n\n        return\n    end\n    if failure then\n        local result = failure.result\n\n        info.runError = ` - {argName(args[failure.index], failure.index)} is invalid`\n\n        if result.message and not result.suggestion then\n            info.comment = {\n                text = result.message,\n                color = if result.comment then'comment'else'warn',\n            }\n        end\n\n        return\n    end\n\n    for index = typedCount + 1, argCount do\n        local arg = args[index]\n\n        if not arg.optional then\n            info.runError = ` - {argName(arg, index)} is missing`\n\n            break\n        end\n    end\n\n    local hintIndex = nil\n\n    if hasSpaces then\n        hintIndex = typedCount + 1\n    elseif typedCount > 0 then\n        hintIndex = typedCount\n    end\n\n    local hintArg = hintIndex and args[hintIndex]\n\n    if hintArg and isLast then\n        local prefix = if hasSpaces then''else': '\n\n        info.comment = {\n            text = `{prefix}({self:highlightArgType(hintArg)})`,\n        }\n    end\nend\nfunction commandParser:highlightArgType(arg)\n    local optional = arg.optional and colorFromName('?', 'symbol') or ''\n    local text = `{colorFromName(arg.kind, arg.kind)}{optional}`\n\n    if arg.name then\n        return `{removeWhiteSpace(arg.name)}: {text}`\n    end\n\n    return text\nend\nfunction commandParser:highlightArgsType(args)\n    if #args == 0 then\n        return ''\n    end\n\n    local buffer = {}\n\n    for _, arg in args do\n        table.insert(buffer, self:highlightArgType(arg))\n    end\n\n    return `({table.concat(buffer, ', ')})`\nend\nfunction commandParser:resetInput()\n    local cmdInput = self.cmdInput\n\n    cmdInput.highlightText = ''\n    cmdInput.commandName = ''\n    cmdInput.commandData = nil\n    cmdInput.isValidCommand = false\n    cmdInput.isAbreviated = false\n    cmdInput.bestMatch = nil\n    cmdInput.bestMatches = {}\n    cmdInput.correctionText = nil\n    cmdInput.correction = nil\n    cmdInput.runError = nil\n    cmdInput.hasGhost = false\n    cmdInput.args = {}\n    cmdInput.statements = {}\n\n    self:setComment('')\nend\nfunction commandParser:highlightStatement(statement, isLast)\n    local cmdInput = self.cmdInput\n    local tokens = statement.tokens\n    local info = {\n        lead = statement.lead,\n        text = '',\n        trailing = statement.spaces,\n        args = {},\n        commandName = '',\n        bestMatches = {},\n        isValidCommand = false,\n        isAbreviated = false,\n    }\n\n    if #tokens == 0 then\n        info.empty = true\n\n        return info\n    end\n\n    local nameToken = tokens[1]\n    local hasSpaces = #statement.spaces > 0\n    local typedName = nameToken.value\n    local rest = typedName\n    local loop = nil\n    local loopError = nil\n    local isRepeat = false\n\n    if nameToken.kind == 'identifier' then\n        local prefix, after = typedName:match('^(.*%^)(.*)$')\n\n        if prefix then\n            loop, loopError = parseLoop(prefix:sub(1, -2))\n            rest = after\n        end\n        if rest:sub(1, 1) == REPEAT_CHAR then\n            isRepeat = true\n            rest = rest:sub(2)\n        end\n    end\n\n    local prefixRaw = typedName:sub(1, #typedName - #rest)\n    local commandKey = rest:lower()\n    local cmdData = getCommand(commandKey)\n\n    info.commandName = commandKey\n    info.commandData = cmdData\n    info.isValidCommand = cmdData ~= nil\n    info.isAbreviated = cmdData ~= nil and cmdData.name ~= commandKey\n    info.loop = loop\n\n    if loopError then\n        info.text = colorFromName(esc(typedName), 'error')\n        info.runError = loopError\n        info.comment = {\n            text = loopError,\n            color = 'error',\n        }\n\n        return info\n    end\n\n    local prefixDisplay = ''\n\n    if prefixRaw ~= '' then\n        prefixDisplay = colorFromName(esc(prefixRaw), 'comment')\n    end\n    if not cmdData then\n        local bestMatches = commandsController:search(commandKey)\n        local bestMatch = bestMatches[1]\n\n        info.bestMatches = bestMatches\n        info.bestMatch = bestMatch\n\n        if hasSpaces or #tokens > 1 or not bestMatch then\n            local body = cmdInput.rawText:sub(nameToken.from, tokens[#tokens].to)\n\n            info.text = colorFromName(esc(body), 'error')\n            info.runError = ' - invalid command'\n            info.comment = {\n                text = ' - invalid command',\n                color = 'error',\n            }\n\n            return info\n        end\n\n        local left, typed, right = splitMatch(bestMatch, rest)\n\n        info.text = prefixDisplay .. colorFromName(esc(left) .. colorFromName(esc(typed), 'warn') .. esc(right), 'comment')\n        info.correction = makeCorrection(nameToken.from, nameToken.to, prefixRaw .. bestMatch, nameToken.usedChar)\n        info.correctionText = bestMatch\n        info.runError = ' - invalid command'\n\n        return info\n    end\n\n    local buffer = {\n        prefixDisplay .. colorFromName(esc(rest), 'valid'),\n    }\n\n    if isLast and #tokens == 1 and not hasSpaces and #cmdData.aliases > 1 then\n        local clone = table.clone(cmdData.aliases)\n        local index = table.find(clone, commandKey)\n\n        if index then\n            table.remove(clone, index)\n        end\n\n        info.comment = {\n            text = `: [{table.concat(clone, ', ')}]`,\n            color = 'comment',\n        }\n    end\n    if isRepeat and #tokens == 1 then\n        info.repeatLast = true\n\n        if #cmdData.args > 0 and commandsController:getLastArgs(cmdData.name) == nil then\n            info.runError = ' - no previous arguments'\n            info.comment = {\n                text = ' - no previous arguments',\n                color = 'error',\n            }\n        end\n    else\n        self:highlightArgs(info, cmdData, statement, hasSpaces, buffer, isLast)\n    end\n\n    info.text = table.concat(buffer, ' ')\n\n    return info\nend\nfunction commandParser:highlight(statements)\n    local cmdInput = self.cmdInput\n\n    self:resetInput()\n\n    local lastIndex = #statements\n    local infos = {}\n\n    for index, statement in statements do\n        infos[index] = self:highlightStatement(statement, index == lastIndex)\n    end\n\n    local focus = infos[lastIndex]\n\n    cmdInput.statements = infos\n    cmdInput.commandName = focus.commandName\n    cmdInput.commandData = focus.commandData\n    cmdInput.isValidCommand = focus.isValidCommand\n    cmdInput.isAbreviated = focus.isAbreviated\n    cmdInput.bestMatch = focus.bestMatch\n    cmdInput.bestMatches = focus.bestMatches\n    cmdInput.args = focus.args\n\n    local comment = nil\n\n    for _, info in infos do\n        if info.empty and lastIndex > 1 then\n            info.runError = ' - command missing'\n        end\n        if info.runError and cmdInput.runError == nil then\n            cmdInput.runError = info.runError\n        end\n        if info.correction and cmdInput.correction == nil then\n            cmdInput.correction = info.correction\n        end\n        if info.hasGhost then\n            cmdInput.hasGhost = true\n        end\n        if info.comment and comment == nil then\n            comment = info.comment\n        end\n    end\n\n    if comment then\n        self:setComment(comment.text, comment.color)\n    end\n\n    local pieces = {}\n\n    for index, info in infos do\n        local trailing = if info.correction or info.hasGhost then''else info.trailing\n        local piece = info.lead .. info.text .. trailing\n\n        if index < lastIndex then\n            piece ..= colorFromName(esc(SEPARATOR), 'symbol')\n        end\n\n        table.insert(pieces, piece)\n    end\n\n    local highlightText = table.concat(pieces)\n\n    cmdInput.highlightText = highlightText\n\n    return highlightText\nend\nfunction commandParser:setComment(...)\n    return self.setCommentCallback(...)\nend\nfunction commandParser.new(cmdInput, commentCallback)\n    return setmetatable({\n        cmdInput = cmdInput,\n        setCommentCallback = commentCallback,\n    }, commandParser)\nend\n\nreturn commandParser\n",
[ "src/commands/systems/commandRunner.luau" ] = "local commandsController = require('../controllers/commandsController')\nlocal commandParser = require('./commandParser')\nlocal argsManager = require('./argsManager')\nlocal loopService = require('../services/loopService')\nlocal logger = require('../../utils/logger')\nlocal commandRunner = {}\n\nfunction commandRunner.runStatement(info)\n    local name = info.commandData.name\n    local argValues = info.args\n\n    if info.repeatLast then\n        argValues = commandsController:getLastArgs(name) or {}\n    end\n    if info.loop then\n        commandRunner.startLoop(name, argValues, info.loop)\n\n        return\n    end\n\n    commandsController:run(name, argsManager.new(argValues))\nend\nfunction commandRunner.startLoop(name, argValues, loop)\n    local runs = 0\n    local id\n\n    id = loopService:add(function()\n        runs += 1\n\n        local success, failure = pcall(function()\n            commandsController:run(name, argsManager.new(argValues))\n        end)\n\n        if not success then\n            loopService:remove(id)\n            logger:error(`loop of '{name}' stopped: {failure}`)\n\n            return\n        end\n        if runs >= loop.count then\n            loopService:remove(id)\n        end\n    end, loop.delay)\nend\n\nlocal function read(text)\n    local cmdInput = {}\n    local parser = commandParser.new(cmdInput, function() end)\n\n    parser:highlight(parser:parse(text))\n\n    return cmdInput.statements, cmdInput.runError\nend\nlocal function missingCommand(statements)\n    for _, info in statements do\n        if info.empty then\n            return 'write the command to run'\n        end\n        if not info.commandData then\n            return `'{info.commandName}' is not a command`\n        end\n    end\n\n    return nil\nend\n\nfunction commandRunner.checkText(text)\n    local statements = read(text)\n    local reason = missingCommand(statements)\n\n    if reason then\n        return false, reason\n    end\n\n    return true\nend\nfunction commandRunner.runText(text)\n    local statements, problem = read(text)\n    local reason = missingCommand(statements)\n\n    if reason then\n        return false, reason\n    end\n    if problem then\n        return false, (problem:gsub('^%s*%-%s*', ''))\n    end\n\n    for _, info in statements do\n        local success, failure = pcall(commandRunner.runStatement, info)\n\n        if not success then\n            return false, tostring(failure)\n        end\n    end\n\n    return true\nend\n\nreturn commandRunner\n",
[ "src/commands/systems/customAliases.luau" ] = "local aliasesData = require('../../storage/data/aliases')\nlocal customAliases = {}\n\nlocal function removeFromArray(array, value)\n    local index = table.find(array, value)\n\n    if index then\n        table.remove(array, index)\n    end\nend\n\nfunction customAliases.add(list, alias, commandName)\n    alias = alias:lower()\n\n    if list.lookup[alias] ~= nil then\n        return false, `'{alias}' is already a command or an alias`\n    end\n\n    local command = list.lookup[commandName:lower()]\n\n    if not command then\n        return false, 'invalid command'\n    end\n\n    list.lookup[alias] = command\n\n    table.insert(list.array, alias)\n\n    aliasesData.object[alias] = command.name\n\n    aliasesData:save()\n\n    return true\nend\nfunction customAliases.remove(list, alias)\n    alias = alias:lower()\n\n    local target = aliasesData.object[alias]\n\n    if type(target) ~= 'string' then\n        return false\n    end\n\n    list.lookup[alias] = nil\n\n    removeFromArray(list.array, alias)\n\n    aliasesData.object[alias] = nil\n\n    aliasesData:save()\n\n    return true, target\nend\nfunction customAliases.clear(list)\n    local aliases = {}\n\n    for alias in aliasesData.object do\n        table.insert(aliases, alias)\n    end\n    for _, alias in aliases do\n        list.lookup[alias] = nil\n\n        removeFromArray(list.array, alias)\n\n        aliasesData.object[alias] = nil\n    end\n\n    aliasesData:save()\n\n    return #aliases\nend\nfunction customAliases.restore(list)\n    for alias, commandName in aliasesData.object do\n        local command = type(commandName) == 'string' and list.lookup[commandName]\n\n        if command and list.lookup[alias] == nil then\n            list.lookup[alias] = command\n\n            table.insert(list.array, alias)\n        end\n    end\nend\n\nreturn customAliases\n",
[ "src/commands/systems/espManager.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal playerService = require('../../framework/services/playerService')\nlocal privateEnv = require('../../framework/environment/private')\nlocal logger = require('../../utils/logger')\nlocal DEFAULT_TRANSPARENCY = 0.3\nlocal DEFAULT_INTERVAL = 0.25\nlocal DEFAULT_COLOR = Color3.fromRGB(255, 255, 255)\nlocal ROOT_FOLDER_NAME = 'iy-esp'\n\nlocal function getRootFolder()\n    local coreGui = robloxServices.CoreGui\n    local folder = coreGui:FindFirstChild(ROOT_FOLDER_NAME)\n\n    if not folder then\n        folder = Instance.new('Folder')\n        folder.Name = ROOT_FOLDER_NAME\n        folder.Parent = coreGui\n    end\n\n    return folder\nend\nlocal function getAdornee(instance)\n    if instance:IsA('BasePart') then\n        return instance\n    end\n    if instance:IsA('Model') then\n        return instance:FindFirstChild('Head') or instance.PrimaryPart or instance:FindFirstChildWhichIsA('BasePart')\n    end\n\n    return nil\nend\nlocal function defaultText(instance, meters)\n    local humanoid = instance:IsA('Model') and instance:FindFirstChildOfClass('Humanoid')\n\n    if humanoid then\n        return (\n[[%s <font color='rgb(160, 160, 160)'>[ %dm ]</font>\n<font color='rgb(25, 240, 25)'>[%d/%d]</font>]]):format(instance.Name, meters, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))\n    end\n\n    return ('%s < %dm >'):format(instance.Name, meters)\nend\n\nlocal EspManager = {}\n\nEspManager.__index = EspManager\n\nfunction EspManager.new(options)\n    local folder = Instance.new('Folder')\n\n    folder.Name = options.tag\n    folder.Parent = getRootFolder()\n\n    return setmetatable({\n        tag = options.tag,\n        source = options.source,\n        color = options.color,\n        text = options.text or defaultText,\n        showBoxes = options.showBoxes == true,\n        showText = options.showText == true,\n        interval = options.interval or DEFAULT_INTERVAL,\n        objects = {},\n        folder = folder,\n        running = false,\n    }, EspManager)\nend\nfunction EspManager:create(instance)\n    local adornee = getAdornee(instance)\n\n    if not adornee then\n        return nil\n    end\n\n    local esp = {\n        instance = instance,\n        adornee = adornee,\n        boxes = {},\n    }\n\n    if self.showBoxes then\n        local parts = instance:IsA('Model') and instance:GetChildren() or {instance}\n\n        for _, part in parts do\n            if part:IsA('BasePart') then\n                local box = Instance.new('BoxHandleAdornment')\n\n                box.Adornee = part\n                box.Size = part.Size\n                box.AlwaysOnTop = true\n                box.ZIndex = 0\n                box.Parent = self.folder\n\n                table.insert(esp.boxes, box)\n            end\n        end\n    end\n    if self.showText then\n        local billboard = Instance.new('BillboardGui')\n\n        billboard.Adornee = adornee\n        billboard.Size = UDim2.new(0, 200, 0, 50)\n        billboard.StudsOffset = Vector3.new(0, 2, 0)\n        billboard.AlwaysOnTop = true\n        billboard.Parent = self.folder\n\n        local label = Instance.new('TextLabel')\n\n        label.BackgroundTransparency = 1\n        label.Size = UDim2.new(1, 0, 1, 0)\n        label.TextSize = 14\n        label.TextStrokeTransparency = 0\n        label.TextYAlignment = Enum.TextYAlignment.Bottom\n        label.RichText = true\n        label.Text = ''\n        label.Parent = billboard\n        esp.billboard = billboard\n        esp.label = label\n    end\n\n    self.objects[instance] = esp\n\n    return esp\nend\nfunction EspManager:update(esp, root)\n    local color = DEFAULT_COLOR\n\n    if self.color then\n        color = self.color(esp.instance)\n    end\n\n    local transparency = privateEnv.espTransparency or DEFAULT_TRANSPARENCY\n\n    for _, box in esp.boxes do\n        box.Color3 = color\n        box.Transparency = transparency\n    end\n\n    if esp.label then\n        local studs = 0\n\n        if root then\n            studs = (root.Position - esp.adornee.Position).Magnitude\n        end\n\n        esp.label.TextColor3 = color\n        esp.label.Text = self.text(esp.instance, math.floor(studs / 5), math.floor(studs))\n    end\nend\nfunction EspManager:removeEsp(instance, esp)\n    for _, box in esp.boxes do\n        box:Destroy()\n    end\n\n    if esp.billboard then\n        esp.billboard:Destroy()\n    end\n\n    self.objects[instance] = nil\nend\nfunction EspManager:refresh()\n    local root = playerService:getRootPart()\n    local wanted = {}\n\n    for _, instance in self.source()do\n        if not wanted[instance] then\n            wanted[instance] = true\n\n            local esp = self.objects[instance]\n\n            if esp and not esp.adornee:IsDescendantOf(workspace) then\n                self:removeEsp(instance, esp)\n\n                esp = nil\n            end\n\n            esp = esp or self:create(instance)\n\n            if esp then\n                self:update(esp, root)\n            end\n        end\n    end\n    for instance, esp in pairs(self.objects)do\n        if not wanted[instance] or not instance:IsDescendantOf(workspace) then\n            self:removeEsp(instance, esp)\n        end\n    end\nend\nfunction EspManager:start()\n    if self.running then\n        return\n    end\n\n    self.running = true\n\n    task.spawn(function()\n        while self.running do\n            local ok, err = pcall(self.refresh, self)\n\n            if not ok then\n                self.running = false\n\n                logger:warn(('esp [%s] stopped: %s'):format(self.tag, tostring(err)))\n\n                break\n            end\n\n            task.wait(self.interval)\n        end\n    end)\nend\nfunction EspManager:destroy()\n    self.running = false\n\n    for instance, esp in pairs(self.objects)do\n        self:removeEsp(instance, esp)\n    end\n\n    self.folder:Destroy()\nend\n\nreturn EspManager\n",
[ "src/commands/systems/eventBinds.luau" ] = "local eventBindsConfig = require('../../framework/config/services/eventBinds')\nlocal eventBindsData = require('../../storage/data/eventBinds')\nlocal commandRunner = require('./commandRunner')\nlocal commandsController = require('../controllers/commandsController')\nlocal resolvePlayers = require('./resolvePlayers')\nlocal ANY = eventBindsConfig.ANY\nlocal eventBinds = {}\n\neventBinds.events = eventBindsConfig.events\n\nlocal eventsByName = {}\n\nfor _, event in eventBindsConfig.events do\n    eventsByName[event.name] = event\nend\n\nlocal function trim(text)\n    return text:match('^%s*(.-)%s*$') or ''\nend\n\nfunction eventBinds.getEvent(name)\n    return eventsByName[name]\nend\nfunction eventBinds.getBinds(eventName)\n    local binds = eventBindsData.object[eventName]\n\n    if type(binds) ~= 'table' then\n        return {}\n    end\n\n    return table.clone(binds)\nend\n\nlocal function normalizeCondition(condition, text)\n    local value = trim(text or '')\n\n    if value == '' then\n        value = condition.default\n    end\n    if value:lower() == ANY then\n        return ANY\n    end\n    if condition.kind == 'Number' and tonumber(value) == nil then\n        return nil, `{condition.label} must be a number or any`\n    end\n\n    return value\nend\n\nfunction eventBinds.add(eventName, command, delay, conditions)\n    local event = eventsByName[eventName]\n\n    if not event then\n        return false, 'invalid event'\n    end\n\n    local text = trim(command)\n    local valid, reason = commandRunner.checkText(text)\n\n    if not valid then\n        return false, reason\n    end\n    if type(delay) ~= 'number' or delay < 0 then\n        return false, 'the delay must be 0 or more'\n    end\n\n    local saved = {}\n\n    for index, condition in event.conditions do\n        local value, problem = normalizeCondition(condition, conditions and conditions[index])\n\n        if not value then\n            return false, problem\n        end\n\n        saved[index] = value\n    end\n\n    local binds = eventBindsData.object[eventName]\n\n    if type(binds) ~= 'table' then\n        binds = {}\n        eventBindsData.object[eventName] = binds\n    end\n\n    table.insert(binds, {\n        command = text,\n        delay = delay,\n        conditions = saved,\n    })\n    eventBindsData:save()\n\n    return true\nend\nfunction eventBinds.remove(eventName, index)\n    local binds = eventBindsData.object[eventName]\n\n    if type(binds) ~= 'table' or binds[index] == nil then\n        return nil\n    end\n\n    local removed = table.remove(binds, index)\n\n    eventBindsData:save()\n\n    return removed\nend\nfunction eventBinds.restore(eventName, index, bind)\n    if not eventsByName[eventName] or type(bind) ~= 'table' then\n        return false\n    end\n\n    local binds = eventBindsData.object[eventName]\n\n    if type(binds) ~= 'table' then\n        binds = {}\n        eventBindsData.object[eventName] = binds\n    end\n\n    table.insert(binds, math.clamp(index, 1, #binds + 1), bind)\n    eventBindsData:save()\n\n    return true\nend\nfunction eventBinds.setDelay(eventName, index, delay)\n    local binds = eventBindsData.object[eventName]\n\n    if type(binds) ~= 'table' or type(binds[index]) ~= 'table' then\n        return false\n    end\n    if type(delay) ~= 'number' or delay < 0 then\n        return false\n    end\n\n    binds[index].delay = delay\n\n    eventBindsData:save()\n\n    return true\nend\n\nlocal function isPlayerMatch(filter, name)\n    local success, players = pcall(resolvePlayers, filter)\n\n    if not success then\n        return false\n    end\n\n    for _, player in players do\n        if player.Name == name then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function conditionMet(condition, filter, value)\n    if filter:lower() == ANY then\n        return true\n    end\n    if condition.kind == 'Player' then\n        return isPlayerMatch(filter, tostring(value))\n    end\n    if condition.kind == 'String' then\n        return tostring(value):lower():find(filter:lower(), 1, true) ~= nil\n    end\n    if condition.kind == 'Number' then\n        local limit, number = tonumber(filter), tonumber(value)\n\n        return limit ~= nil and number ~= nil and number <= limit\n    end\n\n    return false\nend\nlocal function matches(event, bind, values)\n    local saved = bind.conditions or {}\n\n    for index, condition in event.conditions do\n        local filter = tostring(saved[index] or condition.default)\n\n        if not conditionMet(condition, filter, values[index]) then\n            return false\n        end\n    end\n\n    return true\nend\nlocal function quote(text)\n    if text:match('^[%w_%-%.]+$') then\n        return text\n    end\n\n    return '\"' .. (text:gsub('\"', '\\\\\"')) .. '\"'\nend\nlocal function substitute(command, values)\n    return (command:gsub('%$(%d+)', function(digits)\n        local value = values[tonumber(digits)]\n\n        if value == nil then\n            return nil\n        end\n\n        return quote(tostring(value))\n    end))\nend\nlocal function runBind(bind, values)\n    local delay = bind.delay or 0\n\n    if delay > 0 then\n        task.wait(delay)\n    end\n\n    local command = substitute(bind.command, values)\n    local success, reason = commandRunner.runText(command)\n\n    if not success then\n        commandsController:notify('Event Bind', `'{command}' did not run: {reason}`)\n    end\nend\n\nfunction eventBinds.fire(eventName, ...)\n    local event = eventsByName[eventName]\n    local binds = eventBindsData.object[eventName]\n\n    if not event or type(binds) ~= 'table' then\n        return\n    end\n\n    local values = {...}\n\n    for _, bind in table.clone(binds)do\n        if type(bind) == 'table' and matches(event, bind, values) then\n            task.spawn(runBind, bind, values)\n        end\n    end\nend\n\nreturn eventBinds\n",
[ "src/commands/systems/flight.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal keyboardService = require('../../framework/services/keyboardService')\nlocal UserInputService = robloxServices.UserInputService\nlocal flight = {}\nlocal MAX_FORCE = Vector3.one * 9e9\n\nlocal function flatten(vector)\n    local flat = Vector3.new(vector.X, 0, vector.Z)\n\n    if flat.Magnitude == 0 then\n        return Vector3.zero\n    end\n\n    return flat.Unit\nend\nlocal function getDirection(self, humanoid)\n    local cframe = workspace.CurrentCamera.CFrame\n    local move = humanoid.MoveDirection\n    local forward = move:Dot(flatten(cframe.LookVector))\n    local sideways = move:Dot(flatten(cframe.RightVector))\n    local vertical = 0\n\n    if self.privateEnv.qeFly ~= false then\n        if UserInputService:IsKeyDown(keyboardService:getBinding('flyUp')) then\n            vertical += 1\n        end\n        if UserInputService:IsKeyDown(keyboardService:getBinding('flyDown')) then\n            vertical -= 1\n        end\n    end\n\n    local direction = cframe.LookVector * forward + cframe.RightVector * sideways + Vector3.yAxis * vertical\n\n    if direction.Magnitude > 1 then\n        direction = direction.Unit\n    end\n\n    return direction\nend\n\nfunction flight.stop(self, garbageName)\n    local garbage = self:collectGarbage(garbageName)\n\n    if not garbage then\n        return\n    end\n    if garbage.connection then\n        garbage.connection:Disconnect()\n    end\n    if garbage.velocity then\n        garbage.velocity:Destroy()\n    end\n    if garbage.gyro then\n        garbage.gyro:Destroy()\n    end\n    if garbage.humanoid then\n        garbage.humanoid.PlatformStand = false\n    end\nend\nfunction flight.start(self, options)\n    flight.stop(self, options.garbageName)\n\n    local humanoid = self.playerService:getHumanoid()\n    local root = self.playerService:getRootPart()\n\n    if not (humanoid and root) then\n        self:notify('Fly', 'your character is not loaded')\n\n        return\n    end\n\n    local velocity = Instance.new('BodyVelocity')\n\n    velocity.MaxForce = MAX_FORCE\n    velocity.Velocity = Vector3.zero\n    velocity.Parent = root\n\n    local gyro = Instance.new('BodyGyro')\n\n    gyro.MaxTorque = MAX_FORCE\n    gyro.P = 9e4\n    gyro.CFrame = root.CFrame\n    gyro.Parent = root\n\n    if options.platformStand then\n        humanoid.PlatformStand = true\n    end\n\n    local garbage = self:createGarbage(options.garbageName)\n\n    garbage.velocity = velocity\n    garbage.gyro = gyro\n    garbage.humanoid = humanoid\n    garbage.kind = options.kind\n    garbage.connection = self:connect(self.runService.Heartbeat, function()\n        if not root:IsDescendantOf(workspace) or humanoid.Health <= 0 then\n            flight.stop(self, options.garbageName)\n\n            return\n        end\n\n        velocity.Velocity = getDirection(self, humanoid) * options.getSpeed()\n        gyro.CFrame = workspace.CurrentCamera.CFrame\n    end)\nend\n\nreturn flight\n",
[ "src/commands/systems/freecam.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal createService = require('../../framework/services/createService')\nlocal keyboardService = require('../../framework/services/keyboardService')\nlocal playerService = require('../../framework/services/playerService')\nlocal localPlayer = require('../../framework/services/localPlayer')\nlocal isMobile = require('../../framework/environment/isMobile')\nlocal coreGui = require('../../ui/coreGui')\nlocal ContextActionService = robloxServices.ContextActionService\nlocal UserInputService = robloxServices.UserInputService\nlocal freecam = {}\n\nfreecam.DEFAULT_SPEED = 1\nfreecam.DEFAULT_BOOST = 2\nfreecam.MIN_BOOST = 1\nfreecam.MAX_BOOST = 50\n\nlocal BOOST_SETTING = 'freecam.boost'\nlocal GARBAGE_NAME = 'freecam'\nlocal KEYS_ACTION = 'freecamKeys'\nlocal MOUSE_ACTION = 'freecamMouse'\nlocal ACTION_PRIORITY = Enum.ContextActionPriority.High.Value\nlocal GUI_NAME = 'freecamControls'\nlocal MOVE_KEYS = {\n    Enum.KeyCode.W,\n    Enum.KeyCode.A,\n    Enum.KeyCode.S,\n    Enum.KeyCode.D,\n    Enum.KeyCode.E,\n    Enum.KeyCode.Q,\n    Enum.KeyCode.Up,\n    Enum.KeyCode.Down,\n}\nlocal REFERENCE_FOV = 70\nlocal STUDS_PER_SECOND = 64\nlocal SPRING_FREQUENCY = 5\nlocal PAN_PER_PIXEL = math.pi / 64\nlocal MAX_PITCH = math.rad(89)\nlocal SPEED_CHANGE_PER_SECOND = 0.75\nlocal MIN_MULTIPLIER = 0.01\nlocal MAX_MULTIPLIER = 4\nlocal SHIFT_MULTIPLIER = 0.25\nlocal NEAR_PLANE = 0.1\nlocal MAX_FOCUS_DISTANCE = 512\nlocal TOUCH_LOOK_SCALE = 1\nlocal BUTTON_SIZE = 64\nlocal EDGE_OFFSET = 24\nlocal BOTTOM_OFFSET = 40\n\nlocal function sinkInput()\n    return Enum.ContextActionResult.Sink\nend\nlocal function newSpring(initial)\n    return {\n        position = initial,\n        velocity = initial * 0,\n    }\nend\nlocal function updateSpring(spring, dt, goal)\n    local frequency = SPRING_FREQUENCY * 2 * math.pi\n    local offset = goal - spring.position\n    local decay = math.exp(-frequency * dt)\n    local position = goal + (spring.velocity * dt - offset * (frequency * dt + 1)) * decay\n    local velocity = (frequency * dt * (offset * frequency - spring.velocity) + spring.velocity) * decay\n\n    spring.position = position\n    spring.velocity = velocity\n\n    return position\nend\nlocal function readAxis(positiveKey, negativeKey)\n    local positive = UserInputService:IsKeyDown(positiveKey) and 1 or 0\n    local negative = UserInputService:IsKeyDown(negativeKey) and 1 or 0\n\n    return positive - negative\nend\nlocal function getFocusDistance(camera, cframe, fieldOfView)\n    local viewport = camera.ViewportSize\n    local projY = 2 * math.tan(math.rad(fieldOfView) / 2)\n    local projX = viewport.X / viewport.Y * projY\n    local minDistance = MAX_FOCUS_DISTANCE\n    local minDirection = cframe.LookVector\n\n    for x = 0, 1, 0.5 do\n        for y = 0, 1, 0.5 do\n            local offset = cframe.RightVector * ((x - 0.5) * projX) - cframe.UpVector * ((y - 0.5) * projY) + cframe.LookVector\n            local direction = offset.Unit\n            local origin = cframe.Position + offset * NEAR_PLANE\n            local result = workspace:Raycast(origin, direction * MAX_FOCUS_DISTANCE)\n            local distance = result and (result.Position - origin).Magnitude or MAX_FOCUS_DISTANCE\n\n            if distance < minDistance then\n                minDistance = distance\n                minDirection = direction\n            end\n        end\n    end\n\n    return cframe.LookVector:Dot(minDirection) * minDistance\nend\nlocal function readThumbstick(humanoid, yaw)\n    if not humanoid then\n        return Vector3.zero\n    end\n\n    local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))\n    local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))\n    local move = humanoid.MoveDirection\n\n    return Vector3.new(move:Dot(right), 0, -move:Dot(forward))\nend\nlocal function isTouch(input)\n    return input.UserInputType == Enum.UserInputType.Touch\nend\nlocal function isOverControls(garbage, position)\n    for _, control in garbage.controls do\n        local corner = control.AbsolutePosition\n        local size = control.AbsoluteSize\n\n        if position.X >= corner.X and position.X <= corner.X + size.X and position.Y >= corner.Y and position.Y <= corner.Y + size.Y then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function createControls(self, garbage)\n    local gui = createService.new('ScreenGui', coreGui, {\n        Name = GUI_NAME,\n        ResetOnSpawn = false,\n        DisplayOrder = 50,\n    })\n\n    garbage.gui = gui\n\n    local function holdButton(name, text, position)\n        local button = createService.new('TextButton', gui, {\n            Name = name,\n            AnchorPoint = Vector2.new(1, 1),\n            Position = position,\n            Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),\n            BackgroundColor3 = Color3.new(0, 0, 0),\n            BackgroundTransparency = 0.5,\n            AutoButtonColor = false,\n            Text = text,\n            TextColor3 = Color3.new(1, 1, 1),\n            TextScaled = true,\n            Active = true,\n        })\n\n        table.insert(garbage.controls, button)\n        table.insert(garbage.connections, self:connect(button.InputBegan, function(\n            input\n        )\n            if isTouch(input) then\n                garbage.holds[name] = input\n            end\n        end))\n    end\n\n    holdButton('rise', 'UP', UDim2.new(1, -EDGE_OFFSET, 1, -BOTTOM_OFFSET - BUTTON_SIZE - 12))\n    holdButton('fall', 'DOWN', UDim2.new(1, -EDGE_OFFSET, 1, -BOTTOM_OFFSET))\n    holdButton('boost', 'BOOST', UDim2.new(1, -EDGE_OFFSET - BUTTON_SIZE - 12, 1, \n-BOTTOM_OFFSET))\n\n    local close = createService.new('TextButton', gui, {\n        Name = 'Close',\n        AnchorPoint = Vector2.new(1, 0),\n        Position = UDim2.new(1, -EDGE_OFFSET, 0, EDGE_OFFSET),\n        Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),\n        BackgroundColor3 = Color3.new(0, 0, 0),\n        BackgroundTransparency = 0.5,\n        AutoButtonColor = false,\n        Text = 'X',\n        TextColor3 = Color3.new(1, 1, 1),\n        TextScaled = true,\n        Active = true,\n    })\n\n    table.insert(garbage.controls, close)\n    table.insert(garbage.connections, self:connect(close.Activated, function()\n        freecam.stop(self)\n    end))\n\n    local teleport = createService.new('TextButton', gui, {\n        Name = 'Teleport',\n        AnchorPoint = Vector2.new(1, 0),\n        Position = UDim2.new(1, -EDGE_OFFSET - BUTTON_SIZE - 12, 0, EDGE_OFFSET),\n        Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),\n        BackgroundColor3 = Color3.new(0, 0, 0),\n        BackgroundTransparency = 0.5,\n        AutoButtonColor = false,\n        Text = 'TP',\n        TextColor3 = Color3.new(1, 1, 1),\n        TextScaled = true,\n        Active = true,\n    })\n\n    table.insert(garbage.controls, teleport)\n    table.insert(garbage.connections, self:connect(teleport.Activated, function()\n        freecam.teleport(self)\n    end))\n    table.insert(garbage.connections, self:connect(UserInputService.InputEnded, function(\n        input\n    )\n        for name, touch in garbage.holds do\n            if input == touch then\n                garbage.holds[name] = nil\n            end\n        end\n    end))\nend\nlocal function hideJumpButton(self, garbage)\n    local playerGui = robloxServices.Players.LocalPlayer:FindFirstChildOfClass('PlayerGui')\n    local touchGui = playerGui and playerGui:FindFirstChild('TouchGui')\n    local jumpButton = touchGui and touchGui:FindFirstChild('JumpButton', true)\n\n    if not jumpButton then\n        return\n    end\n\n    garbage.jumpButton = jumpButton\n    garbage.jumpVisible = jumpButton.Visible\n    jumpButton.Visible = false\n\n    table.insert(garbage.connections, self:connect(jumpButton:GetPropertyChangedSignal('Visible'), function(\n    )\n        if jumpButton.Visible then\n            jumpButton.Visible = false\n        end\n    end))\nend\nlocal function freezeCharacter(self, garbage)\n    local root = self.playerService:getRootPart()\n\n    if not root then\n        return\n    end\n\n    garbage.root = root\n    garbage.rootAnchored = root.Anchored\n    root.Anchored = true\nend\nlocal function releaseCharacter(garbage)\n    local root = garbage.root\n\n    if root and root.Parent ~= nil then\n        root.Anchored = garbage.rootAnchored\n    end\nend\nlocal function stepFreecam(self, garbage, dt)\n    local camera = workspace.CurrentCamera\n\n    garbage.navMultiplier = math.clamp(garbage.navMultiplier + dt * readAxis(Enum.KeyCode.Up, Enum.KeyCode.Down) * SPEED_CHANGE_PER_SECOND, MIN_MULTIPLIER, MAX_MULTIPLIER)\n\n    local humanoid = self.playerService:getHumanoid()\n    local thumbstick = if isMobile then readThumbstick(humanoid, garbage.rotation.Y)else Vector3.zero\n\n    if isMobile and humanoid then\n        humanoid.Jump = false\n    end\n\n    local rise = garbage.holds.rise and 1 or 0\n    local fall = garbage.holds.fall and 1 or 0\n    local keys = Vector3.new(readAxis(Enum.KeyCode.D, Enum.KeyCode.A) + thumbstick.X, readAxis(Enum.KeyCode.E, Enum.KeyCode.Q) + rise - fall, readAxis(Enum.KeyCode.S, Enum.KeyCode.W) + thumbstick.Z)\n    local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and SHIFT_MULTIPLIER or 1\n    local boostHeld = garbage.holds.boost or UserInputService:IsKeyDown(keyboardService:getBinding('freecamBoost'))\n    local boost = if boostHeld then freecam.getBoost(self)else 1\n    local speed = (self.privateEnv.freecamSpeed or freecam.DEFAULT_SPEED) * garbage.navMultiplier * shift * boost\n    local velocity = updateSpring(garbage.velocitySpring, dt, keys * speed)\n    local pan = updateSpring(garbage.panSpring, dt, garbage.mouseDelta * PAN_PER_PIXEL)\n\n    garbage.mouseDelta = Vector2.zero\n\n    local zoomFactor = math.sqrt(math.tan(math.rad(REFERENCE_FOV / 2)) / math.tan(math.rad(garbage.fieldOfView / 2)))\n    local rotation = garbage.rotation + pan * Vector2.new(0.75, 1) * 8 * (dt / zoomFactor)\n\n    garbage.rotation = Vector2.new(math.clamp(rotation.X, -MAX_PITCH, MAX_PITCH), rotation.Y % (2 * math.pi))\n\n    local orientation = CFrame.fromOrientation(garbage.rotation.X, garbage.rotation.Y, 0)\n    local cframe = CFrame.new(garbage.position) * orientation * CFrame.new(velocity * STUDS_PER_SECOND * dt)\n\n    garbage.position = cframe.Position\n    camera.CFrame = cframe\n\n    if garbage.anchor then\n        garbage.anchor.CFrame = cframe\n    end\n\n    camera.Focus = cframe * CFrame.new(0, 0, -getFocusDistance(camera, cframe, garbage.fieldOfView))\n    camera.FieldOfView = garbage.fieldOfView\nend\nlocal function createAnchor(garbage)\n    return createService.new('Part', workspace, {\n        Name = 'freecamAnchor',\n        Anchored = true,\n        CanCollide = false,\n        CanQuery = false,\n        CanTouch = false,\n        CastShadow = false,\n        Transparency = 1,\n        Size = Vector3.one * 0.2,\n        CFrame = CFrame.new(garbage.position),\n    })\nend\nlocal function waitNextCharacter(camera)\n    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()\n    local humanoid = character:WaitForChild('Humanoid', 100)\n\n    if camera and (camera.CameraSubject == nil or not camera.CameraSubject:IsDescendantOf(workspace)) and playerService:isAlive(character) then\n        camera.CameraSubject = humanoid\n    end\nend\n\nfunction freecam.stop(self)\n    local garbage = self:collectGarbage(GARBAGE_NAME)\n\n    if not garbage then\n        return false\n    end\n\n    for _, connection in garbage.connections do\n        connection:Disconnect()\n    end\n\n    ContextActionService:UnbindAction(KEYS_ACTION)\n    ContextActionService:UnbindAction(MOUSE_ACTION)\n\n    if garbage.gui then\n        garbage.gui:Destroy()\n    end\n    if garbage.jumpButton then\n        garbage.jumpButton.Visible = garbage.jumpVisible\n    end\n\n    releaseCharacter(garbage)\n\n    local cameraSubject = garbage.cameraSubject\n    local camera = workspace.CurrentCamera\n\n    camera.CameraSubject = cameraSubject\n\n    if garbage.isLPHumanoid or (cameraSubject and not cameraSubject:IsDescendantOf(workspace)) then\n        task.spawn(waitNextCharacter, camera)\n    end\n\n    camera.CameraType = garbage.cameraType\n\n    if garbage.anchor then\n        garbage.anchor:Destroy()\n    end\n\n    camera.Focus = garbage.focus\n    camera.FieldOfView = garbage.fieldOfView\n    UserInputService.MouseBehavior = garbage.mouseBehavior\n    UserInputService.MouseIconEnabled = garbage.mouseIconEnabled\n\n    return true\nend\nfunction freecam.teleport(self)\n    local garbage = self:getGarbage(GARBAGE_NAME)\n\n    if not garbage then\n        return false\n    end\n\n    local cframe = CFrame.new(garbage.position) * CFrame.Angles(0, garbage.rotation.Y, 0)\n\n    freecam.stop(self)\n\n    if not self.playerService:teleportTo(cframe) then\n        self:notify('Freecam', 'your character was not found')\n    end\n\n    return true\nend\n\nlocal function guarded(self, what, fn, ...)\n    local ok, err = pcall(fn, ...)\n\n    if not ok then\n        self:notify('Freecam', `{what} failed: {err}`)\n    end\nend\nlocal function startFreecam(self, position)\n    freecam.stop(self)\n\n    local camera = workspace.CurrentCamera\n    local startCFrame = camera.CFrame\n    local pitch, yaw = startCFrame:ToOrientation()\n    local garbage = self:createGarbage(GARBAGE_NAME)\n\n    garbage.connections = {}\n    garbage.controls = {}\n    garbage.holds = {}\n    garbage.cameraType = camera.CameraType\n    garbage.cameraSubject = camera.CameraSubject\n\n    local humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass('Humanoid')\n\n    garbage.isLPHumanoid = (garbage.cameraSubject ~= nil and humanoid == garbage.cameraSubject) or garbage.cameraSubject == nil\n    garbage.focus = camera.Focus\n    garbage.fieldOfView = camera.FieldOfView\n    garbage.mouseBehavior = UserInputService.MouseBehavior\n    garbage.mouseIconEnabled = UserInputService.MouseIconEnabled\n    garbage.position = position or startCFrame.Position\n    garbage.rotation = Vector2.new(pitch, yaw)\n    garbage.mouseDelta = Vector2.zero\n    garbage.navMultiplier = 1\n    garbage.velocitySpring = newSpring(Vector3.zero)\n    garbage.panSpring = newSpring(Vector2.zero)\n    garbage.anchor = createAnchor(garbage)\n    camera.CameraType = Enum.CameraType.Custom\n    camera.CameraSubject = garbage.anchor\n    UserInputService.MouseBehavior = Enum.MouseBehavior.Default\n    UserInputService.MouseIconEnabled = true\n\n    ContextActionService:BindActionAtPriority(KEYS_ACTION, sinkInput, false, ACTION_PRIORITY, table.unpack(MOVE_KEYS))\n    ContextActionService:BindActionAtPriority(MOUSE_ACTION, function(\n        _,\n        _,\n        input\n    )\n        local delta = input.Delta\n\n        garbage.mouseDelta += Vector2.new(-delta.Y, -delta.X)\n\n        return Enum.ContextActionResult.Sink\n    end, false, ACTION_PRIORITY, Enum.UserInputType.MouseMovement)\n\n    if isMobile then\n        freezeCharacter(self, garbage)\n        guarded(self, 'buttons', createControls, self, garbage)\n        guarded(self, 'jump button', hideJumpButton, self, garbage)\n        table.insert(garbage.connections, self:connect(UserInputService.InputBegan, function(\n            input,\n            gameProcessed\n        )\n            if gameProcessed or not isTouch(input) then\n                return\n            end\n            if garbage.lookTouch ~= nil or isOverControls(garbage, input.Position) then\n                return\n            end\n            if input.Position.X < workspace.CurrentCamera.ViewportSize.X / 2 then\n                return\n            end\n\n            garbage.lookTouch = input\n        end))\n        table.insert(garbage.connections, self:connect(UserInputService.InputChanged, function(\n            input\n        )\n            if input == garbage.lookTouch then\n                garbage.mouseDelta += Vector2.new(-input.Delta.Y, -input.Delta.X) * TOUCH_LOOK_SCALE\n            end\n        end))\n        table.insert(garbage.connections, self:connect(UserInputService.InputEnded, function(\n            input\n        )\n            if input == garbage.lookTouch then\n                garbage.lookTouch = nil\n            end\n        end))\n    end\n\n    table.insert(garbage.connections, self:connect(self.runService.RenderStepped, function(\n        dt\n    )\n        local ok, err = pcall(stepFreecam, self, garbage, dt)\n\n        if not ok then\n            freecam.stop(self)\n            self:notify('Freecam', `stopped, the camera was given back: {err}`)\n        end\n    end))\nend\n\nfunction freecam.start(self, position)\n    local ok, err = pcall(startFreecam, self, position)\n\n    if not ok then\n        freecam.stop(self)\n        self:notify('Freecam', `could not start: {err}`)\n    end\nend\nfunction freecam.getBoost(self)\n    local value = self.storage.settings:getValue(BOOST_SETTING)\n\n    if type(value) ~= 'number' then\n        return freecam.DEFAULT_BOOST\n    end\n\n    return math.clamp(value, freecam.MIN_BOOST, freecam.MAX_BOOST)\nend\nfunction freecam.addBoost(self, amount)\n    local value = math.clamp(freecam.getBoost(self) + amount, freecam.MIN_BOOST, freecam.MAX_BOOST)\n\n    self.storage.settings:setValue(BOOST_SETTING, value)\n    self.storage.settings:save()\n\n    return value\nend\nfunction freecam.getPosition(self)\n    local garbage = self:getGarbage(GARBAGE_NAME)\n\n    return garbage and garbage.position\nend\n\nreturn freecam\n",
[ "src/commands/systems/keepiy.luau" ] = "local executorEnv = require('../../framework/environment/executor')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal robloxServices = require('../../framework/services/rbxServices')\nlocal fetchService = require('../../framework/services/fetchService')\nlocal keepiyConfig = require('../../framework/config/commands/keepiy')\nlocal settingsData = require('../../storage/data/settings')\nlocal logger = require('../../utils/logger')\nlocal keepiy = {}\nlocal started = false\nlocal queued = false\n\nlocal function isEnabled()\n    return settingsData:getValue(keepiyConfig.settingKey) == true\nend\nlocal function buildLoader()\n    return require('../../framework/resources').source()\nend\nlocal function onTeleport()\n    if queued or not isEnabled() then\n        return\n    end\n\n    local queueTeleport = executorEnv.queueteleport\n\n    if queueTeleport == nil then\n        return\n    end\n\n    queued = true\n\n    local ok, err = pcall(queueTeleport, buildLoader())\n\n    if not ok then\n        queued = false\n\n        logger:warn('keepiy: failed to queue the loader: ' .. tostring(err))\n    end\nend\n\nfunction keepiy.start()\n    if started then\n        return\n    end\n\n    started = true\n\n    connectionService:Connect(robloxServices.Players.LocalPlayer.OnTeleport, onTeleport)\nend\nfunction keepiy.enable(cmd)\n    if not cmd:expectExploit('queueteleport') then\n        return\n    end\n\n    cmd.infiniteYield:setKeepIY(true)\n    cmd:notify('Keepiy', \n[[on: XLQP runs again after you teleport, and the interface stays open]])\nend\nfunction keepiy.disable(cmd)\n    cmd.infiniteYield:setKeepIY(false)\n    cmd:notify('Keepiy', 'off: IY will not run after the next teleport')\nend\nfunction keepiy.toggle(cmd)\n    if isEnabled() then\n        keepiy.disable(cmd)\n    else\n        keepiy.enable(cmd)\n    end\nend\n\nreturn keepiy\n",
[ "src/commands/systems/plugins.luau" ] = "local executorEnv = require('../../framework/environment/executor')\nlocal storageConfig = require('../../framework/config/storage')\nlocal pluginsData = require('../../storage/data/plugins')\nlocal plugins = {}\nlocal EXTENSION = '.luau'\nlocal FOLDER = `{storageConfig.privateFolder}/plugins`\n\nplugins.FOLDER = FOLDER\n\nlocal loaded = {}\nlocal lastErrors = {}\n\nlocal function removeFromArray(array, value)\n    local index = table.find(array, value)\n\n    if index then\n        table.remove(array, index)\n    end\nend\nlocal function normalizeName(text)\n    local name = text\n\n    if name:sub(-#EXTENSION) == EXTENSION then\n        name = name:sub(1, -#EXTENSION - 1)\n    end\n    if name:match('^[%w_%-]+$') then\n        return name\n    end\n\n    return nil\nend\nlocal function filePath(name)\n    return `{FOLDER}/{name}{EXTENSION}`\nend\nlocal function readSource(name)\n    if executorEnv.readfile == nil or executorEnv.isfile == nil then\n        return nil, 'your exploit does not support readfile'\n    end\n\n    local path = filePath(name)\n    local existsSuccess, exists = pcall(executorEnv.isfile, path)\n\n    if not (existsSuccess and exists) then\n        return nil, `file not found: {path}`\n    end\n\n    local readSuccess, content = pcall(executorEnv.readfile, path)\n\n    if not (readSuccess and type(content) == 'string') then\n        return nil, `could not read {path}`\n    end\n\n    return content\nend\nlocal function compile(source)\n    if executorEnv.loadstring == nil then\n        return nil, 'your exploit does not support loadstring'\n    end\n\n    local loadSuccess, chunk, compileError = pcall(executorEnv.loadstring, source)\n\n    if not loadSuccess then\n        return nil, tostring(chunk)\n    end\n    if not chunk then\n        return nil, tostring(compileError)\n    end\n\n    local runSuccess, result = pcall(chunk)\n\n    if not runSuccess then\n        return nil, `error while loading the plugin: {result}`\n    end\n    if type(result) ~= 'table' then\n        return nil, 'the plugin must return a table of commands'\n    end\n\n    return result\nend\nlocal function prepare(result)\n    local entries = result\n\n    if type(result.action) == 'string' then\n        entries = {result}\n    end\n\n    local prepared = {}\n\n    for _, source in entries do\n        if type(source) ~= 'table' or type(source.action) ~= 'string' then\n            return nil, 'every command needs an action string'\n        end\n        if source.run ~= nil and type(source.run) ~= 'function' then\n            return nil, `run of '{source.action}' must be a function`\n        end\n\n        local names = {}\n\n        for _, text in source.action:split('|')do\n            local name = text:lower()\n\n            if name == '' then\n                return nil, `empty name in '{source.action}'`\n            end\n\n            table.insert(names, name)\n        end\n\n        local entry = {}\n\n        for key, value in source do\n            entry[key] = value\n        end\n\n        local args = entry.args or {}\n\n        if #args == 0 and next(args) then\n            args = {args}\n        end\n\n        entry.args = args\n\n        local aliases = table.clone(names)\n\n        table.sort(aliases, function(a, b)\n            return #a < #b\n        end)\n\n        entry.name = names[1]\n        entry.aliases = aliases\n        entry.action = nil\n\n        table.insert(prepared, {\n            entry = entry,\n            names = names,\n        })\n    end\n\n    if #prepared == 0 then\n        return nil, 'the plugin has no commands'\n    end\n\n    return prepared\nend\nlocal function loadFromFile(list, name)\n    local source, readError = readSource(name)\n\n    if not source then\n        return false, readError\n    end\n\n    local result, compileError = compile(source)\n\n    if not result then\n        return false, compileError\n    end\n\n    local prepared, checkError = prepare(result)\n\n    if not prepared then\n        return false, checkError\n    end\n\n    local keys = {}\n    local taken = {}\n\n    for _, item in prepared do\n        for _, key in item.names do\n            if list.lookup[key] ~= nil or taken[key] then\n                return false, `'{key}' is already a command or an alias`\n            end\n\n            taken[key] = true\n\n            table.insert(keys, key)\n        end\n    end\n    for _, item in prepared do\n        for _, key in item.names do\n            list.lookup[key] = item.entry\n\n            table.insert(list.array, key)\n        end\n    end\n\n    loaded[name] = {\n        keys = keys,\n        commands = #prepared,\n    }\n\n    return true, #prepared\nend\nlocal function loadInto(list, name)\n    local success, detail = loadFromFile(list, name)\n\n    lastErrors[name] = if success then nil else tostring(detail)\n\n    return success, detail\nend\nlocal function unloadFrom(list, name)\n    local record = loaded[name]\n\n    if not record then\n        return\n    end\n\n    for _, key in record.keys do\n        list.lookup[key] = nil\n\n        removeFromArray(list.array, key)\n    end\n\n    loaded[name] = nil\nend\n\nfunction plugins.add(list, text)\n    local name = normalizeName(text)\n\n    if not name then\n        return false, \"plugin names can only use letters, numbers, '_' and '-'\"\n    end\n    if loaded[name] then\n        return false, `'{name}' is already loaded`\n    end\n\n    local success, detail = loadInto(list, name)\n\n    if not success then\n        return false, detail\n    end\n\n    pluginsData.object[name] = name .. EXTENSION\n\n    pluginsData:save()\n\n    return true, detail\nend\nfunction plugins.remove(list, name)\n    if pluginsData.object[name] == nil and loaded[name] == nil then\n        return false\n    end\n\n    unloadFrom(list, name)\n\n    lastErrors[name] = nil\n    pluginsData.object[name] = nil\n\n    pluginsData:save()\n\n    return true\nend\nfunction plugins.reload(list, name)\n    if pluginsData.object[name] == nil then\n        return false, `'{name}' is not installed`\n    end\n\n    unloadFrom(list, name)\n\n    return loadInto(list, name)\nend\nfunction plugins.restore(list)\n    local failures = {}\n\n    for name in pluginsData.object do\n        if not loaded[name] then\n            local success, detail = loadInto(list, name)\n\n            if not success then\n                failures[name] = tostring(detail)\n            end\n        end\n    end\n\n    return failures\nend\nfunction plugins.addAll(list)\n    if executorEnv.listfiles == nil then\n        return nil, 'your exploit does not support listfiles'\n    end\n\n    local success, paths = pcall(executorEnv.listfiles, FOLDER)\n\n    if not (success and type(paths) == 'table') then\n        return nil, `could not read the folder {FOLDER} (create it and put your .luau plugins there)`\n    end\n\n    local result = {\n        added = {},\n        failed = {},\n    }\n\n    for _, path in paths do\n        local name = type(path) == 'string' and path:match('([^/\\\\]+)%.luau$')\n\n        if name and not loaded[name] then\n            local addSuccess, detail = plugins.add(list, name)\n\n            if addSuccess then\n                table.insert(result.added, name)\n            else\n                table.insert(result.failed, `{name}: {detail}`)\n            end\n        end\n    end\n\n    return result\nend\nfunction plugins.getInstalled()\n    local installed = {}\n\n    for name in pluginsData.object do\n        local record = loaded[name]\n\n        table.insert(installed, {\n            name = name,\n            loaded = record ~= nil,\n            commands = if record then record.commands else 0,\n            error = if record then nil else lastErrors[name],\n        })\n    end\n\n    table.sort(installed, function(a, b)\n        return a.name:lower() < b.name:lower()\n    end)\n\n    return installed\nend\nfunction plugins.getAvailable()\n    if executorEnv.listfiles == nil then\n        return nil, 'your exploit does not support listfiles'\n    end\n\n    local success, paths = pcall(executorEnv.listfiles, FOLDER)\n\n    if not (success and type(paths) == 'table') then\n        return nil, `could not read the folder {FOLDER} (create it and put your .luau plugins there)`\n    end\n\n    local names = {}\n\n    for _, path in paths do\n        local name = type(path) == 'string' and path:match('([^/\\\\]+)%.luau$')\n\n        if name and normalizeName(name) and pluginsData.object[name] == nil then\n            table.insert(names, name)\n        end\n    end\n\n    table.sort(names, function(a, b)\n        return a:lower() < b:lower()\n    end)\n\n    return names\nend\n\nreturn plugins\n",
[ "src/commands/systems/resolvePlayers.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal playerService = require('../../framework/services/playerService')\nlocal localPlayer = require('../../framework/services/localPlayer')\n\nlocal function shuffle(list)\n    for index = #list, 2, -1 do\n        local other = math.random(1, index)\n\n        list[index], list[other] = list[other], list[index]\n    end\n\n    return list\nend\nlocal function getHumanoid(player)\n    local character = player.Character\n\n    return character and character:FindFirstChildOfClass('Humanoid')\nend\nlocal function getRoot(player)\n    local character = player.Character\n\n    return character and character:FindFirstChild('HumanoidRootPart')\nend\nlocal function isAlive(player)\n    local humanoid = getHumanoid(player)\n\n    return humanoid ~= nil and humanoid.Health > 0\nend\nlocal function distanceFromLocal(player)\n    local localRoot = getRoot(localPlayer)\n    local root = getRoot(player)\n\n    if not (localRoot and root) then\n        return nil\n    end\n\n    return (root.Position - localRoot.Position).Magnitude\nend\nlocal function filter(players, predicate)\n    local list = {}\n\n    for _, player in players do\n        if predicate(player) then\n            table.insert(list, player)\n        end\n    end\n\n    return list\nend\nlocal function withoutLocal(players)\n    return filter(players, function(player)\n        return player ~= localPlayer\n    end)\nend\nlocal function isOnMyTeam(player)\n    return localPlayer.Team ~= nil and player.Team == localPlayer.Team\nend\nlocal function hasBacon(player)\n    local humanoid = getHumanoid(player)\n\n    if not humanoid then\n        return false\n    end\n\n    for _, accessory in humanoid:GetAccessories()do\n        local name = accessory.Name:lower()\n\n        if name:find('bacon', 1, true) or name:find('pal hair', 1, true) then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function byDistance(players, farthest)\n    local best = nil\n    local bestDistance = nil\n\n    for _, player in withoutLocal(players)do\n        local distance = distanceFromLocal(player)\n\n        if distance then\n            local better = bestDistance == nil or (farthest and distance > bestDistance) or (not farthest and distance < bestDistance)\n\n            if better then\n                best, bestDistance = player, distance\n            end\n        end\n    end\n\n    if best then\n        return {best}\n    end\n\n    return {}\nend\n\nlocal KEYWORDS = {\n    me = function()\n        return {localPlayer}\n    end,\n    all = function(players)\n        return players\n    end,\n    others = function(players)\n        return withoutLocal(players)\n    end,\n    random = function(players)\n        if #players == 0 then\n            return {}\n        end\n\n        return {\n            players[math.random(1, #players)],\n        }\n    end,\n    allies = function(players)\n        return filter(players, isOnMyTeam)\n    end,\n    team = function(players)\n        return filter(players, isOnMyTeam)\n    end,\n    enemies = function(players)\n        return filter(withoutLocal(players), function(player)\n            return not isOnMyTeam(player)\n        end)\n    end,\n    nonteam = function(players)\n        return filter(withoutLocal(players), function(player)\n            return not isOnMyTeam(player)\n        end)\n    end,\n    friends = function(players)\n        return filter(withoutLocal(players), function(player)\n            return localPlayer:IsFriendsWith(player.UserId)\n        end)\n    end,\n    nonfriends = function(players)\n        return filter(withoutLocal(players), function(player)\n            return not localPlayer:IsFriendsWith(player.UserId)\n        end)\n    end,\n    guests = function(players)\n        return filter(players, function(player)\n            return player.UserId <= 0\n        end)\n    end,\n    bacons = function(players)\n        return filter(players, hasBacon)\n    end,\n    alive = function(players)\n        return filter(players, isAlive)\n    end,\n    dead = function(players)\n        return filter(players, function(player)\n            return not isAlive(player)\n        end)\n    end,\n    nearest = function(players)\n        return byDistance(players, false)\n    end,\n    farthest = function(players)\n        return byDistance(players, true)\n    end,\n}\nlocal PATTERNS = {\n    {\n        pattern = '^#(%d+)$',\n        handler = function(players, captured)\n            local list = shuffle(players)\n\n            return table.move(list, 1, math.min(tonumber(captured), #list), 1, {})\n        end,\n    },\n    {\n        pattern = '^@(.+)$',\n        handler = function(players, captured)\n            return filter(players, function(player)\n                return player.Name:lower():sub(1, #captured) == captured\n            end)\n        end,\n    },\n    {\n        pattern = '^%%(.+)$',\n        handler = function(players, captured)\n            return filter(players, function(player)\n                local team = player.Team\n\n                return team ~= nil and team.Name:lower():sub(1, #captured) == captured\n            end)\n        end,\n    },\n    {\n        pattern = '^age(%d+)$',\n        handler = function(players, captured)\n            local age = tonumber(captured)\n\n            return filter(players, function(player)\n                return player.AccountAge <= age\n            end)\n        end,\n    },\n    {\n        pattern = '^rad(%d+)$',\n        handler = function(players, captured)\n            local radius = tonumber(captured)\n\n            return filter(withoutLocal(players), function(player)\n                local distance = distanceFromLocal(player)\n\n                return distance ~= nil and distance <= radius\n            end)\n        end,\n    },\n    {\n        pattern = '^group(%d+)$',\n        handler = function(players, captured)\n            local groupId = tonumber(captured)\n\n            return filter(players, function(player)\n                return player:IsInGroup(groupId)\n            end)\n        end,\n    },\n}\n\nlocal function isSelector(text)\n    local query = (text or 'me'):lower()\n\n    if KEYWORDS[query] then\n        return true\n    end\n\n    for _, entry in PATTERNS do\n        if query:match(entry.pattern) then\n            return true\n        end\n    end\n\n    return false\nend\nlocal function trim(text)\n    return text:match('^%s*(.-)%s*$')\nend\nlocal function resolveTerm(text, players)\n    local query = text:lower()\n    local keyword = KEYWORDS[query]\n\n    if keyword then\n        return keyword(players)\n    end\n\n    for _, entry in PATTERNS do\n        local captured = query:match(entry.pattern)\n\n        if captured then\n            return entry.handler(players, captured)\n        end\n    end\n\n    return playerService:getPlayersByName(text)\nend\nlocal function union(first, second)\n    local seen = {}\n    local list = {}\n\n    for _, player in first do\n        if not seen[player] then\n            seen[player] = true\n\n            table.insert(list, player)\n        end\n    end\n    for _, player in second do\n        if not seen[player] then\n            seen[player] = true\n\n            table.insert(list, player)\n        end\n    end\n\n    return list\nend\nlocal function difference(first, second)\n    local remove = {}\n\n    for _, player in second do\n        remove[player] = true\n    end\n\n    return filter(first, function(player)\n        return not remove[player]\n    end)\nend\nlocal function splitOperators(text)\n    local items = {}\n    local op = '+'\n    local buffer = {}\n\n    for index = 1, #text do\n        local char = text:sub(index, index)\n\n        if char == '+' or char == '-' then\n            table.insert(items, {\n                op = op,\n                term = trim(table.concat(buffer)),\n            })\n\n            buffer = {}\n            op = char\n        else\n            table.insert(buffer, char)\n        end\n    end\n\n    table.insert(items, {\n        op = op,\n        term = trim(table.concat(buffer)),\n    })\n\n    return items\nend\nlocal function resolveChain(text, players)\n    local items = splitOperators(text)\n    local first = items[1]\n    local result = {}\n\n    if first.term ~= '' then\n        result = resolveTerm(first.term, players)\n    elseif items[2] and items[2].op == '-' then\n        result = table.clone(players)\n    end\n\n    for index = 2, #items do\n        local item = items[index]\n        local matches = {}\n\n        if item.term ~= '' then\n            matches = resolveTerm(item.term, players)\n        end\n        if item.op == '+' then\n            result = union(result, matches)\n        else\n            result = difference(result, matches)\n        end\n    end\n\n    return result\nend\nlocal function parts(text)\n    local list = {}\n\n    for part in text:gmatch('[^,]+')do\n        local value = trim(part)\n\n        if value ~= '' then\n            table.insert(list, value)\n        end\n    end\n\n    return list\nend\nlocal function hasOperators(text)\n    return text ~= nil and text:find('[,+%-]') ~= nil\nend\nlocal function resolvePlayers(text)\n    local input = text or 'me'\n    local players = robloxServices.Players:GetPlayers()\n    local whole = resolveTerm(trim(input), players)\n\n    if #whole > 0 then\n        return whole\n    end\n    if not hasOperators(input) then\n        return playerService:getPlayersByName(trim(input))\n    end\n\n    local result = {}\n\n    for _, part in parts(input)do\n        result = union(result, resolveChain(part, players))\n    end\n\n    return result\nend\n\nreturn setmetatable({\n    isSelector = isSelector,\n    hasOperators = hasOperators,\n    parts = parts,\n}, {\n    __call = function(_, text)\n        return resolvePlayers(text)\n    end,\n})\n",
[ "src/commands/systems/waypoints.luau" ] = "local waypointsData = require('../../storage/data/waypoints')\nlocal privateEnv = require('../../framework/environment/private')\nlocal playerService = require('../../framework/services/playerService')\nlocal stringifier = require('../../utils/stringifier')\nlocal SHOWN_GARBAGE = 'showingWaypoints'\nlocal garbages = privateEnv.iyGarbages or {}\n\nprivateEnv.iyGarbages = garbages\n\nlocal waypoints = {}\n\nlocal function placeKey()\n    return tostring(game.PlaceId)\nend\nlocal function getPlace(create)\n    if create then\n        return waypointsData:register(placeKey(), {})\n    end\n\n    local place = waypointsData:getValue(placeKey())\n\n    return if type(place) == 'table'then place else nil\nend\nlocal function countEntries(place)\n    local count = 0\n\n    if type(place) == 'table' then\n        for _ in place do\n            count += 1\n        end\n    end\n\n    return count\nend\nlocal function readPosition(coords)\n    if type(coords) ~= 'string' then\n        return nil\n    end\n\n    local success, position = pcall(stringifier.unstringify, stringifier, coords, 'Vector3')\n\n    if success and typeof(position) == 'Vector3' then\n        return position\n    end\n\n    return nil\nend\n\nfunction waypoints.list()\n    local list = {}\n\n    for name, coords in getPlace() or {}do\n        local position = readPosition(coords)\n\n        if position then\n            table.insert(list, {\n                name = name,\n                position = position,\n            })\n        end\n    end\n\n    table.sort(list, function(a, b)\n        return a.name:lower() < b.name:lower()\n    end)\n\n    return list\nend\nfunction waypoints.find(name)\n    local lowered = name:lower()\n\n    for _, waypoint in waypoints.list()do\n        if waypoint.name:lower() == lowered then\n            return waypoint\n        end\n    end\n\n    return nil\nend\nfunction waypoints.count()\n    return countEntries(getPlace())\nend\nfunction waypoints.countAll()\n    local total = 0\n\n    for _, place in waypointsData:getData()do\n        total += countEntries(place)\n    end\n\n    return total\nend\nfunction waypoints.save(name, position)\n    local place = (getPlace(true))\n    local lowered = name:lower()\n    local replaced = false\n\n    for storedName in place do\n        if storedName:lower() == lowered then\n            place[storedName] = nil\n            replaced = true\n        end\n    end\n\n    place[name] = (stringifier:stringify(position))\n\n    waypointsData:save()\n\n    return replaced\nend\nfunction waypoints.remove(name)\n    local place = getPlace()\n    local lowered = name:lower()\n    local removed = false\n\n    if type(place) == 'table' then\n        for storedName in place do\n            if storedName:lower() == lowered then\n                place[storedName] = nil\n                removed = true\n            end\n        end\n    end\n    if removed then\n        waypointsData:save()\n    end\n\n    return removed\nend\nfunction waypoints.clearPlace()\n    local count = waypoints.count()\n\n    waypointsData:setValue(placeKey(), nil)\n    waypointsData:save()\n\n    return count\nend\nfunction waypoints.clearAll()\n    local total = 0\n\n    for key, place in waypointsData:getData()do\n        total += countEntries(place)\n\n        waypointsData:setValue(key, nil)\n    end\n\n    waypointsData:save()\n\n    return total\nend\nfunction waypoints.format(position)\n    return `({math.round(position.X)}, {math.round(position.Y)}, {math.round(position.Z)})`\nend\nfunction waypoints.parsePosition(text)\n    local numbers = {}\n\n    for piece in text:gmatch('[^%s,;]+')do\n        local number = tonumber(piece)\n\n        if number == nil or number ~= number or math.abs(number) == math.huge then\n            return nil\n        end\n\n        table.insert(numbers, number)\n    end\n\n    if #numbers ~= 3 then\n        return nil\n    end\n\n    return Vector3.new(numbers[1], numbers[2], numbers[3])\nend\nfunction waypoints.go(waypoint, mode, speed)\n    if mode == 'tween' then\n        speed = if typeof(speed) == 'number'then speed else nil\n\n        local tween = playerService:tweenTeleportTo({\n            target = CFrame.new(waypoint.position),\n            speed = speed or privateEnv.tweenSpeed,\n        })\n\n        return tween ~= nil\n    end\n    if mode == 'walk' then\n        local humanoid = playerService:unseat()\n\n        if not humanoid then\n            return false\n        end\n\n        humanoid:MoveTo(waypoint.position)\n\n        return true\n    end\n\n    return playerService:teleportTo(CFrame.new(waypoint.position))\nend\nfunction waypoints.isShown()\n    return garbages[SHOWN_GARBAGE] ~= nil\nend\nfunction waypoints.hide()\n    local markers = garbages[SHOWN_GARBAGE]\n\n    if markers == nil then\n        return false\n    end\n\n    garbages[SHOWN_GARBAGE] = nil\n\n    for _, marker in markers do\n        marker:Destroy()\n    end\n\n    return true\nend\n\nlocal function createMarker(waypoint)\n    local part = Instance.new('Part')\n\n    part.Size = Vector3.new(5, 5, 5)\n    part.CFrame = CFrame.new(waypoint.position)\n    part.Anchored = true\n    part.CanCollide = false\n    part.CanTouch = false\n    part.CanQuery = false\n    part.Parent = workspace\n\n    local box = Instance.new('BoxHandleAdornment')\n\n    box.Adornee = part\n    box.AlwaysOnTop = true\n    box.ZIndex = 10\n    box.Size = part.Size\n    box.Parent = part\n\n    local billboard = Instance.new('BillboardGui')\n\n    billboard.Adornee = part\n    billboard.AlwaysOnTop = true\n    billboard.Size = UDim2.fromOffset(160, 30)\n    billboard.StudsOffset = Vector3.new(0, 4, 0)\n    billboard.Parent = part\n\n    local label = Instance.new('TextLabel')\n\n    label.BackgroundTransparency = 1\n    label.Size = UDim2.fromScale(1, 1)\n    label.Text = waypoint.name\n    label.TextColor3 = Color3.new(1, 1, 1)\n    label.TextStrokeTransparency = 0\n    label.TextScaled = true\n    label.Parent = billboard\n\n    return part\nend\n\nfunction waypoints.show()\n    waypoints.hide()\n\n    local markers = {}\n    local list = waypoints.list()\n\n    for _, waypoint in list do\n        table.insert(markers, createMarker(waypoint))\n    end\n\n    garbages[SHOWN_GARBAGE] = markers\n\n    return #list\nend\nfunction waypoints.refreshMarkers()\n    if waypoints.isShown() then\n        waypoints.show()\n    end\nend\n\nreturn waypoints\n",
[ "src/core/checkStubs.luau" ] = "local commandsList = require('../commands/list')\n\nlocal function findStubs()\n    local stubs = {}\n    local sectionName = 'unknown'\n\n    for _, entry in commandsList.original do\n        if entry.isSection then\n            sectionName = entry.sectionName\n        elseif entry.run == nil then\n            table.insert(stubs, {\n                section = sectionName,\n                name = entry.name,\n            })\n        end\n    end\n\n    return stubs\nend\n\nreturn function(commandsController)\n    local stubs = findStubs()\n\n    if #stubs == 0 then\n        return\n    end\n\n    local bySection = {}\n    local order = {}\n\n    for _, stub in stubs do\n        if not bySection[stub.section] then\n            bySection[stub.section] = {}\n\n            table.insert(order, stub.section)\n        end\n\n        table.insert(bySection[stub.section], stub.name)\n    end\n\n    local lines = {}\n\n    for _, section in order do\n        local names = table.concat(bySection[section], ', ')\n\n        table.insert(lines, `[{section}] {names}`)\n    end\n\n    local report = table.concat(lines, '\\n')\n\n    commandsController:notify('Commands without run', `{#stubs} command(s) still need a run function, see console`)\nend\n",
[ "src/core/checkVersion.luau" ] = "local tools = require('../utils/tools')\nlocal fetchService = require('../framework/services/fetchService')\nlocal frameworkSettings = require('../framework/settings')\n\nlocal function checkVersion()\n    local versionToNumber = tools.versionToNumber\n    local currentVersion = require('../version')\n    local latestVersion = fetchService.fetch('/src/version.luau')\n\n    if latestVersion == nil then\n        return\n    end\n\n    local versionChunk = loadstring(latestVersion)\n\n    if versionChunk == nil then\n        return\n    end\n\n    latestVersion = versionChunk()\n\n    if versionToNumber(latestVersion) > versionToNumber(currentVersion) then\n        require('../ui/notifier'):notify(frameworkSettings.newVersionMessage)\n    end\nend\n\nreturn checkVersion\n",
[ "src/core/cleanup.luau" ] = "local privateEnv = require('../framework/environment/private')\nlocal logger = require('../utils/logger')\nlocal cleanup = {}\n\nlocal function stopRunning(garbage)\n    if type(garbage) ~= 'table' then\n        return\n    end\n    if type(garbage.stop) == 'function' then\n        pcall(garbage.stop)\n    end\n    if garbage.running ~= nil then\n        garbage.running = false\n    end\n    if typeof(garbage.thread) == 'thread' then\n        pcall(task.cancel, garbage.thread)\n    end\nend\n\nfunction cleanup:init()\n    if privateEnv.screenGui then\n        privateEnv.screenGui:Destroy()\n        logger:log('destroyed old interface')\n    end\n    if privateEnv.connectionService then\n        privateEnv.connectionService:cleanup()\n\n        privateEnv.connectionService = nil\n\n        logger:log('cleaned old connections')\n    end\n\n    for _, garbage in privateEnv.iyGarbages or {}do\n        stopRunning(garbage)\n    end\n\n    logger:log('finished cleanup!')\nend\n\nreturn cleanup\n",
[ "src/core/init.luau" ] = "require('./cleanup'):init()\n\nlocal commandsController = require('../commands/controllers/commandsController')\nlocal keepiy = require('../commands/systems/keepiy')\nlocal playerService = require('../framework/services/playerService')\nlocal fetchService = require('../framework/services/fetchService')\nlocal eventListeners = require('../commands/services/eventListeners')\nlocal interface = require('../ui')\nlocal infiniteYield = {}\n\nfunction infiniteYield:boot()\n    self.boot = nil\n\n    commandsController:init({\n        infiniteYield = interface,\n        playerService = playerService,\n        fetchService = fetchService,\n    })\n    keepiy.start()\n    interface:awake()\n    eventListeners.start()\nend\n\nreturn infiniteYield\n",
[ "src/core/storage.luau" ] = "local localPlayer = require('../framework/services/localPlayer')\nlocal datas = require('../storage')\n\nlocal function registerSettings()\n    local settingsData = datas.settings\n\n    settingsData:register('clearOnEnter', true)\n    settingsData:register('spaceAfterCorrection', true)\n    settingsData:register('uiScale', 1.4)\n    settingsData:save()\nend\nlocal function registerUserData()\n    local userData = datas.user\n    local usedPlaces = userData:register('usedPlaces', {})\n\n    userData:register('totalUsedCommands', {})\n    userData:register('usedAccounts', {})\n    userData:register('firstTimeExecuted', os.date('%Y-%m-%d %H:%M:%S'))\n    userData:register('lastTimeExecuted', '')\n    userData:register('executionCount', 0)\n    userData:add('usedAccounts', localPlayer.UserId)\n    userData:increment('executionCount', 1)\n    userData:setValue('lastTimeExecuted', os.date('%Y-%m-%d %H:%M:%S'))\n\n    usedPlaces[game.GameId] = (usedPlaces[game.GameId] or 0) + 1\n\n    userData:save()\nend\n\nregisterSettings()\nregisterUserData()\n\nreturn true\n",
[ "src/framework/config/commands/keepiy.luau" ] = "return {\n    settingKey = 'interface.keepIY',\n    bundleName = 'compiled.luau',\n    localBundlePath = 'xlqp/loader.luau',\n}\n",
[ "src/framework/config/github.luau" ] = "return {owner = \"josediaz765\", repository = \"xlqp\"}\n",
[ "src/framework/config/links.luau" ] = "local gitCfg = require('./github')\n\nreturn {\n    discord = 'https://discord.gg/dFpeqN4UHk',\n    github = `https://github.com/{gitCfg.owner}/{gitCfg.repository}`,\n}\n",
[ "src/framework/config/services/eventBinds.luau" ] = "local ANY = 'any'\n\nreturn {\n    ANY = ANY,\n    events = {\n        {\n            name = 'OnExecute',\n            description = 'when IY loads',\n            conditions = {},\n        },\n        {\n            name = 'OnJoin',\n            description = 'a player joins',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = ANY,\n                },\n            },\n        },\n        {\n            name = 'OnLeave',\n            description = 'a player leaves',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = ANY,\n                },\n            },\n        },\n        {\n            name = 'OnSpawn',\n            description = 'a character spawns',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = 'me',\n                },\n            },\n        },\n        {\n            name = 'OnDied',\n            description = 'a character dies',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = 'me',\n                },\n            },\n        },\n        {\n            name = 'OnDamage',\n            description = 'a character takes damage',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = 'me',\n                },\n                {\n                    kind = 'Number',\n                    label = '$2 health at most',\n                    default = ANY,\n                },\n            },\n        },\n        {\n            name = 'OnKilled',\n            description = 'a player kills another',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 victim',\n                    default = 'me',\n                },\n                {\n                    kind = 'Player',\n                    label = '$2 killer',\n                    default = ANY,\n                },\n            },\n        },\n        {\n            name = 'OnChatted',\n            description = 'a player chats',\n            conditions = {\n                {\n                    kind = 'Player',\n                    label = '$1 player',\n                    default = ANY,\n                },\n                {\n                    kind = 'String',\n                    label = '$2 message contains',\n                    default = ANY,\n                },\n            },\n        },\n    },\n}\n",
[ "src/framework/config/services/keybinds.luau" ] = "return {\n    bindings = {\n        prefix = {\n            label = 'Prefix',\n            settingKey = 'keybinds.prefix',\n            default = 'Semicolon',\n            also = {\n                'RightControl',\n            },\n            group = 'interface',\n        },\n        flyUp = {\n            label = 'Up',\n            settingKey = 'keybinds.flyUp',\n            default = 'E',\n            group = 'fly',\n        },\n        flyDown = {\n            label = 'Down',\n            settingKey = 'keybinds.flyDown',\n            default = 'Q',\n            group = 'fly',\n        },\n        floatUp = {\n            label = 'Up',\n            settingKey = 'keybinds.floatUp',\n            default = 'E',\n            group = 'float',\n        },\n        floatDown = {\n            label = 'Down',\n            settingKey = 'keybinds.floatDown',\n            default = 'Q',\n            group = 'float',\n        },\n        freecamBoost = {\n            label = 'Boost (held)',\n            settingKey = 'keybinds.freecamBoost',\n            default = 'LeftControl',\n            group = 'freecam',\n        },\n    },\n    groups = {\n        {\n            key = 'fly',\n            title = 'Fly',\n        },\n        {\n            key = 'float',\n            title = 'Float',\n        },\n        {\n            key = 'freecam',\n            title = 'Freecam',\n        },\n    },\n}\n",
