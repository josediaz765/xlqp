[ "src/ui/utils/inputUtils.luau" ] = "local connectionService = require('../../framework/services/connectionService')\nlocal rbxServices = require('../../framework/services/rbxServices')\nlocal userInputService = rbxServices.UserInputService\nlocal PRESSING_INPUTS = {\n    [Enum.UserInputType.MouseButton1] = true,\n    [Enum.UserInputType.Touch] = true,\n}\nlocal MOVING_INPUTS = {\n    [Enum.UserInputType.MouseMovement] = true,\n    [Enum.UserInputType.Touch] = true,\n}\nlocal inputUtils = {}\n\nfunction inputUtils.onReleaseEvent(callback)\n    local releaseEvent\n\n    releaseEvent = connectionService:Connect(userInputService.InputEnded, function(\n        input\n    )\n        if inputUtils.isPressingInput(input) then\n            releaseEvent:Disconnect()\n            callback(input)\n        end\n    end)\n\n    return releaseEvent\nend\nfunction inputUtils.onMouseEvent(callback)\n    local mouseEvent\n\n    mouseEvent = connectionService:Connect(userInputService.InputChanged, function(\n        input\n    )\n        if inputUtils.isMovingInput(input) then\n            callback(input)\n        end\n    end)\n\n    return mouseEvent\nend\nfunction inputUtils.isPressingInput(input)\n    return PRESSING_INPUTS[input.UserInputType] ~= nil\nend\nfunction inputUtils.isMovingInput(input)\n    return MOVING_INPUTS[input.UserInputType] ~= nil\nend\n\nreturn inputUtils\n",
[ "src/ui/utils/mainFrameDock.luau" ] = "local robloxServices = require('../../framework/services/rbxServices')\nlocal connectionService = require('../../framework/services/connectionService')\nlocal uiTweens = require('../../framework/services/tweenService')\nlocal TweenService = robloxServices.TweenService\nlocal UserInputService = robloxServices.UserInputService\nlocal RunService = robloxServices.RunService\nlocal MOVE_TIME = 0.32\nlocal TAP_MAX_TIME = 0.1\nlocal TAP_MAX_TRAVEL = 10\nlocal DRAG_DOWN_MIN = 50\nlocal CLICK_MAX_TIME = 0.3\nlocal SWIPE_OUTSIDE_MIN = 20\nlocal LOCK_IDLE_TIME = 3\nlocal MOVING_GRACE = 0.5\nlocal HOVER_EXPAND_TIME = 0.2\nlocal HOVER_MINIMIZE_TIME = 0.5\nlocal HOVER_MINIMIZE_DELAY = 1\nlocal PRESS_TYPES = {\n    [Enum.UserInputType.MouseButton1] = true,\n    [Enum.UserInputType.Touch] = true,\n}\nlocal dock = {}\n\ndock.__index = dock\n\nfunction dock.new(options)\n    local self = setmetatable({\n        frame = options.frame,\n        screenGui = options.screenGui,\n        topBarHeight = options.topBarHeight,\n        clampPosition = options.clampPosition,\n        getScale = options.getScale,\n        onMinimize = options.onMinimize,\n        onInteractive = options.onInteractive,\n        hoverToOpen = options.hoverToOpen == true and UserInputService.MouseEnabled,\n        commandBarInUse = options.commandBarInUse,\n        isMoving = options.isMoving,\n        lastMovingAt = -math.huge,\n        state = 'minimized',\n        interactive = nil,\n        hovering = false,\n        hoverRequest = 0,\n        dragging = false,\n        keepOpen = options.keepOpen == true,\n        windowParts = {},\n        tween = nil,\n        press = nil,\n        touches = {},\n        outsideTouches = {},\n        swipeLocked = false,\n        lastInteractionAt = -math.huge,\n        connections = {},\n    }, dock)\n\n    self.frame.Position = self:targetFor('minimized')\n\n    table.insert(self.connections, connectionService:Connect(UserInputService.InputBegan, function(\n        input\n    )\n        self:onInputBegan(input)\n    end))\n    table.insert(self.connections, connectionService:Connect(UserInputService.InputEnded, function(\n        input\n    )\n        self:onInputEnded(input)\n    end))\n    table.insert(self.connections, connectionService:Connect(UserInputService.InputChanged, function(\n        input\n    )\n        self:onInputChanged(input)\n    end))\n    table.insert(self.connections, connectionService:Connect(RunService.Heartbeat, function(\n    )\n        if self.isMoving and self.isMoving() then\n            self.lastMovingAt = os.clock()\n        end\n\n        self:checkLockIdle()\n    end))\n    self:setInteractive(false)\n\n    if self.hoverToOpen then\n        table.insert(self.connections, connectionService:Connect(self.frame.MouseEnter, function(\n        )\n            if self.frame.Visible then\n                self:setHovering(true)\n            end\n        end))\n        table.insert(self.connections, connectionService:Connect(self.frame.MouseLeave, function(\n        )\n            self:setHovering(false)\n        end))\n    end\n\n    return self\nend\n\nlocal function pointInside(object, point)\n    local pos = object.AbsolutePosition\n    local size = object.AbsoluteSize\n\n    return point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y\nend\n\nfunction dock:isOverWindow(point)\n    if pointInside(self.frame, point) then\n        return true\n    end\n\n    for _, part in self.windowParts do\n        if pointInside(part, point) then\n            return true\n        end\n    end\n\n    return false\nend\nfunction dock:addWindowPart(object)\n    table.insert(self.windowParts, object)\nend\nfunction dock:setKeepOpen(enabled)\n    self.keepOpen = enabled == true\n\n    if self.keepOpen and self.state == 'minimized' then\n        self:expand()\n    end\nend\nfunction dock:reveal()\n    self:lockSwipe()\n\n    if self.state == 'minimized' then\n        self:expand()\n    end\nend\nfunction dock:lockSwipe()\n    if self.hoverToOpen then\n        return\n    end\n    if not self:fingerOutsideWindow() then\n        return\n    end\n\n    self.swipeLocked = true\n    self.lastInteractionAt = os.clock()\nend\nfunction dock:fingerOutsideWindow()\n    for _, position in self.touches do\n        if not self:isOverWindow(position) then\n            return true\n        end\n    end\n\n    return false\nend\nfunction dock:unlockSwipe()\n    self.swipeLocked = false\nend\nfunction dock:noteInteraction()\n    self.lastInteractionAt = os.clock()\nend\nfunction dock:checkLockIdle()\n    if self.swipeLocked and os.clock() - self.lastInteractionAt >= LOCK_IDLE_TIME then\n        self.swipeLocked = false\n    end\nend\nfunction dock:onSettled(fn)\n    local tween = self.tween\n\n    if tween and tween.PlaybackState == Enum.PlaybackState.Playing then\n        tween.Completed:Once(fn)\n    else\n        task.defer(fn)\n    end\nend\nfunction dock:nearestSnap()\n    local frame = self.frame\n    local distanceToTop = frame.AbsolutePosition.Y\n    local distanceToBottom = self.screenGui.AbsoluteSize.Y - (frame.AbsolutePosition.Y + frame.AbsoluteSize.Y)\n\n    if distanceToTop <= distanceToBottom then\n        return 'top'\n    end\n    if self.state == 'expanded' then\n        return 'expanded'\n    end\n\n    return 'minimized'\nend\nfunction dock:targetFor(state)\n    local x = self.clampPosition(self.frame.Position).X\n\n    if state == 'top' then\n        return UDim2.new(x.Scale, x.Offset, 0, 0)\n    end\n    if state == 'expanded' then\n        return UDim2.new(x.Scale, x.Offset, 1, -self.frame.Size.Y.Offset)\n    end\n\n    return UDim2.new(x.Scale, x.Offset, 1, -self.topBarHeight)\nend\nfunction dock:clampDrag(pos)\n    local x = self.clampPosition(pos).X\n    local scale = math.max(self.getScale(), 0.01)\n    local screenHeight = self.screenGui.AbsoluteSize.Y / scale\n    local maxY = math.max(screenHeight - self.topBarHeight, 0)\n    local y = math.clamp(pos.Y.Scale * screenHeight + pos.Y.Offset, 0, maxY)\n\n    return UDim2.new(x.Scale, x.Offset, 0, y)\nend\nfunction dock:wasMovingRecently()\n    return os.clock() - self.lastMovingAt < MOVING_GRACE\nend\nfunction dock:setInteractive(enabled)\n    if self.interactive == enabled then\n        return\n    end\n\n    self.interactive = enabled\n\n    if self.onInteractive then\n        self.onInteractive(enabled)\n    end\nend\nfunction dock:cancel()\n    if self.tween then\n        self.tween:Cancel()\n\n        self.tween = nil\n    end\nend\nfunction dock:moveTo(state, time, direction)\n    if state == self.state and self.tween and self.tween.PlaybackState == Enum.PlaybackState.Playing then\n        return\n    end\n\n    local wasMinimized = self.state == 'minimized'\n\n    self.state = state\n\n    self:cancel()\n\n    if state == 'minimized' then\n        self.swipeLocked = false\n    elseif wasMinimized then\n        self:lockSwipe()\n    end\n    if state == 'minimized' then\n        self:setInteractive(false)\n    end\n\n    local target = self:targetFor(state)\n    local duration = uiTweens:getScale(time or MOVE_TIME)\n\n    if duration <= 0 then\n        self.frame.Position = target\n\n        self:setInteractive(state ~= 'minimized')\n\n        return\n    end\n\n    local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out)\n    local tween = TweenService:Create(self.frame, info, {Position = target})\n\n    self.tween = tween\n\n    tween.Completed:Connect(function(playback)\n        if playback ~= Enum.PlaybackState.Completed then\n            return\n        end\n        if self.tween ~= tween or self.state == 'minimized' then\n            return\n        end\n\n        self:setInteractive(true)\n    end)\n    tween:Play()\nend\nfunction dock:expand(time, direction)\n    self:moveTo('expanded', time, direction)\nend\nfunction dock:setHovering(over)\n    if over == self.hovering then\n        return\n    end\n\n    self.hovering = over\n\n    if self.dragging then\n        return\n    end\n    if over then\n        self:onHoverEnter()\n    else\n        self:onHoverLeave()\n    end\nend\nfunction dock:onHoverEnter()\n    self.hoverRequest = self.hoverRequest + 1\n\n    if self.state == 'minimized' then\n        self:expand(HOVER_EXPAND_TIME, Enum.EasingDirection.InOut)\n    end\nend\nfunction dock:onHoverLeave()\n    self.hoverRequest = self.hoverRequest + 1\n\n    local request = self.hoverRequest\n\n    if not self:canHoverMinimize() then\n        return\n    end\n\n    task.delay(HOVER_MINIMIZE_DELAY, function()\n        if request ~= self.hoverRequest or not self:canHoverMinimize() then\n            return\n        end\n\n        self:minimize(HOVER_MINIMIZE_TIME, Enum.EasingDirection.InOut)\n    end)\nend\nfunction dock:canHoverMinimize()\n    return self.state == 'expanded' and not self.keepOpen and not self:commandBarBusy()\nend\nfunction dock:onCommandBarClosed(enteredCommand)\n    if not self.hoverToOpen then\n        return\n    end\n    if self:fingerOnWindow() then\n        return\n    end\n\n    local request = self.hoverRequest\n\n    task.wait()\n\n    if request ~= self.hoverRequest or self.dragging or not self:canHoverMinimize() then\n        return\n    end\n    if self.hovering and not enteredCommand then\n        return\n    end\n    if self:fingerOnWindow() then\n        return\n    end\n\n    self:minimize(HOVER_MINIMIZE_TIME, Enum.EasingDirection.InOut)\nend\nfunction dock:onMobileEnter(isFocused)\n    if self.hoverToOpen then\n        return\n    end\n    if not self:wasMovingRecently() then\n        return\n    end\n\n    task.wait()\n\n    if self.dragging or isFocused() then\n        return\n    end\n    if self.state ~= 'expanded' or self.keepOpen then\n        return\n    end\n\n    self:minimize()\nend\nfunction dock:setDragging(dragging)\n    local wasDragging = self.dragging\n\n    self.dragging = dragging == true\n\n    if wasDragging and not self.dragging and self.hoverToOpen and not self.hovering then\n        self:onHoverLeave()\n    end\nend\nfunction dock:minimize(time, direction)\n    if self.onMinimize then\n        self.onMinimize()\n    end\n\n    self:moveTo('minimized', time, direction)\nend\nfunction dock:reflow()\n    self:cancel()\n\n    self.frame.Position = self:targetFor(self.state)\n\n    self:setInteractive(self.state ~= 'minimized')\nend\nfunction dock:sleep()\n    self:cancel()\n\n    self.state = 'minimized'\n    self.swipeLocked = false\n    self.frame.Position = self:targetFor('minimized')\n\n    self:setInteractive(false)\nend\nfunction dock:onDragEnded(gesture)\n    if gesture.travel <= TAP_MAX_TRAVEL then\n        self:moveTo(self.state)\n\n        return\n    end\n    if gesture.dy >= DRAG_DOWN_MIN and not self:commandBarBusy() and not self.swipeLocked then\n        self:minimize()\n\n        return\n    end\n\n    self:moveTo(self:nearestSnap())\nend\nfunction dock:onListSwipeDown()\n    if self.hoverToOpen or self.swipeLocked then\n        return\n    end\n    if self.state == 'minimized' or self:commandBarBusy() then\n        return\n    end\n\n    self:minimize()\nend\nfunction dock:commandBarBusy()\n    return self.commandBarInUse ~= nil and self.commandBarInUse() == true\nend\nfunction dock:fingerOnWindow()\n    for _, position in self.touches do\n        if self:isOverWindow(position) then\n            return true\n        end\n    end\n\n    return false\nend\nfunction dock:onInputChanged(input)\n    if input.UserInputType ~= Enum.UserInputType.Touch then\n        return\n    end\n    if self.touches[input] == nil then\n        return\n    end\n\n    self.touches[input] = input.Position\n\n    if self:isOverWindow(input.Position) then\n        self:noteInteraction()\n    end\n\n    local startPos = self.outsideTouches[input]\n\n    if startPos and (input.Position - startPos).Magnitude >= SWIPE_OUTSIDE_MIN then\n        self:onOutsideSwipe()\n    end\nend\nfunction dock:onOutsideSwipe()\n    if self.hoverToOpen or self.dragging or self.swipeLocked then\n        return\n    end\n    if self.state ~= 'expanded' or self.keepOpen or self:commandBarBusy() then\n        return\n    end\n\n    table.clear(self.outsideTouches)\n    self:minimize()\nend\nfunction dock:onInputBegan(input)\n    if input.UserInputType == Enum.UserInputType.Touch then\n        self.touches[input] = input.Position\n\n        if self:isOverWindow(input.Position) then\n            self:noteInteraction()\n        else\n            self.outsideTouches[input] = input.Position\n        end\n    end\n    if not PRESS_TYPES[input.UserInputType] then\n        return\n    end\n\n    self.press = {\n        type = input.UserInputType,\n        time = os.clock(),\n        position = input.Position,\n        inside = self:isOverWindow(input.Position),\n        startedExpanded = self.state == 'expanded',\n    }\nend\nfunction dock:onInputEnded(input)\n    if input.UserInputType == Enum.UserInputType.Touch then\n        self.touches[input] = nil\n        self.outsideTouches[input] = nil\n    end\n\n    local press = self.press\n\n    if not press or input.UserInputType ~= press.type then\n        return\n    end\n\n    self.press = nil\n\n    local duration = os.clock() - press.time\n    local travel = (input.Position - press.position).Magnitude\n\n    if press.inside then\n        if duration <= TAP_MAX_TIME and travel <= TAP_MAX_TRAVEL and self.state == 'minimized' then\n            self:expand()\n        end\n\n        return\n    end\n\n    local isClick = duration <= CLICK_MAX_TIME and travel <= TAP_MAX_TRAVEL\n\n    if isClick and press.startedExpanded and not self.hoverToOpen and self.state == 'expanded' and not self.keepOpen and not self:commandBarBusy() and not self:wasMovingRecently() then\n        self:minimize()\n    end\nend\nfunction dock:destroy()\n    self:cancel()\n\n    self.hoverRequest = self.hoverRequest + 1\n\n    for _, connection in self.connections do\n        connectionService:disconnect(connection)\n    end\n\n    table.clear(self.connections)\n    table.clear(self.touches)\n    table.clear(self.outsideTouches)\nend\n\nreturn dock\n",
[ "src/ui/utils/notificationPlacement.luau" ] = "local placement = {}\n\nfunction placement.compute(window, screen, stack, gap)\n    local left = window.x.scale * screen.width + window.x.offset\n    local right = left + window.width\n    local roomRight = screen.width - right - gap\n    local roomLeft = left - gap\n    local onRight\n\n    if roomRight >= stack.width then\n        onRight = true\n    elseif roomLeft >= stack.width then\n        onRight = false\n    else\n        onRight = roomRight >= roomLeft\n    end\n\n    local x\n\n    if onRight then\n        x = {\n            scale = window.x.scale,\n            offset = window.x.offset + window.width + gap,\n        }\n    else\n        x = {\n            scale = window.x.scale,\n            offset = window.x.offset - gap,\n        }\n    end\n\n    local top = window.y.scale * screen.height + window.y.offset\n    local bottom = top + window.height\n    local visibleCenter = (math.max(top, 0) + math.min(bottom, screen.height)) / 2\n    local growsUp = visibleCenter > screen.height / 2\n    local y, anchorY, room\n\n    if growsUp then\n        if bottom >= screen.height then\n            y = {\n                scale = 1,\n                offset = 0,\n            }\n        else\n            y = {\n                scale = window.y.scale,\n                offset = window.y.offset + window.height,\n            }\n        end\n\n        anchorY = 1\n        room = math.min(bottom, screen.height)\n    else\n        if top < 0 then\n            y = {\n                scale = 0,\n                offset = 0,\n            }\n        else\n            y = {\n                scale = window.y.scale,\n                offset = window.y.offset,\n            }\n        end\n\n        anchorY = 0\n        room = screen.height - math.max(top, 0)\n    end\n\n    return {\n        x = x,\n        y = y,\n        anchorX = if onRight then 0 else 1,\n        anchorY = anchorY,\n        room = math.max(room, 0),\n    }\nend\n\nreturn placement\n",
[ "src/ui/utils/scaleObject.luau" ] = "return {\n    uiScale = Instance.new('UIScale'),\n    getScale = function(self)\n        local uiScale = self.uiScale\n\n        return uiScale and (uiScale:GetAttribute('REAL_SCALE') or uiScale.Scale) or 1\n    end,\n    setScale = function(self, scale)\n        local uiScale = self.uiScale\n\n        if uiScale then\n            uiScale.Scale = scale\n\n            uiScale:SetAttribute('REAL_SCALE', scale)\n        end\n    end,\n}\n",
[ "src/ui/utils/titleFormatter.luau" ] = "local titleFormatter = {}\nlocal fwSettings = require('../../framework/settings')\nlocal emojis = require('../themes/tokens/emojis')\n\nfunction titleFormatter.getEasterDate()\n    local year = tonumber(os.date('%Y'))\n    local century = math.floor(year / 100)\n    local correction = math.floor((13 + 8 * century) / 25)\n    local solarCorrection = (15 - correction + century - math.floor(century / 4)) % 30\n    local lunarCorrection = (4 + century - math.floor(century / 4)) % 7\n    local epact = (19 * (year % 19) + solarCorrection) % 30\n    local daysToAdd = (2 * (year % 4) + 4 * (year % 7) + 6 * epact + lunarCorrection) % 7\n    local paschalFullMoon = 22 + epact + daysToAdd\n\n    if epact == 29 and daysToAdd == 6 then\n        return '04 19'\n    elseif epact == 28 and daysToAdd == 6 then\n        return '04 18'\n    end\n    if paschalFullMoon > 31 then\n        return string.format('04 %02d', paschalFullMoon - 31)\n    end\n\n    return string.format('03 %02d', paschalFullMoon)\nend\nfunction titleFormatter.getHolidayEmoji()\n    local eDate = titleFormatter.getEasterDate()\n    local holidays = {\n        ['01 01'] = emojis['NEW_YEAR'],\n        ['02 14'] = emojis['VALENTINE_DAYS'],\n        ['03 17'] = emojis['CLOVER'],\n        ['10 31'] = emojis['HALLOWEEN'],\n        ['12 25'] = emojis['CHRISTMAS'],\n        [eDate] = emojis['EASTER'],\n    }\n    local today = os.date('%m %d')\n\n    return holidays[today]\nend\nfunction titleFormatter.getDisplayName()\n    local displayName = fwSettings.applicationName\n    local version = fwSettings.version\n\n    displayName = string.gsub(displayName, '!VERSION', version)\n\n    local holidayEmoji = titleFormatter.getHolidayEmoji()\n\n    if holidayEmoji then\n        displayName = `{holidayEmoji} {displayName} {holidayEmoji}`\n    end\n\n    return displayName\nend\n\nreturn titleFormatter\n",
[ "src/utils/encryptor.luau" ] = "local logger = require('./logger')\nlocal encryptor = {}\n\nencryptor.__index = encryptor\n\nfunction encryptor:encrypt(text)\n    logger:expect(text, {\n        'string',\n    }, \"'encryptor:encrypt' #1\")\n\n    local seed = self.encryptKey\n    local buffer = {}\n\n    for index = 1, #text do\n        seed = (seed * 16807) % 2147483647\n\n        table.insert(buffer, string.format('%02X', (text:byte(index) + seed % 256) % 256))\n    end\n\n    return table.concat(buffer)\nend\nfunction encryptor:decrypt(text, keys)\n    logger:expect(text, {\n        'string',\n    }, \"'encryptor:decrypt' #1\")\n\n    local seed = self.encryptKey\n    local result = {}\n\n    for index = 1, #text, 2 do\n        local byte = tonumber(text:sub(index, index + 1), 16)\n\n        seed = (seed * 16807) % 2147483647\n        result[#result + 1] = string.char((byte - seed % 256 + 256) % 256)\n    end\n\n    return table.concat(result)\nend\nfunction encryptor.new(encryptKey)\n    logger:expect(encryptKey, {\n        'number',\n    }, \"'encryptor.new' #1\")\n\n    return setmetatable({encryptKey = encryptKey}, encryptor)\nend\n\nreturn encryptor\n",
[ "src/utils/getHierarchy.luau" ] = "local LUA_KEYWORDS = {\n    ['and'] = true,\n    ['break'] = true,\n    ['do'] = true,\n    ['else'] = true,\n    ['elseif'] = true,\n    ['end'] = true,\n    ['false'] = true,\n    ['for'] = true,\n    ['function'] = true,\n    ['if'] = true,\n    ['in'] = true,\n    ['local'] = true,\n    ['nil'] = true,\n    ['not'] = true,\n    ['or'] = true,\n    ['repeat'] = true,\n    ['return'] = true,\n    ['then'] = true,\n    ['true'] = true,\n    ['until'] = true,\n    ['while'] = true,\n}\n\nlocal function escapeString(text)\n    local escaped = text:gsub('\\\\', '\\\\\\\\'):gsub('\"', '\\\\\"'):gsub('\\n', '\\\\n')\n\n    return escaped\nend\nlocal function indexFor(name)\n    if string.match(name, '^[%a_][%w_]*$') and not LUA_KEYWORDS[name] then\n        return '.' .. name\n    end\n\n    return '[\"' .. escapeString(name) .. '\"]'\nend\nlocal function rootFor(top)\n    local isService = pcall(game.GetService, game, top.ClassName)\n\n    if isService then\n        return `game:GetService(\"{top.ClassName}\")`\n    end\n\n    return 'game' .. indexFor(top.Name)\nend\nlocal function getHierarchy(instance)\n    if not instance then\n        return ''\n    end\n\n    local chain = {}\n    local node = instance\n\n    while node and node ~= game do\n        table.insert(chain, 1, node)\n\n        node = node.Parent\n    end\n\n    if node ~= game then\n        return instance:GetFullName()\n    end\n    if #chain == 0 then\n        return 'game'\n    end\n\n    local path = rootFor(chain[1])\n\n    for index = 2, #chain do\n        path = path .. indexFor(chain[index].Name)\n    end\n\n    return path\nend\n\nreturn getHierarchy\n",
[ "src/utils/json.luau" ] = "local robloxServices = require('../framework/services/rbxServices')\nlocal logger = require('./logger')\nlocal httpService = robloxServices.HttpService\nlocal jsonEncode = httpService.JSONEncode\nlocal jsonDecode = httpService.JSONDecode\n\nreturn {\n    encode = function(raw, filePath)\n        local success, content = pcall(jsonEncode, httpService, raw)\n\n        if not success then\n            logger:warn(`failed to encode json '{filePath or 'unknown'}': {content}`)\n\n            return nil\n        end\n\n        return content\n    end,\n    decode = function(content, filePath)\n        local success, raw = pcall(jsonDecode, httpService, content)\n\n        if not success then\n            logger:warn(`failed to decode json '{filePath or 'unknown'}': {raw}`)\n\n            return nil\n        end\n\n        return raw\n    end,\n}\n",
[ "src/utils/logger.luau" ] = "local loggerConfigs = require('../framework/config/utils/logger')\nlocal logText = loggerConfigs.logText\nlocal logger = {}\n\nfunction logger:isEnabled()\n    return loggerConfigs.isEnabled\nend\nfunction logger:enable()\n    loggerConfigs.isEnabled = true\nend\nfunction logger:disable()\n    loggerConfigs.isEnabled = false\nend\nfunction logger:log(message, ...)\n    if not self:isEnabled() then\n        return\n    end\n\n    print(logText:format(tostring(message)), ...)\nend\nfunction logger:debug(message, ...)\n    if not self:isEnabled() then\n        return\n    end\n\n    print(logText:format(tostring(message)), ...)\nend\nfunction logger:warn(message)\n    if not self:isEnabled() then\n        return\n    end\n\n    (warn or print)(logText:format(tostring(message)))\nend\nfunction logger:error(message, level)\n    error(logText:format(tostring(message)), level)\nend\nfunction logger:fail(message)\n    self:error('failed to load: ' .. message)\nend\nfunction logger:assert(value, message)\n    if not value then\n        self:error(message)\n\n        return\n    end\n\n    return value\nend\nfunction logger:expect(value, expected, message)\n    if not table.find(expected, typeof(value)) then\n        self:error((message or '') .. ` expected '{table.concat(expected, ', ')}'. got '{typeof(value)}'.`)\n    end\n\n    return value\nend\n\nreturn logger\n",
[ "src/utils/luahighlight.luau" ] = "local luaConvertions = require('../framework/config/utils/luaConvertions')\nlocal logger = require('./logger')\nlocal tools = require('./tools')\nlocal lookupify = tools.lookupify\nlocal highlight = {}\n\nhighlight.__index = highlight\n\nfunction highlight:skipWhiteSpace() end\nfunction highlight:next() end\nfunction highlight:apply(sourceCode)\n    logger:expect(sourceCode, {\n        'string',\n    }, \"'highlight:apply' #1\")\n\n    return table.concat(codeBuffer)\nend\nfunction highlight.new()\n    return setmetatable({codeBuffer = {}}, highlight)\nend\n\nreturn highlight\n",
[ "src/utils/nameColor.luau" ] = "local colors = require('../framework/config/ui/colors').text\nlocal PALETTE = {colors.red, colors.purple, colors.green}\nlocal nameColor = {}\n\nfunction nameColor.value(name)\n    local value = 0\n    local length = #name\n\n    for index = 1, length do\n        local code = string.byte(name, index)\n        local reverseIndex = length - index + 1\n\n        if length % 2 == 1 then\n            reverseIndex -= 1\n        end\n        if reverseIndex % 4 >= 2 then\n            code = -code\n        end\n\n        value += code\n    end\n\n    return value\nend\nfunction nameColor.forName(name)\n    return PALETTE[nameColor.value(name) % #PALETTE + 1]\nend\nfunction nameColor.forPlayer(player, legacy)\n    return nameColor.forName(player.Name)\nend\n\nreturn nameColor\n",
[ "src/utils/signal.luau" ] = "local connection = {}\nlocal signal = {}\n\nconnection.__index = connection\nsignal.__index = signal\n\nfunction connection:Disconnect()\n    if not self._isConnected then\n        return\n    end\n\n    local connections = self.Parent and self.Parent.Connections\n    local found = connections and table.find(connections, self)\n\n    if found then\n        table.remove(connections, found)\n    end\n\n    self._connectedFunc = nil\n    self._isConnected = false\nend\nfunction connection:Fire(...)\n    if self._connectedFunc ~= nil then\n        task.spawn(self._connectedFunc, ...)\n    end\nend\nfunction connection.new(parent, func)\n    local connected = setmetatable({\n        _isConnected = true,\n        _connectedFunc = func,\n        Parent = parent,\n    }, connection)\n\n    table.insert(parent.Connections, connected)\n\n    return connected\nend\nfunction signal:Connect(func)\n    assert(type(func) == 'function', `function expected, got {type(func)}`)\n\n    return connection.new(self, func)\nend\nfunction signal:Once(func)\n    local connection\n\n    connection = self:Connect(function(...)\n        connection:Disconnect()\n        task.spawn(func, ...)\n    end)\n\n    return connection\nend\nfunction signal:Wait()\n    local waitingCoroutine, connection = coroutine.running(), nil\n\n    connection = self:Connect(function(...)\n        connection:Disconnect()\n        task.spawn(waitingCoroutine, ...)\n    end)\n\n    return coroutine.yield()\nend\nfunction signal:Fire(...)\n    for _, connection in ipairs(self.Connections)do\n        connection:Fire(...)\n    end\nend\nfunction signal.new()\n    return setmetatable({Connections = {}}, signal)\nend\n\nreturn signal\n",
[ "src/utils/stringifier.luau" ] = "local stringifier = {}\nlocal toString = {\n    ['Vector3'] = function(value)\n        return `{value.X} {value.Y} {value.Z}`\n    end,\n    ['Color3'] = function(value)\n        return `{value.R} {value.G} {value.B}`\n    end,\n}\nlocal fromString = {\n    ['Vector3'] = function(text)\n        local split = text:split(' ')\n\n        return Vector3.new(split[1] or 0, split[2] or 0, split[3] or 0)\n    end,\n    ['Color3'] = function(text)\n        local split = text:split(' ')\n\n        return Color3.new(split[1] or 0, split[2] or 0, split[3] or 0)\n    end,\n}\n\nfunction stringifier:stringify(value)\n    local callback = toString[typeof(value)]\n\n    assert(callback, \"can't convert to string\")\n\n    return callback(value)\nend\nfunction stringifier:unstringify(text, kind)\n    local callback = fromString[kind]\n\n    assert(callback, \"can't convert to value\")\n\n    return callback(text)\nend\n\nreturn stringifier\n",
[ "src/utils/textHighlight.luau" ] = "local argColors = require('../framework/config/ui/colors').args\nlocal tools = require('./tools')\nlocal highlight = {}\nlocal symbolChars = tools.charset(':#()[]<>{}-\\u{2013}\\u{2013}&*$%@')\nlocal WORD_PATTERN = '^[%w_%.]+'\nlocal TAG_PATTERN = '^[%w_]+'\n\nlocal function isWordChar(char)\n    return char ~= '' and string.match(char, '[%w_%.]') ~= nil\nend\nlocal function isNumber(word)\n    return string.match(word, '^%d+$') ~= nil or string.match(word, '^%d+%.%d+$') ~= nil\nend\nlocal function findClosingQuote(text, opening)\n    local quote = string.sub(text, opening, opening)\n    local position = opening + 1\n\n    while position <= #text do\n        local char = string.sub(text, position, position)\n\n        if char == '\\\\' then\n            position += 2\n        elseif char == quote then\n            return position\n        else\n            position += 1\n        end\n    end\n\n    return nil\nend\nlocal function split(text)\n    local pieces = {}\n\n    local function push(piece, color, bold)\n        if piece == '' then\n            return\n        end\n\n        local last = pieces[#pieces]\n\n        if last and last.color == color and last.bold == bold then\n            last.text = last.text .. piece\n        else\n            table.insert(pieces, {\n                text = piece,\n                color = color,\n                bold = bold,\n            })\n        end\n    end\n\n    local position = 1\n    local length = #text\n\n    while position <= length do\n        local char = string.sub(text, position, position)\n        local previous = if position > 1 then string.sub(text, position - 1, position - 1)else''\n\n        if (char == '@' or char == '#') and not isWordChar(previous) then\n            local _, tagEnd = string.find(text, TAG_PATTERN, position + 1)\n\n            if tagEnd then\n                push(string.sub(text, position, tagEnd), argColors.tag, true)\n\n                position = tagEnd + 1\n\n                continue\n            end\n        end\n        if (char == '\"' or char == \"'\") and not isWordChar(previous) then\n            local closing = findClosingQuote(text, position)\n\n            if closing then\n                push(string.sub(text, position, closing), argColors.string, false)\n\n                position = closing + 1\n\n                continue\n            end\n        end\n        if isWordChar(char) then\n            local _, wordEnd = string.find(text, WORD_PATTERN, position)\n            local word = string.sub(text, position, wordEnd)\n\n            push(word, if isNumber(word)then argColors.number else nil, false)\n\n            position = wordEnd + 1\n        else\n            push(char, if symbolChars[char]then argColors.symbol else nil, false)\n\n            position += 1\n        end\n    end\n\n    return pieces\nend\n\nfunction highlight:apply(value)\n    local parts = {}\n\n    for _, piece in split(tostring(value))do\n        local text = tools.escapeRichText(piece.text)\n\n        if piece.color then\n            text = tools.colorFromRGB(text, piece.color)\n        end\n        if piece.bold then\n            text = `<b>{text}</b>`\n        end\n\n        table.insert(parts, text)\n    end\n\n    return table.concat(parts)\nend\n\nreturn highlight\n",
[ "src/utils/tools.luau" ] = "local tools = {}\nlocal readableChars = 'abcdefghijklmnopqrstuvABCDEFGHIJKLMNOPQRSTUV_0123456789'\nlocal RICH_TEXT_ESCAPE = {\n    ['&'] = '&amp;',\n    ['<'] = '&lt;',\n    ['>'] = '&gt;',\n    ['\"'] = '&quot;',\n    [\"'\"] = '&apos;',\n}\n\nfunction tools.randomString(length)\n    local buffer = {}\n\n    for _ = 1, length do\n        local index = math.random(1, #readableChars)\n\n        table.insert(buffer, readableChars:sub(index, index))\n    end\n\n    return table.concat(buffer)\nend\nfunction tools.getDeep(tab, path)\n    for key in path:gmatch('[^%.]+')do\n        tab = tab[key]\n    end\n\n    return tab\nend\nfunction tools.simpleCreate(className, properties)\n    local object = Instance.new(className)\n\n    for property, value in properties do\n        object[property] = value\n    end\n\n    return object\nend\nfunction tools.chararray(text)\n    local array = {}\n\n    for pos = 1, #text do\n        table.insert(array, text:sub(pos, pos))\n    end\n\n    return array\nend\nfunction tools.lookupify(array)\n    local tab = {}\n\n    for key = 1, #array do\n        local value = array[key]\n\n        tab[value] = true\n    end\n\n    return tab\nend\nfunction tools.unlookupify(tab)\n    local array = {}\n\n    for key, _ in tab do\n        table.insert(array, key)\n    end\n\n    return array\nend\nfunction tools.escapeRichText(text)\n    local escaped = tostring(text):gsub('.', function(char)\n        return RICH_TEXT_ESCAPE[char] or char\n    end)\n\n    return escaped\nend\nfunction tools.charset(text)\n    local set = {}\n\n    for char in text:gmatch('.')do\n        set[char] = true\n    end\n\n    return set\nend\nfunction tools.versionToNumber(version)\n    local cleanVersion = version:gsub('^v', '')\n    local versionNumber = 0\n    local parts = cleanVersion:split('.')\n\n    for index, part in parts do\n        local numericPart = tonumber(part) or 0\n\n        versionNumber += numericPart * math.pow(1000, 3 - index)\n    end\n\n    return versionNumber\nend\nfunction tools.colorFromRGB(text, color3)\n    return `<font color=\"#{color3:ToHex()}\">{text}</font>`\nend\nfunction tools.richFontSize(text, size)\n    return `<font size=\"{size}\">{text}</font>`\nend\n\nreturn tools\n",
[ "src/version.luau" ] = "return 'v0.7.0'\n",
},
}
