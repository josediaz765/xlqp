[ "src/framework/config/utils/luaConvertions.luau" ] = "local tools = require('../../../utils/tools')\nlocal defaultEscapeSequences = {\n    ['a'] = '\\a',\n    ['b'] = '\\b',\n    ['f'] = '\\f',\n    ['n'] = '\\n',\n    ['r'] = '\\r',\n    ['t'] = '\\t',\n    ['v'] = '\\v',\n    ['\\\\'] = '\\\\',\n    ['\"'] = '\"',\n    [\"'\"] = \"'\",\n}\nlocal startIdentChars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_'\nlocal identChars = \n[[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789]]\nlocal hexDigitsChars = '0123456789abcdefABCDEF'\nlocal digitChars = '0123456789'\n\nreturn {\n    whiteSpaceChars = {\n        ' ',\n        '\\t',\n        '\\n',\n        '\\r',\n    },\n    startIdentChars = tools.chararray(startIdentChars),\n    identChars = tools.chararray(identChars),\n    numberChars = tools.chararray(digitChars),\n    hexNumberChars = tools.chararray(hexDigitsChars),\n    escapeSequences = defaultEscapeSequences,\n    maxSymbolLength = 3,\n    binaryNumberChars = {\n        '0',\n        '1',\n    },\n    decimalExponent = {\n        'e',\n        'E',\n    },\n    hexadecimalNums = {\n        'x',\n        'X',\n    },\n    binaryNums = {\n        'b',\n        'B',\n    },\n    decimalSeparators = {\n        '_',\n    },\n    hybridKeywords = {\n        'continue',\n        'export',\n        'type',\n        'typeof',\n        'read',\n        'write',\n    },\n    keywords = {\n        'and',\n        'break',\n        'do',\n        'else',\n        'elseif',\n        'continue',\n        'end',\n        'false',\n        'for',\n        'function',\n        'if',\n        'in',\n        'local',\n        'nil',\n        'not',\n        'or',\n        'repeat',\n        'return',\n        'then',\n        'true',\n        'until',\n        'while',\n        'export',\n        'type',\n        'typeof',\n        'read',\n        'write',\n    },\n    symbols = {\n        '+=',\n        '-=',\n        '/=',\n        '%=',\n        