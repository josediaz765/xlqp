[ "src/framework/environment/executor.luau" ] = "local _ENV = (getgenv or getfenv or getrenv)()\n\nlocal function register(kind, original, fallback)\n    if type(original) == kind then\n        return original\n    end\n    if fallback ~= nil then\n        if fallback == true then\n            fallback = function(...)\n                return ...\n            end\n        end\n\n        return fallback\n    end\nend\n\nreturn setmetatable({\n    cloneref = register('function', cloneref, true),\n    setfpscap = register('function', setfpscap, function(cap)\n        if typeof(_ENV.FPS_CAP_THREAD) == 'thread' then\n            task.cancel(_ENV.FPS_CAP_THREAD)\n        end\n\n        _ENV.FPS_CAP_THREAD = task.spawn(function()\n            local os_clock = os.clock\n            local task_wait = task.wait\n            local timer = os_clock() + (1 / cap)\n\n            while true do\n                task_wait(math.max(timer - os_clock(), 0))\n\n                timer = os_clock() + (1 / cap)\n            end\n        end)\n    end),\n    gethui = register('function', gethui or get_hidden_gui),\n    sethiddenproperty = register('function', sethiddenproperty or set_hidden_property or set_hidden_prop),\n    gethiddenproperty = register('function', gethiddenproperty or get_hidden_property or get_hidden_prop),\n    queueteleport = register('function', queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)),\n    httprequest = register('function', request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)),\n    setclipboard = register('function', setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)),\n    firetouchinterest = register('function', firetouchinterest),\n    makefolder = register('function', makefolder),\n    isfolder = register('function', isfolder),\n    getcustomasset = register('function', getcustomasset or getsynasset),\n    hookfunction = register('function', hookfunction),\n    hookmetamethod = register('function', hookmetamethod),\n    getnamecallmethod = register('function', getnamecallmethod or get_namecall_method),\n    checkcaller = register('function', checkcaller, function()\n        return false\n    end),\n    newcclosure = register('function', newcclosure),\n    getgc = register('function', getgc or get_gc_objects),\n    setthreadidentity = register('function', setthreadidentity or syn_context_set or setthreadcontext or (syn and syn.set_thread_identity)),\n    replicatesignal = register('function', replicatesignal),\n    getconnections = register('function', getconnections or get_signal_cons),\n    writefile = register('function', writefile),\n    readfile = register('function', readfile),\n    listfiles = register('function', listfiles),\n    loadstring = register('function', loadstring),\n    isfile = register('function', isfile, readfile and function(path)\n        local success, result = pcall(readfile, path)\n\n        return success and result ~= nil and result ~= ''\n    end),\n}, {\n    __index = _ENV,\n    __newindex = function(self, index, value)\n        _ENV[index] = value\n    end,\n})\n",
